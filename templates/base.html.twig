<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Dev Esports{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        
        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
        
        <!-- Font Awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        
        <!-- Chart.js -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        
        <!-- App CSS -->
        <link href="{{ asset('css/app.css') }}" rel="stylesheet">
        
        <style>
            :root {
                --primary: #b622d1;
                --primary-dark: #8b1aa8;
                --secondary: #00d9ff;
                --secondary-dark: #00a8cc;
                --accent: #ff0080;
                --accent-dark: #cc0066;
                --success: #10b981;
                --danger: #ff3860;
                --warning: #ff9500;
                --info: #0dd9ff;
                --bg-dark: #0a0e27;
                --bg-secondary: #141829;
                --bg-tertiary: #1a1f3a;
                --text-primary: #ffffff;
                --text-secondary: #b0b8cc;
                --text-muted: #6b7280;
                --border: #334155;
                --shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
                overflow-x: hidden;
            }

            html.sidebar-open {
                overflow: hidden;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                background-color: var(--bg-dark);
                color: var(--text-primary);
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            body.sidebar-open {
                overflow: hidden;
                width: 100%;
                height: 100vh;
                margin: 0 !important;
            }

            /* Navbar Styles */
            .navbar-custom {
                background: rgba(10, 14, 39, 0.8);
                border-bottom: 1px solid rgba(0, 242, 254, 0.08);
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
                padding: 0.6rem 0;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1022;
                backdrop-filter: blur(20px) saturate(180%);
                -webkit-backdrop-filter: blur(20px) saturate(180%);
                width: 100%;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            /* When sidebar is visible */
            body.has-sidebar .navbar-custom {
                margin-left: 0;
            }

            body.has-sidebar.sidebar-collapsed .navbar-custom {
                margin-left: 0;
            }

            @media (max-width: 768px) {
                body.has-sidebar .navbar-custom {
                    margin-left: 0 !important;
                }

                body.has-sidebar.sidebar-collapsed .navbar-custom {
                    margin-left: 0 !important;
                }
            }

            .navbar-brand-custom {
                font-size: 1.4rem;
                font-weight: 800;
                display: flex;
                align-items: center;
                gap: 0.6rem;
                background: linear-gradient(135deg, #00f2fe, #00ff9d);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                text-decoration: none;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                white-space: nowrap;
                margin-right: 2rem;
                letter-spacing: -0.5px;
            }

            .navbar-brand-custom:hover {
                transform: scale(1.03);
                filter: brightness(1.2);
            }

            .navbar-brand-custom i {
                font-size: 1.5rem;
                -webkit-text-fill-color: #00f2fe;
            }

            .navbar-nav-custom {
                display: flex;
                gap: 2rem;
                align-items: center;
                list-style: none;
            }

            .nav-item-custom a {
                color: var(--text-secondary);
                text-decoration: none;
                font-weight: 500;
                padding: 0.5rem 0.9rem;
                border-radius: 8px;
                transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                position: relative;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 0.9rem;
                letter-spacing: 0.1px;
            }

            .nav-item-custom a:hover {
                color: #00f2fe;
                background: rgba(0, 242, 254, 0.08);
            }

            /* Auth Buttons */
            .btn-nav-auth {
                background: transparent !important;
                color: #00f2fe !important;
                border: 1.5px solid rgba(0, 242, 254, 0.4) !important;
                border-radius: 10px !important;
                padding: 0.45rem 1.1rem !important;
                font-weight: 600 !important;
                transition: all 0.25s ease !important;
            }

            .btn-nav-auth:hover {
                background: rgba(0, 242, 254, 0.1) !important;
                border-color: #00f2fe !important;
                transform: translateY(-1px);
                box-shadow: 0 4px 15px rgba(0, 242, 254, 0.2) !important;
            }

            .btn-nav-signup {
                background: linear-gradient(135deg, #00f2fe, #00ff9d) !important;
                color: #0a0e27 !important;
                border: none !important;
                border-radius: 10px !important;
                padding: 0.5rem 1.2rem !important;
                font-weight: 700 !important;
                transition: all 0.25s ease !important;
            }

            .btn-nav-signup:hover {
                box-shadow: 0 4px 20px rgba(0, 242, 254, 0.35) !important;
                transform: translateY(-1px);
            }

            /* Dropdown Menu */
            .nav-item-custom.dropdown {
                position: relative;
            }

            .nav-item-custom .dropdown-toggle::after {
                display: inline-block;
                content: '';
                border: none;
                margin-left: 0.5rem;
            }

            .dropdown-menu-custom {
                background: rgba(16, 20, 48, 0.98) !important;
                border: 1px solid rgba(0, 242, 254, 0.12) !important;
                border-radius: 12px !important;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255,255,255,0.03) !important;
                backdrop-filter: blur(30px) !important;
                -webkit-backdrop-filter: blur(30px) !important;
                min-width: 220px !important;
                padding: 0.5rem !important;
                animation: dropdownFade 0.2s ease;
            }

            @keyframes dropdownFade {
                from { opacity: 0; transform: translateY(-8px); }
                to { opacity: 1; transform: translateY(0); }
            }

            .dropdown-menu-custom .dropdown-item {
                color: var(--text-secondary) !important;
                padding: 0.7rem 1rem !important;
                transition: all 0.2s ease !important;
                display: flex !important;
                align-items: center !important;
                gap: 0.6rem !important;
                border-radius: 8px !important;
                font-size: 0.9rem !important;
            }

            .dropdown-menu-custom .dropdown-item:hover {
                background: rgba(0, 242, 254, 0.08) !important;
                color: #00f2fe !important;
                transform: translateX(4px);
            }

            .dropdown-menu-custom .dropdown-divider {
                background-color: rgba(0, 242, 254, 0.1) !important;
                margin: 0.5rem 0 !important;
            }

            .nav-item-custom a::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 0;
                height: 2px;
                background: var(--primary);
                transition: width 0.3s ease;
            }

            .nav-item-custom a:hover {
                color: var(--primary);
                background: rgba(0, 242, 254, 0.1);
            }

            .nav-item-custom a:hover::after {
                width: 100%;
            }

            .nav-item-custom a i {
                font-size: 1.1rem;
            }

            /* Admin Badge */
            .admin-badge {
                background: linear-gradient(135deg, #00f2fe, #00ff9d);
                color: #0a0e27;
                padding: 0.35rem 0.75rem;
                border-radius: 8px;
                font-weight: 700;
                font-size: 0.8rem;
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                letter-spacing: 0.3px;
                box-shadow: 0 2px 10px rgba(0, 242, 254, 0.25);
            }

            .admin-badge i {
                font-size: 0.95rem;
            }

            /* Sidebar Styles */
            .sidebar-nav {
                position: fixed;
                left: 0;
                top: 0;
                width: 260px;
                height: 100vh;
                background: rgba(12, 16, 36, 0.95);
                border-right: 1px solid rgba(0, 242, 254, 0.08);
                z-index: 500;
                display: flex;
                flex-direction: column;
                overflow-y: auto;
                padding-top: 0;
                transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                margin-top: 0;
                box-shadow: 4px 0 24px rgba(0, 0, 0, 0.3);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
            }

            /* When sidebar is collapsed, keep it but push it off-screen on mobile */
            .sidebar-nav.collapsed {
                width: 80px;
            }

            body.admin-layout {
                margin-left: 0;
                margin-top: 0;
            }

            body.admin-layout.sidebar-collapsed {
                margin-left: 0;
            }

            body.admin-layout.sidebar-hidden {
                margin-left: 0;
            }

            body.admin-layout main {
                transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1), width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                padding-top: 120px !important;
                margin-left: 80px;
                width: calc(100% - 80px);
            }

            body.admin-layout .navbar-custom {
                left: 0;
                width: 100%;
            }

            body.admin-layout.sidebar-collapsed .navbar-custom {
                left: 0;
                width: 100%;
            }

            /* Ensure main content is visible and full width */
            main,
            main.container-fluid,
            main.container-fluid.py-4 {
                display: block !important;
                visibility: visible !important;
                position: relative !important;
                z-index: 10 !important;
                background: transparent !important;
                padding-top: 90px !important;
                margin-top: 0 !important;
                margin-left: 0 !important;
                margin-right: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
                padding-bottom: 2rem !important;
            }

            body.has-sidebar {
                overflow-x: hidden;
                margin: 0 !important;
                padding: 0 !important;
                width: 100%;
            }

            body.has-sidebar main {
                margin-left: 80px !important;
                width: calc(100% - 80px) !important;
                transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1), width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }

            body.has-sidebar.sidebar-collapsed main {
                margin-left: 80px !important;
                width: calc(100% - 80px) !important;
            }

            @media (max-width: 768px) {
                body.has-sidebar main {
                    margin-left: 0 !important;
                }

                body.has-sidebar.sidebar-collapsed main {
                    margin-left: 0 !important;
                }
            }

            /* Sidebar Brand */
            .sidebar-brand {
                padding: 2rem 1.5rem;
                border-bottom: 1px solid rgba(0, 242, 254, 0.1);
                flex-shrink: 0;
                transition: all 0.3s ease;
            }

            .sidebar-nav.collapsed .sidebar-brand {
                padding: 1.5rem 0.75rem;
            }

            .brand-link {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                text-decoration: none;
                font-weight: 800;
                font-size: 1.2rem;
                color: var(--primary);
                transition: all 0.3s ease;
            }

            .sidebar-nav.collapsed .brand-link {
                justify-content: center;
                gap: 0;
            }

            .brand-link:hover {
                transform: scale(1.05);
                text-shadow: 0 0 10px rgba(0, 242, 254, 0.4);
            }

            .brand-icon {
                font-size: 1.75rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .brand-text {
                transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .sidebar-nav.collapsed .brand-text {
                opacity: 0;
                visibility: hidden;
                width: 0;
            }

            /* Menu Styles */
            .sidebar-menu {
                flex: 1;
                padding: 1rem 0;
                overflow-y: auto;
            }

            .sidebar-menu::-webkit-scrollbar {
                width: 6px;
            }

            .sidebar-menu::-webkit-scrollbar-track {
                background: transparent;
            }

            .sidebar-menu::-webkit-scrollbar-thumb {
                background: rgba(0, 242, 254, 0.2);
                border-radius: 3px;
            }

            .menu-section-title {
                padding: 1rem 1.5rem 0.5rem;
                font-size: 0.7rem;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                color: var(--text-secondary);
                font-weight: 700;
                margin-top: 0.5rem;
                transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.4s cubic-bezier(0.4, 0, 0.2, 1), padding 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .sidebar-nav.collapsed .menu-section-title {
                opacity: 0;
                visibility: hidden;
                padding: 0.5rem 0.75rem;
                height: 0;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 1rem;
                padding: 0.875rem 1.5rem;
                color: var(--text-secondary);
                text-decoration: none;
                transition: all 0.3s ease;
                border-left: 3px solid transparent;
                margin: 0.25rem 0.5rem;
                border-radius: 0 8px 8px 0;
                font-weight: 500;
                cursor: pointer;
                position: relative;
            }

            .sidebar-nav.collapsed .menu-item {
                padding: 0.875rem 0.75rem;
                justify-content: center;
                gap: 0;
            }

            .sidebar-nav.collapsed .menu-item .menu-label,
            .sidebar-nav.collapsed .menu-item .menu-arrow {
                opacity: 0;
                visibility: hidden;
                width: 0;
                overflow: hidden;
            }

            .menu-item:hover {
                color: var(--primary);
                background: rgba(0, 242, 254, 0.08);
                border-left-color: var(--primary);
                transform: translateX(4px);
            }

            .sidebar-nav.collapsed .menu-item:hover {
                transform: translateX(0);
            }

            .menu-item.active {
                color: var(--primary);
                background: rgba(0, 242, 254, 0.12);
                border-left-color: var(--primary);
                font-weight: 600;
                box-shadow: inset 0 0 10px rgba(0, 242, 254, 0.1);
            }

            .menu-icon {
                min-width: 1.5rem;
                font-size: 1.1rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .menu-label {
                flex: 1;
                font-size: 0.95rem;
                transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .menu-arrow {
                font-size: 0.75rem;
                transition: transform 0.3s ease;
                color: var(--text-secondary);
            }

            .menu-toggle[aria-expanded="true"] .menu-arrow {
                transform: rotate(180deg);
            }

            .menu-group {
                margin: 0;
            }

            .menu-subitem {
                display: flex;
                align-items: center;
                padding: 0.7rem 1.5rem 0.7rem 3.75rem;
                color: var(--text-secondary);
                text-decoration: none;
                transition: all 0.3s ease;
                font-size: 0.9rem;
                font-weight: 500;
                border-left: 3px solid transparent;
                position: relative;
            }

            .sidebar-nav.collapsed .menu-subitem {
                display: none;
            }

            .menu-subitem::before {
                content: '';
                position: absolute;
                left: 1.75rem;
                width: 4px;
                height: 4px;
                background: rgba(0, 242, 254, 0.4);
                border-radius: 50%;
                transition: all 0.3s ease;
            }

            .menu-subitem:hover {
                color: var(--primary);
                background: rgba(0, 242, 254, 0.05);
                border-left-color: var(--primary);
                transform: translateX(4px);
            }

            .menu-subitem:hover::before {
                background: var(--primary);
                transform: scale(1.5);
            }

            .menu-subitem.active {
                color: var(--secondary);
                background: rgba(37, 211, 102, 0.08);
                border-left-color: var(--secondary);
                font-weight: 600;
            }

            .menu-subitem.active::before {
                background: var(--secondary);
            }

            /* Divider */
            .menu-divider {
                height: 1px;
                background: rgba(0, 242, 254, 0.1);
                margin: 1rem 0;
            }

            /* Sidebar Footer */
            .sidebar-footer {
                padding: 1.5rem;
                border-top: 1px solid rgba(0, 242, 254, 0.1);
                flex-shrink: 0;
            }

            .footer-item {
                text-align: center;
            }

            .version-text {
                font-size: 0.75rem;
                color: var(--text-secondary);
                margin: 0;
                font-weight: 600;
            }

            .copyright-text {
                font-size: 0.7rem;
                color: var(--text-secondary);
                margin: 0.25rem 0 0;
            }

            /* Sidebar Toggle */
            .sidebar-toggle {
                position: fixed;
                top: 1rem;
                left: 1rem;
                width: 2.5rem;
                height: 2.5rem;
                background: linear-gradient(135deg, var(--primary), #00a8cc);
                border: none;
                border-radius: 8px;
                color: var(--bg-dark);
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.3s ease;
                font-size: 1.25rem;
                font-weight: bold;
                z-index: 1045;
                box-shadow: var(--shadow);
            }

            .sidebar-toggle:hover {
                transform: scale(1.1);
                box-shadow: 0 6px 20px rgba(0, 242, 254, 0.4);
            }

            .sidebar-toggle:active {
                transform: scale(0.95);
            }

            .sidebar-toggle i {
                transition: transform 0.3s ease;
            }

            body.admin-layout.sidebar-collapsed .sidebar-toggle i {
                transform: rotate(180deg);
            }

            /* Mobile Responsiveness */
            @media (max-width: 768px) {
                body.admin-layout {
                    margin-left: 0 !important;
                }

                body.admin-layout main {
                    margin-left: 0 !important;
                    width: 100%;
                }

                .navbar-custom {
                    left: 0 !important;
                    width: 100% !important;
                }

                body.sidebar-open {
                    overflow-y: hidden;
                }

                .sidebar-toggle {
                    z-index: 10000;
                }
            }

            /* Navbar Custom Container */
            .navbar-container-custom {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 1.5rem 0 5rem;
            }

            .navbar-content {
                display: flex;
                justify-content: flex-end;
                align-items: center;
                width: 100%;
            }

            /* Flash Messages */
            .alert-custom {
                border-radius: 8px;
                border: none;
                padding: 1rem 1.5rem;
                margin-bottom: 1rem;
                backdrop-filter: blur(10px);
                animation: slideIn 0.3s ease;
                margin-top: 1rem;
            }

            .alert-custom.alert-success {
                background-color: rgba(37, 211, 102, 0.1);
                color: #25d366;
                border-left: 4px solid #25d366;
            }

            .alert-custom.alert-danger {
                background-color: rgba(255, 68, 68, 0.1);
                color: #ff4444;
                border-left: 4px solid #ff4444;
            }

            .alert-custom.alert-warning {
                background-color: rgba(255, 149, 0, 0.1);
                color: #ff9500;
                border-left: 4px solid #ff9500;
            }

            .alert-custom.alert-info {
                background-color: rgba(13, 217, 255, 0.1);
                color: #0dd9ff;
                border-left: 4px solid #0dd9ff;
            }

            @keyframes slideIn {
                from {
                    opacity: 0;
                    transform: translateY(-10px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
        </style>
        
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    </head>
    {% set is_admin = 'admin' in app.request.attributes.get('_route', '') %}
    {% set is_logged_in_player = app.user and is_granted('ROLE_USER') %}
    <body{% if is_admin %} class="admin-layout"{% endif %}>
        
        {% if is_admin %}
            {% include 'partials/sidebar.html.twig' %}
        {% elseif is_logged_in_player %}
            {% include 'partials/player_sidebar.html.twig' %}
        {% endif %}
        
        <script>
            // Mark body as having sidebar
            if (document.querySelector('.sidebar-nav')) {
                document.body.classList.add('has-sidebar');
            }

            // Sidebar Toggle Functionality
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarNav = document.querySelector('.sidebar-nav');
            const body = document.body;

            if (sidebarToggle && sidebarNav) {
                // Check localStorage for saved state
                const sidebarCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
                if (sidebarCollapsed) {
                    sidebarNav.classList.add('collapsed');
                    body.classList.add('sidebar-collapsed');
                }

                // Toggle sidebar on button click
                sidebarToggle.addEventListener('click', () => {
                    sidebarNav.classList.toggle('collapsed');
                    body.classList.toggle('sidebar-collapsed');
                    
                    // Save state to localStorage
                    const isCollapsed = sidebarNav.classList.contains('collapsed');
                    localStorage.setItem('sidebarCollapsed', isCollapsed);
                    
                    // Prevent body from being pushed - keep it in place
                    body.style.overflow = 'auto';
                });

                // Add tooltip on hover for collapsed sidebar
                const menuItems = document.querySelectorAll('.menu-item');
                menuItems.forEach(item => {
                    item.addEventListener('mouseenter', function() {
                        if (sidebarNav.classList.contains('collapsed')) {
                            const label = this.querySelector('.menu-label');
                            if (label) {
                                this.setAttribute('title', label.textContent);
                            }
                        }
                    });
                });
            }
        </script>
        
        <!-- Navigation Bar - Hide on auth pages -->
        {% if app.request.attributes.get('_route') not in ['app_login', 'app_register', 'app_forgot_password', 'app_reset_password'] %}
        <nav class="navbar-custom">
            <div class="navbar-container-custom">
                <div style="display: flex; align-items: center; gap: 2rem;">
                    <a class="navbar-brand-custom" href="/">
                        <i class="fas fa-gamepad"></i>
                        <span>Dev Esports</span>
                    </a>
                </div>
                
                <div class="navbar-content">
                    <ul class="navbar-nav-custom">
                        <li class="nav-item-custom">
                            <a href="{{ path('match_index') }}">
                                <i class="fas fa-trophy"></i> Matches
                            </a>
                        </li>
                        <li class="nav-item-custom">
                            <a href="{{ path('tournament_index') }}">
                                <i class="fas fa-crown"></i> Tournaments
                            </a>
                        </li>
                        <li class="nav-item-custom">
                            <a href="{{ path('team_index') }}">
                                <i class="fas fa-users"></i> Teams
                            </a>
                        </li>
                        {% if app.user %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item-custom">
                                    <a href="{{ path('admin_player_index') }}">
                                        <i class="fas fa-user-check"></i> User Approvals
                                    </a>
                                </li>
                                <li class="nav-item-custom">
                                    <a href="{{ path('ai_pricing_index') }}">
                                        <i class="fas fa-brain"></i> AI Pricing
                                    </a>
                                </li>
                                <li class="nav-item-custom">
                                    <a href="{{ path('admin_dashboard') }}">
                                        <span class="admin-badge">
                                            <i class="fas fa-lock"></i> Admin
                                        </span>
                                    </a>
                                </li>
                            {% endif %}
                            <li class="nav-item-custom dropdown">
                                <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle"></i> 
                                    {{ app.user.nickname|default(app.user.email|slice(0, 20)) }}
                                </a>
                                <div class="dropdown-menu dropdown-menu-custom">
                                    <a class="dropdown-item" href="{{ path('player_dashboard') }}">
                                        <i class="fas fa-user-circle"></i> My Dashboard
                                    </a>
                                    <a class="dropdown-item" href="{{ path('player_tickets') }}">
                                        <i class="fas fa-ticket-alt"></i> My Tickets
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" href="{{ path('app_logout') }}">
                                        <i class="fas fa-sign-out-alt"></i> Logout
                                    </a>
                                </div>
                            </li>
                        {% else %}
                            <li class="nav-item-custom">
                                <a href="{{ path('app_login') }}" class="btn-nav-auth">
                                    <i class="fas fa-sign-in-alt"></i> Login
                                </a>
                            </li>
                            <li class="nav-item-custom">
                                <a href="{{ path('app_register') }}" class="btn-nav-signup">
                                    <i class="fas fa-user-plus"></i> Sign Up
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
        {% endif %}

        <!-- Flash Messages -->
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    {% if app.flashes %}
                        {% for type, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-custom alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                                    {{ message|raw }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endfor %}
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <main class="container-fluid py-4">
            {% block body %}{% endblock %}
        </main>

        <!-- Footer -->
        <footer class="footer mt-5">
            <div class="container">
                <div class="footer-content">
                    <div class="footer-brand">
                        <i class="fas fa-gamepad"></i>
                        <span>Dev Esports</span>
                    </div>
                    <p class="footer-text">&copy; 2026 Dev Esports. All rights reserved.</p>
                    <div class="footer-links">
                        <a href="{{ path('match_index') }}">Matches</a>
                        <a href="{{ path('tournament_index') }}">Tournaments</a>
                        <a href="{{ path('team_index') }}">Teams</a>
                    </div>
                </div>
            </div>
        </footer>

        <style>
            .footer {
                background: rgba(8, 11, 28, 0.95);
                border-top: 1px solid rgba(0, 242, 254, 0.08);
                padding: 2.5rem 0;
                margin-top: 4rem;
                position: relative;
                overflow: hidden;
            }
            .footer::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 1px;
                background: linear-gradient(90deg, transparent, rgba(0, 242, 254, 0.4), transparent);
            }
            .footer-content {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 1rem;
                text-align: center;
            }
            .footer-brand {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 1.2rem;
                font-weight: 700;
                background: linear-gradient(135deg, #00f2fe, #00ff9d);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }
            .footer-brand i {
                -webkit-text-fill-color: #00f2fe;
            }
            .footer-text {
                color: var(--text-muted);
                font-size: 0.85rem;
                margin: 0;
            }
            .footer-links {
                display: flex;
                gap: 2rem;
            }
            .footer-links a {
                color: var(--text-secondary);
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 500;
                transition: color 0.2s ease;
            }
            .footer-links a:hover {
                color: #00f2fe;
            }
        </style>

        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
