            <!-- Mercure Notification JS -->
                <script>
                // Notification Bell Dropdown Toggle
                const bell = document.getElementById('notificationBell');
                const dropdown = document.getElementById('notificationDropdown');
                bell.addEventListener('click', function(e) {
                    bell.classList.toggle('active');
                    e.stopPropagation();
                });
                document.addEventListener('click', function() {
                    bell.classList.remove('active');
                });

                // Mercure EventSource for live notifications only
                let notificationCount = 0;
                // Use the correct Mercure hub URL from backend config
                const mercureUrl = 'http://127.0.0.1:2019/.well-known/mercure';
                const url = new URL(mercureUrl);
                url.searchParams.append('topic', 'http://esports.com/reclamation/*');
                const es = new EventSource(url);
                es.onopen = function() {
                    console.log('Mercure connection established');
                };
                es.onerror = function(e) {
                    console.error('Mercure connection error:', e);
                };
                es.onmessage = function(event) {
                    try {
                        const data = JSON.parse(event.data);
                        notificationCount++;
                        document.getElementById('notificationCount').textContent = notificationCount;
                        const item = document.createElement('a');
                        item.className = 'dropdown-item';
                        item.href = `{{ path('app_reclamation_index') }}#reclamation-${data.reclamationId}`;
                        item.innerHTML = `${data.reclamationTitle} <span class="text-muted">(par ${data.adminName})</span>`;
                        dropdown.prepend(item);
                    } catch (e) {
                        console.error('Mercure notification parse error:', e);
                    }
                };
                </script>

        <!-- Global CSRF Token & State Change Script -->
        <form id="stateChangeForm" style="display: none;">
            <input type="hidden" name="_token" value="{{ csrf_token('change_state') }}">
        </form>

        <script>
        function changeReclamationState(reclamationId, newState) {
            // Find the button - could be stateDropdown (show) or stateDropdown-{id} (index)
            let btn = document.getElementById('stateDropdown') || document.getElementById('stateDropdown-' + reclamationId);
            if (!btn) return;
            
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Modification...';
            
            const formData = new FormData();
            formData.append('state', newState);
            formData.append('_token', document.querySelector('#stateChangeForm input[name="_token"]').value);
            
            fetch('/reclamation/' + reclamationId + '/change-state', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    // Replace dropdown with static badge
                    const badgeContainer = btn.parentElement;
                    const newBadge = document.createElement('span');
                    newBadge.className = 'badge ' + data.badge_class;
                    newBadge.textContent = (newState === 'RESOLU' ? 'RÉSOLU' : 'REJETÉ');
                    badgeContainer.replaceChild(newBadge, btn);

                    const cardElement = document.querySelector('#reclamation-' + reclamationId);
                    if (cardElement) {
                        const cardItem = cardElement.closest('.reclamation-item');
                        if (cardItem) {
                            cardItem.dataset.state = newState;
                        }
                    }

                    window.dispatchEvent(new CustomEvent('reclamation-state-updated', {
                        detail: {
                            id: reclamationId,
                            state: newState,
                        }
                    }));
                    
                    // Show success alert - find best location
                    const alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-success alert-dismissible fade show';
                    alertDiv.innerHTML = '<i class="fas fa-check-circle"></i> État modifié avec succès. <button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
                    
                    // Insert at top of container
                    const container = document.querySelector('.container-fluid') || document.querySelector('main') || document.body;
                    container.insertBefore(alertDiv, container.firstChild);
                } else {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    alert('Erreur: ' + (data.error || 'Impossible de modifier l\'état'));
                }
            })
            .catch(error => {
                btn.innerHTML = originalText;
                btn.disabled = false;
                alert('Erreur: ' + error.message);
            });
        }
        </script>
    </body>
