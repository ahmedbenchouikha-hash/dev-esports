<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Dev Esports{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        
        <!-- Font Awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        
        <!-- Chart.js -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        
        <!-- App CSS -->
        <link href="{{ asset('css/app.css') }}" rel="stylesheet">
        
        <style>
            :root {
                --primary: #00f2fe;
                --primary-dark: #0089b3;
                --secondary: #25d366;
                --danger: #ff4444;
                --warning: #ffb84d;
                --bg-dark: #0f172a;
                --bg-sidebar: #1a2847;
                --bg-navbar: #1e3a5f;
                --text-primary: #ffffff;
                --text-secondary: #94a3b8;
                --border: #334155;
                --shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: var(--bg-dark);
                color: var(--text-primary);
            }

            /* Navbar Styles */
            .navbar-custom {
                background: linear-gradient(135deg, var(--bg-navbar) 0%, #1a2a42 100%);
                border-bottom: 1px solid rgba(0, 242, 254, 0.1);
                box-shadow: var(--shadow);
                padding: 0.75rem 0;
                position: sticky;
                top: 0;
                z-index: 1020;
                backdrop-filter: blur(10px);
            }

            /* When sidebar is visible */
            body.has-sidebar .navbar-custom {
                margin-left: 260px;
                transition: margin 0.3s ease;
            }

            body.has-sidebar.sidebar-collapsed .navbar-custom {
                margin-left: 80px;
            }

            .navbar-brand-custom {
                font-size: 1.5rem;
                font-weight: 800;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                color: var(--primary);
                text-decoration: none;
                transition: all 0.3s ease;
            }

            .navbar-brand-custom:hover {
                transform: scale(1.05);
                text-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
            }

            .navbar-brand-custom i {
                font-size: 1.75rem;
            }

            .navbar-nav-custom {
                display: flex;
                gap: 2rem;
                align-items: center;
                list-style: none;
            }

            .nav-item-custom a {
                color: var(--text-secondary);
                text-decoration: none;
                font-weight: 500;
                padding: 0.5rem 1rem;
                border-radius: 6px;
                transition: all 0.3s ease;
                position: relative;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .nav-item-custom a:hover {
                color: var(--primary);
            }

            /* Auth Buttons */
            .btn-nav-auth {
                background: rgba(0, 242, 254, 0.1) !important;
                color: var(--primary) !important;
                border: 1px solid var(--primary) !important;
            }

            .btn-nav-auth:hover {
                background: rgba(0, 242, 254, 0.2) !important;
            }

            .btn-nav-signup {
                background: linear-gradient(135deg, #25d366, #00a853) !important;
                color: white !important;
            }

            .btn-nav-signup:hover {
                box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3) !important;
            }

            /* Dropdown Menu */
            .nav-item-custom.dropdown {
                position: relative;
            }

            .nav-item-custom .dropdown-toggle::after {
                display: inline-block;
                content: '';
                border: none;
                margin-left: 0.5rem;
            }

            .dropdown-menu-custom {
                background: rgba(26, 40, 71, 0.95) !important;
                border: 1px solid rgba(0, 242, 254, 0.2) !important;
                border-radius: 8px !important;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4) !important;
                backdrop-filter: blur(10px) !important;
                min-width: 200px !important;
            }

            .dropdown-menu-custom .dropdown-item {
                color: var(--text-secondary) !important;
                padding: 0.75rem 1rem !important;
                transition: all 0.3s ease !important;
                display: flex !important;
                align-items: center !important;
                gap: 0.5rem !important;
            }

            .dropdown-menu-custom .dropdown-item:hover {
                background: rgba(0, 242, 254, 0.1) !important;
                color: var(--primary) !important;
            }

            .dropdown-menu-custom .dropdown-divider {
                background-color: rgba(0, 242, 254, 0.1) !important;
                margin: 0.5rem 0 !important;
            }

            .nav-item-custom a::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 0;
                height: 2px;
                background: var(--primary);
                transition: width 0.3s ease;
            }

            .nav-item-custom a:hover {
                color: var(--primary);
                background: rgba(0, 242, 254, 0.1);
            }

            .nav-item-custom a:hover::after {
                width: 100%;
            }

            .nav-item-custom a i {
                font-size: 1.1rem;
            }

            /* Admin Badge */
            .admin-badge {
                background: linear-gradient(135deg, var(--primary), #00a8cc);
                color: var(--bg-dark);
                padding: 0.4rem 0.8rem;
                border-radius: 12px;
                font-weight: 600;
                font-size: 0.85rem;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

            .admin-badge i {
                font-size: 0.95rem;
            }

            /* Sidebar Styles */
            .sidebar-nav {
                position: fixed;
                left: 0;
                top: 0;
                width: 260px;
                height: 100vh;
                background: linear-gradient(180deg, var(--bg-sidebar) 0%, #1a2847 100%);
                border-right: 1px solid var(--border);
                z-index: 1030;
                display: flex;
                flex-direction: column;
                overflow-y: auto;
                padding-top: 0;
                transition: all 0.3s ease;
                margin-top: 0;
            }

            .sidebar-nav.collapsed {
                width: 80px;
            }

            body.admin-layout {
                margin-left: 260px;
                margin-top: 0;
            }

            body.admin-layout.sidebar-hidden {
                margin-left: 0;
            }

            body.admin-layout main {
            .sidebar-brand {
                padding: 2rem 1.5rem;
                border-bottom: 1px solid rgba(0, 242, 254, 0.1);
                flex-shrink: 0;
            }

            .brand-link {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                text-decoration: none;
                font-weight: 800;
                font-size: 1.2rem;
                color: var(--primary);
                transition: all 0.3s ease;
            }

            .brand-link:hover {
                transform: scale(1.05);
                text-shadow: 0 0 10px rgba(0, 242, 254, 0.4);
            }

            .brand-icon {
                font-size: 1.75rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .sidebar-menu {
                flex: 1;
                padding: 1rem 0;
                overflow-y: auto;
            }

            .sidebar-menu::-webkit-scrollbar {
                width: 6px;
            }

            .sidebar-menu::-webkit-scrollbar-track {
                background: transparent;
            }

            .sidebar-menu::-webkit-scrollbar-thumb {
                background: rgba(0, 242, 254, 0.2);
                border-radius: 3px;
            }

            .menu-section-title {
                padding: 1rem 1.5rem 0.5rem;
                font-size: 0.7rem;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                color: var(--text-secondary);
                font-weight: 700;
                margin-top: 0.5rem;
                transition: all 0.3s ease;
            }

            .sidebar-nav.collapsed .menu-section-title {
                display: none;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 1rem;
                padding: 0.875rem 1.5rem;
                color: var(--text-secondary);
                text-decoration: none;
                transition: all 0.3s ease;
                border-left: 3px solid transparent;
                margin: 0.25rem 0.5rem;
                border-radius: 0 8px 8px 0;
                font-weight: 500;
                cursor: pointer;
                position: relative;
            }

            .sidebar-nav.collapsed .menu-item {
                padding: 0.875rem 0.75rem;
                justify-content: center;
                gap: 0;
            }

            .sidebar-nav.collapsed .menu-item .menu-label,
            .sidebar-nav.collapsed .menu-item .menu-arrow {
                display: none;
            }

            .menu-item:hover {
                color: var(--primary);
                background: rgba(0, 242, 254, 0.08);
                border-left-color: var(--primary);
                transform: translateX(4px);
            }

            .sidebar-nav.collapsed .menu-item:hover {
                transform: translateX(0);
            }

            .menu-item.active {
                color: var(--primary);
                background: rgba(0, 242, 254, 0.12);
                border-left-color: var(--primary);
                font-weight: 600;
                box-shadow: inset 0 0 10px rgba(0, 242, 254, 0.1);
            }

            .menu-icon {
                min-width: 1.5rem;
                font-size: 1.1rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .menu-label {
                flex: 1;
                font-size: 0.95rem;
            }

            .menu-arrow {
                font-size: 0.75rem;
                transition: transform 0.3s ease;
                color: var(--text-secondary);
            }

            .menu-toggle[aria-expanded="true"] .menu-arrow {
                transform: rotate(180deg);
            }

            .menu-group {
                margin: 0;
            }

            .menu-subitem {
                display: flex;
                align-items: center;
                padding: 0.7rem 1.5rem 0.7rem 3.75rem;
                color: var(--text-secondary);
                text-decoration: none;
                transition: all 0.3s ease;
                font-size: 0.9rem;
                font-weight: 500;
                border-left: 3px solid transparent;
                position: relative;
            }

            .sidebar-nav.collapsed .menu-subitem {
                display: none;
            }

            .menu-subitem::before {
                content: '';
                position: absolute;
                left: 1.75rem;
                width: 4px;
                height: 4px;
                background: rgba(0, 242, 254, 0.4);
                border-radius: 50%;
                transition: all 0.3s ease;
            }

            .menu-subitem:hover {
                color: var(--primary);
                background: rgba(0, 242, 254, 0.05);
                border-left-color: var(--primary);
                transform: translateX(4px);
            }

            .menu-subitem:hover::before {
                background: var(--primary);
                transform: scale(1.5);
            }

            .menu-subitem.active {
                color: var(--secondary);
                background: rgba(37, 211, 102, 0.08);
                border-left-color: var(--secondary);
                font-weight: 600;
            }

            .menu-subitem.active::before {
                background: var(--secondary);
            }

            /* Divider */
            .menu-divider {
                height: 1px;
                background: rgba(0, 242, 254, 0.1);
                margin: 1rem 0;
            }

            /* Sidebar Footer */
            .sidebar-footer {
                padding: 1.5rem;
                border-top: 1px solid rgba(0, 242, 254, 0.1);
                flex-shrink: 0;
            }

            .footer-item {
                text-align: center;
            }

            .version-text {
                font-size: 0.75rem;
                color: var(--text-secondary);
                margin: 0;
                font-weight: 600;
            }

            .copyright-text {
                font-size: 0.7rem;
                color: var(--text-secondary);
                margin: 0.25rem 0 0;
            }

            /* Sidebar Toggle */
            .sidebar-toggle {
                position: fixed;
                top: 1rem;
                left: 1rem;
                width: 2.5rem;
                height: 2.5rem;
                background: linear-gradient(135deg, var(--primary), #00a8cc);
                border: none;
                border-radius: 8px;
                color: var(--bg-dark);
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.3s ease;
                font-size: 1.25rem;
                font-weight: bold;
                z-index: 1045;
                box-shadow: var(--shadow);
            }

            .sidebar-toggle:hover {
                transform: scale(1.1);
                box-shadow: 0 6px 20px rgba(0, 242, 254, 0.4);
            }

            .sidebar-toggle:active {
                transform: scale(0.95);
            }

            .sidebar-toggle i {
                transition: transform 0.3s ease;
            }

            body.admin-layout.sidebar-collapsed .sidebar-toggle i {
                transform: rotate(180deg);
            }

            /* Mobile Responsiveness */
            @media (max-width: 768px) {
                .sidebar-nav {
                    width: 100%;
                    height: 100vh;
                    transform: translateX(-100%);
                    box-shadow: var(--shadow);
                }

                .sidebar-nav.show {
                    transform: translateX(0);
                }

                body.admin-layout {
                    margin-left: 0;
                }

                body.admin-layout main {
                    width: 100%;
                }

                .sidebar-toggle {
                    position: fixed;
                    top: 1rem;
                    left: 1rem;
                }

                .navbar-custom {
                    padding: 0.75rem 3.5rem 0.75rem 0.75rem;
                }

                .navbar-nav-custom {
                    gap: 1rem;
                }
            }

            /* Navbar Custom Container */
            .navbar-container-custom {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 1.5rem;
            }

            .navbar-content {
                display: flex;
                justify-content: flex-end;
                align-items: center;
                width: 100%;
            }

            /* Flash Messages */
            .alert-custom {
                border-radius: 8px;
                border: none;
                padding: 1rem 1.5rem;
                margin-bottom: 1rem;
                backdrop-filter: blur(10px);
                animation: slideIn 0.3s ease;
                margin-top: 1rem;
            }

            .alert-custom.alert-success {
                background-color: rgba(37, 211, 102, 0.1);
                color: #25d366;
                border-left: 4px solid #25d366;
            }

            .alert-custom.alert-danger {
                background-color: rgba(255, 68, 68, 0.1);
                color: #ff4444;
                border-left: 4px solid #ff4444;
            }

            .alert-custom.alert-warning {
                background-color: rgba(255, 149, 0, 0.1);
                color: #ff9500;
                border-left: 4px solid #ff9500;
            }

            .alert-custom.alert-info {
                background-color: rgba(13, 217, 255, 0.1);
                color: #0dd9ff;
                border-left: 4px solid #0dd9ff;
            }

            @keyframes slideIn {
                from {
                    opacity: 0;
                    transform: translateY(-10px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .footer {
                background: rgba(26, 40, 71, 0.8);
                backdrop-filter: blur(10px);
                border-top: 1px solid rgba(0, 242, 254, 0.1);
                padding: 2rem 0;
                margin-top: 3rem;
            }

            .footer p {
                margin-bottom: 0.5rem;
                color: var(--text-secondary);
            }

            .footer .text-muted {
                color: var(--text-secondary) !important;
                font-size: 0.9rem;
            }
        </style>
        
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    </head>
    {% set is_admin = 'admin' in app.request.attributes.get('_route', '') %}
    {% set is_logged_in_player = app.user and is_granted('ROLE_USER') %}
    <body{% if is_admin %} class="admin-layout"{% endif %}>
        
        {% if is_admin %}
            {% include 'partials/sidebar.html.twig' %}
        {% elseif is_logged_in_player %}
            {% include 'partials/player_sidebar.html.twig' %}
        {% endif %}
        
        <script>
            // Mark body as having sidebar
            if (document.querySelector('.sidebar-nav')) {
                document.body.classList.add('has-sidebar');
            }

            // Sidebar Toggle Functionality
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarNav = document.querySelector('.sidebar-nav');
            const body = document.body;

            if (sidebarToggle && sidebarNav) {
                // Check localStorage for saved state
                const sidebarCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
                if (sidebarCollapsed) {
                    sidebarNav.classList.add('collapsed');
                    body.classList.add('sidebar-collapsed');
                }

                // Toggle sidebar on button click
                sidebarToggle.addEventListener('click', () => {
                    sidebarNav.classList.toggle('collapsed');
                    body.classList.toggle('sidebar-collapsed');
                    
                    // Save state to localStorage
                    const isCollapsed = sidebarNav.classList.contains('collapsed');
                    localStorage.setItem('sidebarCollapsed', isCollapsed);
                });

                // Add tooltip on hover for collapsed sidebar
                const menuItems = document.querySelectorAll('.menu-item');
                menuItems.forEach(item => {
                    item.addEventListener('mouseenter', function() {
                        if (sidebarNav.classList.contains('collapsed')) {
                            const label = this.querySelector('.menu-label');
                            if (label) {
                                this.setAttribute('title', label.textContent);
                            }
                        }
                    });
                });
            }
        </script>
        
    <body>
        {% set is_admin = 'admin' in app.request.attributes.get('_route', '') %}
        
        {% if is_admin %}
            {% include 'partials/sidebar.html.twig' %}
            <script>
                // Add admin layout class
                document.body.classList.add('admin-layout');
            </script>
        {% endif %}
        
        <!-- Navigation Bar - Hide on auth pages -->
        {% if app.request.attributes.get('_route') not in ['app_login', 'app_register', 'app_forgot_password', 'app_reset_password'] %}
        <nav class="navbar-custom">
            <div class="navbar-container-custom">
                <div style="display: flex; align-items: center; gap: 2rem;">
                    <a class="navbar-brand-custom" href="/">
                    <a class="navbar-brand-custom" href="{{ path('tournament_index') }}">
                        <i class="fas fa-gamepad"></i>
                        <span>Dev Esports</span>
                    </a>
                </div>
                
                <div class="navbar-content">
                    <ul class="navbar-nav-custom">
                        <li class="nav-item-custom">
                            <a href="{{ path('match_index') }}">
                                <i class="fas fa-trophy"></i> Matches
                            </a>
                        </li>
                        <li class="nav-item-custom">
                            <a href="{{ path('tournament_index') }}">
                                <i class="fas fa-crown"></i> Tournaments
                            </a>
                        </li>
                        <li class="nav-item-custom">
                            <a href="{{ path('team_index') }}">
                                <i class="fas fa-users"></i> Teams
                            </a>
                        </li>
                        {% if app.user %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item-custom">
                                    <a href="{{ path('admin_player_index') }}">
                                        <i class="fas fa-user-check"></i> User Approvals
                                    </a>
                                </li>
                                <li class="nav-item-custom">
                                    <a href="{{ path('admin_dashboard') }}">
                                        <span class="admin-badge">
                                            <i class="fas fa-lock"></i> Admin
                                        </span>
                                    </a>
                                </li>
                            {% endif %}
                            <li class="nav-item-custom dropdown">
                                <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle"></i> 
                                    {{ app.user.nickname|default(app.user.email|slice(0, 20)) }}
                                    <a href="{{ path('admin_tournament_registration_list') }}">
                                        <i class="fas fa-clipboard-list"></i> Registrations
                                    </a>
                                </li>
                            {% endif %}

                            <!-- Notifications Dropdown -->
                            <li class="nav-item-custom dropdown">
                                <a href="#" class="dropdown-toggle position-relative" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-bell"></i>
                                    <span class="notification-badge" id="notificationBadge" style="display: none;">0</span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationDropdown">
                                    <div class="dropdown-header d-flex justify-content-between align-items-center" style="padding: 0.75rem 1rem;">
                                        <span class="fw-bold">Notifications</span>
                                        <a href="{{ path('app_notifications') }}" class="mark-all-read">View All</a>
                                    </div>
                                    <div class="dropdown-divider"></div>
                                    <div id="notificationList" style="max-height: 300px; overflow-y: auto;">
                                        <div class="text-center p-3 text-muted">
                                            <i class="fas fa-spinner fa-spin"></i> Loading...
                                        </div>
                                    </div>
                                    <div class="dropdown-divider"></div>
                                    <div class="dropdown-item text-center">
                                        <button class="btn btn-sm btn-link mark-all-read" id="markAllReadBtn">
                                            <i class="fas fa-check-double"></i> Mark all as read
                                        </button>
                                    </div>
                                </div>
                            </li>

                            <li class="nav-item-custom dropdown">
                                <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle"></i> 
                                    {{ app.user.email|slice(0, 20) }}
                                </a>
                                <div class="dropdown-menu dropdown-menu-custom">
                                    <a class="dropdown-item" href="{{ path('player_dashboard') }}">
                                        <i class="fas fa-user-circle"></i> My Dashboard
                                    </a>
                                    <a class="dropdown-item" href="{{ path('tournament_my_registrations') }}">
                                        <i class="fas fa-list"></i> My Registrations
                                    </a>
                                    <a class="dropdown-item" href="{{ path('app_notifications') }}">
                                        <i class="fas fa-bell"></i> Notifications
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" href="{{ path('app_logout') }}">
                                        <i class="fas fa-sign-out-alt"></i> Logout
                                    </a>
                                </div>
                            </li>
                        {% else %}
                            <li class="nav-item-custom">
                                <a href="{{ path('app_login') }}" class="btn-nav-auth">
                                    <i class="fas fa-sign-in-alt"></i> Login
                                </a>
                            </li>
                            <li class="nav-item-custom">
                                <a href="{{ path('app_register') }}" class="btn-nav-signup">
                                    <i class="fas fa-user-plus"></i> Sign Up
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
        {% endif %}

        <!-- Flash Messages -->
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    {% if app.flashes %}
                        {% for type, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-custom alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                                    {{ message|raw }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endfor %}
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <main class="container-fluid py-4">
            {% block body %}{% endblock %}
        </main>

        <!-- Footer -->
        <footer class="footer mt-5">
            <div class="container">
                <p>&copy; 2026 Dev Esports. All rights reserved.</p>
                <p class="text-muted">PIDEV Project - Esports Management System</p>
            </div>
        </footer>

        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        
        <!-- Notification Scripts -->
        <script>
        document.addEventListener('DOMContentLoaded', function() {
            {% if app.user %}
                loadNotifications();
                
                // Load notifications every 30 seconds
                setInterval(loadNotifications, 30000);
                
                // Mark all as read button
                document.getElementById('markAllReadBtn')?.addEventListener('click', function(e) {
                    e.preventDefault();
                    markAllNotificationsRead();
                });
            {% endif %}
            
            function loadNotifications() {
                // Update unread count
                fetch('/notifications/unread-count')
                    .then(response => response.json())
                    .then(data => {
                        const badge = document.getElementById('notificationBadge');
                        if (badge) {
                            if (data.count > 0) {
                                badge.textContent = data.count;
                                badge.style.display = 'inline';
                            } else {
                                badge.style.display = 'none';
                            }
                        }
                    });
                
                // Load recent notifications for dropdown
                fetch('/notifications/recent')
                    .then(response => response.json())
                    .then(data => {
                        const notificationList = document.getElementById('notificationList');
                        if (notificationList) {
                            if (data.notifications && data.notifications.length > 0) {
                                let html = '';
                                data.notifications.forEach(notification => {
                                    const unreadClass = !notification.isRead ? 'unread' : '';
                                    const iconClass = notification.icon || 'fas fa-bell';
                                    html += `
                                        <a href="${notification.link || '#'}" class="notification-item ${unreadClass}">
                                            <div class="d-flex gap-3">
                                                <div class="notification-icon">
                                                    <i class="${iconClass}"></i>
                                                </div>
                                                <div class="notification-content">
                                                    <div>${notification.message}</div>
                                                    <small class="notification-time">${notification.time}</small>
                                                </div>
                                            </div>
                                        </a>
                                    `;
                                });
                                notificationList.innerHTML = html;
                            } else {
                                notificationList.innerHTML = `
                                    <div class="text-center p-4 text-muted">
                                        <i class="fas fa-bell-slash fa-2x mb-2"></i>
                                        <p>No notifications</p>
                                    </div>
                                `;
                            }
                        }
                    });
            }
            
            function markAllNotificationsRead() {
                fetch('/notifications/mark-all-read', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Update badge
                        const badge = document.getElementById('notificationBadge');
                        if (badge) {
                            badge.style.display = 'none';
                        }
                        
                        // Reload notifications
                        loadNotifications();
                        
                        // Show success message
                        const alert = document.createElement('div');
                        alert.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3';
                        alert.style.zIndex = '9999';
                        alert.innerHTML = `
                            All notifications marked as read!
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        `;
                        document.body.appendChild(alert);
                        
                        setTimeout(() => {
                            alert.remove();
                        }, 3000);
                    }
                });
            }
        });
        </script>
    </body>
</html>
