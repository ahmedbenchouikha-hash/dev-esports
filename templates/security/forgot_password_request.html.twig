{% extends "base.html.twig" %}

{% block title %}Forgot Password - RankUp{% endblock %}

{% block body %}
<div class="login-container">
    <div class="login-wrapper">
        <!-- Forgot Password Card -->
        <div class="login-card">
            <!-- Header -->
            <div class="login-header">
                <div class="login-logo">
                    <i class="fas fa-key"></i>
                </div>
                <h1>Reset Password</h1>
                <p class="login-subtitle">Enter your email to receive a reset link</p>
            </div>

            <!-- Error Messages -->
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}

            <!-- Success Messages -->
            {% for message in app.flashes('success') %}
                <div class="alert alert-success" role="alert">
                    <i class="fas fa-check-circle"></i>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}

            <!-- Forgot Password Form -->
            <form method="post">
                <!-- Email Field -->
                <div class="form-group">
                    <label for="email" class="form-label">
                        <i class="fas fa-envelope"></i>
                        Email Address
                    </label>
                    {{ form_widget(requestForm.email, {
                        'attr': {
                            'class': 'form-control form-control-lg',
                            'placeholder': 'you@example.com',
                            'autofocus': true
                        }
                    }) }}
                    {% if form_errors(requestForm.email) %}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(requestForm.email) }}
                        </div>
                    {% endif %}
                </div>

                <!-- reCAPTCHA (if configured) -->
                {% if form_errors(requestForm._token) %}
                    <div class="alert alert-warning">
                        {{ form_errors(requestForm._token) }}
                    </div>
                {% endif %}

                <!-- Submit Button -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-paper-plane"></i>
                        Send Reset Link
                    </button>
                </div>

                <!-- Hidden CSRF Token -->
                {{ form_rest(requestForm) }}
            </form>

            <!-- Back to Login Link -->
            <div class="text-center mt-4">
                <p class="small">
                    Remember your password? 
                    <a href="{{ path('app_login') }}" class="text-decoration-none">
                        Back to Login
                    </a>
                </p>
            </div>

            <!-- Register Link -->
            <div class="text-center">
                <p class="small">
                    Don't have an account? 
                    <a href="{{ path('app_register') }}" class="text-decoration-none">
                        Register here
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
    }

    .login-wrapper {
        width: 100%;
        max-width: 450px;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-logo {
        font-size: 48px;
        color: #667eea;
        margin-bottom: 15px;
    }

    .login-header h1 {
        font-size: 28px;
        font-weight: 700;
        color: #333;
        margin: 0;
    }

    .login-subtitle {
        color: #666;
        font-size: 14px;
        margin: 8px 0 0 0;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #333;
        font-weight: 600;
        font-size: 14px;
    }

    .form-control {
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 14px;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        outline: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    }

    .alert {
        border-radius: 8px;
        border: none;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
    }

    .text-center {
        text-align: center;
    }

    .text-center a {
        color: #667eea;
        font-weight: 600;
        transition: color 0.3s ease;
    }

    .text-center a:hover {
        color: #764ba2;
    }

    .small {
        font-size: 13px;
        color: #666;
    }

    .invalid-feedback {
        color: #dc3545;
        font-size: 13px;
        margin-top: 5px;
    }
</style>
{% endblock %}
