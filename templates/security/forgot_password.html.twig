{% block body %}
<div class="forgot-password-container">
    <div class="forgot-password-wrapper">
        <!-- Forgot Password Card -->
        <div class="forgot-password-card">
            <!-- Header -->
            <div class="forgot-password-header">
                <div class="forgot-password-logo">
                    <i class="fas fa-key"></i>
                </div>
                <h1>Reset Password</h1>
                <p class="forgot-password-subtitle">Enter your email to reset your password</p>
            </div>

            <!-- Forgot Password Form -->
            <form method="post" novalidate>
                <!-- Email Field -->
                <div class="form-group">
                    <label for="email" class="form-label">
                        <i class="fas fa-envelope"></i>
                        Email Address
                    </label>
                    <input type="email" 
                           id="email" 
                           name="email" 
                           class="form-control"
                           placeholder="your@example.com"
                           required
                           autofocus>
                </div>

                <!-- CSRF Token -->
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

                <!-- Submit Button -->
                <button class="btn btn-forgot btn-primary" type="submit">
                    <i class="fas fa-paper-plane"></i>
                    Send Reset Link
                </button>
            </form>

            <!-- Back to Login Link -->
            <div class="forgot-password-footer">
                <p>Remember your password? 
                    <a href="{{ path('app_login') }}" class="link-inline">Back to login</a>
                </p>
            </div>
        </div>

        <!-- Decorative Elements -->
        <div class="decorative-elements">
            <div class="element element-1"></div>
            <div class="element element-2"></div>
            <div class="element element-3"></div>
        </div>
    </div>
</div>

<style>
    .forgot-password-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0f172a 0%, #1a2847 50%, #1e3a5f 100%);
        position: relative;
        overflow: hidden;
        padding: 2rem;
    }

    .forgot-password-wrapper {
        position: relative;
        width: 100%;
        max-width: 420px;
        z-index: 1;
    }

    /* Forgot Password Card */
    .forgot-password-card {
        background: rgba(26, 40, 71, 0.85);
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 16px;
        padding: 2.5rem;
        backdrop-filter: blur(10px);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    }

    /* Header */
    .forgot-password-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .forgot-password-logo {
        width: 80px;
        height: 80px;
        margin: 0 auto 1rem;
        background: linear-gradient(135deg, #00f2fe, #25d366);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: var(--bg-dark);
        box-shadow: 0 10px 30px rgba(0, 242, 254, 0.3);
    }

    .forgot-password-header h1 {
        font-size: 2rem;
        margin: 1rem 0 0.5rem;
        color: var(--text-primary);
        font-weight: 800;
        background: linear-gradient(135deg, #00f2fe, #25d366);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .forgot-password-subtitle {
        color: var(--text-secondary);
        margin: 0;
        font-size: 1rem;
    }

    /* Form Groups */
    .form-group {
        margin-bottom: 1.5rem;
        pointer-events: auto;
    }

    .form-label {
        display: block;
        margin-bottom: 0.75rem;
        color: var(--text-primary);
        font-weight: 600;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-label i {
        color: var(--primary);
        font-size: 1rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        background: rgba(0, 242, 254, 0.05);
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 8px;
        color: var(--text-primary);
        font-size: 1rem;
        transition: all 0.3s ease;
        cursor: text;
    }

    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }

    .form-control:focus {
        outline: none;
        background: rgba(0, 242, 254, 0.1);
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(0, 242, 254, 0.1);
    }

    /* Button */
    .btn-forgot {
        width: 100%;
        padding: 1rem;
        font-size: 1rem;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, #00f2fe, #00a8cc);
        color: var(--bg-dark);
        box-shadow: 0 4px 15px rgba(0, 242, 254, 0.2);
    }

    .btn-primary:hover {
        box-shadow: 0 8px 25px rgba(0, 242, 254, 0.4);
        transform: translateY(-2px);
    }

    .btn-primary:active {
        transform: translateY(0);
        box-shadow: 0 4px 15px rgba(0, 242, 254, 0.2);
    }

    /* Footer */
    .forgot-password-footer {
        text-align: center;
        margin-top: 2rem;
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    .forgot-password-footer p {
        margin: 0;
    }

    .link-inline {
        color: var(--primary);
        text-decoration: none;
        font-weight: 700;
        transition: all 0.3s ease;
    }

    .link-inline:hover {
        color: #25d366;
        text-decoration: underline;
    }

    /* Decorative Elements */
    .decorative-elements {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        overflow: hidden;
        z-index: 0;
        pointer-events: none;
    }

    .element {
        position: absolute;
        border-radius: 50%;
        opacity: 0.05;
    }

    .element-1 {
        width: 300px;
        height: 300px;
        top: -100px;
        left: -100px;
        background: linear-gradient(135deg, #00f2fe, #25d366);
    }

    .element-2 {
        width: 200px;
        height: 200px;
        bottom: -50px;
        right: -50px;
        background: linear-gradient(135deg, #00f2fe, #25d366);
    }

    .element-3 {
        width: 150px;
        height: 150px;
        top: 50%;
        right: -75px;
        background: linear-gradient(135deg, #25d366, #00a853);
    }

    /* Responsive */
    @media (max-width: 480px) {
        .forgot-password-card {
            padding: 2rem;
        }

        .forgot-password-header h1 {
            font-size: 1.5rem;
        }

        .forgot-password-logo {
            width: 60px;
            height: 60px;
            font-size: 2rem;
        }

        .form-control {
            font-size: 16px;
        }

        .btn-forgot {
            padding: 0.875rem;
            font-size: 0.95rem;
        }

        .forgot-password-footer {
            font-size: 0.85rem;
        }
    }
</style>
{% endblock %}
