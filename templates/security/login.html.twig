{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
    {% include '_sidebar.html.twig' %}

    <div class="content-with-sidebar">
        <div class="auth-container">
            <h1>Sign In</h1>

            {% if error %}
                <div class="form-error"><span class="icon">!</span>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {{ form_start(loginForm, { 'action': path('app_login'), 'attr': {'novalidate': 'novalidate'} }) }}

            <div class="form-group">
                {{ form_label(loginForm.email) }}
                {{ form_widget(loginForm.email, {'attr': {'class': 'input' ~ ((loginForm.vars.submitted and loginForm.email.vars.errors) ? ' invalid' : '')}}) }}
                {% if loginForm.vars.submitted and loginForm.email.vars.errors %}
                    <div class="form-error"><span class="icon">!</span>{{ loginForm.email.vars.errors|first }}</div>
                {% endif %}
            </div>

            <div class="form-group">
                {{ form_label(loginForm.password) }}
                {{ form_widget(loginForm.password, {'attr': {'class': 'input' ~ ((loginForm.vars.submitted and loginForm.password.vars.errors) ? ' invalid' : '')}}) }}
                {% if loginForm.vars.submitted and loginForm.password.vars.errors %}
                    <div class="form-error"><span class="icon">!</span>{{ loginForm.password.vars.errors|first }}</div>
                {% endif %}
            </div>

            <div class="form-group">
                <div class="g-recaptcha" data-sitekey="%RECAPTCHA_SITE_KEY%"></div>
            </div>

            {{ form_row(loginForm._csrf_token) }}

            <button class="submit" type="submit">Sign in</button>

            <p class="muted"><a href="{{ path('app_forgot_password_request') }}">Forgot your password?</a></p>

            {{ form_end(loginForm) }}
        </div>
    </div>
{% endblock %}
