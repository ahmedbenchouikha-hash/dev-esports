{% extends "auth_base.html.twig" %}

{% block title %}Login - RankUp{% endblock %}

{% block body %}
<div class="auth-card">
    <!-- Login Header -->
    <div class="text-center mb-4">
        <div style="font-size: 3rem; margin-bottom: 1rem;">
            <i class="fas fa-crown" style="color: #00d9ff;"></i>
        </div>
        <h1 style="font-size: 2rem; font-weight: 700; background: linear-gradient(135deg, #00f2fe, #25d366); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin: 0;">
            RankUp
        </h1>
        <p style="color: rgba(176, 184, 204, 0.8); margin-top: 0.5rem;">Welcome Back</p>
    </div>

    <!-- Error Messages -->
    {% if error %}
        <div class="alert alert-danger mb-3" role="alert" style="background-color: rgba(255, 56, 96, 0.15); border-color: rgba(255, 56, 96, 0.3); padding: 1rem; border-radius: 8px; border: 1px solid;">
            <i class="fas fa-exclamation-circle"></i>
            <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
        </div>
    {% endif %}

    <!-- Login Form -->
    <form method="post" style="margin-top: 2rem;">
        <!-- Email Field -->
        <div class="mb-3">
            <label for="inputEmail" class="form-label" style="font-weight: 500; color: rgba(255, 255, 255, 0.9); margin-bottom: 0.5rem;">Email Address</label>
            <input 
                type="email" 
                value="{{ last_username }}" 
                name="email" 
                id="inputEmail" 
                class="form-control" 
                autocomplete="email" 
                required
                autofocus
                placeholder="your@email.com"
                style="background-color: rgba(20, 24, 41, 0.8); border-color: rgba(0, 242, 254, 0.2); color: white; padding: 0.625rem 0.75rem; font-size: 0.95rem; border: 1px solid; border-radius: 6px; width: 100%;"
            >
        </div>

        <!-- Password Field -->
        <div class="mb-3">
            <label for="inputPassword" class="form-label" style="font-weight: 500; color: rgba(255, 255, 255, 0.9); margin-bottom: 0.5rem;">Password</label>
            <input 
                type="password" 
                name="password" 
                id="inputPassword" 
                class="form-control" 
                autocomplete="current-password" 
                required
                placeholder="••••••••"
                style="background-color: rgba(20, 24, 41, 0.8); border-color: rgba(0, 242, 254, 0.2); color: white; padding: 0.625rem 0.75rem; font-size: 0.95rem; border: 1px solid; border-radius: 6px; width: 100%;"
            >
        </div>

        <!-- CSRF Token (hidden) -->
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <!-- Login Button -->
        <button 
            type="submit" 
            class="btn w-100 mb-3"
            style="background: linear-gradient(135deg, #00f2fe, #25d366); color: #0a0e27; font-weight: 600; padding: 0.75rem; border: none; border-radius: 8px; transition: all 0.3s ease; cursor: pointer; margin-top: 1.5rem;"
            onmouseover="this.style.boxShadow='0 0 20px rgba(0, 242, 254, 0.4)'"
            onmouseout="this.style.boxShadow='none'"
        >
            <i class="fas fa-sign-in-alt"></i> Sign In
        </button>

        <!-- Forgot Password Link -->
        <div class="text-center" style="margin-top: 1rem;">
            <a href="{{ path('app_forgot_password_request') }}" style="color: #00d9ff; text-decoration: none; font-size: 0.9rem;">
                Forgot your password?
            </a>
        </div>
    </form>

    <!-- Sign Up Link -->
    <div class="text-center mt-4" style="padding-top: 1.5rem; border-top: 1px solid rgba(0, 242, 254, 0.1); margin-top: 2rem;">
        <p style="color: rgba(176, 184, 204, 0.8); margin-bottom: 0.5rem;">Don't have an account?</p>
        <a href="{{ path('app_register') }}" style="background: rgba(0, 242, 254, 0.1); color: #00d9ff; text-decoration: none; padding: 0.5rem 1rem; border-radius: 6px; display: inline-block; border: 1px solid rgba(0, 242, 254, 0.3); transition: all 0.3s ease;" 
            onmouseover="this.style.backgroundColor='rgba(0, 242, 254, 0.2)'"
            onmouseout="this.style.backgroundColor='rgba(0, 242, 254, 0.1)'"
        >
            Create Account
        </a>
    </div>
</div>

<style>
    .auth-card {
        background: linear-gradient(135deg, rgba(20, 24, 41, 0.95) 0%, rgba(26, 40, 71, 0.95) 100%);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 20px;
        padding: 3rem;
        max-width: 450px;
        width: 100%;
        box-shadow: 0 8px 32px rgba(0, 242, 254, 0.1), 0 0 60px rgba(37, 211, 102, 0.05);
    }

    .form-control {
        transition: all 0.3s ease;
    }

    .form-control:focus {
        background-color: rgba(26, 40, 71, 0.8) !important;
        border-color: rgba(0, 242, 254, 0.5) !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 242, 254, 0.25) !important;
        color: white;
        outline: none;
    }

    .alert {
        color: #ff9999;
    }

    .alert i {
        margin-right: 0.5rem;
    }

    @media (max-width: 576px) {
        .auth-card {
            padding: 2rem;
            margin: 1rem;
        }
    }
</style>
{% endblock %}
