{% extends "base.html.twig" %}

{% block title %}Login - RankUp{% endblock %}

{% block body %}
<div class="login-container">
    <div class="login-wrapper">
        <!-- Login Card -->
        <div class="login-card">
            <!-- Header -->
            <div class="login-header">
                <div class="login-logo">
                    <i class="fas fa-crown"></i>
                </div>
                <h1>RankUp</h1>
                <h1>Dev Esports</h1>
                <p class="login-subtitle">Welcome Back</p>
            </div>

            <!-- Error Messages -->
            {% if error %}
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            <!-- Login Form -->
            <form method="post">
                <!-- Email Field -->
                <div class="form-group">
                    <label for="inputEmail" class="form-label">
                        <i class="fas fa-envelope"></i>
                        Email Address
                    </label>
                    <input type="email" 
                           value="{{ last_email }}" 
                           name="email" 
                           id="inputEmail" 
                           class="form-control form-control-lg"
                           placeholder="you@example.com"
                           required 
                           autofocus>
                </div>

                <!-- Password Field -->
                <div class="form-group">
                    <label for="inputPassword" class="form-label">
                        <i class="fas fa-lock"></i>
                        Password
                    </label>
                    <input type="password" 
                           name="password" 
                           id="inputPassword" 
                           class="form-control form-control-lg"
                           placeholder="Enter your password"
                           required>
                </div>

                <!-- Remember Me -->
                <div class="form-check">
                    <input type="checkbox" 
                           name="_remember_me" 
                           id="inputRememberMe" 
                           class="form-check-input">
                    <label class="form-check-label" for="inputRememberMe">
                        Remember me for 30 days
                    </label>
                </div>

                <!-- CSRF Token -->
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <!-- Submit Button -->
                <button class="btn btn-login btn-primary" type="submit">
                    <i class="fas fa-sign-in-alt"></i>
                    Sign In
                </button>
            </form>

            <!-- Divider -->
            <div class="divider">
                <span>OR</span>
            </div>

            <!-- Links -->
            <div class="login-links">
                <a href="{{ path('app_forgot_password_request') }}" class="link-secondary">
                    <i class="fas fa-redo"></i>
                    Forgot your password?
                </a>
                <a href="{{ path('app_register') }}" class="link-primary">
                    <i class="fas fa-user-plus"></i>
                    Create an account
                </a>
            </div>
        </div>

        <!-- Decorative Elements -->
        <div class="decorative-elements">
            <div class="element element-1"></div>
            <div class="element element-2"></div>
            <div class="element element-3"></div>
        </div>
    </div>
</div>

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0f172a 0%, #1a2847 50%, #1e3a5f 100%);
        position: relative;
        overflow: hidden;
        padding: 2rem;
    }

    .login-wrapper {
        position: relative;
        width: 100%;
        max-width: 420px;
        z-index: 10;
    }

    /* Login Card */
    .login-card {
        background: rgba(26, 40, 71, 0.85);
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 16px;
        padding: 2.5rem;
        backdrop-filter: blur(10px);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        z-index: 10;
    }

    /* Header */
    .login-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .login-logo {
        width: 80px;
        height: 80px;
        margin: 0 auto 1rem;
        background: linear-gradient(135deg, #00f2fe, #25d366);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: var(--bg-dark);
        box-shadow: 0 10px 30px rgba(0, 242, 254, 0.3);
    }

    .login-header h1 {
        font-size: 2rem;
        margin: 1rem 0 0.5rem;
        color: var(--text-primary);
        font-weight: 800;
        background: linear-gradient(135deg, #00f2fe, #25d366);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .login-subtitle {
        color: var(--text-secondary);
        margin: 0;
        font-size: 1rem;
    }

    /* Alert */
    .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        animation: slideDown 0.3s ease;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .alert-danger {
        background: rgba(255, 68, 68, 0.1);
        border: 1px solid rgba(255, 68, 68, 0.3);
        color: #ff9999;
    }

    .alert i {
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    /* Form Groups */
    .form-group {
        margin-bottom: 1.5rem;
        pointer-events: auto;
    }

    .form-label {
        display: block;
        margin-bottom: 0.75rem;
        color: var(--text-primary);
        font-weight: 600;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-label i {
        color: var(--primary);
        font-size: 1rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        background: rgba(0, 242, 254, 0.05);
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 8px;
        color: var(--text-primary);
        font-size: 1rem;
        transition: all 0.3s ease;
        cursor: text;
    }

    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }

    .form-control:focus {
        outline: none;
        background: rgba(0, 242, 254, 0.1);
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(0, 242, 254, 0.1);
    }

    .form-control-lg {
        padding: 0.875rem 1.125rem;
        font-size: 1.025rem;
    }

    /* Checkbox */
    .form-check {
        display: flex;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        margin-right: 0.75rem;
        cursor: pointer;
        accent-color: var(--primary);
    }

    .form-check-label {
        color: var(--text-secondary);
        font-size: 0.95rem;
        cursor: pointer;
        margin: 0;
    }

    .form-check-label:hover {
        color: var(--text-primary);
    }

    /* Button */
    .btn-login {
        width: 100%;
        padding: 1rem;
        font-size: 1rem;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, #00f2fe, #00a8cc);
        color: var(--bg-dark);
        box-shadow: 0 4px 15px rgba(0, 242, 254, 0.2);
    }

    .btn-primary:hover {
        box-shadow: 0 8px 25px rgba(0, 242, 254, 0.4);
        transform: translateY(-2px);
    }

    .btn-primary:active {
        transform: translateY(0);
        box-shadow: 0 4px 15px rgba(0, 242, 254, 0.2);
    }

    /* Divider */
    .divider {
        position: relative;
        margin: 2rem 0;
        text-align: center;
    }

    .divider::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(0, 242, 254, 0.2), transparent);
    }

    .divider span {
        position: relative;
        background: rgba(26, 40, 71, 0.85);
        color: var(--text-secondary);
        padding: 0 1rem;
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* Links */
    .login-links {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    a.link-secondary,
    a.link-primary {
        padding: 0.75rem 1rem;
        border-radius: 8px;
        text-align: center;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.95rem;
    }

    a.link-secondary {
        color: var(--primary);
        background: rgba(0, 242, 254, 0.1);
        border: 1px solid rgba(0, 242, 254, 0.2);
    }

    a.link-secondary:hover {
        background: rgba(0, 242, 254, 0.2);
        border-color: var(--primary);
    }

    a.link-primary {
        color: var(--bg-dark);
        background: linear-gradient(135deg, rgba(37, 211, 102, 0.9), rgba(0, 168, 83, 0.9));
        border: none;
    }

    a.link-primary:hover {
        box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
        transform: translateY(-1px);
    }

    /* Decorative Elements */
    .decorative-elements {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        overflow: hidden;
        z-index: 0;
        pointer-events: none;
    }

    .element {
        position: absolute;
        border-radius: 50%;
        opacity: 0.05;
    }

    .element-1 {
        width: 300px;
        height: 300px;
        top: -100px;
        left: -100px;
        background: linear-gradient(135deg, #00f2fe, #25d366);
    }

    .element-2 {
        width: 200px;
        height: 200px;
        bottom: -50px;
        right: -50px;
        background: linear-gradient(135deg, #00f2fe, #25d366);
    }

    .element-3 {
        width: 150px;
        height: 150px;
        top: 50%;
        right: -75px;
        background: linear-gradient(135deg, #25d366, #00a853);
    }

    /* Responsive */
    @media (max-width: 480px) {
        .login-card {
            padding: 2rem;
        }

        .login-header h1 {
            font-size: 1.5rem;
        }

        .login-logo {
            width: 60px;
            height: 60px;
            font-size: 2rem;
        }

        .form-control {
            font-size: 16px;
        }

        .btn-login {
            padding: 0.875rem;
            font-size: 0.95rem;
        }

        .login-links {
            gap: 0.5rem;
        }

        a.link-secondary,
        a.link-primary {
            padding: 0.625rem 0.75rem;
            font-size: 0.85rem;
        }
    }
</style>
{% endblock %}
