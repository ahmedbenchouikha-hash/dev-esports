{% extends "base.html.twig" %}

{% block title %}Admin Responses - RankUp{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .admin-module-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.1rem;
            gap: 1rem;
        }

        .admin-module-subtitle {
            margin: 0.35rem 0 0;
            color: #94a3b8;
            font-size: 0.92rem;
        }

        .admin-response-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 1.35rem;
        }

        .admin-response-item {
            display: flex;
            flex-direction: column;
            gap: 0.7rem;
        }

        .admin-response-card {
            background: rgba(30, 41, 79, 0.72);
            border: 1px solid rgba(96, 165, 250, 0.24);
            border-radius: 14px;
            padding: 1.05rem 1.05rem;
            box-shadow: 0 14px 32px rgba(2, 6, 23, 0.35);
            min-height: 232px;
            display: flex;
            flex-direction: column;
            transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        }

        .admin-response-card:hover {
            transform: translateY(-2px);
            border-color: rgba(125, 211, 252, 0.42);
            box-shadow: 0 18px 34px rgba(2, 6, 23, 0.4);
        }

        .admin-response-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.8rem;
            margin-bottom: 0.7rem;
        }

        .admin-created-badge {
            font-size: 0.75rem;
            color: #bfdbfe;
            background: rgba(30, 58, 138, 0.35);
            border: 1px solid rgba(96, 165, 250, 0.38);
            border-radius: 999px;
            padding: 0.22rem 0.55rem;
        }

        .admin-message-title {
            font-weight: 700;
            color: #e2e8f0;
            margin-bottom: 0;
        }

        .admin-message-body {
            color: #cbd5e1;
            line-height: 1.45;
            margin-bottom: 0.85rem;
            flex: 1;
        }

        .admin-response-actions {
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .admin-linked-pill {
            align-self: flex-start;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border-radius: 999px;
            padding: 0.34rem 0.72rem;
            font-size: 0.8rem;
            color: #cfe8ff;
            text-decoration: none;
            border: 1px solid rgba(125, 211, 252, 0.34);
            background: rgba(14, 116, 144, 0.28);
        }

        .admin-linked-pill:hover {
            color: #ecfeff;
            border-color: rgba(125, 211, 252, 0.56);
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="admin-module-header">
        <div>
            <h1 class="mb-0">Admin Responses</h1>
            <p class="admin-module-subtitle">Centralisez les réponses administratives et suivez les réclamations en cours.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="{{ path('app_admin_response_new') }}" class="crud-icon-btn crud-icon-btn-add" title="Add Response" aria-label="Add Response">
                <i class="fas fa-plus"></i>
            </a>
            {% include 'admin_response/_chatbot_widget.html.twig' with { chatbot_inline: true } %}
        </div>
    </div>

    {% if admin_responses|length > 0 %}
        <div class="admin-response-grid">
            {% for response in admin_responses %}
                <article class="admin-response-item">
                    <div class="admin-response-card">
                        <div class="admin-response-meta">
                            <h6 class="admin-message-title">Réponse administrative</h6>
                            <span class="admin-created-badge">{{ response.createdAt|date('d/m/Y H:i') }}</span>
                        </div>

                        <p class="admin-message-body">{{ response.message }}</p>

                        <div class="admin-response-actions">
                            <a href="{{ path('app_admin_response_show', {'id': response.id}) }}" class="crud-view-btn" title="View" aria-label="View">
                                <i class="fas fa-eye"></i>
                            </a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_admin_response_edit', {'id': response.id}) }}" class="crud-icon-btn crud-icon-btn-edit crud-icon-btn-sm" title="Edit" aria-label="Edit">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <form method="POST" action="{{ path('app_admin_response_delete', {'id': response.id}) }}" style="display: inline;" onsubmit="return confirm('Delete this response?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ response.id) }}">
                                    <button type="submit" class="crud-icon-btn crud-icon-btn-delete crud-icon-btn-sm" title="Delete" aria-label="Delete">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>

                    <a class="admin-linked-pill" href="{{ path('app_reclamation_show', {'id': response.reclamation.id}) }}">
                        <i class="fas fa-link"></i>
                        Réclamation liée: {{ response.reclamation.titre }}
                    </a>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> No admin responses yet.
        </div>
    {% endif %}
</div>
{% endblock %}
