{% extends "base.html.twig" %}

{% block title %}Admin Response - Dev Esports{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .admin-show-shell {
            background: rgba(30, 41, 79, 0.72);
            border: 1px solid rgba(71, 85, 105, 0.55);
            border-radius: 14px;
            box-shadow: 0 12px 30px rgba(2, 6, 23, 0.35);
        }

        .admin-show-subtitle {
            margin-top: 0.35rem;
            color: #94a3b8;
            font-size: 0.92rem;
        }

        .admin-response-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.8rem;
            margin-bottom: 0.7rem;
        }

        .admin-created-badge {
            font-size: 0.75rem;
            color: #bfdbfe;
            background: rgba(30, 58, 138, 0.35);
            border: 1px solid rgba(96, 165, 250, 0.38);
            border-radius: 999px;
            padding: 0.22rem 0.55rem;
        }

        .admin-message-title {
            font-weight: 700;
            color: #e2e8f0;
            margin-bottom: 0;
        }

        .admin-message-body {
            color: #cbd5e1;
            line-height: 1.5;
            margin-bottom: 0;
        }

        .admin-linked-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border-radius: 999px;
            padding: 0.34rem 0.72rem;
            font-size: 0.8rem;
            color: #cfe8ff;
            text-decoration: none;
            border: 1px solid rgba(125, 211, 252, 0.34);
            background: rgba(14, 116, 144, 0.28);
            margin-top: 0.75rem;
        }

        .admin-linked-pill:hover {
            color: #ecfeff;
            border-color: rgba(125, 211, 252, 0.56);
        }

        .admin-back-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            border-radius: 999px;
            border: 1px solid rgba(148, 163, 184, 0.45);
            background: rgba(30, 41, 59, 0.55);
            color: #cbd5e1;
            text-decoration: none;
            padding: 0.45rem 0.9rem;
            font-weight: 600;
        }

        .admin-back-pill:hover {
            color: #e2e8f0;
            border-color: rgba(148, 163, 184, 0.7);
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">Response Details</h1>
            <p class="admin-show-subtitle">Consultez le contenu, la réclamation liée et l’historique de la réponse.</p>
        </div>
        <div>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_response_edit', {'id': admin_response.id}) }}" class="crud-icon-btn crud-icon-btn-edit" title="Edit" aria-label="Edit">
                    <i class="fas fa-pen"></i>
                </a>
                <form method="POST" action="{{ path('app_admin_response_delete', {'id': admin_response.id}) }}" style="display: inline;" onsubmit="return confirm('Delete this response?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ admin_response.id) }}">
                    <button type="submit" class="crud-icon-btn crud-icon-btn-delete" title="Delete" aria-label="Delete">
                        <i class="fas fa-times"></i>
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="card admin-show-shell">
        <div class="card-body">
            <div class="admin-response-meta">
                <h6 class="admin-message-title">Réponse administrative</h6>
                <span class="admin-created-badge">{{ admin_response.createdAt|date('d/m/Y H:i') }}</span>
            </div>
            <p class="admin-message-body">{{ admin_response.message }}</p>
        </div>
        <div class="card-footer">
            <small class="text-muted">
                Created: {{ admin_response.createdAt|date('d/m/Y H:i') }}
                {% if admin_response.updatedAt %}
                    | Updated: {{ admin_response.updatedAt|date('d/m/Y H:i') }}
                {% endif %}
            </small>
        </div>
    </div>

    <a class="admin-linked-pill" href="{{ path('app_reclamation_show', {'id': admin_response.reclamation.id}) }}">
        <i class="fas fa-link"></i>
        Réclamation liée: {{ admin_response.reclamation.titre }}
    </a>

    <div class="mt-3">
        <a href="{{ path('app_admin_response_index') }}" class="admin-back-pill">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
        <a href="{{ path('app_reclamation_show', {'id': admin_response.reclamation.id}) }}" class="crud-view-btn" title="View Reclamation" aria-label="View Reclamation">
            <i class="fas fa-eye"></i>
        </a>
    </div>
</div>
{% endblock %}
