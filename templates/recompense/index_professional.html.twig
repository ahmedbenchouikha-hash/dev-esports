{% extends 'base.html.twig' %}

{% block title %}Gestion des Récompenses | Dev-Esports{% endblock %}

{% block body %}
<div class="recompense-dashboard">
    <!-- Header Professionnel -->
    <div class="header-section">
        <div class="header-content">
            <div class="header-info">
                <h1>🏆 Gestion des Récompenses</h1>
                <p class="subtitle">Système de gestion complet des récompenses esports</p>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
            <button class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#createRewardModal">
                <i class="fas fa-plus"></i> Créer Récompense
            </button>
            {% endif %}
        </div>
    </div>

    <!-- Filtres Avancés -->
    <div class="filters-section">
        <form method="GET" class="filters-form">
            <div class="filter-group">
                <input type="text" name="search" class="filter-input" placeholder="🔍 Rechercher une récompense..." 
                       value="{{ filters.search ?? '' }}">
            </div>
            
            <div class="filter-group">
                <select name="type" class="filter-select">
                    <option value="">📂 Tous les types</option>
                    {% for type in types %}
                    <option value="{{ type }}" {% if filters.type == type %}selected{% endif %}>{{ type }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-group">
                <select name="sortBy" class="filter-select">
                    <option value="classement" {% if filters.sortBy == 'classement' %}selected{% endif %}>Classement</option>
                    <option value="recompense" {% if filters.sortBy == 'recompense' %}selected{% endif %}>Nom (A-Z)</option>
                    <option value="type" {% if filters.sortBy == 'type' %}selected{% endif %}>Type</option>
                </select>
            </div>

            <button type="submit" class="btn btn-search">🔎 Filtrer</button>
        </form>
    </div>

    <!-- Grille de Récompenses (Carte Professionelle) -->
    <div class="recompenses-grid">
        {% if recompenses is empty %}
            <div class="no-data">
                <i class="fas fa-inbox"></i>
                <p>Aucune récompense trouvée</p>
                <small>Créez votre première récompense pour commencer</small>
            </div>
        {% else %}
            {% for recompense in recompenses %}
            <div class="reward-card">
                <!-- Illustration statique -->
                <div class="reward-image">
                    <div class="placeholder-gif">
                        <i class="fas fa-trophy"></i>
                        <small>Récompense esports</small>
                    </div>
                </div>

                <!-- Contenu -->
                <div class="reward-content">
                    <div class="reward-header">
                        <h3 class="reward-name">{{ recompense.recompense }}</h3>
                        <span class="badge badge-{{ recompense.type|lower }}">{{ recompense.type }}</span>
                    </div>

                    <!-- Classement -->
                    <div class="reward-ranking">
                        <span class="rank-badge">#{{ recompense.classement }}</span>
                        <span class="rank-text">Classement</span>
                    </div>

                    <!-- Description -->
                    {% if recompense.description %}
                    <p class="reward-description">{{ recompense.description[:60] }}...</p>
                    {% endif %}

                    <!-- Motif IA -->
                    {% if recompense.motifSuppereIa %}
                    <div class="ai-motif">
                        <small class="ai-label">
                            <i class="fas fa-brain"></i> Motif IA Suggéré
                        </small>
                        <p>{{ recompense.motifSuppereIa }}</p>
                    </div>
                    {% endif %}

                    <!-- Stats -->
                    <div class="reward-stats">
                        <span class="stat">
                            <i class="fas fa-file-alt"></i>
                            {{ recompense.demandes|length }} demandes
                        </span>
                        <span class="stat">
                            <i class="fas fa-bookmark"></i>
                            {{ recompense.tournament.nom ?? 'N/A' }}
                        </span>
                    </div>

                    <!-- Actions -->
                    <div class="reward-actions">
                        <a href="{{ path('recompense_show', {id: recompense.id}) }}" class="btn btn-sm btn-info">
                            <i class="fas fa-eye"></i> Voir détails
                        </a>
                        {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('recompense_edit', {id: recompense.id}) }}" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i> Éditer
                        </a>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>

    <!-- Pagination -->
    {% if pagination.pages > 1 %}
    <nav class="pagination-container">
        <ul class="pagination">
            {% if pagination.page > 1 %}
            <li><a href="{{ path('recompense_index', {page: 1}) }}" class="btn-page">« Première</a></li>
            <li><a href="{{ path('recompense_index', {page: pagination.page - 1}) }}" class="btn-page">‹ Prev</a></li>
            {% endif %}

            {% for p in 1..pagination.pages %}
                {% if p - pagination.page >= -2 and p - pagination.page <= 2 %}
                <li>
                    <a href="{{ path('recompense_index', {page: p}) }}" 
                       class="btn-page {% if p == pagination.page %}active{% endif %}">
                        {{ p }}
                    </a>
                </li>
                {% endif %}
            {% endfor %}

            {% if pagination.page < pagination.pages %}
            <li><a href="{{ path('recompense_index', {page: pagination.page + 1}) }}" class="btn-page">Next ›</a></li>
            <li><a href="{{ path('recompense_index', {page: pagination.pages}) }}" class="btn-page">Dernière »</a></li>
            {% endif %}
        </ul>
    </nav>
    {% endif %}
</div>

<!-- Modal Création Récompense -->
<div class="modal fade" id="createRewardModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Créer une Nouvelle Récompense</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="{{ path('recompense_create') }}" class="modal-form">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Nom de la Récompense *</label>
                        <input type="text" name="recompense" class="form-control" required>
                    </div>

                    <div class="form-group">
                        <label>Type *</label>
                        <select name="type" class="form-control" required>
                            <option>-- Sélectionner --</option>
                            {% for type in types %}
                            <option value="{{ type }}">{{ type }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Classement *</label>
                            <input type="number" name="classement" class="form-control" min="1" max="30" required>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Tournoi</label>
                            <select name="tournament_id" class="form-control">
                                <option>-- Sélectionner --</option>
                                {% for tournament in tournaments %}
                                <option value="{{ tournament.id }}">{{ tournament.nom }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Description</label>
                        <textarea name="description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">✓ Créer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.recompense-dashboard {
    padding: 2rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header-section {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.header-info h1 {
    font-size: 2.5rem;
    color: #333;
    margin: 0;
}

.subtitle {
    color: #666;
    font-size: 1rem;
    margin: 0.5rem 0 0;
}

.filters-section {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.filters-form {
    display: flex;
    gap: 1rem;
    align-items: flex-end;
    flex-wrap: wrap;
}

.filter-group {
    flex: 1;
    min-width: 200px;
}

.filter-input, .filter-select {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 0.95rem;
}

.btn-search {
    padding: 0.75rem 1.5rem;
    background: #667eea;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
}

.recompenses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
}

.reward-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s, box-shadow 0.3s;
}

.reward-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
}

.reward-image {
    position: relative;
    width: 100%;
    height: 250px;
    background: #f5f5f5;
    overflow: hidden;
}

.reward-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.placeholder-gif {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #999;
    font-size: 3rem;
}

.btn-refresh-gif {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(102, 126, 234, 0.9);
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    opacity: 0;
    transition: opacity 0.3s;
}

.reward-card:hover .btn-refresh-gif {
    opacity: 1;
}

.reward-content {
    padding: 1.5rem;
}

.reward-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 1rem;
}

.reward-name {
    font-size: 1.3rem;
    color: #333;
    margin: 0;
}

.badge {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    color: white;
}

.badge-argent { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
.badge-équipement { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
.badge-titre { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }
.badge-accès\ vip { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); }

.reward-ranking {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
}

.rank-badge {
    background: #667eea;
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-weight: bold;
}

.rank-text {
    color: #999;
    font-size: 0.9rem;
}

.reward-description {
    color: #666;
    font-size: 0.95rem;
    margin: 0.5rem 0;
}

.ai-motif {
    background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
    padding: 0.75rem;
    border-left: 3px solid #667eea;
    border-radius: 4px;
    margin: 1rem 0;
}

.ai-label {
    color: #667eea;
    font-weight: 600;
}

.ai-motif p {
    margin: 0.5rem 0 0;
    color: #555;
    font-size: 0.9rem;
}

.reward-stats {
    display: flex;
    gap: 1rem;
    margin: 1rem 0;
    font-size: 0.9rem;
    color: #666;
}

.stat {
    display: flex;
    align-items: center;
    gap: 0.3rem;
}

.reward-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
}

.reward-actions .btn {
    flex: 1;
    padding: 0.5rem;
    text-align: center;
    font-size: 0.9rem;
}

.btn-info {
    background: #667eea;
    color: white;
    text-decoration: none;
    border-radius: 4px;
    border: none;
    cursor: pointer;
}

.btn-warning {
    background: #f5a623;
    color: white;
    text-decoration: none;
    border-radius: 4px;
    border: none;
    cursor: pointer;
}

.no-data {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    color: #999;
}

.no-data i {
    font-size: 3rem;
    margin-bottom: 1rem;
}

.pagination-container {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
}

.pagination {
    display: flex;
    list-style: none;
    gap: 0.5rem;
}

.btn-page {
    padding: 0.5rem 1rem;
    background: white;
    border: 1px solid #ddd;
    border-radius: 4px;
    text-decoration: none;
    color: #667eea;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-page:hover,
.btn-page.active {
    background: #667eea;
    color: white;
    border-color: #667eea;
}

@media (max-width: 768px) {
    .recompenses-grid {
        grid-template-columns: 1fr;
    }
    
    .header-content {
        flex-direction: column;
        gap: 1rem;
    }
    
    .filters-form {
        flex-direction: column;
    }
}
</style>

{% endblock %}
