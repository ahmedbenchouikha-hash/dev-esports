{% extends 'base.html.twig' %}

{% block title %}Récompenses - Gestion des Récompenses{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>Gestion des Récompenses</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="{{ path('recompense_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Ajouter une récompense
            </a>
            <a href="{{ path('recompense_export_pdf') }}" class="btn btn-danger">
                <i class="fas fa-file-pdf"></i> Exporter en PDF
            </a>
        </div>
    </div>

    {% if app.flashes %}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    {% endif %}

    <!-- Search and Sort -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <input type="text" name="search" class="form-control" 
                           placeholder="Rechercher par nom, type ou description..."
                           value="{{ search ?? '' }}">
                </div>
                <div class="col-md-4">
                    <select name="sort" class="form-select">
                        <option value="">Trier par...</option>
                        <option value="classement_asc" {% if sort == 'classement_asc' %}selected{% endif %}>
                            Classement (croissant)
                        </option>
                        <option value="classement_desc" {% if sort == 'classement_desc' %}selected{% endif %}>
                            Classement (décroissant)
                        </option>
                        <option value="name_asc" {% if sort == 'name_asc' %}selected{% endif %}>
                            Nom (A-Z)
                        </option>
                        <option value="name_desc" {% if sort == 'name_desc' %}selected{% endif %}>
                            Nom (Z-A)
                        </option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-search"></i> Chercher
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Statistics -->
    {% if recompenses|length > 0 %}
        <div class="alert alert-info">
            <strong>Statistiques:</strong> {{ recompenses|length }} récompense(s) 
            | Classement min: {{ minClassement }} | Classement max: {{ maxClassement }}
        </div>

        <!-- Charts Row -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-pie-chart me-2"></i>Distribution by Type</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="rewardTypeChart" height="60"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="fas fa-bar-chart me-2"></i>Requests per Reward</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="requestsChart" height="60"></canvas>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- Recompenses Table -->
    {% if recompenses|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Type</th>
                        <th>Classement</th>
                        <th>Description</th>
                        <th>Demandes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for recompense in recompenses %}
                        <tr>
                            <td>{{ recompense.id }}</td>
                            <td><strong>{{ recompense.recompense }}</strong></td>
                            <td>{{ recompense.type }}</td>
                            <td>
                                <span class="badge bg-info">{{ recompense.classement }}</span>
                            </td>
                            <td>{{ recompense.description ? (recompense.description|slice(0, 50) ~ (recompense.description|length > 50 ? '...' : '')) : '-' }}</td>
                            <td>
                                <span class="badge bg-secondary">{{ recompense.demandes|length }}</span>
                            </td>
                            <td>
                                <a href="{{ path('recompense_show', {'id': recompense.id}) }}" 
                                   class="btn btn-sm btn-info" title="Voir">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('recompense_edit', {'id': recompense.id}) }}" 
                                   class="btn btn-sm btn-warning" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="{{ path('demande_recompense_new', {recompenseId: recompense.id}) }}" 
                                   class="btn btn-sm btn-success" title="Demander">
                                    <i class="fas fa-plus"></i>
                                </a>
                                <form method="post" action="{{ path('recompense_delete', {'id': recompense.id}) }}" 
                                      style="display:inline;" 
                                      onsubmit="return confirm('Êtes-vous sûr?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recompense.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-warning">
            Aucune récompense trouvée.
        </div>
    {% endif %}
</div>

<!-- Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    {% if recompenses|length > 0 %}
        // Prepare data for charts
        const recompenses = {{ recompenses|json_encode }};
        
        // Group by type for pie chart
        const typeCount = {};
        const rewardNames = [];
        const requestCounts = [];
        const typeColors = {
            'Computer accessory': '#00f2fe',
            'Medal': '#fd7e14',
            'Cash': '#95E1D3',
            'Trophy': '#FF6B6B',
            'default': '#6366f1'
        };
        
        recompenses.forEach(reward => {
            // Count by type
            if (!typeCount[reward.type]) {
                typeCount[reward.type] = 0;
            }
            typeCount[reward.type]++;
            
            // Track reward names and request counts
            rewardNames.push(reward.recompense);
            requestCounts.push(reward.demandes ? reward.demandes.length : 0);
        });
        
        // Pie Chart - Distribution by Type
        const ctx1 = document.getElementById('rewardTypeChart').getContext('2d');
        new Chart(ctx1, {
            type: 'doughnut',
            data: {
                labels: Object.keys(typeCount),
                datasets: [{
                    data: Object.values(typeCount),
                    backgroundColor: [
                        typeColors['Computer accessory'] || typeColors['default'],
                        typeColors['Medal'] || typeColors['default'],
                        typeColors['Cash'] || typeColors['default'],
                        typeColors['Trophy'] || typeColors['default'],
                    ],
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 15,
                            font: {
                                size: 12,
                                weight: '500'
                            }
                        }
                    }
                }
            }
        });
        
        // Bar Chart - Requests per Reward
        const ctx2 = document.getElementById('requestsChart').getContext('2d');
        new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: rewardNames,
                datasets: [{
                    label: 'Number of Requests',
                    data: requestCounts,
                    backgroundColor: '#4299E1',
                    borderColor: '#2c5282',
                    borderWidth: 1.5,
                    borderRadius: 4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                indexAxis: 'y',
                plugins: {
                    legend: {
                        labels: {
                            font: {
                                size: 12,
                                weight: '500'
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                }
            }
        });
    {% endif %}
});
</script>
{% endblock %}
