<!-- Hidden CSRF Token -->
<input type="hidden" id="csrfToken" value="{{ csrf_token('recompense_delete') }}">

<!-- Modal Form -->
<div class="modal fade" id="recompenseFormModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div id="recompenseFormContent"></div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fe fe-alert-triangle text-danger me-2"></i>Confirm deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this reward? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="fe fe-trash-2 me-2"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const recompenseModal = new bootstrap.Modal(document.getElementById('recompenseFormModal'));
    const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
    let currentRecompenseId = null;

    // Add Button
    document.querySelector('.add-btn')?.addEventListener('click', function() {
        currentRecompenseId = null;
        fetch('{{ path("recompense_modal_form") }}?action=create')
            .then(res => res.json())
            .then(data => {
                document.getElementById('recompenseFormContent').innerHTML = data.html;
                recompenseModal.show();
                attachFormListeners();
            });
    });

    // Edit Buttons
    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            currentRecompenseId = this.dataset.id;
            fetch(`{{ path("recompense_modal_form") }}?action=edit&id=${currentRecompenseId}`)
                .then(res => res.json())
                .then(data => {
                    if (data.error) {
                        alert(data.error);
                        return;
                    }
                    document.getElementById('recompenseFormContent').innerHTML = data.html;
                    recompenseModal.show();
                    attachFormListeners();
                });
        });
    });

    // Delete Buttons
    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            currentRecompenseId = this.dataset.id;
            deleteModal.show();
        });
    });

    // Confirm Delete
    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        const csrfToken = document.getElementById('csrfToken').value;
        
        fetch('{{ path("recompense_modal_delete") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: `id=${currentRecompenseId}&_token=${csrfToken}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                deleteModal.hide();
                location.reload();
            } else {
                alert('Error: ' + (data.error || 'Unable to delete'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred');
        });
    });

    function attachFormListeners() {
        const form = document.getElementById('recompenseForm');
        if (!form) return;

        document.getElementById('submitRecompenseForm').addEventListener('click', function() {
            const formData = new FormData(form);
            
            fetch('{{ path("recompense_modal_form") }}', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    recompenseModal.hide();
                    location.reload();
                } else if (data.html) {
                    document.getElementById('recompenseFormContent').innerHTML = data.html;
                    attachFormListeners();
                } else if (data.errors) {
                    const errorsStr = data.errors.join('<br>');
                    alert('Validation error:\n' + errorsStr);
                } else if (data.error) {
                    alert('Error: ' + data.error);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while submitting the form');
            });
        });
    }
});
</script>
