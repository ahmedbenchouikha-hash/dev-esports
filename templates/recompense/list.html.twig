{% extends 'base.html.twig' %}

{% block title %}Récompenses - Gestion des Récompenses{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>Gestion des Récompenses</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="{{ path('recompense_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Ajouter une récompense
            </a>
            <a href="{{ path('recompense_export_pdf') }}" class="btn btn-danger">
                <i class="fas fa-file-pdf"></i> Exporter en PDF
            </a>
        </div>
    </div>

    {% if app.flashes %}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    {% endif %}

    <!-- Search and Sort -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <input type="text" name="search" class="form-control" 
                           placeholder="Rechercher par nom, type ou description..."
                           value="{{ search ?? '' }}">
                </div>
                <div class="col-md-4">
                    <select name="sort" class="form-select">
                        <option value="">Trier par...</option>
                        <option value="classement_asc" {% if sort == 'classement_asc' %}selected{% endif %}>
                            Classement (croissant)
                        </option>
                        <option value="classement_desc" {% if sort == 'classement_desc' %}selected{% endif %}>
                            Classement (décroissant)
                        </option>
                        <option value="name_asc" {% if sort == 'name_asc' %}selected{% endif %}>
                            Nom (A-Z)
                        </option>
                        <option value="name_desc" {% if sort == 'name_desc' %}selected{% endif %}>
                            Nom (Z-A)
                        </option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-search"></i> Chercher
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Statistics -->
    {% if recompenses|length > 0 %}
        <div class="alert alert-info">
            <strong>Statistiques:</strong> {{ recompenses|length }} récompense(s) 
            | Classement min: {{ minClassement }} | Classement max: {{ maxClassement }}
        </div>

        <!-- Charts Row -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-pie-chart me-2"></i>Distribution by Type</h5>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height: 300px; width: 100%;">
                            <canvas id="rewardTypeChart" style="max-width: 100%;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="fas fa-bar-chart me-2"></i>Requests per Reward</h5>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height: 300px; width: 100%;">
                            <canvas id="requestsChart" style="max-width: 100%;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- Recompenses Table -->
    {% if recompenses|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Type</th>
                        <th>Classement</th>
                        <th>Description</th>
                        <th>Demandes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for recompense in recompenses %}
                        <tr>
                            <td>{{ recompense.id }}</td>
                            <td><strong>{{ recompense.recompense }}</strong></td>
                            <td>{{ recompense.type }}</td>
                            <td>
                                <span class="badge bg-info">{{ recompense.classement }}</span>
                            </td>
                            <td>{{ recompense.description ? (recompense.description|slice(0, 50) ~ (recompense.description|length > 50 ? '...' : '')) : '-' }}</td>
                            <td>
                                <span class="badge bg-secondary">{{ recompense.demandes|length }}</span>
                            </td>
                            <td>
                                <a href="{{ path('recompense_show', {'id': recompense.id}) }}" 
                                   class="btn btn-sm btn-info" title="Voir">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('recompense_edit', {'id': recompense.id}) }}" 
                                   class="btn btn-sm btn-warning" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="{{ path('demande_recompense_new', {recompenseId: recompense.id}) }}" 
                                   class="btn btn-sm btn-success" title="Demander">
                                    <i class="fas fa-plus"></i>
                                </a>
                                <form method="post" action="{{ path('recompense_delete', {'id': recompense.id}) }}" 
                                      style="display:inline;" 
                                      onsubmit="return confirm('Êtes-vous sûr?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recompense.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-warning">
            Aucune récompense trouvée.
        </div>
    {% endif %}
</div>

<!-- Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('Chart script loaded');
    {% if recompenses|length > 0 %}
        console.log('Recompenses found');
        // Build data structure directly from template
        const chartData = {
            types: {},
            rewards: []
        };
        
        // Prepare data from template
        {% for reward in recompenses %}
            const type = '{{ reward.type }}';
            const name = '{{ reward.recompense }}';
            const demandes = {{ reward.demandes|length }};
            
            console.log('Reward:', name, 'Type:', type, 'Demandes:', demandes);
            
            // Count by type
            if (!chartData.types[type]) {
                chartData.types[type] = 0;
            }
            chartData.types[type]++;
            
            // Store reward names and request counts
            chartData.rewards.push({
                name: name,
                requests: demandes
            });
        {% endfor %}
        
        console.log('Chart data:', chartData);
        
        // Define colors
        const typeColors = {
            'Computer accessory': '#00f2fe',
            'Medal': '#fd7e14',
            'Cash': '#95E1D3',
            'Trophy': '#FF6B6B'
        };
        
        // Get colors for pie chart based on types
        const typeLabels = Object.keys(chartData.types);
        const typeValues = Object.values(chartData.types);
        const typeBackgroundColors = typeLabels.map(type => typeColors[type] || '#6366f1');
        
        console.log('Type labels:', typeLabels);
        console.log('Type values:', typeValues);
        
        // Pie Chart - Distribution by Type
        const ctx1 = document.getElementById('rewardTypeChart');
        console.log('ctx1 element:', ctx1);
        if (ctx1) {
            try {
                new Chart(ctx1, {
                    type: 'doughnut',
                    data: {
                        labels: typeLabels,
                        datasets: [{
                            data: typeValues,
                            backgroundColor: typeBackgroundColors,
                            borderColor: '#fff',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 10,
                                    font: {
                                        size: 11,
                                        weight: '500'
                                    }
                                }
                            }
                        }
                    }
                });
                console.log('Type chart created successfully');
            } catch (e) {
                console.error('Error creating type chart:', e);
            }
        }
        
        // Bar Chart - Requests per Reward
        const ctx2 = document.getElementById('requestsChart');
        console.log('ctx2 element:', ctx2);
        if (ctx2) {
            try {
                const rewardNames = chartData.rewards.map(r => r.name);
                const requestCounts = chartData.rewards.map(r => r.requests);
                
                console.log('Reward names:', rewardNames);
                console.log('Request counts:', requestCounts);
                
                new Chart(ctx2, {
                    type: 'bar',
                    data: {
                        labels: rewardNames,
                        datasets: [{
                            label: 'Requests',
                            data: requestCounts,
                            backgroundColor: '#4299E1',
                            borderColor: '#2c5282',
                            borderWidth: 1.5,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        indexAxis: 'y',
                        plugins: {
                            legend: {
                                labels: {
                                    font: {
                                        size: 11,
                                        weight: '500'
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1
                                }
                            }
                        }
                    }
                });
                console.log('Requests chart created successfully');
            } catch (e) {
                console.error('Error creating requests chart:', e);
            }
        }
    {% else %}
        console.log('No recompenses found');
    {% endif %}
});
</script>
{% endblock %}
