{# Chart: Dépenses par Catégorie - ApexCharts #}
<div id="chartDepensesByCategory" style="height: 350px;"></div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts@latest/dist/apexcharts.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    try {
        const rawData = {%- filter json_encode -%}{{ depenses }}{%- endfilter -%};
        const depenses = typeof rawData === 'string' ? JSON.parse(rawData) : rawData;
        
        if (!Array.isArray(depenses) || depenses.length === 0) {
            document.getElementById('chartDepensesByCategory').innerHTML = 
                '<div class="alert alert-info text-center pt-5"><i class="fas fa-database"></i> Pas de données disponibles</div>';
            return;
        }
        
        const categoryMap = {};
        let validatedTotal = 0;
        
        depenses.forEach(d => {
            if (d && d.statut === 'validée') {
                const cat = d.categorie || 'Non catégorisée';
                categoryMap[cat] = (categoryMap[cat] || 0) + (parseFloat(d.montant) || 0);
                validatedTotal += (parseFloat(d.montant) || 0);
            }
        });
        
        const categories = Object.keys(categoryMap);
        const values = Object.values(categoryMap);
        
        if (categories.length === 0) {
            document.getElementById('chartDepensesByCategory').innerHTML = 
                '<div class="alert alert-info text-center pt-5"><i class="fas fa-database"></i> Aucune dépense validée</div>';
            return;
        }
        
        const options = {
            series: values,
            chart: { type: 'donut', sparkline: { enabled: false } },
            colors: ['#FF6B6B', '#4ECDC4', '#45B7D1', '#FFA07A', '#98D8C8', '#F7DC6F', '#BB8FCE', '#87CEEB'],
            labels: categories.map(cat => {
                const pct = ((categoryMap[cat] / validatedTotal) * 100).toFixed(1);
                return cat + ' (' + pct + '%)';
            }),
            plotOptions: {
                pie: {
                    donut: {
                        size: '65%',
                        labels: {
                            show: true,
                            name: { show: true, fontSize: '12px', color: '#666' },
                            value: {
                                show: true,
                                fontSize: '14px',
                                color: '#333',
                                formatter: function(val) { return (val || 0).toFixed(2) + ' TND'; }
                            },
                            total: {
                                show: true,
                                label: 'Total',
                                fontSize: '13px',
                                color: '#555',
                                formatter: function() { return validatedTotal.toFixed(2) + ' TND'; }
                            }
                        }
                    }
                }
            },
            legend: { position: 'bottom', fontSize: '12px', offsetY: 10 },
            tooltip: {
                y: {
                    formatter: function(val) {
                        return val.toFixed(2) + ' TND (' + ((val/validatedTotal)*100).toFixed(1) + '%)';
                    }
                }
            }
        };
        
        new ApexCharts(document.getElementById('chartDepensesByCategory'), options).render();
    } catch(e) {
        console.error('Chart error:', e);
        document.getElementById('chartDepensesByCategory').innerHTML = 
            '<div class="alert alert-danger"><strong>Erreur graphique:</strong> ' + e.message + '</div>';
    }
});
</script>
