{# Chart: Dépenses par Catégorie #}
<div class="chart-container" style="position: relative; width: 100%; height: 350px;">
    {% set depensesByCategory = {} %}
    {% for depense in depenses %}
        {% set category = depense.categorie ?? 'Sans catégorie' %}
        {% if depensesByCategory[category] is not defined %}
            {% set depensesByCategory = depensesByCategory|merge({(category): 0}) %}
        {% endif %}
        {% set depensesByCategory = depensesByCategory|merge({(category): depensesByCategory[category] + (depense.montant ?? 0)}) %}
    {% endfor %}

    {% if depensesByCategory|length > 0 %}
        {% set labels = [] %}
        {% set data = [] %}
        {% for cat, amount in depensesByCategory %}
            {% set labels = labels|merge([cat]) %}
            {% set data = data|merge([amount]) %}
        {% endfor %}
        <canvas id="depensesCategoryChart" style="max-height: 350px;"></canvas>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const canvasElement = document.getElementById('depensesCategoryChart');
                if (!canvasElement) return;
                
                const ctx = canvasElement.getContext('2d');
                const labels = {{ labels|json_encode|raw }};
                const data = {{ data|json_encode|raw }};
                
                const colors = [
                    '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0',
                    '#9966FF', '#FF9F40', '#FF9933', '#C9CBCF'
                ];

                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: data,
                            backgroundColor: colors.slice(0, labels.length),
                            borderColor: '#fff',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            });
        </script>
    {% else %}
        <div style="display: flex; justify-content: center; align-items: center; height: 100%; color: #999;">
            <p>Aucune donnée disponible</p>
        </div>
    {% endif %}
</div>
