{# Chart: Comparaison Budget Équipes - ApexCharts #}
<div id="chartTeamsBudget" style="height: 350px;"></div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts@latest/dist/apexcharts.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    try {
        const rawData = {%- filter json_encode -%}{{ budgets }}{%- endfilter -%};
        const budgets = typeof rawData === 'string' ? JSON.parse(rawData) : rawData;
        
        if (!Array.isArray(budgets) || budgets.length === 0) {
            document.getElementById('chartTeamsBudget').innerHTML = 
                '<div class="alert alert-info text-center pt-5"><i class="fas fa-database"></i> Pas de budgets disponibles</div>';
            return;
        }
        
        const teamNames = [];
        const allocatedSeries = [];
        const usedSeries = [];
        
        budgets.forEach(b => {
            if (b) {
                const teamName = b.team_name || ('Équipe ' + (b.id || b.team_id || 'Unknown'));
                teamNames.push(teamName);
                allocatedSeries.push(parseFloat(b.montant_alloue || 0));
                usedSeries.push(parseFloat(b.montant_utilise || 0));
            }
        });
        
        if (teamNames.length === 0) {
            document.getElementById('chartTeamsBudget').innerHTML = 
                '<div class="alert alert-info text-center pt-5"><i class="fas fa-database"></i> Aucune équipe avec budget</div>';
            return;
        }
        
        const options = {
            series: [
                {
                    name: 'Budget Alloué',
                    data: allocatedSeries
                },
                {
                    name: 'Budget Utilisé',
                    data: usedSeries
                }
            ],
            chart: {
                type: 'bar',
                height: 350,
                sparkline: { enabled: false }
            },
            colors: ['#45B7D1', '#FF6B6B'],
            plotOptions: {
                bar: {
                    horizontal: true,
                    columnWidth: '55%',
                    borderRadius: 4,
                    dataLabels: {
                        position: 'top'
                    }
                }
            },
            dataLabels: {
                enabled: true,
                offsetX: -6,
                style: {
                    fontSize: '11px',
                    colors: ['#333']
                },
                formatter: function(val) {
                    return (val || 0).toFixed(2) + ' TND';
                }
            },
            stroke: {
                show: true,
                width: 1,
                colors: ['#f3f3f3']
            },
            tooltip: {
                shared: true,
                intersect: false,
                y: {
                    formatter: function(val) {
                        return (val || 0).toFixed(2) + ' TND';
                    }
                }
            },
            xaxis: {
                categories: teamNames,
                title: {
                    text: 'Budget (TND)'
                }
            },
            yaxis: {
                title: {
                    text: 'Équipes'
                }
            },
            legend: {
                position: 'bottom',
                horizontalAlign: 'center',
                offsetY: 10
            }
        };
        
        new ApexCharts(document.getElementById('chartTeamsBudget'), options).render();
    } catch(e) {
        console.error('Chart error:', e);
        document.getElementById('chartTeamsBudget').innerHTML = 
            '<div class="alert alert-danger"><strong>Erreur graphique:</strong> ' + e.message + '</div>';
    }
});
</script>
