{% extends 'base.html.twig' %}

{% block title %}RAWG Game Search - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-12">
        <h1 class="page-title">Search RAWG Games</h1>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <form method="GET" action="{{ path('rawg_games') }}" class="row g-3">
                    <div class="col-md-9">
                        <input
                            type="text"
                            name="q"
                            class="form-control"
                            placeholder="Search games from RAWG (e.g. FIFA, Valorant, Elden Ring)"
                            value="{{ query }}"
                        >
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">Search</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{% if error %}
    <div class="alert alert-danger">{{ error }}</div>
{% endif %}

{% if query and games is empty and not error %}
    <div class="alert alert-info">No games found for "{{ query }}".</div>
{% endif %}

{% if games is not empty %}
    <div class="row g-3">
        {% for game in games %}
            <div class="col-lg-4 col-md-6">
                <div class="card h-100">
                    {% if game.background_image is defined and game.background_image %}
                        <img src="{{ game.background_image }}" class="card-img-top" alt="{{ game.name }}" style="height: 180px; object-fit: cover;">
                    {% endif %}
                    <div class="card-body">
                        <h5 class="mb-2">{{ game.name }}</h5>
                        <p class="mb-1"><strong>Released:</strong> {{ game.released ?: 'N/A' }}</p>
                        <p class="mb-1"><strong>Rating:</strong> {{ game.rating is defined ? game.rating : 'N/A' }}</p>
                        <p class="mb-0"><strong>Genres:</strong>
                            {% if game.genres is defined and game.genres is iterable and game.genres|length > 0 %}
                                {% for genre in game.genres %}
                                    {{ genre.name }}{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            {% else %}
                                N/A
                            {% endif %}
                        </p>
                        {% if game.slug is defined and game.slug %}
                            <div class="mt-3">
                                <a
                                    href="https://rawg.io/games/{{ game.slug }}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn btn-primary w-100"
                                >
                                    View On RAWG
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
