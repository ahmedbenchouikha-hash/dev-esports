{% extends 'base.html.twig' %}

{% block title %}Reward Requests Management{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <!-- Messages flash -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="fe fe-alert-circle me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="mb-1"><i class="fe fe-inbox me-2"></i>Reward Requests</h1>
            <p class="text-muted mb-0">{{ demandes|length }} request(s) found</p>
        </div>
        {% if isPlayer %}
        <div class="d-flex gap-2">
            <a href="{{ path('demande_recompense_export_pdf') }}" class="btn btn-outline-danger">
                <i class="fe fe-download me-2"></i>Export PDF
            </a>
            <button type="button" class="btn btn-primary add-btn" data-action="create">
                <i class="fe fe-plus me-2"></i>New request
            </button>
        </div>
        {% endif %}
    </div>

    <!-- Search and Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Search</label>
                    <input type="text" name="search" class="form-control" 
                           placeholder="Name, email, reason..."
                           value="{{ search ?? '' }}">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select name="statut" class="form-select">
                        <option value="">All statuses</option>
                        <option value="en_attente" {% if statut == 'en_attente' %}selected{% endif %}>Pending</option>
                        <option value="approuvee" {% if statut == 'approuvee' %}selected{% endif %}>Approved</option>
                        <option value="rejetee" {% if statut == 'rejetee' %}selected{% endif %}>Rejected</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Sort</label>
                    <select name="sort" class="form-select">
                        <option value="date_desc" {% if sort == 'date_desc' %}selected{% endif %}>Most recent</option>
                        <option value="date_asc" {% if sort == 'date_asc' %}selected{% endif %}>Oldest</option>
                        <option value="prioritaire" {% if sort == 'prioritaire' %}selected{% endif %}>Priority</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-outline-secondary w-100">
                        <i class="fe fe-search me-1"></i>Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Demandes Table -->
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Requester</th>
                        <th>Email</th>
                        <th>Reward</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th><i class="fas fa-brain me-1" style="color: #6366f1;"></i>AI Score</th>
                        <th>Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if demandes|length == 0 %}
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="fe fe-inbox me-2"></i>No requests found
                            </td>
                        </tr>
                    {% else %}
                        {% for demande in demandes %}
                        <tr>
                            <td><strong>{{ demande.id }}</strong></td>
                            <td>{{ demande.nomDemandeur }}</td>
                            <td>
                                {% if demande.emailVerifiedAt %}
                                    <span title="Email verified"><i class="fe fe-check text-success me-1"></i>{{ demande.email }}</span>
                                {% else %}
                                    <span title="Email not verified"><i class="fe fe-x text-warning me-1"></i>{{ demande.email }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <small>{{ demande.recompense.recompense }}</small><br>
                                <span class="badge bg-secondary">{{ demande.recompense.type }}</span>
                            </td>
                            <td>
                                {% if demande.statut == 'en_attente' %}
                                    <span class="badge bg-warning text-dark">Pending</span>
                                {% elseif demande.statut == 'approuvee' %}
                                    <span class="badge bg-success">Approved</span>
                                {% else %}
                                    <span class="badge bg-danger">Rejected</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if demande.isPrioritaire %}
                                    <span class="badge bg-danger">High</span>
                                {% else %}
                                    <span class="badge bg-secondary">Low</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if demande.aiLegitimacyScore is not null %}
                                    <span class="badge 
                                        {% if demande.aiLegitimacyScore >= 80 %}bg-success
                                        {% elseif demande.aiLegitimacyScore >= 60 %}bg-info
                                        {% elseif demande.aiLegitimacyScore >= 40 %}bg-warning
                                        {% else %}bg-danger
                                        {% endif %}"
                                        title="Legitimacy score">
                                        {{ demande.aiLegitimacyScore }}/100
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary">Processing...</span>
                                {% endif %}
                            </td>
                            <td>{{ demande.dateDemande|date('d/m/Y H:i') }}</td>
                            <td class="text-center">
                                <a href="{{ path('demande_recompense_show', { id: demande.id }) }}" class="btn btn-sm btn-info" title="View details + AI analysis">
                                    <i class="fe fe-eye me-1"></i>View
                                </a>
                                {% if isAdmin %}
                                <button type="button" class="btn btn-sm btn-success status-btn"
                                        data-url="{{ path('demande_recompense_change_statut', { id: demande.id }) }}"
                                        data-statut="approuvee"
                                        data-token="{{ csrf_token('statut' ~ demande.id) }}"
                                        {% if demande.statut == 'approuvee' %}disabled{% endif %}>
                                    <i class="fe fe-check me-1"></i>Approve
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger status-btn"
                                        data-url="{{ path('demande_recompense_change_statut', { id: demande.id }) }}"
                                        data-statut="rejetee"
                                        data-token="{{ csrf_token('statut' ~ demande.id) }}"
                                        {% if demande.statut == 'rejetee' %}disabled{% endif %}>
                                    <i class="fe fe-x me-1"></i>Reject
                                </button>
                                {% elseif isPlayer %}
                                <button type="button" class="btn btn-sm btn-warning edit-btn" data-id="{{ demande.id }}" title="Edit">
                                    <i class="fe fe-edit-2 me-1"></i>Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-danger delete-btn" data-id="{{ demande.id }}" title="Delete">
                                    <i class="fe fe-trash-2 me-1"></i>Delete
                                </button>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Hidden CSRF Token -->
<input type="hidden" id="csrfToken" value="{{ csrf_token('demande_recompense_delete') }}">

<!-- Modal Form -->
<div class="modal fade" id="demandeFormModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div id="demandeFormContent"></div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fe fe-alert-triangle text-danger me-2"></i>Confirm deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this request? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="fe fe-trash-2 me-2"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const demandeModal = new bootstrap.Modal(document.getElementById('demandeFormModal'));
    const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
    let currentDemandeId = null;

    // Add Button
    document.querySelector('.add-btn')?.addEventListener('click', function() {
        currentDemandeId = null;
        fetch('{{ path("demande_recompense_modal_form") }}?action=create')
            .then(res => res.json())
            .then(data => {
                document.getElementById('demandeFormContent').innerHTML = data.html;
                demandeModal.show();
                attachFormListeners();
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error while loading the form');
            });
    });

    // Edit Buttons
    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            currentDemandeId = this.dataset.id;
            fetch(`{{ path("demande_recompense_modal_form") }}?action=edit&id=${currentDemandeId}`)
                .then(res => res.json())
                .then(data => {
                    if (data.error) {
                        alert(data.error);
                        return;
                    }
                    document.getElementById('demandeFormContent').innerHTML = data.html;
                    demandeModal.show();
                    attachFormListeners();
                });
        });
    });

    // Delete Buttons
    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            currentDemandeId = this.dataset.id;
            deleteModal.show();
        });
    });

    // Approve / Reject Buttons (Admin)
    document.querySelectorAll('.status-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const url = this.dataset.url;
            const statut = this.dataset.statut;
            const token = this.dataset.token;

            if (statut === 'rejetee' && !confirm('Are you sure you want to reject this request?')) {
                return;
            }

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `statut=${statut}&_token=${token}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error: ' + (data.error || 'Unable to update status'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred');
            });
        });
    });

    // Confirm Delete
    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        const csrfToken = document.getElementById('csrfToken').value;
        
        fetch('{{ path("demande_recompense_modal_delete") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: `id=${currentDemandeId}&_token=${csrfToken}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                deleteModal.hide();
                location.reload();
            } else {
                alert('Error: ' + (data.error || 'Unable to delete'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred');
        });
    });

    function attachFormListeners() {
        const form = document.getElementById('demandeForm');
        if (!form) return;

        const motifField = form.querySelector('[id$="_motif"]');
        const recompenseField = form.querySelector('[id$="_recompense"]');
        const nomField = form.querySelector('[id$="_nomDemandeur"]');
        const suggestBtn = document.getElementById('suggestMotifBtn');
        const suggestionBox = document.getElementById('aiSuggestionBox');
        const suggestionText = document.getElementById('aiSuggestionText');
        const acceptBtn = document.getElementById('acceptSuggestionBtn');
        const aiRecompenseError = form.querySelector('.ai-recompense-error');
        const aiNomError = form.querySelector('.ai-nom-error');

        if (motifField && suggestBtn && suggestionBox && suggestionText && acceptBtn) {
            // Always show the AI Suggest button, whether motif is empty or not
            suggestBtn.style.display = 'inline-block';
            
            const clearAiErrors = () => {
                if (aiRecompenseError) {
                    aiRecompenseError.textContent = '';
                    aiRecompenseError.style.display = 'none';
                }
                if (aiNomError) {
                    aiNomError.textContent = '';
                    aiNomError.style.display = 'none';
                }
                recompenseField?.classList.remove('is-invalid');
                nomField?.classList.remove('is-invalid');
            };

            recompenseField?.addEventListener('change', clearAiErrors);
            nomField?.addEventListener('input', clearAiErrors);

            suggestBtn.addEventListener('click', function() {
                const recompenseId = recompenseField?.value;
                const nomDemandeur = nomField?.value?.trim();
                const motif = motifField?.value?.trim();

                if (!recompenseId || !nomDemandeur) {
                    clearAiErrors();
                    if (!recompenseId && aiRecompenseError) {
                        recompenseField?.classList.add('is-invalid');
                        aiRecompenseError.textContent = 'Please select a reward.';
                        aiRecompenseError.style.display = 'block';
                    }
                    if (!nomDemandeur && aiNomError) {
                        nomField?.classList.add('is-invalid');
                        aiNomError.textContent = 'Please enter your name.';
                        aiNomError.style.display = 'block';
                    }
                    return;
                }

                suggestBtn.disabled = true;
                suggestBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Generating...';

                fetch('{{ path("demande_recompense_motif_suggest") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: `recompenseId=${encodeURIComponent(recompenseId)}&nomDemandeur=${encodeURIComponent(nomDemandeur)}&motif=${encodeURIComponent(motif || '')}`
                })
                .then(res => res.json())
                .then(data => {
                    if (data.suggestion) {
                        suggestionBox.classList.remove('alert-danger');
                        suggestionBox.classList.add('alert-info');
                        suggestionText.textContent = data.suggestion;
                        suggestionBox.style.display = 'block';
                    } else {
                        suggestionBox.classList.remove('alert-info');
                        suggestionBox.classList.add('alert-danger');
                        suggestionText.textContent = data.error || 'Unable to generate suggestion.';
                        suggestionBox.style.display = 'block';
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    suggestionBox.classList.remove('alert-info');
                    suggestionBox.classList.add('alert-danger');
                    suggestionText.textContent = 'An error occurred while generating the suggestion.';
                    suggestionBox.style.display = 'block';
                })
                .finally(() => {
                    suggestBtn.disabled = false;
                    suggestBtn.innerHTML = '<i class="fas fa-wand-magic-sparkles me-1"></i>AI Suggest';
                });
            });

            acceptBtn.addEventListener('click', function() {
                if (suggestionText.textContent.trim() !== '') {
                    motifField.value = suggestionText.textContent.trim();
                    suggestionBox.style.display = 'none';
                    updateSuggestionVisibility();
                }
            });
        }

        document.getElementById('submitDemandeForm').addEventListener('click', function() {
            const formData = new FormData(form);
            
            fetch('{{ path("demande_recompense_modal_form") }}', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    demandeModal.hide();
                    location.reload();
                } else if (data.html) {
                    document.getElementById('demandeFormContent').innerHTML = data.html;
                    attachFormListeners();
                } else if (data.errors) {
                    const errorsStr = data.errors.join('<br>');
                    // Afficher les erreurs dans un div plutôt qu'une alerte
                    const formErrors = document.getElementById('formErrors');
                    if (formErrors) {
                        formErrors.innerHTML = `<div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Validation errors:</strong><br>
                            ${errorsStr}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>`;
                    } else {
                        alert('Validation error:\n' + errorsStr);
                    }
                } else if (data.error) {
                    const formErrors = document.getElementById('formErrors');
                    if (formErrors) {
                        formErrors.innerHTML = `<div class="alert alert-danger alert-dismissible fade show" role="alert">
                            ${data.error}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>`;
                    } else {
                        alert('Error: ' + data.error);
                    }
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while submitting the form');
            });
        });
    }
});
</script>
{% endblock %}
