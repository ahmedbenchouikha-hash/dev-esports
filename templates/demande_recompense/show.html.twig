{% extends 'base.html.twig' %}

{% block title %}Reward Request Details{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-eye me-2"></i>Demande #{{ demande.id }}
                        </h4>
                        <a href="{{ path('demande_recompense_index') }}" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Reward</h6>
                            <p class="mb-0">
                                <strong>{{ demande.recompense.recompense }}</strong>
                                <span class="badge" style="background-color: 
                                    {% if demande.recompense.type == 'Accessoire' %}#FFC107
                                    {% elseif demande.recompense.type == 'Médaille' %}#E8D4F1
                                    {% elseif demande.recompense.type == 'Argent' %}#C0C0C0
                                    {% else %}#FFD700
                                    {% endif %}
                                ">{{ demande.recompense.type }}</span>
                            </p>
                            <small class="text-muted">Tournament: {{ demande.recompense.tournament.name }}</small>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Status</h6>
                            <p class="mb-0">
                                {% if demande.statut == 'en_attente' %}
                                    <span class="badge bg-warning">Pending</span>
                                {% elseif demande.statut == 'approuvee' %}
                                    <span class="badge bg-success">Approved</span>
                                {% else %}
                                    <span class="badge bg-danger">Rejected</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    <hr>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Requester name</h6>
                            <p>{{ demande.nomDemandeur }}</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Email</h6>
                            <p>
                                {{ demande.email }}
                                {% if demande.isEmailVerified() %}
                                    <i class="fas fa-check-circle text-success ms-2"></i>
                                {% else %}
                                    <i class="fas fa-times-circle text-danger ms-2"></i>
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">Request reason</h6>
                        <p class="border-start border-4 ps-3 border-info">{{ demande.motif }}</p>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Request date</h6>
                            <p>{{ demande.dateDemande.format('d/m/Y H:i') }}</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Priority</h6>
                            <p>
                                {% if demande.isPrioritaire %}
                                    <span class="badge bg-danger">High</span>
                                {% else %}
                                    <span class="badge bg-secondary">Low</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    {# === ANALYSE IA === #}
                    {% if demande.aiLegitimacyScore is not null %}
                    <hr class="my-4">
                    <div class="card bg-light">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-brain me-2" style="color: #6366f1;"></i>
                                AI Analysis - Mistral AI
                            </h5>
                        </div>
                        <div class="card-body">
                            <!-- Score de Légitimité -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <h6 class="text-muted">Legitimacy score</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 20px;">
                                            <div class="progress-bar 
                                                {% if demande.aiLegitimacyScore >= 80 %}bg-success
                                                {% elseif demande.aiLegitimacyScore >= 60 %}bg-info
                                                {% elseif demande.aiLegitimacyScore >= 40 %}bg-warning
                                                {% else %}bg-danger
                                                {% endif %}"
                                                role="progressbar" 
                                                style="width: {{ demande.aiLegitimacyScore }}%" 
                                                aria-valuenow="{{ demande.aiLegitimacyScore }}" 
                                                aria-valuemin="0" 
                                                aria-valuemax="100">
                                            </div>
                                        </div>
                                        <strong>{{ demande.aiLegitimacyScore }}/100</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-muted">AI confidence</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 20px;">
                                            <div class="progress-bar bg-primary" 
                                                role="progressbar" 
                                                style="width: {{ demande.aiConfidenceLevel }}%" 
                                                aria-valuenow="{{ demande.aiConfidenceLevel }}" 
                                                aria-valuemin="0" 
                                                aria-valuemax="100">
                                            </div>
                                        </div>
                                        <strong>{{ demande.aiConfidenceLevel|round(0) }}%</strong>
                                    </div>
                                </div>
                            </div>

                            <!-- Fraude & Sentiment -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <h6 class="text-muted">Fraud type</h6>
                                    <p class="mb-0">
                                        {% if demande.aiFraudType == 'legitimate' %}
                                            <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Legitimate</span>
                                        {% elseif demande.aiFraudType == 'suspicious' %}
                                            <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle me-1"></i>Suspicious</span>
                                        {% else %}
                                            <span class="badge bg-danger"><i class="fas fa-ban me-1"></i>Spam</span>
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-muted">Sentiment</h6>
                                    <p class="mb-0">
                                        {% if demande.aiSentiment == 'positive' %}
                                            <span class="badge bg-success">😊 Positive</span>
                                        {% elseif demande.aiSentiment == 'negative' %}
                                            <span class="badge bg-danger">😞 Negative</span>
                                        {% else %}
                                            <span class="badge bg-secondary">😐 Neutral</span>
                                        {% endif %}
                                    </p>
                                </div>
                            </div>

                            <!-- Catégorie Suggérée -->
                            {% if demande.aiSuggestedRewardType %}
                            <div class="mb-3">
                                <h6 class="text-muted">Suggested reward category</h6>
                                <p class="mb-0">
                                    <span class="badge bg-primary">{{ demande.aiSuggestedRewardType }}</span>
                                </p>
                            </div>
                            {% endif %}

                            <!-- Points Clés -->
                            {% if demande.aiKeyPoints is not null and demande.aiKeyPoints|length > 0 %}
                            <div class="mb-3">
                                <h6 class="text-muted">Key points identified</h6>
                                <ul class="list-group list-group-flush">
                                    {% for point in demande.aiKeyPoints %}
                                    <li class="list-group-item bg-transparent border-0 ps-0">
                                        <i class="fas fa-arrow-right me-2" style="color: #6366f1;"></i>{{ point }}
                                    </li>
                                    {% endfor %}
                                </ul>
                            </div>
                            {% endif %}

                            <!-- Explication IA -->
                            {% if demande.aiAnalysisReason %}
                            <div class="mb-3">
                                <h6 class="text-muted">Analysis explanation</h6>
                                <div class="alert alert-info" role="alert">
                                    <p class="mb-0">{{ demande.aiAnalysisReason }}</p>
                                </div>
                            </div>
                            {% endif %}

                            <!-- Auto-Approbation -->
                            <div class="mb-0">
                                <h6 class="text-muted">Approval recommendation</h6>
                                <p class="mb-0">
                                    {% if demande.aiShouldAutoApprove %}
                                        <span class="badge bg-success" style="font-size: 0.9rem;">
                                            <i class="fas fa-lightbulb me-1"></i>
                                            AI recommends auto-approval
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary" style="font-size: 0.9rem;">
                                            <i class="fas fa-info-circle me-1"></i>
                                            Manual review recommended
                                        </span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                    {% else %}
                    <hr class="my-4">
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-robot me-2"></i>
                        <strong>AI analysis pending</strong> - No AI analysis available at the moment
                    </div>
                    {% endif %}

                    <div class="d-flex justify-content-between gap-2 mt-4">
                        <a href="{{ path('demande_recompense_index') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back to list
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
