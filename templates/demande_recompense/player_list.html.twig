{% extends 'base.html.twig' %}

{% block title %}My Reward Requests{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="fas fa-gift me-2"></i>My Reward Requests</h1>
                    <p class="text-muted">Manage your reward requests and track their status</p>
                </div>
                <a href="{{ path('recompense_index') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Request Reward
                </a>
            </div>

            <!-- Flash Messages -->
            {% if app.flashes %}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endif %}

            <!-- Empty State -->
            {% if demandes|length == 0 %}
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-inbox" style="font-size: 3rem; color: #ccc;"></i>
                    </div>
                    <h4>No reward requests yet</h4>
                    <p class="text-muted mb-4">You haven't requested any rewards yet. Start by browsing available rewards!</p>
                    <a href="{{ path('recompense_index') }}" class="btn btn-primary">
                        <i class="fas fa-gift me-2"></i>Browse Rewards
                    </a>
                </div>
            </div>

            <!-- Requests List -->
            {% else %}
            <div class="row">
                {% for demande in demandes %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <!-- Reward Info -->
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                {% if demande.recompense %}
                                    {{ demande.recompense.recompense }}
                                {% else %}
                                    Unknown Reward
                                {% endif %}
                            </h6>
                        </div>

                        <div class="card-body">
                            <!-- Status Badge -->
                            <div class="mb-3">
                                {% if demande.statut == 'en_attente' %}
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-clock me-1"></i>Pending
                                    </span>
                                {% elseif demande.statut == 'approuvee' %}
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle me-1"></i>Approved
                                    </span>
                                {% else %}
                                    <span class="badge bg-danger">
                                        <i class="fas fa-times-circle me-1"></i>Rejected
                                    </span>
                                {% endif %}
                            </div>

                            <!-- Details -->
                            <div class="mb-3">
                                <small class="text-muted d-block"><strong>Requested:</strong> {{ demande.dateDemande|date('d M Y') }}</small>
                                <small class="text-muted d-block"><strong>Type:</strong> {{ demande.recompense ? demande.recompense.type : 'N/A' }}</small>
                                {% if demande.aiLegitimacyScore %}
                                <small class="text-muted d-block">
                                    <strong>AI Score:</strong>
                                    {% if demande.aiLegitimacyScore >= 80 %}
                                        <span class="badge bg-success" title="Legitimacy score">{{ demande.aiLegitimacyScore }}/100</span>
                                    {% elseif demande.aiLegitimacyScore >= 60 %}
                                        <span class="badge bg-info" title="Legitimacy score">{{ demande.aiLegitimacyScore }}/100</span>
                                    {% elseif demande.aiLegitimacyScore >= 40 %}
                                        <span class="badge bg-warning" title="Legitimacy score">{{ demande.aiLegitimacyScore }}/100</span>
                                    {% else %}
                                        <span class="badge bg-danger" title="Legitimacy score">{{ demande.aiLegitimacyScore }}/100</span>
                                    {% endif %}
                                </small>
                                {% endif %}
                            </div>

                            <!-- Reason Preview -->
                            <p class="text-muted small mb-3" style="height: 60px; overflow: hidden;">
                                <em>{{ demande.motif|slice(0, 100) }}{% if demande.motif|length > 100 %}...{% endif %}</em>
                            </p>
                        </div>

                        <!-- Actions -->
                        <div class="card-footer bg-light">
                            <div class="d-flex gap-2">
                                <a href="{{ path('demande_recompense_show', {id: demande.id}) }}" class="btn btn-sm btn-primary flex-grow-1">
                                    <i class="fas fa-eye me-1"></i>View
                                </a>
                                {% if demande.statut == 'en_attente' %}
                                <button type="button" class="btn btn-sm btn-outline-secondary edit-btn" data-id="{{ demande.id }}" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger delete-btn" data-id="{{ demande.id }}" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            <!-- Pagination if needed -->
            {% if demandes.paginationData is defined %}
                <div class="d-flex justify-content-center mt-4">
                    {% if demandes.paginationData %}
                        <!-- Pagination controls would go here -->
                    {% endif %}
                </div>
            {% endif %}

            {% endif %}
        </div>
    </div>
</div>

<!-- Modal for Forms -->
<div class="modal fade" id="demandeFormModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div id="demandeFormContent"></div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle text-danger me-2"></i>Confirm deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this reward request? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || 
                      document.getElementById('csrfToken')?.value || '';
    
    let deleteId = null;

    // Edit button
    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            fetch(`{{ path('demande_recompense_modal_form') }}?action=edit&id=${id}`, {
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            })
            .then(r => r.json())
            .then(data => {
                if (data.html) {
                    document.getElementById('demandeFormContent').innerHTML = data.html;
                    new bootstrap.Modal(document.getElementById('demandeFormModal')).show();
                    setupFormHandlers();
                } else if (data.error) {
                    alert(data.error);
                }
            });
        });
    });

    // Delete button
    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            deleteId = this.getAttribute('data-id');
            new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
        });
    });

    // Confirm delete
    document.getElementById('confirmDeleteBtn')?.addEventListener('click', function() {
        if (!deleteId) return;
        
        fetch('{{ path('demande_recompense_modal_delete') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: `id=${deleteId}&_token=${csrfToken}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else if (data.error) {
                alert(data.error);
            }
        });
    });

    function setupFormHandlers() {
        const form = document.querySelector('#demandeFormContent form');
        if (!form) return;

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(form);
            
            fetch(form.getAttribute('action') || '{{ path('demande_recompense_modal_form') }}', {
                method: 'POST',
                body: formData,
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else if (data.errors) {
                    alert(data.errors.join('\n'));
                } else if (data.error) {
                    alert(data.error);
                }
            });
        });
    }
});
</script>
{% endblock %}
