{% extends 'base.html.twig' %}

{% block title %}Manager Requests - Admin Panel{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex align-items-center mb-4">
                <h1 class="mb-0">
                    <i class="fas fa-users-cog text-primary"></i> Manager Role Requests
                </h1>
            </div>

            {% if app.flashes %}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endif %}

            <!-- Pending Requests -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-hourglass-half"></i> Pending Requests ({{ pendingRequests|length }})
                    </h5>
                </div>
                <div class="card-body p-0">
                    {% if pendingRequests is empty %}
                        <p class="text-muted p-3 mb-0">No pending manager requests.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Player</th>
                                        <th>Team Name</th>
                                        <th>Requested On</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for request in pendingRequests %}
                                        <tr>
                                            <td>
                                                <strong>{{ request.player.username }}</strong>
                                                <br>
                                                <small class="text-muted">{{ request.player.email }}</small>
                                            </td>
                                            <td>
                                                {% if request.teamName %}
                                                    <span class="badge bg-info">{{ request.teamName }}</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">No team specified</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {{ request.createdAt|date('Y-m-d H:i') }}
                                            </td>
                                            <td>
                                                <a href="{{ path('admin_manager_review', {'id': request.id}) }}" class="btn btn-sm btn-primary">
                                                <i class="fas fa-eye"></i> Review
                                            </a>
                                                    <i class="fas fa-eye"></i> Review
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Recently Reviewed Requests -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-history"></i> Recently Reviewed Requests (Last 20)
                    </h5>
                </div>
                <div class="card-body p-0">
                    {% if reviewedRequests is empty %}
                        <p class="text-muted p-3 mb-0">No reviewed requests.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Player</th>
                                        <th>Status</th>
                                        <th>Reviewed By</th>
                                        <th>Reviewed On</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for request in reviewedRequests %}
                                        <tr>
                                            <td>
                                                <strong>{{ request.player.username }}</strong>
                                                <br>
                                                <small class="text-muted">{{ request.player.email }}</small>
                                            </td>
                                            <td>
                                                {% if request.status == 'approved' %}
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check-circle"></i> Approved
                                                    </span>
                                                {% else %}
                                                    <span class="badge bg-danger">
                                                        <i class="fas fa-times-circle"></i> Rejected
                                                    </span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if request.reviewedBy %}
                                                    {{ request.reviewedBy.email }}
                                                {% else %}
                                                    N/A
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if request.reviewedAt %}
                                                    {{ request.reviewedAt|date('Y-m-d H:i') }}
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if request.status == 'approved' %}
                                                <form method="POST" action="{{ path('admin_manager_revoke', {'id': request.id}) }}" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('revoke_' ~ request.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to revoke this manager role?')">
                                                        <i class="fas fa-ban"></i> Revoke
                                                    </button>
                                                </form>
                                            {% else %}
                                                <span class="text-muted small">No action</span>
                                            {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
