{% extends "base.html.twig" %}

{% block title %}Reclamation #{{ reclamation.id }} - Dev Esports{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Reclamation #{{ reclamation.id }}</h1>
        <div>
            <a href="{{ path('app_reclamation_edit', {'id': reclamation.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit
            </a>
            <form method="POST" action="{{ path('app_reclamation_delete', {'id': reclamation.id}) }}" style="display: inline;" onsubmit="return confirm('Delete this reclamation?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id) }}">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </form>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5>{{ reclamation.titre }}</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <h6 class="text-muted">Status</h6>
                    <p><span class="badge {% if reclamation.etat.value == 'EN_COURS' %}bg-warning{% elseif reclamation.etat.value == 'RESOLU' %}bg-success{% else %}bg-danger{% endif %}">{{ reclamation.etat.value|replace({'_': ' '}) }}</span></p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted">Type</h6>
                    <p>{{ reclamation.type.value|replace({'_': ' '}) }}</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-12">
                    <h6 class="text-muted">Description</h6>
                    <p>{{ reclamation.description }}</p>
                </div>
            </div>

            {% if reclamation.player %}
            <div class="row mb-3">
                <div class="col-md-6">
                    <h6 class="text-muted">Player</h6>
                    <p>{{ reclamation.player.nickname }}</p>
                </div>
            </div>
            {% endif %}

            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-muted">Created</h6>
                    <p>{{ reclamation.createdAt|date('d/m/Y H:i') }}</p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted">Updated</h6>
                    <p>{{ reclamation.updatedAt|date('d/m/Y H:i') }}</p>
                </div>
            </div>
        </div>
    </div>

    {% if reclamation.adminResponse %}
    <div class="card mb-4 border-success">
        <div class="card-header bg-success text-white">
            <h5>Admin Response</h5>
        </div>
        <div class="card-body">
            <p>{{ reclamation.adminResponse.message }}</p>
            <small class="text-muted">Responded: {{ reclamation.adminResponse.createdAt|date('d/m/Y H:i') }}</small>
        </div>
    </div>
    {% endif %}

    {% if reclamation.punition %}
    <div class="card mb-4 border-danger">
        <div class="card-header bg-danger text-white">
            <h5>Punishment Applied</h5>
        </div>
        <div class="card-body">
            <p><strong>Player Status:</strong> <span class="badge bg-danger">{{ reclamation.punition.playerStatus }}</span></p>
            <p><strong>From:</strong> {{ reclamation.punition.startAt|date('d/m/Y H:i') }}</p>
            <p><strong>To:</strong> {{ reclamation.punition.endAt|date('d/m/Y H:i') }}</p>
            <a href="{{ path('app_punition_show', {'id': reclamation.punition.id}) }}" class="btn btn-sm btn-danger">View Punishment</a>
        </div>
    </div>
    {% endif %}

    <a href="{{ path('app_reclamation_index') }}" class="btn btn-secondary">Back to List</a>
</div>
{% endblock %}
