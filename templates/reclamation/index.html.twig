{% extends "base.html.twig" %}

{% block title %}Reclamations - RankUp{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Reclamations</h1>
        <a href="{{ path('app_reclamation_new_player') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> New Reclamation
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% if reclamations|length > 0 %}
        <div class="row">
            {% for reclamation in reclamations %}
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-light">
                        <div class="d-flex justify-content-between align-items-start">
                            <div id="reclamation-{{ reclamation.id }}">
                                <h5 class="card-title mb-0">#{{ reclamation.id }} {{ reclamation.titre }}</h5>
                                <small class="text-muted">Created: {{ reclamation.createdAt|date('d/m/Y H:i') }}</small>
                            </div>
                            <span class="badge {% if reclamation.etat.value == 'EN_COURS' %}bg-warning{% elseif reclamation.etat.value == 'RESOLU' %}bg-success{% else %}bg-danger{% endif %}">
                                {{ reclamation.etat.value|replace({'_': ' '}) }}
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="card-text">{{ reclamation.description|slice(0, 200) }}{% if reclamation.description|length > 200 %}...{% endif %}</p>
                        <div class="row mb-2">
                            <div class="col-6">
                                <small class="text-muted"><strong>Type:</strong></small>
                                <p class="mb-0">{{ reclamation.type.value|replace({'_': ' '}) }}</p>
                            </div>
                            {% if reclamation.player %}
                            <div class="col-6">
                                <small class="text-muted"><strong>Player:</strong></small>
                                <p class="mb-0">{{ reclamation.player.nickname }}</p>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="{{ path('app_reclamation_show', {'id': reclamation.id}) }}" class="btn btn-sm btn-info">
                            <i class="fas fa-eye"></i> View
                        </a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_reclamation_edit', {'id': reclamation.id}) }}" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <form method="POST" action="{{ path('app_reclamation_delete', {'id': reclamation.id}) }}" style="display: inline;" onsubmit="return confirm('Delete this reclamation?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id) }}">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> No reclamations yet. <a href="{{ path('app_reclamation_new_player') }}">Create one</a>
        </div>
    {% endif %}
</div>
{% endblock %}
