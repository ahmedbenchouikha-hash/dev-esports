<script>
    (function () {
        const leaderboardButtons = document.querySelectorAll('.reclamation-leaderboard-btn');
        const leaderboardTotal = document.getElementById('leaderboard-total');
        const leaderboardEnCours = document.getElementById('leaderboard-en-cours');
        const leaderboardResolu = document.getElementById('leaderboard-resolu');
        const leaderboardRejete = document.getElementById('leaderboard-rejete');
        const reclamationItems = document.querySelectorAll('.reclamation-item');
        const emotionButtons = document.querySelectorAll('.emotion-analyze-btn');
        const filterEmpty = document.getElementById('reclamationFilterEmpty');
        let activeFilter = 'ALL';

        const updateLeaderboardValues = (stats) => {
            if (leaderboardTotal) leaderboardTotal.textContent = stats.total;
            if (leaderboardEnCours) leaderboardEnCours.textContent = stats.en_cours;
            if (leaderboardResolu) leaderboardResolu.textContent = stats.resolu;
            if (leaderboardRejete) leaderboardRejete.textContent = stats.rejete;
        };

        const applyLeaderboardFilter = () => {
            if (!reclamationItems.length) {
                return;
            }

            let visibleCount = 0;
            reclamationItems.forEach((item) => {
                const itemState = item.dataset.state;
                const shouldShow = activeFilter === 'ALL' || itemState === activeFilter;
                item.style.display = shouldShow ? '' : 'none';
                if (shouldShow) {
                    visibleCount++;
                }
            });

            if (filterEmpty) {
                filterEmpty.style.display = visibleCount === 0 ? '' : 'none';
            }
        };

        const refreshLeaderboardStats = async () => {
            try {
                const response = await fetch('{{ path('app_reclamation_leaderboard_stats') }}', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) {
                    return;
                }

                const data = await response.json();
                updateLeaderboardValues(data);
            } catch (error) {
            }
        };

        leaderboardButtons.forEach((button) => {
            button.addEventListener('click', () => {
                activeFilter = button.dataset.filter;
                leaderboardButtons.forEach((btn) => btn.classList.remove('active'));
                button.classList.add('active');
                applyLeaderboardFilter();
            });
        });

        window.addEventListener('reclamation-state-updated', (event) => {
            const detail = event.detail || {};
            if (detail.id && detail.state) {
                const card = document.querySelector('#reclamation-' + detail.id);
                const item = card ? card.closest('.reclamation-item') : null;
                if (item) {
                    item.dataset.state = detail.state;
                }
            }

            refreshLeaderboardStats();
            applyLeaderboardFilter();
        });

        applyLeaderboardFilter();
        setInterval(refreshLeaderboardStats, 10000);

        const urgencyClassMap = {
            high: 'emotion-urgency-high',
            medium: 'emotion-urgency-medium',
            low: 'emotion-urgency-low',
        };

        emotionButtons.forEach((button) => {
            button.addEventListener('click', async () => {
                const id = button.dataset.id;
                const url = button.dataset.url;
                const badge = document.getElementById('emotionStateBadge-' + id);
                const reason = document.getElementById('emotionReason-' + id);

                if (!id || !url || !badge || !reason) {
                    return;
                }

                const originalText = button.innerHTML;
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Analyse...';
                reason.textContent = '';

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        reason.textContent = data.error || 'Erreur lors de l\'analyse.';
                        return;
                    }

                    const emotionState = (data.emotion_state || 'neutral user').toString();
                    const urgency = (data.urgency || 'medium').toString().toLowerCase();
                    const shortReason = (data.short_reason || 'Analyse effectuée.').toString();

                    badge.textContent = emotionState;
                    badge.classList.remove('emotion-urgency-high', 'emotion-urgency-medium', 'emotion-urgency-low');
                    badge.classList.add(urgencyClassMap[urgency] || 'emotion-urgency-medium');
                    reason.textContent = shortReason;
                } catch (error) {
                    reason.textContent = 'Erreur réseau pendant l\'analyse émotionnelle.';
                } finally {
                    button.disabled = false;
                    button.innerHTML = originalText;
                }
            });
        });
    })();
</script>
