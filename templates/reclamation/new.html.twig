{% extends "base.html.twig" %}

{% block title %}New Reclamation - RankUp{% endblock %}

{% block body %}
<div class="container py-4">
    <h1>Create New Reclamation</h1>

    <div class="card mt-4">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.titre, 'Title') }}
                    {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.titre) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.description, 'Description') }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.attachment, 'Attachment') }}
                    {{ form_widget(form.attachment, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.attachment) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.player, 'Player') }}
                    {{ form_widget(form.player, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.player) }}
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save"></i> Create Reclamation
                    </button>
                    <a href="{{ path('app_reclamation_index') }}" class="btn btn-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
