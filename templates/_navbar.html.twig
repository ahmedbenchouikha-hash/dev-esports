<nav class="site-nav">
    <div class="nav-inner">
        <div class="brand">
            <a href="{{ path('app_home') }}">Esport<span class="accent">Dev</span></a>
        </div>

        <input id="nav-toggle" class="nav-toggle" type="checkbox" />
        <label for="nav-toggle" class="nav-toggle-label">☰</label>

        <ul class="nav-links">
            <li><a href="{{ path('app_home') }}">Home</a></li>
            <li><a href="{{ path('api_docs') }}">API Docs</a></li>
