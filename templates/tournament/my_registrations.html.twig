{% extends "base.html.twig" %}

{% block title %}My Tournament Registrations{% endblock %}

{% block body %}
<div class="tournament-registrations-container">
    <div class="registrations-header">
        <h1><i class="fas fa-ticket-alt"></i> My Tournament Registrations</h1>
        <p>Track your team's tournament participation status</p>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-circle"></i>
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">
            <i class="fas fa-times-circle"></i>
            {{ message }}
        </div>
    {% endfor %}

    <div class="registrations-content">
        <!-- Stats Section -->
        {% if registrations|length > 0 %}
            <div class="registration-stats">
                <div class="stat-card">
                    <div class="stat-icon pending">
                        <i class="fas fa-hourglass-half"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number">{{ pending_count }}</span>
                        <span class="stat-label">Pending</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon approved">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number">{{ approved_count }}</span>
                        <span class="stat-label">Approved</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon rejected">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number">{{ rejected_count }}</span>
                        <span class="stat-label">Rejected</span>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Tabs Navigation -->
        {% if registrations|length > 0 %}
            <div class="registrations-tabs">
                <button class="tab-button active" data-tab="all-tab">
                    <i class="fas fa-list"></i> All Registrations <span class="tab-badge">{{ registrations|length }}</span>
                </button>
                <button class="tab-button" data-tab="pending-tab">
                    <i class="fas fa-hourglass-half"></i> Pending <span class="tab-badge">{{ pending_count }}</span>
                </button>
                <button class="tab-button" data-tab="approved-tab">
                    <i class="fas fa-check-circle"></i> Approved <span class="tab-badge">{{ approved_count }}</span>
                </button>
                <button class="tab-button" data-tab="rejected-tab">
                    <i class="fas fa-times-circle"></i> Rejected <span class="tab-badge">{{ rejected_count }}</span>
                </button>
            </div>

            <!-- All Registrations Tab -->
            <div id="all-tab" class="tab-content active">
                <div class="registrations-list">
                    {% for registration in registrations %}
                        <div class="registration-card" data-status="{{ registration.status }}">
                            <div class="registration-header">
                                <div class="tournament-info">
                                    <h3>{{ registration.tournament.name }}</h3>
                                    <p class="team-name">
                                        <i class="fas fa-users"></i> {{ registration.teamName }}
                                    </p>
                                </div>
                                <span class="status-badge status-{{ registration.status|lower }}">
                                    <i class="fas fa-{% if registration.status == 'pending' %}hourglass-half{% elseif registration.status == 'approved' %}check-circle{% else %}times-circle{% endif %}"></i>
                                    {{ registration.status|capitalize }}
                                </span>
                            </div>

                            <div class="registration-body">
                                {% if registration.tournament.description %}
                                    <div class="tournament-description">
                                        <p>{{ registration.tournament.description }}</p>
                                    </div>
                                {% endif %}

                                <div class="registration-details">
                                    <div class="detail">
                                        <span class="label"><i class="fas fa-calendar"></i> Start Date:</span>
                                        <span class="value">{{ registration.tournament.startDate ? registration.tournament.startDate|date('M d, Y H:i') : 'N/A' }}</span>
                                    </div>

                                    <div class="detail">
                                        <span class="label"><i class="fas fa-envelope"></i> Contact:</span>
                                        <span class="value">{{ registration.contactEmail }}</span>
                                    </div>

                                    {% if registration.contactPhone %}
                                        <div class="detail">
                                            <span class="label"><i class="fas fa-phone"></i> Phone:</span>
                                            <span class="value">{{ registration.contactPhone }}</span>
                                        </div>
                                    {% endif %}

                                    <div class="detail">
                                        <span class="label"><i class="fas fa-clock"></i> Registered:</span>
                                        <span class="value">{{ registration.createdAt|date('M d, Y H:i') }}</span>
                                    </div>

                                    {% if registration.status == 'approved' and registration.reviewedAt %}
                                        <div class="detail">
                                            <span class="label"><i class="fas fa-check"></i> Approved Date:</span>
                                            <span class="value">{{ registration.reviewedAt|date('M d, Y H:i') }}</span>
                                        </div>
                                    {% endif %}
                                </div>

                                {% if registration.additionalInfo %}
                                    <div class="info-section">
                                        <h5><i class="fas fa-sticky-note"></i> Additional Notes</h5>
                                        <p>{{ registration.additionalInfo }}</p>
                                    </div>
                                {% endif %}

                                {% if registration.status == 'rejected' and registration.adminNotes %}
                                    <div class="rejection-reason">
                                        <h5><i class="fas fa-exclamation-triangle"></i> Rejection Reason</h5>
                                        <p>{{ registration.adminNotes }}</p>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="registration-footer">
                                <a href="{{ path('tournament_show', {id: registration.tournament.id}) }}" class="btn-link">
                                    <i class="fas fa-eye"></i> View Tournament
                                </a>
                                {% if registration.status == 'pending' %}
                                    <span class="status-info">
                                        <i class="fas fa-info-circle"></i> Waiting for admin approval
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Pending Registrations Tab -->
            <div id="pending-tab" class="tab-content">
                <div class="registrations-list">
                    {% set pending_regs = registrations|filter(reg => reg.status == 'pending') %}
                    {% if pending_regs|length > 0 %}
                        {% for registration in pending_regs %}
                            <div class="registration-card" data-status="pending">
                                <div class="registration-header">
                                    <div class="tournament-info">
                                        <h3>{{ registration.tournament.name }}</h3>
                                        <p class="team-name">
                                            <i class="fas fa-users"></i> {{ registration.teamName }}
                                        </p>
                                    </div>
                                    <span class="status-badge status-pending">
                                        <i class="fas fa-hourglass-half"></i> Pending
                                    </span>
                                </div>

                                <div class="registration-body">
                                    <div class="pending-message">
                                        <i class="fas fa-info-circle"></i>
                                        <p>Your registration is under review. The tournament admin will review your submission and notify you of the decision.</p>
                                    </div>

                                    <div class="registration-details">
                                        <div class="detail">
                                            <span class="label"><i class="fas fa-calendar"></i> Registered On:</span>
                                            <span class="value">{{ registration.createdAt|date('M d, Y H:i') }}</span>
                                        </div>
                                        <div class="detail">
                                            <span class="label"><i class="fas fa-envelope"></i> Contact Email:</span>
                                            <span class="value">{{ registration.contactEmail }}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="empty-state">
                            <i class="fas fa-check-circle"></i>
                            <p>No pending registrations</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Approved Registrations Tab -->
            <div id="approved-tab" class="tab-content">
                <div class="registrations-list">
                    {% set approved_regs = registrations|filter(reg => reg.status == 'approved') %}
                    {% if approved_regs|length > 0 %}
                        {% for registration in approved_regs %}
                            <div class="registration-card" data-status="approved">
                                <div class="registration-header">
                                    <div class="tournament-info">
                                        <h3>{{ registration.tournament.name }}</h3>
                                        <p class="team-name">
                                            <i class="fas fa-users"></i> {{ registration.teamName }}
                                        </p>
                                    </div>
                                    <span class="status-badge status-approved">
                                        <i class="fas fa-check-circle"></i> Approved
                                    </span>
                                </div>

                                <div class="registration-body">
                                    <div class="approved-message">
                                        <i class="fas fa-trophy"></i>
                                        <p>Congratulations! Your team has been approved for this tournament!</p>
                                    </div>

                                    <div class="registration-details">
                                        <div class="detail">
                                            <span class="label"><i class="fas fa-calendar"></i> Tournament Start:</span>
                                            <span class="value">{{ registration.tournament.startDate ? registration.tournament.startDate|date('M d, Y H:i') : 'N/A' }}</span>
                                        </div>
                                        <div class="detail">
                                            <span class="label"><i class="fas fa-check"></i> Approved On:</span>
                                            <span class="value">{{ registration.reviewedAt ? registration.reviewedAt|date('M d, Y H:i') : 'N/A' }}</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="registration-footer">
                                    <a href="{{ path('tournament_show', {id: registration.tournament.id}) }}" class="btn-link">
                                        <i class="fas fa-arrow-right"></i> View Tournament Details
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="empty-state">
                            <i class="fas fa-inbox"></i>
                            <p>No approved registrations yet</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Rejected Registrations Tab -->
            <div id="rejected-tab" class="tab-content">
                <div class="registrations-list">
                    {% set rejected_regs = registrations|filter(reg => reg.status == 'rejected') %}
                    {% if rejected_regs|length > 0 %}
                        {% for registration in rejected_regs %}
                            <div class="registration-card" data-status="rejected">
                                <div class="registration-header">
                                    <div class="tournament-info">
                                        <h3>{{ registration.tournament.name }}</h3>
                                        <p class="team-name">
                                            <i class="fas fa-users"></i> {{ registration.teamName }}
                                        </p>
                                    </div>
                                    <span class="status-badge status-rejected">
                                        <i class="fas fa-times-circle"></i> Rejected
                                    </span>
                                </div>

                                <div class="registration-body">
                                    {% if registration.adminNotes %}
                                        <div class="rejection-reason">
                                            <h5><i class="fas fa-comment"></i> Rejection Reason:</h5>
                                            <p>{{ registration.adminNotes }}</p>
                                        </div>
                                    {% else %}
                                        <div class="rejection-message">
                                            <i class="fas fa-times-circle"></i>
                                            <p>Your registration for this tournament was not approved.</p>
                                        </div>
                                    {% endif %}

                                    <div class="registration-details">
                                        <div class="detail">
                                            <span class="label"><i class="fas fa-calendar"></i> Submitted On:</span>
                                            <span class="value">{{ registration.createdAt|date('M d, Y H:i') }}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="empty-state">
                            <i class="fas fa-check-circle"></i>
                            <p>No rejected registrations</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="empty-state large">
                <div class="empty-icon">
                    <i class="fas fa-inbox"></i>
                </div>
                <h3>No Registrations Yet</h3>
                <p>You haven't registered for any tournaments yet.</p>
                <a href="{{ path('tournament_index') }}" class="btn-primary">
                    <i class="fas fa-search"></i> Browse Tournaments
                </a>
            </div>
        {% endif %}
    </div>

    <div class="registrations-footer">
        <a href="{{ path('player_dashboard') }}" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<style>
    .tournament-registrations-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .registrations-header {
        margin-bottom: 2rem;
        border-bottom: 2px solid var(--primary);
        padding-bottom: 1.5rem;
    }

    .registrations-header h1 {
        font-size: 2rem;
        color: var(--text-primary);
        margin: 0 0 0.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .registrations-header h1 i {
        color: var(--primary);
    }

    .registrations-header p {
        color: var(--text-secondary);
        margin: 0;
    }

    .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .alert-success {
        background: rgba(37, 211, 102, 0.1);
        border: 1px solid rgba(37, 211, 102, 0.3);
        color: #25d366;
    }

    .alert-warning {
        background: rgba(255, 193, 7, 0.1);
        border: 1px solid rgba(255, 193, 7, 0.3);
        color: #ffc107;
    }

    .alert-danger {
        background: rgba(255, 68, 68, 0.1);
        border: 1px solid rgba(255, 68, 68, 0.3);
        color: #ff4444;
    }

    .registrations-content {
        background: rgba(26, 40, 71, 0.5);
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .registration-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: rgba(26, 40, 71, 0.6);
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 10px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        border-color: var(--primary);
        box-shadow: 0 4px 15px rgba(0, 242, 254, 0.1);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .stat-icon.pending {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
    }

    .stat-icon.approved {
        background: rgba(37, 211, 102, 0.2);
        color: #25d366;
    }

    .stat-icon.rejected {
        background: rgba(255, 68, 68, 0.2);
        color: #ff4444;
    }

    .stat-info {
        display: flex;
        flex-direction: column;
    }

    .stat-number {
        font-size: 1.8rem;
        font-weight: bold;
        color: var(--text-primary);
    }

    .stat-label {
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    .registrations-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        border-bottom: 1px solid rgba(0, 242, 254, 0.2);
        padding-bottom: 1rem;
    }

    .tab-button {
        background: rgba(0, 242, 254, 0.05);
        border: 1px solid rgba(0, 242, 254, 0.2);
        color: var(--text-secondary);
        padding: 0.75rem 1.25rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .tab-button:hover {
        background: rgba(0, 242, 254, 0.1);
        border-color: var(--primary);
        color: var(--text-primary);
    }

    .tab-button.active {
        background: var(--primary);
        border-color: var(--primary);
        color: white;
    }

    .tab-badge {
        background: rgba(255, 255, 255, 0.2);
        padding: 0.2rem 0.6rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: bold;
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
    }

    .registrations-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .registration-card {
        background: rgba(26, 40, 71, 0.8);
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .registration-card:hover {
        border-color: var(--primary);
        box-shadow: 0 8px 25px rgba(0, 242, 254, 0.15);
        transform: translateY(-2px);
    }

    .registration-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 1.5rem;
        border-bottom: 1px solid rgba(0, 242, 254, 0.1);
        gap: 1rem;
    }

    .tournament-info h3 {
        color: var(--text-primary);
        margin: 0 0 0.5rem;
        font-size: 1.2rem;
    }

    .team-name {
        color: var(--primary);
        margin: 0;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .status-badge {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .status-pending {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .status-approved {
        background: rgba(37, 211, 102, 0.2);
        color: #25d366;
        border: 1px solid rgba(37, 211, 102, 0.3);
    }

    .status-rejected {
        background: rgba(255, 68, 68, 0.2);
        color: #ff4444;
        border: 1px solid rgba(255, 68, 68, 0.3);
    }

    .registration-body {
        padding: 1.5rem;
    }

    .tournament-description {
        background: rgba(0, 242, 254, 0.05);
        padding: 1rem;
        border-left: 3px solid var(--primary);
        border-radius: 6px;
        margin-bottom: 1.5rem;
    }

    .tournament-description p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    .registration-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .detail {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem;
        background: rgba(0, 242, 254, 0.05);
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .detail .label {
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
    }

    .detail .label i {
        color: var(--primary);
    }

    .detail .value {
        color: var(--text-primary);
    }

    .info-section {
        background: rgba(0, 242, 254, 0.05);
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1rem;
    }

    .info-section h5 {
        color: var(--primary);
        margin: 0 0 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-section p {
        margin: 0;
        color: var(--text-secondary);
    }

    .rejection-reason {
        background: rgba(255, 68, 68, 0.1);
        border: 1px solid rgba(255, 68, 68, 0.2);
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1rem;
    }

    .rejection-reason h5 {
        color: #ff6b6b;
        margin: 0 0 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .rejection-reason p {
        margin: 0;
        color: var(--text-secondary);
    }

    .pending-message,
    .approved-message,
    .rejection-message {
        background: rgba(0, 242, 254, 0.05);
        border-left: 4px solid var(--primary);
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .pending-message i {
        color: #ffc107;
        font-size: 1.2rem;
        flex-shrink: 0;
        margin-top: 0.2rem;
    }

    .approved-message {
        border-left-color: #25d366;
        background: rgba(37, 211, 102, 0.05);
    }

    .approved-message i {
        color: #25d366;
    }

    .rejection-message {
        border-left-color: #ff4444;
        background: rgba(255, 68, 68, 0.05);
    }

    .rejection-message i {
        color: #ff4444;
    }

    .registration-footer {
        padding: 1rem 1.5rem;
        background: rgba(0, 242, 254, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid rgba(0, 242, 254, 0.1);
    }

    .btn-link {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-link:hover {
        color: #25d366;
        transform: translateX(4px);
    }

    .status-info {
        color: var(--text-secondary);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: var(--text-secondary);
    }

    .empty-state.large {
        text-align: center;
        padding: 5rem 2rem;
    }

    .empty-icon {
        font-size: 3rem;
        color: var(--primary);
        margin-bottom: 1rem;
    }

    .empty-state h3 {
        color: var(--text-primary);
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .empty-state p {
        margin-bottom: 1.5rem;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: var(--primary);
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background: #00e6ff;
        box-shadow: 0 4px 15px rgba(0, 242, 254, 0.3);
        transform: translateY(-2px);
    }

    .registrations-footer {
        text-align: center;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: var(--secondary);
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: #00a8cc;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0, 168, 204, 0.3);
    }

    @media (max-width: 768px) {
        .registration-details {
            grid-template-columns: 1fr;
        }

        .registration-header {
            flex-direction: column;
        }

        .status-badge {
            align-self: flex-start;
        }

        .registrations-tabs {
            flex-direction: column;
        }

        .tab-button {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabContents = document.querySelectorAll('.tab-content');

    tabButtons.forEach(button => {
        button.addEventListener('click', function() {
            const tabId = this.getAttribute('data-tab');

            // Remove active class from all buttons and contents
            tabButtons.forEach(btn => btn.classList.remove('active'));
            tabContents.forEach(content => content.classList.remove('active'));

            // Add active class to clicked button and corresponding content
            this.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        });
    });
});
</script>
{% endblock %}
