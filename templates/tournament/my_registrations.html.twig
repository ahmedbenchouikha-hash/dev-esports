{% extends 'base.html.twig' %}

{% block title %}My Tournament Registrations{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">
                <i class="fas fa-list"></i> My Tournament Registrations
            </h1>

            {% if registrations is empty %}
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> 
                    You haven't registered for any tournaments yet. 
                    <a href="{{ path('tournament_available') }}" class="alert-link">Browse available tournaments</a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Tournament</th>
                                <th>Dates</th>
                                <th>Experience Level</th>
                                <th>Status</th>
                                <th>Registered</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for registration in registrations %}
                                <tr>
                                    <td>
                                        <strong>{{ registration.tournament.name }}</strong>
                                    </td>
                                    <td>
                                        <small>
                                            {{ registration.tournament.startDate|date('M d') }} - 
                                            {{ registration.tournament.endDate|date('M d, Y') }}
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">{{ registration.experienceLevel }}</span>
                                    </td>
                                    <td>
                                        {% if registration.isPending() %}
                                            <span class="badge bg-warning">
                                                <i class="fas fa-clock"></i> Pending
                                            </span>
                                        {% elseif registration.isApproved() %}
                                            <span class="badge bg-success">
                                                <i class="fas fa-check"></i> Approved
                                            </span>
                                        {% elseif registration.isRejected() %}
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times"></i> Rejected
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            {{ registration.createdAt|date('M d, Y') }}
                                        </small>
                                    </td>
                                    <td>
                                        <a href="{{ path('tournament_show', {id: registration.tournament.id}) }}" 
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="mt-4">
                    <a href="{{ path('tournament_available') }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Register for More Tournaments
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
