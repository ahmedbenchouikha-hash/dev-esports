{% extends 'base.html.twig' %}

{% block title %}Tournament Registrations - Admin{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3">
                    <i class="fas fa-clipboard-list"></i> All Tournament Registrations
                </h1>
                <a href="{{ path('tournament_index') }}" class="btn btn-outline-primary btn-sm">
                    ← Back to Tournaments
                </a>
            </div>
        </div>
    </div>

    {% if registrationsByTournament|length > 0 %}
        {% for tournamentId, data in registrationsByTournament %}
            <div class="card mb-4">
                <div class="card-header bg-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-trophy"></i>
                        {{ data.tournament.name }}
                        <span class="badge bg-info ms-2">{{ data.registrations|length }} registrations</span>
                    </h5>
                </div>
                <div class="card-body">
                    {% if data.registrations|length > 0 %}
                        <div class="row">
                            {% for registration in data.registrations %}
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100 border-left {% if registration.status == 'pending' %}border-warning{% elseif registration.status == 'approved' %}border-success{% else %}border-danger{% endif %}" style="border-left-width: 4px;">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <h6 class="card-title mb-0">{{ registration.teamName }}</h6>
                                                    <small class="text-muted">Registration #{{ registration.id }}</small>
                                                </div>
                                                <span class="badge 
                                                    {% if registration.status == 'pending' %}bg-warning
                                                    {% elseif registration.status == 'approved' %}bg-success
                                                    {% else %}bg-danger{% endif %}">
                                                    {{ registration.status|capitalize }}
                                                </span>
                                            </div>
                                            
                                            <div class="mb-3">
                                                <small class="text-muted d-block">
                                                    <i class="fas fa-envelope"></i> {{ registration.contactEmail }}
                                                </small>
                                                {% if registration.contactPhone %}
                                                    <small class="text-muted d-block">
                                                        <i class="fas fa-phone"></i> {{ registration.contactPhone }}
                                                    </small>
                                                {% endif %}
                                                <small class="text-muted d-block">
                                                    <i class="fas fa-calendar"></i> {{ registration.createdAt|date('M d, Y H:i')|default('Unknown') }}
                                                </small>
                                            </div>

                                            <a href="{{ path('tournament_admin_registration_show', {id: registration.id}) }}" class="btn btn-sm btn-primary w-100">
                                                <i class="fas fa-eye"></i> Review Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted mb-0">No registrations for this tournament.</p>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i>
            No tournament registrations yet.
        </div>
    {% endif %}
</div>

<style>
    .card {
        border: 1px solid rgba(0, 242, 254, 0.2);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        border-bottom: 2px solid rgba(0, 242, 254, 0.3);
    }

    .border-left {
        border-left: 4px solid;
    }
</style>
{% endblock %}
