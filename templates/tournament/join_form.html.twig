{% extends 'base.html.twig' %}

{% block title %}Join Tournament - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-trophy"></i> Join Tournament
                    </h3>
                </div>

                <div class="card-body">
                    <div class="alert alert-info mb-4">
                        <h5><strong>{{ tournament.name }}</strong></h5>
                        <p class="mb-0">
                            {% if tournament.description %}
                                {{ tournament.description }}
                            {% else %}
                                No description provided
                            {% endif %}
                        </p>
                        {% if tournament.startDate %}
                            <hr class="my-2">
                            <small class="text-muted">
                                <i class="fas fa-calendar"></i> Starts: {{ tournament.startDate|date('M d, Y H:i') }}
                            </small>
                        {% endif %}
                    </div>

                    <div class="mb-4 p-3 bg-light border rounded">
                        <h6 class="mb-3"><strong>Your Team Information</strong></h6>
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-1">
                                    <strong>Team Name:</strong><br>
                                    <span class="text-secondary">{{ team.name }}</span>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1">
                                    <strong>Players in Team:</strong><br>
                                    <span class="text-secondary">{{ team.teamMembers|length }}</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    {{ form_start(form, {
                        'attr': {
                            'class': 'needs-validation',
                            'novalidate': 'novalidate'
                        }
                    }) }}

                    <div class="mb-3">
                        {{ form_label(form.teamName, 'Team Name', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.teamName) }}
                        {{ form_errors(form.teamName, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.contactEmail, 'Contact Email', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.contactEmail) }}
                        {{ form_errors(form.contactEmail, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.additionalInfo, 'Additional Notes', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.additionalInfo) }}
                        <small class="form-text text-muted d-block mt-1">
                            <i class="fas fa-info-circle"></i> Optional: Add any relevant information about your team's participation
                        </small>
                        {{ form_errors(form.additionalInfo, {'attr': {'class': 'invalid-feedback d-block'}}) }} }}
                    </div>

                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-circle"></i>
                        <strong>Note:</strong> Your registration will be pending until it's approved by the tournament admin.
                    </div>

                    <div class="d-flex gap-2 justify-content-between">
                        <a href="{{ path('tournament_show', {'id': tournament.id}) }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Tournament
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-check"></i> Submit Registration
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form-control {
            border-radius: 0.375rem;
            padding: 0.6rem 0.75rem;
        }
        .form-control:readonly {
            background-color: #e9ecef;
            color: #495057;
        }
        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }
        .card-header {
            font-weight: 600;
            letter-spacing: 0.5px;
        }
        .btn {
            padding: 0.6rem 1.5rem;
            font-weight: 500;
        }
    </style>
{% endblock %}
