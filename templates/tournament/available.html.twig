{% extends 'base.html.twig' %}

{% block title %}Available Tournaments - Join Now{% endblock %}

{% block body %}
<div class="available-tournaments-container">
    <div class="tournaments-header">
        <h1><i class="fas fa-trophy"></i> Available Tournaments</h1>
        <p>Browse and join upcoming tournaments for your team</p>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-circle"></i>
            {{ message }}
        </div>
    {% endfor %}

    <div class="tournaments-content">
        {% if tournaments|length > 0 %}
            <div class="tournaments-grid">
                {% for tournament in tournaments %}
                    <div class="tournament-card">
                        <div class="card-header">
                            <h3>{{ tournament.name }}</h3>
                            <span class="status-badge">
                                {% set registration = registrationStatuses[tournament.id] %}
                                {% if registration %}
                                    {% if registration.isPending() %}
                                        <span class="badge-pending">
                                            <i class="fas fa-hourglass-half"></i> Pending
                                        </span>
                                    {% elseif registration.isApproved() %}
                                        <span class="badge-approved">
                                            <i class="fas fa-check-circle"></i> Approved
                                        </span>
                                    {% elseif registration.isRejected() %}
                                        <span class="badge-rejected">
                                            <i class="fas fa-times-circle"></i> Rejected
                                        </span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge-unregistered">
                                        <i class="fas fa-inbox"></i> Not Registered
                                    </span>
                                {% endif %}
                            </span>
                        </div>

                        <div class="card-body">
                            {% if tournament.description %}
                                <p class="tournament-description">{{ tournament.description }}</p>
                            {% endif %}

                            <div class="tournament-details">
                                <div class="detail-row">
                                    <span class="label"><i class="fas fa-calendar"></i> Start Date:</span>
                                    <span class="value">{{ tournament.startDate|date('M d, Y') }}</span>
                                </div>

                                {% if tournament.endDate %}
                                    <div class="detail-row">
                                        <span class="label"><i class="fas fa-calendar-check"></i> End Date:</span>
                                        <span class="value">{{ tournament.endDate|date('M d, Y') }}</span>
                                    </div>
                                {% endif %}

                                {% if tournament.prizePool %}
                                    <div class="detail-row">
                                        <span class="label"><i class="fas fa-trophy"></i> Prize Pool:</span>
                                        <span class="value prize">${{ tournament.prizePool|number_format(2) }}</span>
                                    </div>
                                {% endif %}

                                <div class="detail-row">
                                    <span class="label"><i class="fas fa-chart-pie"></i> Status:</span>
                                    <span class="value">
                                        {% if tournament.status == 'pending' %}
                                            <span class="status-text pending">Pending</span>
                                        {% elseif tournament.status == 'ongoing' %}
                                            <span class="status-text ongoing">Ongoing</span>
                                        {% elseif tournament.status == 'completed' %}
                                            <span class="status-text completed">Completed</span>
                                        {% else %}
                                            <span class="status-text cancelled">Cancelled</span>
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer">
                            {% set registration = registrationStatuses[tournament.id] %}
                            {% if registration %}
                                <!-- Already registered -->
                                <a href="{{ path('tournament_show', {id: tournament.id}) }}" class="btn-view">
                                    <i class="fas fa-eye"></i> View Details
                                </a>
                            {% else %}
                                <!-- Not registered yet -->
                                <a href="{{ path('tournament_join_form', {id: tournament.id}) }}" class="btn-join">
                                    <i class="fas fa-plus-circle"></i> Join Tournament
                                </a>
                            {% endif %}
                            <a href="{{ path('tournament_show', {id: tournament.id}) }}" class="btn-info-link">
                                <i class="fas fa-info-circle"></i> More Info
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-inbox"></i>
                </div>
                <h3>No Available Tournaments</h3>
                <p>There are currently no tournaments available. Please check back later!</p>
                <a href="{{ path('player_dashboard') }}" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        {% endif %}
    </div>

    {% if app.user and app.user.getTeam() %}
        <div class="registrations-link">
            <a href="{{ path('tournament_my_registrations') }}" class="btn-registrations">
                <i class="fas fa-list"></i> View Your Registrations
            </a>
        </div>
    {% endif %}
</div>

<style>
    .available-tournaments-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .tournaments-header {
        margin-bottom: 2rem;
        border-bottom: 2px solid var(--primary);
        padding-bottom: 1.5rem;
    }

    .tournaments-header h1 {
        font-size: 2rem;
        color: var(--text-primary);
        margin: 0 0 0.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .tournaments-header h1 i {
        color: var(--primary);
    }

    .tournaments-header p {
        color: var(--text-secondary);
        margin: 0;
    }

    .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .alert-success {
        background: rgba(37, 211, 102, 0.1);
        border: 1px solid rgba(37, 211, 102, 0.3);
        color: #25d366;
    }

    .alert-warning {
        background: rgba(255, 193, 7, 0.1);
        border: 1px solid rgba(255, 193, 7, 0.3);
        color: #ffc107;
    }

    .tournaments-content {
        background: rgba(26, 40, 71, 0.5);
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .tournaments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .tournament-card {
        background: rgba(26, 40, 71, 0.8);
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .tournament-card:hover {
        border-color: var(--primary);
        box-shadow: 0 8px 25px rgba(0, 242, 254, 0.15);
        transform: translateY(-4px);
    }

    .card-header {
        padding: 1.5rem;
        background: rgba(0, 242, 254, 0.05);
        border-bottom: 1px solid rgba(0, 242, 254, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }

    .card-header h3 {
        margin: 0;
        color: var(--text-primary);
        font-size: 1.2rem;
        flex: 1;
    }

    .status-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .badge-pending,
    .badge-approved,
    .badge-rejected,
    .badge-unregistered {
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        white-space: nowrap;
    }

    .badge-pending {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .badge-approved {
        background: rgba(37, 211, 102, 0.2);
        color: #25d366;
        border: 1px solid rgba(37, 211, 102, 0.3);
    }

    .badge-rejected {
        background: rgba(255, 68, 68, 0.2);
        color: #ff4444;
        border: 1px solid rgba(255, 68, 68, 0.3);
    }

    .badge-unregistered {
        background: rgba(100, 100, 100, 0.2);
        color: #999;
        border: 1px solid rgba(100, 100, 100, 0.3);
    }

    .card-body {
        padding: 1.5rem;
        flex: 1;
    }

    .tournament-description {
        color: var(--text-secondary);
        margin: 0 0 1rem;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .tournament-details {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem;
        background: rgba(0, 242, 254, 0.05);
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .detail-row .label {
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
    }

    .detail-row .label i {
        color: var(--primary);
    }

    .detail-row .value {
        color: var(--text-primary);
        font-weight: 600;
    }

    .detail-row .prize {
        color: #25d366;
        font-size: 1.05rem;
    }

    .status-text {
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .status-text.pending {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
    }

    .status-text.ongoing {
        background: rgba(37, 211, 102, 0.2);
        color: #25d366;
    }

    .status-text.completed {
        background: rgba(0, 168, 204, 0.2);
        color: #00a8cc;
    }

    .status-text.cancelled {
        background: rgba(255, 68, 68, 0.2);
        color: #ff4444;
    }

    .card-footer {
        padding: 1rem 1.5rem;
        background: rgba(0, 242, 254, 0.05);
        border-top: 1px solid rgba(0, 242, 254, 0.1);
        display: flex;
        gap: 0.75rem;
    }

    .btn-join,
    .btn-view,
    .btn-info-link {
        flex: 1;
        padding: 0.75rem;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

    .btn-join {
        background: linear-gradient(135deg, var(--primary), #00e6ff);
        color: white;
    }

    .btn-join:hover {
        box-shadow: 0 4px 15px rgba(0, 242, 254, 0.3);
        transform: translateY(-2px);
    }

    .btn-view {
        background: linear-gradient(135deg, #25d366, #00a853);
        color: white;
    }

    .btn-view:hover {
        box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
        transform: translateY(-2px);
    }

    .btn-info-link {
        background: rgba(0, 242, 254, 0.1);
        color: var(--primary);
        border: 1px solid rgba(0, 242, 254, 0.3);
    }

    .btn-info-link:hover {
        background: rgba(0, 242, 254, 0.2);
        transform: translateY(-2px);
    }

    .empty-state {
        text-align: center;
        padding: 5rem 2rem;
    }

    .empty-icon {
        font-size: 4rem;
        color: var(--primary);
        margin-bottom: 1rem;
    }

    .empty-state h3 {
        color: var(--text-primary);
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .empty-state p {
        color: var(--text-secondary);
        margin-bottom: 2rem;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: var(--secondary);
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: #00a8cc;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0, 168, 204, 0.3);
    }

    .registrations-link {
        text-align: center;
        padding: 2rem;
        background: rgba(0, 242, 254, 0.05);
        border: 1px dashed rgba(0, 242, 254, 0.3);
        border-radius: 12px;
    }

    .btn-registrations {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 2rem;
        background: var(--primary);
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-registrations:hover {
        background: #00e6ff;
        box-shadow: 0 4px 15px rgba(0, 242, 254, 0.3);
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .tournaments-grid {
            grid-template-columns: 1fr;
        }

        .card-header {
            flex-direction: column;
        }

        .status-badge {
            width: 100%;
            justify-content: flex-start;
        }

        .card-footer {
            flex-direction: column;
        }

        .btn-join,
        .btn-view,
        .btn-info-link {
            width: 100%;
        }
    }
</style>
{% endblock %}
