{% extends 'base.html.twig' %}

{% block title %}Tournaments - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <h1 class="page-title">🏆 Tournaments</h1>
    </div>
</div>

<!-- Search and Filter Section -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-6">
                        <input type="text" name="search" class="form-control" placeholder="Search by tournament name..." value="{{ search }}">
                    </div>
                    <div class="col-md-3">
                        <select name="status" class="form-select">
                            <option value="">All Status</option>
                            <option value="pending" {% if status == 'pending' %}selected{% endif %}>Pending</option>
                            <option value="ongoing" {% if status == 'ongoing' %}selected{% endif %}>Ongoing</option>
                            <option value="completed" {% if status == 'completed' %}selected{% endif %}>Completed</option>
                            <option value="cancelled" {% if status == 'cancelled' %}selected{% endif %}>Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">Search</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Tournaments List -->
<div class="row">
    {% if tournaments is empty %}
        <div class="col-md-12">
            <div class="alert alert-info">
                No tournaments found. <a href="{{ path('tournament_index') }}">Clear filters</a>
            </div>
        </div>
    {% else %}
        {% for tournament in tournaments %}
            <div class="col-lg-6 col-xl-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title">{{ tournament.name }}</h5>
                            <span class="badge {% if tournament.status == 'completed' %}badge-success{% elseif tournament.status == 'ongoing' %}badge-danger{% elseif tournament.status == 'pending' %}badge-warning{% else %}badge-secondary{% endif %}">
                                {{ tournament.status|capitalize }}
                            </span>
                        </div>
                        
                        {% if tournament.description %}
                            <p class="card-text" style="font-size: 0.9rem;">{{ tournament.description|slice(0, 100) }}{% if tournament.description|length > 100 %}...{% endif %}</p>
                        {% endif %}
                        
                        <div class="mb-3">
                            <small class="text-muted">
                                📅 {{ tournament.startDate|date('d M Y') }} to {{ tournament.endDate|date('d M Y') }}<br>
                                📍 {{ tournament.location ?? 'TBD' }}<br>
                                💰 {% if tournament.prizePool %}${{ tournament.prizePool|number_format(0) }}{% else %}Prize TBD{% endif %}<br>
                                🎮 {{ tournament.games|length }} Matches
                            </small>
                        </div>
                        
                        <a href="{{ path('tournament_show', { id: tournament.id }) }}" class="btn btn-primary w-100 btn-sm">View Tournament</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}
