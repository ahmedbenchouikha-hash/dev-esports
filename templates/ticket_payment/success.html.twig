{% extends 'base.html.twig' %}

{% block title %}Payment Successful - Dev Esports{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card text-center" style="border-color: var(--success)">
                <div class="card-body py-5">
                    <div style="font-size: 4rem; color: var(--success); margin-bottom: 20px;">
                        <i class="fas fa-check-circle"></i>
                    </div>

                    <h1 class="mb-3">Payment Successful!</h1>

                    <p class="lead mb-4" style="color: var(--text-secondary);">
                        Your ticket has been purchased successfully.
                    </p>

                    <div class="alert alert-info mb-4">
                        <strong>Confirmation Email:</strong><br>
                        A detailed confirmation and your e-ticket have been sent to your email address.
                    </div>

                    <div class="alert alert-warning mb-4">
                        <strong>Important:</strong><br>
                        Please keep your confirmation email safe. You'll need the ticket number to enter the event.
                    </div>

                    <div class="mb-4">
                        <a href="{% if app.request.get('ticket') %}/admin/ticket/{{ app.request.get('ticket') }}{% else %}/{% endif %}" class="btn btn-lg" style="background-color: var(--secondary); color: var(--bg-dark); font-weight: bold;">
                            <i class="fas fa-home"></i> Return Home
                        </a>
                    </div>

                    <small style="color: var(--text-muted);">
                        Need help? <a href="/contact" style="color: var(--secondary);">Contact Support</a>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
