{% extends 'base.html.twig' %}

{% block title %}Edit Budget - RankUp{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="page-title mb-4">✏️ Edit Budget</h1>

            <div class="card">
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'form', 'novalidate': true}}) }}
                    
                    <!-- Allocated Amount -->
                    <div class="mb-3">
                        {{ form_label(form.montantAlloue, 'Allocated Amount (€) *') }}
                        {{ form_widget(form.montantAlloue, {'attr': {'placeholder': '0.00', 'class': 'form-control'}}) }}
                        {% if form.montantAlloue.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.montantAlloue) }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Team -->
                    <div class="mb-3">
                        {{ form_label(form.team, 'Team *') }}
                        {{ form_widget(form.team, {'attr': {'class': 'form-control'}}) }}
                        {% if form.team.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.team) }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Notes -->
                    <div class="mb-3">
                        {{ form_label(form.notes, 'Notes') }}
                        {{ form_widget(form.notes, {'attr': {'placeholder': 'Add notes about this budget...', 'class': 'form-control', 'rows': 4}}) }}
                        {% if form.notes.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.notes) }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Status Info -->
                    <div class="mb-3">
                        <p><strong>Status:</strong> <span class="badge badge-{{ budget.statut == 'actif' ? 'success' : (budget.statut == 'dépassé' ? 'danger' : 'warning') }}">{{ budget.statut }}</span></p>
                    </div>

                    <!-- Submit Buttons -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                        <a href="{{ path('budget_show', {id: budget.id}) }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
