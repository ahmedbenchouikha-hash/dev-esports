{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="page-title mb-4">💰 Create Budget</h1>
            
            <!-- Flash Messages -->
            {% if app.flashes %}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endif %}

            <div class="card">
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'form', 'novalidate': true}}) }}
                    
                    <!-- Allocated Amount -->
                    <div class="mb-3">
                        {{ form_label(form.montantAlloue, 'Allocated Amount (€) *') }}
                        {{ form_widget(form.montantAlloue, {'attr': {'placeholder': '0.00', 'class': 'form-control'}}) }}
                        {% if form.montantAlloue.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.montantAlloue) }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Team -->
                    <div class="mb-3">
                        {{ form_label(form.team, 'Team *') }}
                        {{ form_widget(form.team, {'attr': {'class': 'form-control'}}) }}
                        {% if form.team.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.team) }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Notes -->
                    <div class="mb-3">
                        {{ form_label(form.notes, 'Notes') }}
                        {{ form_widget(form.notes, {'attr': {'placeholder': 'Add notes about this budget...', 'class': 'form-control', 'rows': 4}}) }}
                        {% if form.notes.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.notes) }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Submit Buttons -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Create Budget
                        </button>
                        <a href="{{ path('budget_index') }}" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
