{% extends 'base.html.twig' %}

{% block title %}Create Budget - RankUp{% endblock %}

{% block body %}
<div class="container mt-4" style="position: relative; z-index: 100;">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="page-title mb-4">💰 Create Budget</h1>

            <div class="card" style="position: relative; z-index: 100;">
                <div class="card-body">
                    {{ form_start(form) }}
                        
                        <!-- Allocated Amount -->
                        <div class="mb-3">
                            {{ form_label(form.montantAlloue, 'Allocated Amount (€) *') }}
                            {{ form_widget(form.montantAlloue, {'attr': {'placeholder': '0.00', 'class': 'form-control'}}) }}
                            {{ form_errors(form.montantAlloue) }}
                        </div>

                        <!-- Team -->
                        <div class="mb-3">
                            {{ form_label(form.team, 'Team *') }}
                            {{ form_widget(form.team, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.team) }}
                        </div>

                        <!-- Notes -->
                        <div class="mb-3">
                            {{ form_label(form.notes, 'Notes') }}
                            {{ form_widget(form.notes, {'attr': {'placeholder': 'Add notes about this budget...', 'class': 'form-control', 'rows': 4}}) }}
                            {{ form_errors(form.notes) }}
                        </div>

                        <!-- Justification Document Upload -->
                        <div class="mb-3">
                            {{ form_label(form.justificatifFile, 'Upload Justification Document (optional)') }}
                            {{ form_widget(form.justificatifFile, {'attr': {'class': 'form-control', 'accept': '.pdf,.jpg,.jpeg,.png,.gif'}}) }}
                            <small class="form-text text-muted">
                                Max 5MB. Accepted formats: PDF, JPG, PNG, GIF
                            </small>
                            {{ form_errors(form.justificatifFile) }}
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-save"></i> Create Budget
                            </button>
                            <a href="{{ path('budget_index') }}" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
