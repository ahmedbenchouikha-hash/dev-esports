{% extends 'base.html.twig' %}

{% block title %}Budget Alerts - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="page-title">🚨 Budget Alerts</h1>
            <a href="{{ path('budget_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>
</div>

<!-- Alerts -->
<div class="row">
    <div class="col-md-12">
        {% if alertes is empty %}
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> <strong>All Clear!</strong> No budget alerts at this time.
            </div>
        {% else %}
            <!-- Critical Alerts -->
            {% set critiques = alertes|filter(a => a.type == 'depassement') %}
            {% if critiques %}
                <div class="card border-danger mb-4">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">🔴 CRITICAL - Budgets Exceeded ({{ critiques|length }})</h5>
                    </div>
                    <div class="card-body">
                        {% for alerte in critiques %}
                            <div class="alert alert-danger mb-3">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6><strong>{{ alerte.budget.team.name }}</strong></h6>
                                        <p class="mb-0">
                                            <strong>Exceeded by:</strong> {{ alerte.montant_depasse|number_format(2, ',', ' ') }}€<br>
                                            <strong>Usage:</strong> {{ alerte.pourcentage|round(1) }}%
                                        </p>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <a href="{{ path('budget_show', {id: alerte.budget.id}) }}" class="btn btn-danger btn-sm">
                                            View Budget
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <!-- High Priority Alerts -->
            {% set haute = alertes|filter(a => a.severite == 'haute') %}
            {% if haute %}
                <div class="card border-warning mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">🟠 HIGH - Near Budget Limit ({{ haute|length }})</h5>
                    </div>
                    <div class="card-body">
                        {% for alerte in haute %}
                            <div class="alert alert-warning mb-3">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6><strong>{{ alerte.budget.team.name }}</strong></h6>
                                        <p class="mb-0">
                                            <strong>Usage:</strong> {{ alerte.pourcentage|round(1) }}%<br>
                                            <strong>Remaining:</strong> {{ alerte.budget.montantRestant|number_format(2, ',', ' ') }}€
                                        </p>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <a href="{{ path('budget_show', {id: alerte.budget.id}) }}" class="btn btn-warning btn-sm">
                                            View Budget
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <!-- Medium Priority Alerts -->
            {% set moyenne = alertes|filter(a => a.severite == 'moyenne') %}
            {% if moyenne %}
                <div class="card border-info mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">🟡 MEDIUM - Monitor ({{ moyenne|length }})</h5>
                    </div>
                    <div class="card-body">
                        {% for alerte in moyenne %}
                            <div class="alert alert-info mb-3">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6><strong>{{ alerte.budget.team.name }}</strong></h6>
                                        <p class="mb-0">
                                            <strong>Usage:</strong> {{ alerte.pourcentage|round(1) }}%<br>
                                            <strong>Remaining:</strong> {{ alerte.budget.montantRestant|number_format(2, ',', ' ') }}€
                                        </p>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <a href="{{ path('budget_show', {id: alerte.budget.id}) }}" class="btn btn-info btn-sm">
                                            View Budget
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
