{% extends 'base.html.twig' %}

{% block title %}Budget Details - Rankup{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="page-title">💰 Budget Details</h1>
                <div>
                    {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('budget_edit', {id: budget.id}) }}" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    {% endif %}
                    <a href="{{ path('budget_index') }}" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>

            <!-- Budget Summary Card -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">{{ budget.team.name }}</h5>
                </div>
                <div class="card-body">
                    <!-- Amount Info -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="text-muted">Allocated:</label>
                            <h4 class="text-primary">{{ budget.montantAlloue|number_format(2, ',', ' ') }}€</h4>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted">Used:</label>
                            <h4 class="text-warning">{{ budget.montantUtilise|number_format(2, ',', ' ') }}€</h4>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted">Remaining:</label>
                            {% if budget.montantRestant >= 0 %}
                                <h4 class="text-success">{{ budget.montantRestant|number_format(2, ',', ' ') }}€</h4>
                            {% else %}
                                <h4 class="text-danger">{{ budget.montantRestant|number_format(2, ',', ' ') }}€</h4>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label class="text-muted">Usage: {{ budget.pourcentageUtilisation }}%</label>
                            <div class="progress" style="height: 25px;">
                                {% set percentage = budget.pourcentageUtilisation %}
                                <div class="progress-bar {% if percentage > 100 %}bg-danger{% elseif percentage > 80 %}bg-warning{% else %}bg-success{% endif %}" role="progressbar" style="width: {% if percentage > 100 %}100{% else %}{{ percentage|round(1) }}{% endif %}%" aria-valuenow="{{ percentage }}" aria-valuemin="0" aria-valuemax="100">
                                    {{ percentage|round(1) }}%
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted">Status:</label>
                            {% if budget.statut == 'actif' %}
                                <p><span class="badge bg-success fs-6">Active</span></p>
                            {% elseif budget.statut == 'dépassé' %}
                                <p><span class="badge bg-danger fs-6">Exceeded</span></p>
                            {% else %}
                                <p><span class="badge bg-secondary fs-6">{{ budget.statut }}</span></p>
                            {% endif %}
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted">Created:</label>
                            <p>{{ budget.dateAllocation|date('d/m/Y H:i') }}</p>
                        </div>
                    </div>

                    <!-- Notes -->
                    {% if budget.notes %}
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="text-muted">Notes:</label>
                                <p>{{ budget.notes }}</p>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Alert if Exceeded -->
                    {% if budget.isDepassement() %}
                        <div class="alert alert-danger">
                            <strong>⚠️ Budget Exceeded!</strong><br>
                            This budget has been exceeded by {{ (budget.montantUtilise - budget.montantAlloue)|number_format(2, ',', ' ') }}€
                        </div>
                    {% elseif budget.pourcentageUtilisation > 80 %}
                        <div class="alert alert-warning">
                            <strong>⚡ Warning - High Usage</strong><br>
                            This budget is {{ budget.pourcentageUtilisation|round(1) }}% used. Only {{ budget.montantRestant|number_format(2, ',', ' ') }}€ remaining
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Related Expenses -->
            {% if depenses %}
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Related Approved Expenses</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Amount</th>
                                    <th>Category</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for depense in depenses %}
                                    <tr>
                                        <td><a href="{{ path('depense_show', {id: depense.id}) }}">{{ depense.titre }}</a></td>
                                        <td>{{ depense.montant|number_format(2, ',', ' ') }}€</td>
                                        <td>
                                            {% if depense.categorie == 'materiel' %}
                                                <span class="badge bg-info">Material</span>
                                            {% elseif depense.categorie == 'transport' %}
                                                <span class="badge bg-primary">Transport</span>
                                            {% elseif depense.categorie == 'logistique' %}
                                                <span class="badge bg-secondary">Logistics</span>
                                            {% elseif depense.categorie == 'nourriture' %}
                                                <span class="badge bg-success">Food</span>
                                            {% else %}
                                                <span class="badge bg-warning">Other</span>
                                            {% endif %}
                                        </td>
                                        <td><small class="text-muted">{{ depense.dateCreation|date('d/m/Y') }}</small></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}

            <!-- Delete Button -->
            {% if is_granted('ROLE_ADMIN') %}
            <div class="card">
                <div class="card-body">
                    <form method="POST" action="{{ path('budget_delete', {id: budget.id}) }}" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ budget.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete this budget? This action cannot be undone.')">
                            <i class="fas fa-trash"></i> Delete Budget
                        </button>
                    </form>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
