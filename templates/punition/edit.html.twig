{% extends "base.html.twig" %}

{% block title %}Edit Punishment #{{ punition.id }} - RankUp{% endblock %}

{% block body %}
<div class="container py-4">
    <h1>Edit Punishment #{{ punition.id }}</h1>

    <div class="card mt-4">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.startAt, 'Start Date') }}
                    {{ form_widget(form.startAt, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.startAt) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.endAt, 'End Date') }}
                    {{ form_widget(form.endAt, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.endAt) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.playerStatus, 'Player Status') }}
                    {{ form_widget(form.playerStatus, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.playerStatus) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.reclamation, 'Reclamation') }}
                    {{ form_widget(form.reclamation, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.reclamation) }}
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <a href="{{ path('app_punition_show', {'id': punition.id}) }}" class="btn btn-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
