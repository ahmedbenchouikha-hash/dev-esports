{% extends "base.html.twig" %}

{% block title %}Punishment #{{ punition.id }} - Dev Esports{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Punishment #{{ punition.id }}</h1>
        <div>
            <a href="{{ path('app_punition_edit', {'id': punition.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit
            </a>
            <form method="POST" action="{{ path('app_punition_delete', {'id': punition.id}) }}" style="display: inline;" onsubmit="return confirm('Delete this punishment?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ punition.id) }}">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <h6 class="text-muted">Start Date</h6>
                    <p>{{ punition.startAt|date('d/m/Y H:i') }}</p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted">End Date</h6>
                    <p>{{ punition.endAt|date('d/m/Y H:i') }}</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <h6 class="text-muted">Player Status</h6>
                    <p><span class="badge bg-danger">{{ punition.playerStatus }}</span></p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted">Related Player</h6>
                    <p>{{ punition.reclamation.player.nickname ?? 'N/A' }}</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <h6 class="text-muted">Reclamation</h6>
                    <p>
                        <a href="{{ path('app_reclamation_show', {'id': punition.reclamation.id}) }}">#{{ punition.reclamation.id }} - {{ punition.reclamation.titre }}</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <a href="{{ path('app_punition_index') }}" class="btn btn-secondary mt-3">Back to List</a>
</div>
{% endblock %}
