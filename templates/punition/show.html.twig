{% extends "base.html.twig" %}

{% block title %}Punishment Details - Dev Esports{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .module-show-shell {
            background: rgba(30, 41, 79, 0.72);
            border: 1px solid rgba(71, 85, 105, 0.55);
            border-radius: 14px;
            box-shadow: 0 12px 30px rgba(2, 6, 23, 0.35);
        }

        .module-show-subtitle {
            margin-top: 0.35rem;
            color: #94a3b8;
            font-size: 0.92rem;
        }

        .module-linked-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border-radius: 999px;
            padding: 0.34rem 0.72rem;
            font-size: 0.8rem;
            color: #cfe8ff;
            text-decoration: none;
            border: 1px solid rgba(125, 211, 252, 0.34);
            background: rgba(14, 116, 144, 0.28);
            margin-top: 0.75rem;
        }

        .module-linked-pill:hover {
            color: #ecfeff;
            border-color: rgba(125, 211, 252, 0.56);
        }

        .module-back-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            border-radius: 999px;
            border: 1px solid rgba(148, 163, 184, 0.45);
            background: rgba(30, 41, 59, 0.55);
            color: #cbd5e1;
            text-decoration: none;
            padding: 0.45rem 0.9rem;
            font-weight: 600;
        }

        .module-back-pill:hover {
            color: #e2e8f0;
            border-color: rgba(148, 163, 184, 0.7);
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">Punishment Details</h1>
            <p class="module-show-subtitle">Consultez les informations complètes de la sanction appliquée.</p>
        </div>
        <div>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_punition_edit', {'id': punition.id}) }}" class="crud-icon-btn crud-icon-btn-edit" title="Edit" aria-label="Edit">
                    <i class="fas fa-pen"></i>
                </a>
                <form method="POST" action="{{ path('app_punition_delete', {'id': punition.id}) }}" style="display: inline;" onsubmit="return confirm('Delete this punishment?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ punition.id) }}">
                    <button type="submit" class="crud-icon-btn crud-icon-btn-delete" title="Delete" aria-label="Delete">
                        <i class="fas fa-times"></i>
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="card module-show-shell">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <h6 class="text-muted">Start Date</h6>
                    <p>{{ punition.startAt|date('d/m/Y H:i') }}</p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted">End Date</h6>
                    <p>{{ punition.endAt|date('d/m/Y H:i') }}</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <h6 class="text-muted">Bans</h6>
                    {% include 'punition/_ban_chips.html.twig' with { banList: punition.banList, containerClass: 'd-flex flex-wrap gap-2' } only %}
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted">Related Player</h6>
                    <p>{{ punition.reclamation.player.nickname ?? 'N/A' }}</p>
                </div>
            </div>

        </div>
    </div>

    <a class="module-linked-pill" href="{{ path('app_reclamation_show', {'id': punition.reclamation.id}) }}">
        <i class="fas fa-link"></i>
        Réclamation liée: {{ punition.reclamation.titre }}
    </a>

    <div class="mt-3">
        <a href="{{ path('app_punition_index') }}" class="module-back-pill">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>
{% endblock %}
