{% extends "base.html.twig" %}

{% block title %}Punitions - RankUp{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .module-header-subtitle {
            margin-top: 0.35rem;
            color: #94a3b8;
            font-size: 0.92rem;
        }

        .module-table-shell {
            background: rgba(30, 41, 79, 0.72);
            border: 1px solid rgba(71, 85, 105, 0.55);
            border-radius: 14px;
            padding: 0.4rem;
            box-shadow: 0 12px 30px rgba(2, 6, 23, 0.35);
        }

        .module-table-shell table { margin-bottom: 0; }

        .punition-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 280px));
            gap: 1.9rem;
            justify-content: start;
        }

        .punition-leaderboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 0.9rem;
            margin-bottom: 1.25rem;
        }

        .punition-leaderboard-card {
            border: 1px solid rgba(148, 163, 184, 0.28);
            border-radius: 14px;
            background: linear-gradient(180deg, #1f2f53 0%, #1a2744 100%);
            color: #e2e8f0;
            padding: 0.8rem 0.95rem;
            box-shadow: 0 8px 16px rgba(2, 6, 23, 0.22);
            text-align: left;
            transition: transform 0.15s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

        button.punition-leaderboard-card {
            width: 100%;
            border: 1px solid rgba(148, 163, 184, 0.28);
            cursor: pointer;
        }

        .punition-leaderboard-card:hover {
            transform: translateY(-1px);
            border-color: rgba(125, 211, 252, 0.5);
        }

        .punition-leaderboard-card.active {
            border-color: rgba(125, 211, 252, 0.8);
            box-shadow: 0 0 0 1px rgba(125, 211, 252, 0.25), 0 10px 18px rgba(2, 6, 23, 0.28);
        }

        .punition-leaderboard-label {
            display: block;
            font-size: 0.79rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 700;
            opacity: 0.92;
            margin-bottom: 0.35rem;
        }

        .punition-leaderboard-value {
            font-size: 1.45rem;
            font-weight: 800;
            line-height: 1;
        }

        .punition-leaderboard-players .punition-leaderboard-value { color: #67e8f9; }
        .punition-leaderboard-game .punition-leaderboard-value { color: #22d3ee; }
        .punition-leaderboard-match .punition-leaderboard-value { color: #facc15; }
        .punition-leaderboard-tournament .punition-leaderboard-value { color: #fb7185; }

        .punition-card-shell {
            background: rgba(30, 41, 79, 0.72);
            border: 1px solid rgba(71, 85, 105, 0.55);
            border-radius: 14px;
            box-shadow: 0 12px 30px rgba(2, 6, 23, 0.35);
            padding: 0.72rem;
        }

        .punition-player-box {
            position: relative;
            width: 100%;
            border: 1px solid rgba(56, 189, 248, 0.45);
            background: linear-gradient(180deg, rgba(14, 116, 144, 0.35) 0%, rgba(14, 165, 233, 0.25) 100%);
            color: #e0f2fe;
            border-radius: 12px;
            padding: 0.72rem 0.82rem;
            text-align: left;
            font-size: 0.94rem;
            font-weight: 700;
            box-shadow: 0 8px 16px rgba(2, 6, 23, 0.25);
            transition: transform 0.15s ease, filter 0.2s ease, border-color 0.2s ease;
        }

        .punition-player-box-name {
            display: block;
            line-height: 1.2;
        }

        .punition-player-alert-badge {
            position: absolute;
            top: -0.45rem;
            left: -0.45rem;
            z-index: 2;
            font-size: 0.72rem;
            line-height: 1;
            padding: 0.35rem 0.42rem;
            border-radius: 999px;
        }

        .punition-player-box-multi-ban .punition-player-box-name {
            padding-left: 1.15rem;
        }

        .punition-player-box-hint {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            margin-top: 0.35rem;
            font-size: 0.74rem;
            color: #bae6fd;
            opacity: 0.9;
            font-weight: 600;
        }

        .punition-player-box:hover {
            transform: translateY(-1px);
            filter: brightness(1.05);
            border-color: rgba(125, 211, 252, 0.75);
        }

        .punition-bans-row {
            margin-top: 0.65rem;
        }

        .punition-modal-content {
            background: #16213d;
            border: 1px solid rgba(71, 85, 105, 0.6);
            border-radius: 14px;
        }

        .punition-modal-content .modal-header {
            border-bottom: 1px solid rgba(71, 85, 105, 0.45);
        }

        .punition-modal-content .modal-footer {
            border-top: 1px solid rgba(71, 85, 105, 0.45);
        }

        .punition-linked-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border-radius: 999px;
            padding: 0.34rem 0.72rem;
            font-size: 0.8rem;
            color: #cfe8ff;
            text-decoration: none;
            border: 1px solid rgba(125, 211, 252, 0.34);
            background: rgba(14, 116, 144, 0.28);
        }

        .punition-linked-pill:hover {
            color: #ecfeff;
            border-color: rgba(125, 211, 252, 0.56);
        }

        .punition-filter-empty {
            display: none;
            margin-top: 1rem;
        }

        .punition-voice-shell {
            background: rgba(30, 41, 79, 0.72);
            border: 1px solid rgba(71, 85, 105, 0.55);
            border-radius: 14px;
            box-shadow: 0 12px 30px rgba(2, 6, 23, 0.35);
        }

        .punition-ai-trigger {
            background: linear-gradient(180deg, #22d3ee 0%, #0891b2 100%);
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">Punitions</h1>
            <p class="module-header-subtitle">Suivez les sanctions appliquées avec un aperçu clair des décisions admin.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button
                type="button"
                class="crud-icon-btn punition-ai-trigger"
                title="Open AI Assistant"
                aria-label="Open AI Assistant"
                data-bs-toggle="modal"
                data-bs-target="#punitionVoiceModal"
            >
                <i class="fas fa-microphone"></i>
            </button>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_punition_new') }}" class="crud-icon-btn crud-icon-btn-add" title="Add Punishment" aria-label="Add Punishment">
                    <i class="fas fa-plus"></i>
                </a>
            {% endif %}
        </div>
    </div>

    <div class="modal fade" id="punitionVoiceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div
                class="modal-content punition-modal-content punition-voice-shell"
                data-controller="punition-voice"
                data-punition-voice-endpoint-value="{{ path('app_punition_voice_assistant') }}"
            >
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-microphone me-2"></i>Assistant Vocal IA</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button
                            type="button"
                            class="btn btn-outline-primary"
                            data-punition-voice-target="button"
                            data-action="click->punition-voice#toggle"
                        >
                            <i class="fas fa-microphone"></i> Assistant Vocal
                        </button>
                        <span class="text-muted" data-punition-voice-target="status">Assistant prêt.</span>
                    </div>

                    <div class="mt-3">
                        <small class="text-muted d-block mb-1">Vous avez dit :</small>
                        <div class="form-control" data-punition-voice-target="transcript" style="min-height: 40px;"></div>
                    </div>

                    <div class="mt-3">
                        <small class="text-muted d-block mb-1">Réponse IA :</small>
                        <div class="form-control" data-punition-voice-target="answer" style="min-height: 54px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% set bannedPlayersCount = punitions|length %}
    {% set bannedGameCount = 0 %}
    {% set bannedMatchCount = 0 %}
    {% set bannedTournamentCount = 0 %}

    {% for punition in punitions %}
        {% if 'banned from this game' in punition.banList %}
            {% set bannedGameCount = bannedGameCount + 1 %}
        {% endif %}
        {% if 'banned from this match' in punition.banList %}
            {% set bannedMatchCount = bannedMatchCount + 1 %}
        {% endif %}
        {% if 'banned from this tournament' in punition.banList %}
            {% set bannedTournamentCount = bannedTournamentCount + 1 %}
        {% endif %}
    {% endfor %}

    <div class="punition-leaderboard" id="punitionLeaderboard">
        <button type="button" class="punition-leaderboard-card punition-leaderboard-players active" data-filter="all">
            <span class="punition-leaderboard-label">Banned Players</span>
            <span class="punition-leaderboard-value" id="punitionLbPlayers">{{ bannedPlayersCount }}</span>
        </button>
        <button type="button" class="punition-leaderboard-card punition-leaderboard-game" data-filter="game">
            <span class="punition-leaderboard-label">Banned From Games</span>
            <span class="punition-leaderboard-value" id="punitionLbGame">{{ bannedGameCount }}</span>
        </button>
        <button type="button" class="punition-leaderboard-card punition-leaderboard-match" data-filter="match">
            <span class="punition-leaderboard-label">Banned From Match</span>
            <span class="punition-leaderboard-value" id="punitionLbMatch">{{ bannedMatchCount }}</span>
        </button>
        <button type="button" class="punition-leaderboard-card punition-leaderboard-tournament" data-filter="tournament">
            <span class="punition-leaderboard-label">Banned From Tournaments</span>
            <span class="punition-leaderboard-value" id="punitionLbTournament">{{ bannedTournamentCount }}</span>
        </button>
    </div>

    {% if punitions|length > 0 %}
        <div class="punition-grid" id="punitionGrid">
            {% for punition in punitions %}
                <div
                    class="punition-item"
                    data-has-game="{{ 'banned from this game' in punition.banList ? '1' : '0' }}"
                    data-has-match="{{ 'banned from this match' in punition.banList ? '1' : '0' }}"
                    data-has-tournament="{{ 'banned from this tournament' in punition.banList ? '1' : '0' }}"
                >
                <article class="punition-card-shell">
                    <button
                        type="button"
                        class="punition-player-box{% if punition.banList|length > 1 %} punition-player-box-multi-ban{% endif %}"
                        data-bs-toggle="modal"
                        data-bs-target="#punitionDetailsModal-{{ punition.id }}"
                    >
                        {% if punition.banList|length > 1 %}
                            <span class="badge text-bg-danger punition-player-alert-badge" title="Multiple bans" aria-label="Multiple bans">😡</span>
                        {% endif %}
                        <span class="punition-player-box-name">{{ punition.reclamation.player.nickname ?? 'N/A' }}</span>
                        <span class="punition-player-box-hint"><i class="fas fa-up-right-and-down-left-from-center"></i> Click to view details</span>
                    </button>

                    <div class="punition-bans-row">
                        {% include 'punition/_ban_chips.html.twig' with { banList: punition.banList, containerClass: 'd-flex flex-wrap gap-1' } only %}
                    </div>
                </article>

                <div class="modal fade" id="punitionDetailsModal-{{ punition.id }}" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content punition-modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Punition Details</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <small class="text-muted d-block">Start Date</small>
                                    <strong>{{ punition.startAt|date('d/m/Y H:i') }}</strong>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted d-block">End Date</small>
                                    <strong>{{ punition.endAt|date('d/m/Y H:i') }}</strong>
                                </div>

                                <a class="punition-linked-pill" href="{{ path('app_reclamation_show', {'id': punition.reclamation.id}) }}">
                                    <i class="fas fa-link"></i>
                                    Réclamation liée: {{ punition.reclamation.titre }}
                                </a>
                            </div>
                            <div class="modal-footer">
                                <a href="{{ path('app_punition_show', {'id': punition.id}) }}" class="crud-view-btn" title="View" aria-label="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_punition_edit', {'id': punition.id}) }}" class="crud-icon-btn crud-icon-btn-edit crud-icon-btn-sm" title="Edit" aria-label="Edit">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <form method="POST" action="{{ path('app_punition_delete', {'id': punition.id}) }}" style="display: inline;" onsubmit="return confirm('Delete this punishment?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ punition.id) }}">
                                        <button type="submit" class="crud-icon-btn crud-icon-btn-delete crud-icon-btn-sm" title="Delete" aria-label="Delete">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            {% endfor %}
        </div>
        <div class="alert alert-info punition-filter-empty" id="punitionFilterEmpty" role="alert">
            <i class="fas fa-filter"></i> No players match this leaderboard filter.
        </div>
    {% else %}
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> No punishments yet.
        </div>
    {% endif %}
</div>

<script>
    (function () {
        const playersEl = document.getElementById('punitionLbPlayers');
        const gameEl = document.getElementById('punitionLbGame');
        const matchEl = document.getElementById('punitionLbMatch');
        const tournamentEl = document.getElementById('punitionLbTournament');
        const leaderboardButtons = document.querySelectorAll('#punitionLeaderboard .punition-leaderboard-card');
        const punitionItems = document.querySelectorAll('.punition-item');
        const filterEmpty = document.getElementById('punitionFilterEmpty');
        let activeFilter = 'all';
        let previousStats = null;

        if (!playersEl || !gameEl || !matchEl || !tournamentEl) {
            return;
        }

        const applyFilter = () => {
            if (!punitionItems.length) {
                return;
            }

            let visibleCount = 0;

            punitionItems.forEach((item) => {
                let show = true;

                if (activeFilter === 'game') {
                    show = item.dataset.hasGame === '1';
                } else if (activeFilter === 'match') {
                    show = item.dataset.hasMatch === '1';
                } else if (activeFilter === 'tournament') {
                    show = item.dataset.hasTournament === '1';
                }

                item.style.display = show ? '' : 'none';
                if (show) {
                    visibleCount++;
                }
            });

            if (filterEmpty) {
                filterEmpty.style.display = visibleCount === 0 ? '' : 'none';
            }
        };

        const refreshLeaderboard = async () => {
            try {
                const response = await fetch('{{ path('app_punition_leaderboard_stats') }}', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) {
                    return;
                }

                const data = await response.json();
                const currentStats = {
                    banned_players: data.banned_players ?? 0,
                    banned_from_game: data.banned_from_game ?? 0,
                    banned_from_match: data.banned_from_match ?? 0,
                    banned_from_tournament: data.banned_from_tournament ?? 0,
                };

                if (previousStats !== null) {
                    const changed =
                        previousStats.banned_players !== currentStats.banned_players ||
                        previousStats.banned_from_game !== currentStats.banned_from_game ||
                        previousStats.banned_from_match !== currentStats.banned_from_match ||
                        previousStats.banned_from_tournament !== currentStats.banned_from_tournament;

                    if (changed) {
                        window.location.reload();
                        return;
                    }
                }

                previousStats = currentStats;
                playersEl.textContent = (data.banned_players ?? 0).toString();
                gameEl.textContent = (data.banned_from_game ?? 0).toString();
                matchEl.textContent = (data.banned_from_match ?? 0).toString();
                tournamentEl.textContent = (data.banned_from_tournament ?? 0).toString();
            } catch (error) {
            }
        };

        leaderboardButtons.forEach((button) => {
            button.addEventListener('click', () => {
                activeFilter = button.dataset.filter || 'all';
                leaderboardButtons.forEach((btn) => btn.classList.remove('active'));
                button.classList.add('active');
                applyFilter();
            });
        });

        refreshLeaderboard();
        applyFilter();
        setInterval(refreshLeaderboard, 7000);
    })();
</script>
{% endblock %}
