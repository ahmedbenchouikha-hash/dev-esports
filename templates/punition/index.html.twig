{% extends "base.html.twig" %}

{% block title %}Punitions - Dev Esports{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Punitions</h1>
        <a href="{{ path('app_punition_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> New Punishment
        </a>
    </div>

    {% if punitions|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Player</th>
                        <th>Reclamation</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for punition in punitions %}
                    <tr>
                        <td>#{{ punition.id }}</td>
                        <td>{{ punition.reclamation.player.nickname ?? 'N/A' }}</td>
                        <td>#{{ punition.reclamation.id }}</td>
                        <td>{{ punition.startAt|date('d/m/Y H:i') }}</td>
                        <td>{{ punition.endAt|date('d/m/Y H:i') }}</td>
                        <td><span class="badge bg-danger">{{ punition.playerStatus }}</span></td>
                        <td>
                            <a href="{{ path('app_punition_show', {'id': punition.id}) }}" class="btn btn-sm btn-info" title="View">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('app_punition_edit', {'id': punition.id}) }}" class="btn btn-sm btn-warning" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="POST" action="{{ path('app_punition_delete', {'id': punition.id}) }}" style="display: inline;" onsubmit="return confirm('Delete this punishment?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ punition.id) }}">
                                <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> No punishments yet.
        </div>
    {% endif %}
</div>
{% endblock %}
