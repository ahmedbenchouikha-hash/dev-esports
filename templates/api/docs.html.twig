{% extends 'base.html.twig' %}

{% block title %}JWT API Documentation{% endblock %}

{% block body %}
<div class="container" style="max-width: 900px; margin-top: 40px;">
    <div class="card" style="padding: 30px;">
        <h1 style="margin-bottom: 30px; color: #667eea;">JWT API Documentation</h1>
        
        <p style="font-size: 16px; color: #666; margin-bottom: 30px;">
            Your application now has JWT (JSON Web Token) authentication. Use these endpoints to authenticate and access the API.
        </p>

        <h2 style="color: #667eea; margin-top: 30px; margin-bottom: 15px;">Authentication Endpoints</h2>

        <!-- Login Endpoint -->
        <div style="background-color: #f5f5f5; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
            <h3 style="color: #333; margin-top: 0;">1. Login (Get JWT Token)</h3>
            <p><strong>Endpoint:</strong> <code>POST /api/login</code></p>
            <p><strong>Description:</strong> Sign in with your email and password to get a JWT token.</p>
            
            <h4>Request:</h4>
            <pre style="background-color: #fff; padding: 15px; border-left: 4px solid #667eea; overflow-x: auto;"><code>{
  "email": "user@example.com",
  "password": "your-password"
}</code></pre>

            <h4>Response (Success):</h4>
            <pre style="background-color: #fff; padding: 15px; border-left: 4px solid #10b981; overflow-x: auto;"><code>{
  "token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...",
  "user": {
    "id": 1,
    "username": "ghassen",
    "email": "user@example.com",
    "roles": ["ROLE_ADMIN"]
  }
}</code></pre>

            <h4>Response (Error):</h4>
            <pre style="background-color: #fff; padding: 15px; border-left: 4px solid #ef4444; overflow-x: auto;"><code>{
  "error": "Invalid credentials"
}</code></pre>
        </div>

        <!-- Validate Token Endpoint -->
        <div style="background-color: #f5f5f5; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
            <h3 style="color: #333; margin-top: 0;">2. Validate Token</h3>
            <p><strong>Endpoint:</strong> <code>POST /api/validate-token</code></p>
            <p><strong>Description:</strong> Check if a JWT token is valid and not expired.</p>
            
            <h4>Request:</h4>
            <pre style="background-color: #fff; padding: 15px; border-left: 4px solid #667eea; overflow-x: auto;"><code>{
  "token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
}</code></pre>

            <h4>Response (Valid):</h4>
            <pre style="background-color: #fff; padding: 15px; border-left: 4px solid #10b981; overflow-x: auto;"><code>{
  "valid": true,
  "payload": {
    "iat": 1707619200,
    "exp": 1707705600,
    "id": 1,
    "email": "user@example.com",
    "username": "ghassen",
    "roles": ["ROLE_ADMIN"]
  }
}</code></pre>
        </div>

        <!-- Get Current User Endpoint -->
        <div style="background-color: #f5f5f5; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
            <h3 style="color: #333; margin-top: 0;">3. Get Current User Info</h3>
            <p><strong>Endpoint:</strong> <code>GET /api/me</code></p>
            <p><strong>Description:</strong> Get information about the currently authenticated user.</p>
            
            <h4>Request:</h4>
            <pre style="background-color: #fff; padding: 15px; border-left: 4px solid #667eea; overflow-x: auto;"><code>Headers:
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...</code></pre>

            <h4>Response:</h4>
            <pre style="background-color: #fff; padding: 15px; border-left: 4px solid #10b981; overflow-x: auto;"><code>{
  "id": 1,
  "username": "ghassen",
  "email": "user@example.com",
  "roles": ["ROLE_ADMIN"]
}</code></pre>
        </div>

        <h2 style="color: #667eea; margin-top: 40px; margin-bottom: 15px;">How to Use</h2>
        <ol style="font-size: 16px; line-height: 1.8; color: #666;">
            <li><strong>Login:</strong> Send a POST request to <code>/api/login</code> with your email and password.
            <li><strong>Get Token:</strong> You'll receive a JWT token in the response. Store this securely.
            <li><strong>Use Token:</strong> Include the token in the Authorization header for authenticated requests: <code>Authorization: Bearer YOUR_TOKEN_HERE</code>
            <li><strong>Token Expiration:</strong> Tokens expire after 24 hours. Login again to get a new token.
        </ol>

        <h2 style="color: #667eea; margin-top: 40px; margin-bottom: 15px;">Example Usage (JavaScript)</h2>
        <pre style="background-color: #fff; padding: 20px; border-left: 4px solid #667eea; border-radius: 8px; overflow-x: auto;"><code>// Login
const response = await fetch('/api/login', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({
    email: 'user@example.com',
    password: 'password123'
  })
});

const data = await response.json();
const token = data.token;

// Use token in subsequent requests
const userResponse = await fetch('/api/me', {
  headers: { 'Authorization': `Bearer ${token}` }
});

const user = await userResponse.json();
console.log(user);</code></pre>

        <h2 style="color: #667eea; margin-top: 40px; margin-bottom: 15px;">Security Notes</h2>
        <ul style="font-size: 16px; line-height: 1.8; color: #666;">
            <li>Always use HTTPS in production to protect tokens in transit.
            <li>Store tokens securely on the client side (in memory or secure cookies).
            <li>Change the JWT_SECRET in your .env file to something unique and secure.
            <li>Never expose your JWT secret in client-side code or version control.
            <li>Tokens cannot be revoked before expiration. Consider implementing token blacklisting for logout.
        </ul>

        <div style="margin-top: 40px; padding: 20px; background-color: #e7f3ff; border-left: 4px solid #667eea; border-radius: 8px;">
            <p style="margin: 0; color: #334155;">
                <strong>Current JWT Secret:</strong> Set in environment variable <code>JWT_SECRET</code>
            </p>
        </div>
    </div>
</div>
{% endblock %}
