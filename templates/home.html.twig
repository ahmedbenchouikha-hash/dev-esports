{% extends 'base.html.twig' %}

{% block title %}RankUp - Home{% endblock %}

{% block body %}
<!-- Compact Hero -->
<section class="hero-section">
    <div class="hero-bg-effects">
        <div class="hero-image-layer"></div>
        <div class="hero-image-overlay"></div>
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
    </div>
    <div class="hero-content">
        <h1 class="hero-title">Welcome to <span class="hero-highlight">RankUp</span></h1>
        <p class="hero-subtitle">Organize tournaments, track matches, and manage your esports teams.</p>
        <div class="hero-actions">
            <a href="{{ path('match_index') }}" class="btn-hero-primary"><i class="fas fa-gamepad"></i> Matches</a>
            <a href="{{ path('tournament_index') }}" class="btn-hero-secondary"><i class="fas fa-trophy"></i> Tournaments</a>
            <a href="{{ path('team_index') }}" class="btn-hero-secondary"><i class="fas fa-users"></i> Teams</a>
            <a href="{{ path('match_upcoming') }}" class="btn-hero-secondary"><i class="fas fa-clock"></i> Upcoming</a>
        </div>
    </div>
</section>

<!-- Stats Strip -->
<section class="stats-strip">
    <div class="stat-chip">
        <i class="fas fa-gamepad"></i>
        <span class="stat-chip-num">{{ games_count ?? 0 }}</span>
        <span class="stat-chip-label">Matches</span>
    </div>
    <div class="stat-chip chip-tournaments">
        <i class="fas fa-trophy"></i>
        <span class="stat-chip-num">{{ tournaments_count ?? 0 }}</span>
        <span class="stat-chip-label">Tournaments</span>
    </div>
    <div class="stat-chip chip-teams">
        <i class="fas fa-users"></i>
        <span class="stat-chip-num">{{ teams_count ?? 0 }}</span>
        <span class="stat-chip-label">Teams</span>
    </div>
    <div class="stat-chip chip-players">
        <i class="fas fa-user-astronaut"></i>
        <span class="stat-chip-num">{{ players_count ?? 0 }}</span>
        <span class="stat-chip-label">Players</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat-chip chip-finished">
        <span class="stat-chip-num">{{ completed_games ?? 0 }}</span>
        <span class="stat-chip-label">Finished</span>
    </div>
    <div class="stat-chip chip-pending">
        <span class="stat-chip-num">{{ scheduled_games ?? 0 }}</span>
        <span class="stat-chip-label">Pending</span>
    </div>
    <div class="stat-chip chip-ongoing">
        <span class="stat-chip-num">{{ in_progress_games ?? 0 }}</span>
        <span class="stat-chip-label">Ongoing</span>
    </div>
</section>

<!-- Main Content: Two-Column Layout -->
<div class="home-grid">
    <!-- Left Column: Matches + Tournaments + Charts -->
    <div class="home-col-main">
        {% if recent_matches %}
        <section class="content-section">
            <div class="section-header-home">
                <h2><i class="fas fa-gamepad"></i> Recent Matches</h2>
                <a href="{{ path('match_index') }}" class="section-link">View All <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 table-compact">
                        <thead>
                            <tr>
                                <th>Match</th>
                                <th>Tournament</th>
                                <th>Score</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for match in recent_matches %}
                            <tr>
                                <td>
                                    {% if match.team1 and match.team2 %}
                                        <strong style="color: var(--text-primary); font-size: 0.78rem;">{{ match.team1.name }}</strong>
                                        <span style="color: var(--text-muted); margin: 0 0.2rem; font-size: 0.7rem;">vs</span>
                                        <strong style="color: var(--text-primary); font-size: 0.78rem;">{{ match.team2.name }}</strong>
                                    {% else %}
                                        Match #{{ match.id }}
                                    {% endif %}
                                </td>
                                <td>
                                    {% if match.tournament %}
                                        <span class="badge bg-info">{{ match.tournament.name }}</span>
                                    {% else %}
                                        <span class="text-muted">&mdash;</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if match.status == 'finished' %}
                                        <span style="color: #00ff9d; font-weight: 700; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">{{ match.score1 }} &mdash; {{ match.score2 }}</span>
                                    {% else %}
                                        <span class="text-muted">&mdash;</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if match.status == 'finished' %}
                                        <span class="badge badge-success">Finished</span>
                                    {% elseif match.status == 'pending' %}
                                        <span class="badge badge-warning">Pending</span>
                                    {% elseif match.status == 'ongoing' %}
                                        <span class="badge badge-info">Ongoing</span>
                                    {% else %}
                                        <span class="badge badge-danger">Cancelled</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('match_show', {id: match.id}) }}" class="btn btn-sm btn-outline-primary" style="font-size:0.7rem; padding:0.15rem 0.45rem;">View</a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
        {% endif %}

        {% if recent_tournaments %}
        <section class="content-section">
            <div class="section-header-home">
                <h2><i class="fas fa-trophy"></i> Featured Tournaments</h2>
                <a href="{{ path('tournament_index') }}" class="section-link">View All <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="tournament-grid">
                {% for tournament in recent_tournaments %}
                <a href="{{ path('tournament_show', {id: tournament.id}) }}" class="tournament-row-card">
                    <div class="tournament-row-info">
                        <h5>{{ tournament.name }}</h5>
                        <span class="tournament-row-desc">{{ tournament.description|slice(0, 80) }}{% if tournament.description|length > 80 %}...{% endif %}</span>
                    </div>
                    <div class="tournament-row-dates">
                        <span><i class="fas fa-calendar-alt"></i> {{ tournament.startDate ? tournament.startDate|date('d M') : 'TBD' }}</span>
                        <span><i class="fas fa-flag-checkered"></i> {{ tournament.endDate ? tournament.endDate|date('d M') : 'TBD' }}</span>
                    </div>
                    <i class="fas fa-chevron-right tournament-row-arrow"></i>
                </a>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        <!-- Charts Row -->
        <section class="content-section">
            <div class="section-header-home">
                <h2><i class="fas fa-chart-pie"></i> Analytics</h2>
            </div>
            <div class="charts-row">
                <div class="card chart-card">
                    <div class="card-body" style="padding: 1rem;">
                        <span class="chart-label">Match Status</span>
                        <div class="chart-wrapper"><canvas id="statusChart"></canvas></div>
                    </div>
                </div>
                {% if top_teams %}
                <div class="card chart-card">
                    <div class="card-body" style="padding: 1rem;">
                        <span class="chart-label">Top Teams</span>
                        <div class="chart-wrapper"><canvas id="teamsChart"></canvas></div>
                    </div>
                </div>
                {% endif %}
                {% if matches_by_tournament %}
                <div class="card chart-card">
                    <div class="card-body" style="padding: 1rem;">
                        <span class="chart-label">By Tournament</span>
                        <div class="chart-wrapper"><canvas id="tournamentsChart"></canvas></div>
                    </div>
                </div>
                {% endif %}
            </div>
        </section>
    </div>

    <!-- Right Column: Top Teams + Quick Browse -->
    <div class="home-col-side">
        {% if top_teams %}
        <section class="content-section">
            <div class="section-header-home">
                <h2><i class="fas fa-medal"></i> Top Teams</h2>
            </div>
            <div class="card">
                <div class="table-responsive">
                    <table class="table mb-0 table-compact">
                        <thead>
                            <tr>
                                <th style="width: 15%;">#</th>
                                <th>Team</th>
                                <th style="text-align: center;">Wins</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for teamName, wins in top_teams %}
                            <tr>
                                <td><span class="rank-badge rank-{{ loop.index }}">{{ loop.index }}</span></td>
                                <td style="color: var(--text-primary); font-weight: 600; font-size: 0.85rem;">{{ teamName }}</td>
                                <td style="text-align: center;"><span class="wins-badge">{{ wins }}</span></td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
        {% endif %}

        <section class="content-section">
            <div class="section-header-home">
                <h2><i class="fas fa-compass"></i> Quick Browse</h2>
            </div>
            <div class="browse-list">
                <a href="{{ path('match_index') }}" class="browse-item">
                    <span class="browse-item-icon"><i class="fas fa-gamepad"></i></span>
                    <span class="browse-item-text">All Matches</span>
                    <i class="fas fa-arrow-right browse-item-arrow"></i>
                </a>
                <a href="{{ path('tournament_index') }}" class="browse-item">
                    <span class="browse-item-icon tournaments"><i class="fas fa-trophy"></i></span>
                    <span class="browse-item-text">Tournaments</span>
                    <i class="fas fa-arrow-right browse-item-arrow"></i>
                </a>
                <a href="{{ path('team_index') }}" class="browse-item">
                    <span class="browse-item-icon teams"><i class="fas fa-users"></i></span>
                    <span class="browse-item-text">Teams</span>
                    <i class="fas fa-arrow-right browse-item-arrow"></i>
                </a>
                <a href="{{ path('match_upcoming') }}" class="browse-item">
                    <span class="browse-item-icon players"><i class="fas fa-clock"></i></span>
                    <span class="browse-item-text">Upcoming Matches</span>
                    <i class="fas fa-arrow-right browse-item-arrow"></i>
                </a>
            </div>
        </section>
    </div>
</div>

<style>
/* --- Hero (compact) --- */
.hero-section {
    position: relative;
    padding: 3.25rem 1.5rem 2.75rem;
    min-height: clamp(340px, 52vh, 520px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: -1.5rem;
}
.hero-bg-effects { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
.hero-image-layer {
    position: absolute;
    inset: 0;
    background-image: url('{{ asset('uploads/hero/esports-hero.jpg') }}');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    transform: scale(1.06);
    animation: heroCinematicMove 18s ease-in-out infinite alternate;
}
.hero-image-overlay {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(120deg, rgba(8, 11, 26, 0.84) 0%, rgba(8, 11, 26, 0.55) 45%, rgba(8, 11, 26, 0.72) 100%),
        radial-gradient(circle at 20% 30%, rgba(0, 242, 254, 0.2), transparent 45%),
        radial-gradient(circle at 80% 25%, rgba(0, 255, 157, 0.16), transparent 38%);
    animation: heroOverlayPulse 10s ease-in-out infinite;
}
.hero-orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.35; }
.hero-orb-1 { width: 300px; height: 300px; background: radial-gradient(circle, rgba(0,242,254,0.14), transparent 70%); top: -80px; left: 10%; animation: orbFloat 12s ease-in-out infinite; }
.hero-orb-2 { width: 250px; height: 250px; background: radial-gradient(circle, rgba(0,255,157,0.10), transparent 70%); bottom: -60px; right: 10%; animation: orbFloat 15s ease-in-out infinite reverse; }
@keyframes orbFloat { 0%,100%{transform:translate(0,0)} 33%{transform:translate(20px,-15px)} 66%{transform:translate(-15px,10px)} }
@keyframes heroCinematicMove {
    0% { transform: scale(1.06) translate3d(0, 0, 0); background-position: 50% 42%; }
    50% { transform: scale(1.1) translate3d(-0.8%, -0.6%, 0); background-position: 52% 48%; }
    100% { transform: scale(1.08) translate3d(0.8%, 0.6%, 0); background-position: 48% 54%; }
}
@keyframes heroOverlayPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.85; }
}

.hero-content { position: relative; z-index: 1; max-width: 620px; margin: 0 auto; }

.hero-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem) !important;
    font-weight: 800; color: var(--text-primary); -webkit-text-fill-color: var(--text-primary);
    background: none; margin-bottom: 0.5rem; line-height: 1.2;
}
.hero-title::after { display: none; }
.hero-highlight { background: linear-gradient(135deg, #00f2fe, #00ff9d); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }

.hero-subtitle { font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.5; }

.hero-actions { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; }

.btn-hero-primary {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.55rem 1.25rem; background: linear-gradient(135deg, #00f2fe, #00ff9d);
    color: #080b1a !important; text-decoration: none; border-radius: 10px;
    font-weight: 700; font-size: 0.85rem; transition: all 0.25s ease;
    box-shadow: 0 3px 12px rgba(0,242,254,0.2);
}
.btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,242,254,0.3); color: #080b1a !important; }

.btn-hero-secondary {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.55rem 1.25rem; background: transparent; color: var(--text-secondary) !important;
    text-decoration: none; border-radius: 10px; font-weight: 600; font-size: 0.85rem;
    border: 1.5px solid rgba(0,242,254,0.15); transition: all 0.25s ease;
}
.btn-hero-secondary:hover { border-color: rgba(0,242,254,0.4); color: #00f2fe !important; background: rgba(0,242,254,0.04); transform: translateY(-1px); }

/* --- Stats Strip --- */
.stats-strip {
    display: flex; align-items: center; justify-content: center;
    gap: 0.5rem; flex-wrap: wrap;
    padding: 0.75rem 1rem;
    margin: 0 0 1.5rem;
    background: rgba(22,27,53,0.4);
    border-top: 1px solid rgba(0,242,254,0.04);
    border-bottom: 1px solid rgba(0,242,254,0.04);
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
}
.stat-chip {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.3rem 0.65rem; border-radius: 8px;
    font-size: 0.78rem; color: #00f2fe;
    background: rgba(0,242,254,0.06);
}
.stat-chip i { font-size: 0.7rem; opacity: 0.7; }
.stat-chip-num { font-weight: 800; font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; color: var(--text-primary); }
.stat-chip-label { color: var(--text-muted); font-size: 0.72rem; font-weight: 500; }
.stat-chip.chip-tournaments { color: #ffc107; background: rgba(255,193,7,0.06); }
.stat-chip.chip-teams { color: #00ff9d; background: rgba(0,255,157,0.06); }
.stat-chip.chip-players { color: #8b5cf6; background: rgba(139,92,246,0.06); }
.stat-chip.chip-finished .stat-chip-num { color: #00ff9d; }
.stat-chip.chip-pending .stat-chip-num { color: #ffc107; }
.stat-chip.chip-ongoing .stat-chip-num { color: #00f2fe; }
.stat-divider { width: 1px; height: 20px; background: rgba(0,242,254,0.1); margin: 0 0.35rem; }

/* --- Two-Column Grid --- */
.home-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 1.5rem;
    align-items: start;
    max-width: 1200px;
    margin: 0 auto;
}
.home-col-main { min-width: 0; max-width: 100%; }
.home-col-side { min-width: 0; }

/* --- Sections (compact) --- */
.content-section { margin-bottom: 1.5rem; }

.section-header-home {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 0.75rem;
}
.section-header-home h2 {
    font-size: 1.05rem; margin: 0;
    display: flex; align-items: center; gap: 0.5rem;
}
.section-header-home h2::before { display: none; }
.section-header-home h2::after { display: none; }
.section-header-home h2 i { color: var(--primary); font-size: 0.9rem; }

.section-link {
    color: var(--text-muted) !important; text-decoration: none !important;
    font-size: 0.78rem; font-weight: 500;
    display: flex; align-items: center; gap: 0.3rem; transition: color 0.2s ease;
}
.section-link:hover { color: var(--primary) !important; }

/* --- Neutralize card hover on home page --- */
.home-grid .card,
.home-grid .card:hover {
    transform: none !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
}
.matches-card .table-responsive::-webkit-scrollbar { width: 4px; }
.matches-card .table-responsive::-webkit-scrollbar-track { background: transparent; }
.matches-card .table-responsive::-webkit-scrollbar-thumb { background: rgba(0,242,254,0.15); border-radius: 2px; }

/* --- Compact Tables --- */
.table-compact th { padding: 0.35rem 0.5rem; font-size: 0.7rem; }
.table-compact td { padding: 0.35rem 0.5rem; font-size: 0.78rem; line-height: 1.3; }
.table-compact .badge { font-size: 0.65rem; padding: 0.2rem 0.5rem; }
.table-compact .btn-sm { font-size: 0.7rem; padding: 0.15rem 0.5rem; }

/* --- Tournament Row Cards --- */
.tournament-grid { display: flex; flex-direction: column; gap: 0.5rem; }

.tournament-row-card {
    display: flex; align-items: center; gap: 1rem;
    padding: 0.75rem 1rem;
    background: rgba(22,27,53,0.5);
    border: 1px solid rgba(0,242,254,0.06);
    border-radius: 10px; text-decoration: none !important;
    transition: all 0.2s ease;
}
.tournament-row-card:hover {
    border-color: rgba(0,242,254,0.12);
    background: rgba(22,27,53,0.7);
    transform: translateX(3px);
}
.tournament-row-info { flex: 1; min-width: 0; }
.tournament-row-info h5 {
    margin: 0; font-size: 0.9rem; font-weight: 700;
    color: var(--primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    -webkit-text-fill-color: var(--primary);
}
.tournament-row-desc {
    font-size: 0.78rem; color: var(--text-muted);
    display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tournament-row-dates {
    display: flex; gap: 0.75rem; flex-shrink: 0;
    font-size: 0.75rem; color: var(--text-muted);
}
.tournament-row-dates i { color: rgba(0,242,254,0.4); margin-right: 0.25rem; }
.tournament-row-arrow { color: var(--text-muted); font-size: 0.7rem; opacity: 0; transition: all 0.2s ease; }
.tournament-row-card:hover .tournament-row-arrow { opacity: 1; color: var(--primary); }

/* --- Charts --- */
.charts-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
}
.chart-card { overflow: hidden; }
.chart-label {
    display: block; font-size: 0.75rem; font-weight: 600; color: var(--primary);
    margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.3px;
}
.chart-wrapper {
    position: relative;
    height: 160px;
    width: 100%;
}

/* --- Rank & Wins --- */
.rank-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; border-radius: 6px; font-weight: 700; font-size: 0.7rem;
    background: rgba(0,242,254,0.1); color: #00f2fe;
}
.rank-badge.rank-1 { background: rgba(255,215,0,0.12); color: #ffd700; }
.rank-badge.rank-2 { background: rgba(192,192,192,0.12); color: #c0c0c0; }
.rank-badge.rank-3 { background: rgba(205,127,50,0.12); color: #cd7f32; }

.wins-badge {
    display: inline-flex; padding: 0.2rem 0.55rem;
    background: rgba(0,255,157,0.1); color: #00ff9d; border-radius: 6px;
    font-weight: 700; font-size: 0.78rem; font-family: 'JetBrains Mono', monospace;
}

/* --- Browse List (sidebar) --- */
.browse-list { display: flex; flex-direction: column; gap: 0.4rem; }

.browse-item {
    display: flex; align-items: center; gap: 0.65rem;
    padding: 0.6rem 0.85rem;
    background: rgba(22,27,53,0.5); border: 1px solid rgba(0,242,254,0.06);
    border-radius: 10px; text-decoration: none !important; transition: all 0.2s ease;
}
.browse-item:hover {
    border-color: rgba(0,242,254,0.12); background: rgba(22,27,53,0.7);
    transform: translateX(3px);
}
.browse-item-icon {
    width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;
    border-radius: 8px; font-size: 0.85rem; flex-shrink: 0;
    background: rgba(0,242,254,0.08); color: #00f2fe;
}
.browse-item-icon.tournaments { background: rgba(255,193,7,0.08); color: #ffc107; }
.browse-item-icon.teams { background: rgba(0,255,157,0.08); color: #00ff9d; }
.browse-item-icon.players { background: rgba(139,92,246,0.08); color: #8b5cf6; }

.browse-item-text { flex: 1; color: var(--text-primary); font-size: 0.85rem; font-weight: 600; }
.browse-item-arrow { color: var(--text-muted); font-size: 0.7rem; opacity: 0; transition: all 0.2s ease; }
.browse-item:hover .browse-item-arrow { opacity: 1; color: var(--primary); }

/* --- Responsive --- */
@media (max-width: 992px) {
    .home-grid { grid-template-columns: 1fr; }
    .home-col-side { order: -1; }
    .stats-strip { gap: 0.4rem; }
}
@media (max-width: 576px) {
    .hero-section { padding: 2rem 1rem 1.6rem; min-height: 300px; }
    .hero-image-layer { opacity: 0.32; }
    .hero-title { font-size: 1.5rem !important; }
    .hero-actions { gap: 0.4rem; }
    .btn-hero-primary, .btn-hero-secondary { padding: 0.45rem 0.9rem; font-size: 0.8rem; }
    .stats-strip { padding: 0.5rem; }
    .stat-chip { padding: 0.2rem 0.5rem; font-size: 0.72rem; }
    .tournament-row-dates { display: none; }
    .charts-row { grid-template-columns: 1fr; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    Chart.defaults.color = '#7b84a8';
    Chart.defaults.borderColor = 'rgba(0,242,254,0.04)';
    Chart.defaults.font.family = 'Inter, sans-serif';
    Chart.defaults.font.size = 11;

    const statusCtx = document.getElementById('statusChart');
    if (statusCtx) {
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Finished', 'Pending', 'Ongoing', 'Cancelled'],
                datasets: [{
                    data: [{{ completed_games }}, {{ scheduled_games }}, {{ in_progress_games }}, {{ games_count - completed_games - scheduled_games - in_progress_games }}],
                    backgroundColor: ['#00ff9d', '#ffc107', '#00f2fe', '#ff4757'],
                    borderColor: '#080b1a', borderWidth: 2, borderRadius: 3
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '60%',
                plugins: { legend: { display: false } }
            }
        });
    }

    const teamsCtx = document.getElementById('teamsChart');
    if (teamsCtx) {
        const teamNames = {{ team_names_chart|raw }};
        const winsData = {{ wins_chart|raw }};
        if (teamNames && teamNames.length > 0) {
            new Chart(teamsCtx, {
                type: 'bar',
                data: {
                    labels: teamNames,
                    datasets: [{ label: 'Wins', data: winsData,
                        backgroundColor: ['rgba(0,242,254,0.6)','rgba(0,255,157,0.6)','rgba(255,193,7,0.6)','rgba(139,92,246,0.6)','rgba(0,242,254,0.4)'],
                        borderRadius: 4, borderSkipped: false }]
                },
                options: {
                    indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, grid: { color: 'rgba(0,242,254,0.04)' }, ticks: { stepSize: 1, font: { size: 10 } } },
                        y: { grid: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });
        }
    }

    const tourCtx = document.getElementById('tournamentsChart');
    if (tourCtx) {
        const tData = {{ matches_by_tournament|json_encode|raw }};
        if (tData && Object.keys(tData).length > 0) {
            new Chart(tourCtx, {
                type: 'bar',
                data: {
                    labels: Object.keys(tData),
                    datasets: [{ label: 'Matches', data: Object.values(tData),
                        backgroundColor: 'rgba(0,242,254,0.5)', borderRadius: 4, borderSkipped: false }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(0,242,254,0.04)' }, ticks: { stepSize: 1, font: { size: 10 } } },
                        x: { grid: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });
        }
    }
});
</script>
{% endblock %}
