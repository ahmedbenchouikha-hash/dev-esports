{% extends "base.html.twig" %}

{% block title %}Player Dashboard - Dev Esports{% endblock %}

{% block body %}
<div class="player-dashboard">
    <!-- Welcome Header -->
    <div class="welcome-section">
        <div class="welcome-content">
            <div class="welcome-text">
                <h1>Welcome, <span class="player-name">{{ player.nickname }}</span>! 👋</h1>
                <p class="subtitle">Manage your team and profile</p>
            </div>
            <div class="welcome-avatar">
                <div class="avatar-circle">
                    <i class="fas fa-user-circle"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Current Team Section -->
    {% if currentTeam %}
        <div class="team-section current-team-card">
            <div class="section-header">
                <i class="fas fa-shield-alt"></i>
                <h2>Your Current Team</h2>
            </div>
            
            <div class="team-card-content">
                {% if currentTeam.logo %}
                    <div style="flex: 0 0 150px; height: 100px; background: linear-gradient(135deg, rgba(26, 40, 71, 0.8), rgba(26, 40, 71, 0.6)); display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 8px; border: 1px solid rgba(0, 242, 254, 0.15); margin-right: 1.5rem; padding: 0.5rem;">
                        <img src="{{ asset('uploads/logos/' ~ currentTeam.logo) }}" alt="{{ currentTeam.name }} logo" style="max-width: 100%; max-height: 100%; object-fit: contain; width: auto;">
                    </div>
                {% else %}
                    <div style="flex: 0 0 150px; height: 100px; background: linear-gradient(135deg, rgba(0, 242, 254, 0.1), rgba(37, 211, 102, 0.1)); display: flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid rgba(0, 242, 254, 0.15); margin-right: 1.5rem;">
                        <i class="fas fa-image" style="font-size: 2rem; color: rgba(0, 242, 254, 0.3);"></i>
                    </div>
                {% endif %}
                <div class="team-info">
                    <div class="team-header-info">
                        <h3>{{ currentTeam.name }}</h3>
                        <span class="team-badge">
                            <i class="fas fa-check-circle"></i> Active Player
                        </span>
                    </div>
                    
                    <div class="team-details">
                        <div class="detail-item">
                            <i class="fas fa-bar-chart-o"></i>
                            <strong>Ranking:</strong>
                            <span>{{ currentTeam.ranking ?? 'N/A' }}</span>
                        </div>
                        <div class="detail-item">
                            <i class="fas fa-users"></i>
                            <strong>Team Members:</strong>
                            <span>{{ currentTeam.players|length }}</span>
                        </div>
                        <div class="detail-item">
                            <i class="fas fa-trophy"></i>
                            <strong>Status:</strong>
                            <span class="status-active">Active</span>
                        </div>
                    </div>
                </div>

                <div class="team-actions">
                    <form method="POST" action="{{ path('player_leave_team') }}" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('leave_team') }}">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to leave this team?')">
                            <i class="fas fa-sign-out-alt"></i> Leave Team
                        </button>
                    </form>
                </div>
            </div>
        </div>
    {% else %}
        <div class="team-section no-team-card">
            <div class="section-header">
                <i class="fas fa-info-circle"></i>
                <h2>No Team Yet</h2>
            </div>
            <p class="no-team-message">You are not currently part of any team. Join one below to get started!</p>
        </div>
    {% endif %}

    <!-- Team Invitations Section -->
    {% if pendingInvitations|length > 0 %}
        <div class="team-section invitations-section">
            <div class="section-header">
                <i class="fas fa-envelope"></i>
                <h2>Team Invitations</h2>
                <span class="team-count" style="background-color: #ff6b6b;">{{ pendingInvitations|length }} pending</span>
            </div>

            <div class="row">
                {% for invitation in pendingInvitations %}
                    <div class="col-md-6 mb-3">
                        <div class="card border-primary">
                            {% if invitation.team.logo %}
                                <div style="height: 100px; background: linear-gradient(135deg, rgba(26, 40, 71, 0.8), rgba(26, 40, 71, 0.6)); display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid rgba(0, 242, 254, 0.15); padding: 0.5rem;">
                                    <img src="{{ asset('uploads/logos/' ~ invitation.team.logo) }}" alt="{{ invitation.team.name }} logo" style="max-width: 100%; max-height: 100%; object-fit: contain; width: auto;">
                                </div>
                            {% endif %}
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="fas fa-handshake"></i> Invitation from <strong>{{ invitation.team.name }}</strong>
                                </h5>
                            </div>
                            <div class="card-body">
                                <p class="mb-2">
                                    <strong>Team Manager:</strong> Team needs players!
                                </p>
                                <p class="mb-2">
                                    <small class="text-muted">
                                        <i class="fas fa-calendar"></i> Invited on: {{ invitation.createdAt|date('d M Y H:i') }}
                                    </small>
                                </p>
                                
                                {% if invitation.team.description %}
                                    <p class="mb-3">
                                        <small><strong>About Team:</strong><br>{{ invitation.team.description|slice(0, 150) }}{% if invitation.team.description|length > 150 %}...{% endif %}</small>
                                    </p>
                                {% endif %}

                                <div class="mb-2">
                                    <small class="text-muted">
                                        <i class="fas fa-users"></i> Team Members: {{ invitation.team.players|length }}/5
                                    </small>
                                </div>

                                <hr>

                                <div class="d-flex gap-2">
                                    <form method="POST" action="{{ path('team_invitation_accept', { id: invitation.id }) }}" style="flex: 1;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('team_invitation_' ~ invitation.id) }}">
                                        <button type="submit" class="btn btn-success w-100 btn-sm">
                                            <i class="fas fa-check-circle"></i> Accept
                                        </button>
                                    </form>
                                    <form method="POST" action="{{ path('team_invitation_reject', { id: invitation.id }) }}" style="flex: 1;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('team_invitation_' ~ invitation.id) }}">
                                        <button type="submit" class="btn btn-danger w-100 btn-sm">
                                            <i class="fas fa-times-circle"></i> Decline
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <!-- Manager Section -->
    <div class="team-section manager-section">
        <div class="section-header">
            <i class="fas fa-crown"></i>
            <h2>Management</h2>
        </div>

        {% if is_granted('ROLE_MANAGER') %}
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <strong>You are a Manager!</strong> You can now create and manage teams and budgets.
                <div class="mt-3">
                    <a href="{{ path('team_new') }}" class="btn btn-primary me-2">
                        <i class="fas fa-plus"></i> Create Team
                    </a>
                    <a href="{{ path('player_manager_status') }}" class="btn btn-secondary">
                        <i class="fas fa-history"></i> View Manager Applications
                    </a>
                </div>
            </div>
        {% else %}
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="fas fa-crown text-warning"></i> Become a Manager
                    </h5>
                    <p class="card-text text-muted">
                        Ready to lead? Apply for the manager role to create and manage your own teams, handle budgets, and take your competitive career to the next level.
                    </p>
                    <div class="mt-3">
                        <a href="{{ path('player_manager_request') }}" class="btn btn-warning">
                            <i class="fas fa-paper-plane"></i> Apply for Manager Role
                        </a>
                        <a href="{{ path('player_manager_status') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-info-circle"></i> Check Application Status
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    <!-- Available Teams Section -->
    <div class="team-section">
        <div class="section-header">
            <i class="fas fa-search"></i>
            <h2>Available Teams</h2>
            <span class="team-count">{{ availableTeams|length }} teams</span>
        </div>

        {% if availableTeams|length > 0 %}
            <div class="teams-grid">
                {% for team in availableTeams %}
                    <div class="team-card">
                        {% if team.logo %}
                            <div style="height: 120px; background: linear-gradient(135deg, rgba(26, 40, 71, 0.8), rgba(26, 40, 71, 0.6)); display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 0.5rem;">
                                <img src="{{ asset('uploads/logos/' ~ team.logo) }}" alt="{{ team.name }} logo" style="max-width: 100%; max-height: 100%; object-fit: contain; width: auto;">
                            </div>
                        {% else %}
                            <div style="height: 120px; background: linear-gradient(135deg, rgba(0, 242, 254, 0.1), rgba(37, 211, 102, 0.1)); display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-image" style="font-size: 2rem; color: rgba(0, 242, 254, 0.3);"></i>
                            </div>
                        {% endif %}
                        <div class="team-card-header">
                            <h3>{{ team.name }}</h3>
                            <span class="team-size-badge">
                                <i class="fas fa-users"></i> {{ team.players|length }}
                            </span>
                        </div>

                        <div class="team-card-body">
                            <div class="team-stat">
                                <span class="stat-label">Ranking</span>
                                <span class="stat-value">{{ team.ranking ?? 'Not Ranked' }}</span>
                            </div>
                            <div class="team-stat">
                                <span class="stat-label">Players</span>
                                <span class="stat-value">{{ team.players|length }}</span>
                            </div>
                            <div class="team-stat">
                                <span class="stat-label">Founded</span>
                                <span class="stat-value">{{ team.createdAt|date('Y') }}</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="no-teams-message">
                <i class="fas fa-inbox"></i>
                <p>Sorry! No other teams are available at the moment.</p>
            </div>
        {% endif %}
    </div>

    <!-- Player Profile Info -->
    <div class="profile-section">
        <div class="section-header">
            <i class="fas fa-user"></i>
            <h2>Your Profile</h2>
        </div>

        <div class="profile-card">
            <div class="profile-row">
                <span class="profile-label">Nickname:</span>
                <span class="profile-value">{{ player.nickname }}</span>
            </div>
            <div class="profile-row">
                <span class="profile-label">Email:</span>
                <span class="profile-value">{{ player.email }}</span>
            </div>
            <div class="profile-row">
                <span class="profile-label">First Name:</span>
                <span class="profile-value">{{ player.firstName ?? 'Not set' }}</span>
            </div>
            <div class="profile-row">
                <span class="profile-label">Last Name:</span>
                <span class="profile-value">{{ player.lastName ?? 'Not set' }}</span>
            </div>
            <div class="profile-row">
                <span class="profile-label">Birth Date:</span>
                <span class="profile-value">
                    {% if player.birthDate %}
                        {{ player.birthDate|date('d/m/Y') }}
                    {% else %}
                        Not set
                    {% endif %}
                </span>
            </div>

            <div class="profile-actions">
                <!-- Players can view their profile but not edit through admin panel -->
            </div>
        </div>
    </div>
</div>

<style>
    .player-dashboard {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    /* Welcome Section */
    .welcome-section {
        background: linear-gradient(135deg, rgba(0, 242, 254, 0.1) 0%, rgba(37, 211, 102, 0.1) 100%);
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 12px;
        padding: 3rem 2rem;
        margin-bottom: 2rem;
        backdrop-filter: blur(10px);
    }

    .welcome-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
    }

    .welcome-text h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
    }

    .player-name {
        background: linear-gradient(135deg, #00f2fe, #25d366);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 800;
    }

    .subtitle {
        color: var(--text-secondary);
        font-size: 1.1rem;
    }

    .welcome-avatar {
        display: flex;
        justify-content: center;
    }

    .avatar-circle {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #00f2fe, #25d366);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: var(--bg-dark);
        box-shadow: 0 8px 24px rgba(0, 242, 254, 0.3);
    }

    /* Team Sections */
    .team-section {
        background: rgba(26, 40, 71, 0.6);
        border: 1px solid rgba(0, 242, 254, 0.15);
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
        backdrop-filter: blur(10px);
    }

    .current-team-card {
        border: 2px solid rgba(0, 242, 254, 0.3);
        background: rgba(26, 40, 71, 0.8);
        box-shadow: 0 0 20px rgba(0, 242, 254, 0.1);
    }

    .no-team-card {
        border: 2px dashed rgba(255, 180, 77, 0.4);
        background: rgba(255, 180, 77, 0.05);
    }

    /* Section Header */
    .section-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        gap: 1.5rem;
    }

    .section-header i {
        font-size: 1.5rem;
        color: var(--primary);
    }

    .section-header h2 {
        font-size: 1.8rem;
        margin: 0;
        color: var(--text-primary);
        flex: 1;
    }

    .team-count {
        background: rgba(0, 242, 254, 0.1);
        color: var(--primary);
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    /* Current Team Card Content */
    .team-card-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
    }

    .team-info {
        flex: 1;
    }

    .team-header-info {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .team-header-info h3 {
        font-size: 1.5rem;
        margin: 0;
        color: var(--text-primary);
    }

    .team-badge {
        background: linear-gradient(135deg, #25d366, #00a853);
        color: white;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .team-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        background: rgba(0, 242, 254, 0.05);
        border-radius: 8px;
        border-left: 3px solid var(--primary);
    }

    .detail-item i {
        color: var(--primary);
        font-size: 1.1rem;
    }

    .detail-item strong {
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    .detail-item span {
        color: var(--text-primary);
        font-weight: 600;
    }

    .status-active {
        background: rgba(37, 211, 102, 0.2);
        color: #25d366;
        padding: 0.3rem 0.8rem;
        border-radius: 4px;
        font-weight: 600;
    }

    .team-actions {
        display: flex;
        gap: 1rem;
    }

    /* Teams Grid */
    .teams-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
    }

    .team-card {
        background: linear-gradient(135deg, rgba(26, 40, 71, 0.8), rgba(26, 40, 71, 0.6));
        border: 1px solid rgba(0, 242, 254, 0.2);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .team-card:hover {
        border-color: var(--primary);
        box-shadow: 0 8px 24px rgba(0, 242, 254, 0.2);
        transform: translateY(-4px);
    }

    .team-card-header {
        padding: 1.5rem;
        border-bottom: 1px solid rgba(0, 242, 254, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .team-card-header h3 {
        margin: 0;
        font-size: 1.3rem;
        color: var(--text-primary);
    }

    .team-size-badge {
        background: rgba(0, 242, 254, 0.1);
        color: var(--primary);
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .team-card-body {
        padding: 1.5rem;
        flex: 1;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .team-stat {
        padding: 1rem;
        background: rgba(0, 242, 254, 0.05);
        border-radius: 8px;
        border-left: 3px solid var(--primary);
    }

    .stat-label {
        display: block;
        color: var(--text-secondary);
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    .stat-value {
        display: block;
        color: var(--primary);
        font-size: 1.2rem;
        font-weight: 700;
    }

    .team-card-footer {
        padding: 1.5rem;
        border-top: 1px solid rgba(0, 242, 254, 0.1);
    }

    .btn-block {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    /* Messages */
    .no-team-message {
        color: var(--text-secondary);
        font-size: 1rem;
        margin: 0;
    }

    .no-teams-message {
        text-align: center;
        padding: 3rem;
        color: var(--text-secondary);
    }

    .no-teams-message i {
        font-size: 3rem;
        display: block;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    /* Profile Section */
    .profile-section {
        background: rgba(26, 40, 71, 0.6);
        border: 1px solid rgba(0, 242, 254, 0.15);
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
        backdrop-filter: blur(10px);
    }

    .profile-card {
        background: rgba(0, 242, 254, 0.05);
        border-left: 4px solid var(--primary);
        border-radius: 8px;
        padding: 2rem;
        margin-bottom: 1.5rem;
    }

    .profile-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(0, 242, 254, 0.1);
    }

    .profile-row:last-child {
        border-bottom: none;
    }

    .profile-label {
        color: var(--text-secondary);
        font-weight: 600;
        min-width: 150px;
    }

    .profile-value {
        color: var(--text-primary);
        font-weight: 500;
    }

    .profile-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    /* Buttons */
    .btn {
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, #00f2fe, #00a8cc);
        color: var(--bg-dark);
    }

    .btn-primary:hover {
        box-shadow: 0 6px 20px rgba(0, 242, 254, 0.4);
        transform: translateY(-2px);
    }

    .btn-secondary {
        background: rgba(0, 242, 254, 0.1);
        color: var(--primary);
        border: 1px solid var(--primary);
    }

    .btn-secondary:hover {
        background: rgba(0, 242, 254, 0.2);
    }

    .btn-info {
        background: rgba(100, 200, 255, 0.2);
        color: #64c8ff;
        border: 1px solid #64c8ff;
    }

    .btn-info:hover {
        background: rgba(100, 200, 255, 0.3);
    }

    .btn-danger {
        background: rgba(255, 68, 68, 0.2);
        color: #ff4444;
        border: 1px solid #ff4444;
    }

    .btn-danger:hover {
        background: rgba(255, 68, 68, 0.3);
    }

    .btn-sm {
        padding: 0.4rem 0.8rem;
        font-size: 0.85rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .welcome-content {
            flex-direction: column;
            text-align: center;
        }

        .welcome-text h1 {
            font-size: 1.8rem;
        }

        .team-card-content {
            flex-direction: column;
        }

        .team-actions {
            width: 100%;
            flex-direction: column;
        }

        .team-actions .btn {
            width: 100%;
            justify-content: center;
        }

        .section-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .teams-grid {
            grid-template-columns: 1fr;
        }

        .team-card-body {
            grid-template-columns: 1fr;
        }

        .profile-row {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
{% endblock %}
