{% extends "base.html.twig" %}

{% block title %}Player Dashboard - Rankup{% endblock %}

{% block body %}
<div class="player-dashboard">
    <!-- Welcome Header -->
    <div class="welcome-section">
        <div class="welcome-content">
            <div class="welcome-text">
                <h1>Welcome, <span class="player-name">{{ player.nickname }}</span>! 👋</h1>
                <p class="subtitle">Manage your team and profile</p>
            </div>
            <div class="welcome-avatar">
                <div class="avatar-circle">
                    <i class="fas fa-user-circle"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions Section -->
    <div class="quick-actions-section">
        <div class="action-card financial-chart-card">
            <div class="action-icon">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="action-content">
                <h3>Financial Dashboard</h3>
                <p>View team budgets, expenses, and financial charts</p>
            </div>
            <a href="{{ path('budget_index') }}" class="action-btn">
                <i class="fas fa-arrow-right"></i> View Full Dashboard
            </a>
        </div>
    </div>

    <!-- Current Team Section -->
    {% if currentTeam %}
        <div class="team-section current-team-card">
            <div class="section-header">
                <i class="fas fa-shield-alt"></i>
                <h2>Your Current Team</h2>
            </div>
            
            <div class="team-card-content">
                {% if currentTeam.logo %}
                    <div style="flex: 0 0 150px; height: 100px; background: linear-gradient(135deg, rgba(26, 40, 71, 0.8), rgba(26, 40, 71, 0.6)); display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 8px; border: 1px solid rgba(0, 242, 254, 0.15); margin-right: 1.5rem; padding: 0.5rem;">
                        <img src="{{ asset('uploads/logos/' ~ currentTeam.logo) }}" alt="{{ currentTeam.name }} logo" style="max-width: 100%; max-height: 100%; object-fit: contain; width: auto;">
                    </div>
                {% else %}
                    <div style="flex: 0 0 150px; height: 100px; background: linear-gradient(135deg, rgba(0, 242, 254, 0.1), rgba(37, 211, 102, 0.1)); display: flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid rgba(0, 242, 254, 0.15); margin-right: 1.5rem;">
                        <i class="fas fa-image" style="font-size: 2rem; color: rgba(0, 242, 254, 0.3);"></i>
                    </div>
                {% endif %}
                <div class="team-info">
                    <div class="team-header-info">
                        <h3>{{ currentTeam.name }}</h3>
                        <span class="team-badge">
                            <i class="fas fa-check-circle"></i> Active Player
                        </span>
                    </div>
                    
                    <div class="team-details">
                        <div class="detail-item">
                            <i class="fas fa-bar-chart-o"></i>
                            <strong>Ranking:</strong>
                            <span>{{ currentTeam.ranking ?? 'N/A' }}</span>
                        </div>
                        <div class="detail-item">
                            <i class="fas fa-users"></i>
                            <strong>Team Members:</strong>
                            <span>{{ currentTeam.players|length }}</span>
                        </div>
                        <div class="detail-item">
                            <i class="fas fa-trophy"></i>
                            <strong>Status:</strong>
                            <span class="status-active">Active</span>
                        </div>
                    </div>
                </div>

                <div class="team-actions">
                    <form method="POST" action="{{ path('player_leave_team') }}" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('leave_team') }}">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to leave this team?')">
                            <i class="fas fa-sign-out-alt"></i> Leave Team
                        </button>
                    </form>
                </div>
            </div>
        </div>
    {% else %}
        <div class="team-section no-team-card">
            <div class="section-header">
                <i class="fas fa-info-circle"></i>
                <h2>No Team Yet</h2>
            </div>
            <p class="no-team-message">You are not currently part of any team. Join one below to get started!</p>
        </div>
    {% endif %}

    <!-- Player Statistics Section -->
    <div class="team-section stats-section">
        <div class="section-header">
            <i class="fas fa-chart-bar"></i>
            <h2>Your Performance Statistics</h2>
        </div>

        {% if playerStats is defined and (playerStats.totalScore > 0 or playerStats.matchCount > 0) %}
            <div class="row">
                <!-- Total Score Card -->
                <div class="col-md-3 col-sm-6 mb-3">
                    <div class="stat-card score-card">
                        <div class="stat-icon">
                            <i class="fas fa-star"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-value">{{ playerStats.totalScore|number_format(0, '.', ',') }}</div>
                            <div class="stat-label">Total Score</div>
                        </div>
                    </div>
                </div>

                <!-- K/D/A Ratio Card -->
                <div class="col-md-3 col-sm-6 mb-3">
                    <div class="stat-card kda-card">
                        <div class="stat-icon">
                            <i class="fas fa-crosshairs"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-value">{{ playerStats.avgKDA|number_format(2, '.', ',') }}</div>
                            <div class="stat-label">Avg KDA</div>
                            <div class="stat-breakdown">K: {{ playerStats.avgKillsPerMatch }} | A: {{ playerStats.avgAssistsPerMatch }}</div>
                        </div>
                    </div>
                </div>

                <!-- Matches Played Card -->
                <div class="col-md-3 col-sm-6 mb-3">
                    <div class="stat-card matches-card">
                        <div class="stat-icon">
                            <i class="fas fa-gamepad"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-value">{{ playerStats.matchCount }}</div>
                            <div class="stat-label">Matches</div>
                            <div class="stat-breakdown">Played</div>
                        </div>
                    </div>
                </div>

                <!-- Total Damage Card -->
                <div class="col-md-3 col-sm-6 mb-3">
                    <div class="stat-card damage-card">
                        <div class="stat-icon">
                            <i class="fas fa-fire"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-value">{{ (playerStats.totalDamageDealt / 1000)|number_format(1, '.', ',') }}K</div>
                            <div class="stat-label">Total Damage</div>
                            <div class="stat-breakdown">Avg: {{ playerStats.avgDamagePerMatch|number_format(0, '.', ',') }}/match</div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                <strong>No Match Statistics Yet</strong> - Play some matches to see your performance statistics here!
            </div>
        {% endif %}
    </div>

    <!-- Team Invitations Section -->
    {% if pendingInvitations|length > 0 %}
        <div class="team-section invitations-section">
            <div class="section-header">
                <i class="fas fa-envelope"></i>
                <h2>Team Invitations</h2>
                <span class="team-count" style="background-color: #ff6b6b;">{{ pendingInvitations|length }} pending</span>
            </div>

            <div class="row">
                {% for invitation in pendingInvitations %}
                    <div class="col-md-6 mb-3">
                        <div class="card border-primary">
                            {% if invitation.team.logo %}
                                <div style="height: 100px; background: linear-gradient(135deg, rgba(26, 40, 71, 0.8), rgba(26, 40, 71, 0.6)); display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid rgba(0, 242, 254, 0.15); padding: 0.5rem;">
                                    <img src="{{ asset('uploads/logos/' ~ invitation.team.logo) }}" alt="{{ invitation.team.name }} logo" style="max-width: 100%; max-height: 100%; object-fit: contain; width: auto;">
                                </div>
                            {% endif %}
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="fas fa-handshake"></i> Invitation from <strong>{{ invitation.team.name }}</strong>
                                </h5>
                            </div>
                            <div class="card-body">
                                <p class="mb-2">
                                    <strong>Team Manager:</strong> Team needs players!
                                </p>
                                <p class="mb-2">
                                    <small class="text-muted">
                                        <i class="fas fa-calendar"></i> Invited on: {{ invitation.createdAt|date('d M Y H:i') }}
                                    </small>
                                </p>
                                
                                {% if invitation.team.description %}
                                    <p class="mb-3">
                                        <small><strong>About Team:</strong><br>{{ invitation.team.description|slice(0, 150) }}{% if invitation.team.description|length > 150 %}...{% endif %}</small>
                                    </p>
                                {% endif %}

                                <div class="mb-2">
                                    <small class="text-muted">
                                        <i class="fas fa-users"></i> Team Members: {{ invitation.team.players|length }}/5
                                    </small>
                                </div>

                                <hr>

                                <div class="d-flex gap-2">
                                    <form method="POST" action="{{ path('team_invitation_accept', { id: invitation.id }) }}" style="flex: 1;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('team_invitation_' ~ invitation.id) }}">
                                        <button type="submit" class="btn btn-success w-100 btn-sm">
                                            <i class="fas fa-check-circle"></i> Accept
                                        </button>
                                    </form>
                                    <form method="POST" action="{{ path('team_invitation_reject', { id: invitation.id }) }}" style="flex: 1;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('team_invitation_' ~ invitation.id) }}">
                                        <button type="submit" class="btn btn-danger w-100 btn-sm">
                                            <i class="fas fa-times-circle"></i> Decline
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <!-- Manager Section -->
    <div class="team-section manager-section">
        <div class="section-header">
            <i class="fas fa-crown"></i>
            <h2>Management</h2>
        </div>

        {% if is_granted('ROLE_MANAGER') %}
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <strong>You are a Manager!</strong> You can now create and manage teams and budgets.
                <div class="mt-3">
                    <a href="{{ path('team_new') }}" class="btn btn-primary me-2">
                        <i class="fas fa-plus"></i> Create Team
                    </a>
                    <a href="{{ path('player_manager_status') }}" class="btn btn-secondary">
                        <i class="fas fa-history"></i> View Manager Applications
                    </a>
                </div>
            </div>
            {# Beautiful Manager Financial Charts #}
            {% if managerFinancialSummary is not null %}
                <style>
                    .manager-charts-section {
                        margin-top: 2rem;
                    }

                    .chart-card {
                        background: linear-gradient(135deg, rgba(26, 40, 71, 0.8) 0%, rgba(26, 40, 71, 0.6) 100%);
                        backdrop-filter: blur(20px);
                        border: 2px solid rgba(0, 242, 254, 0.2);
                        border-radius: 20px;
                        overflow: hidden;
                        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                        box-shadow: 0 8px 32px rgba(0, 242, 254, 0.1), 0 0 20px rgba(37, 211, 102, 0.05);
                    }

                    .chart-card:hover {
                        border-color: rgba(0, 242, 254, 0.4);
                        box-shadow: 0 16px 48px rgba(0, 242, 254, 0.2), 0 0 40px rgba(37, 211, 102, 0.1);
                        transform: translateY(-4px);
                    }

                    .chart-header {
                        padding: 1.75rem;
                        background: linear-gradient(135deg, rgba(0, 242, 254, 0.15) 0%, rgba(37, 211, 102, 0.1) 100%);
                        border-bottom: 2px solid rgba(0, 242, 254, 0.15);
                        position: relative;
                        overflow: hidden;
                    }

                    .chart-header::before {
                        content: '';
                        position: absolute;
                        top: 0;
                        right: -50px;
                        width: 150px;
                        height: 150px;
                        background: radial-gradient(circle, rgba(0, 242, 254, 0.1), transparent);
                        border-radius: 50%;
                    }

                    .chart-header h5 {
                        font-size: 1.3rem;
                        font-weight: 700;
                        margin: 0;
                        background: linear-gradient(135deg, #00f2fe, #25d366);
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        background-clip: text;
                        display: flex;
                        align-items: center;
                        gap: 0.75rem;
                        position: relative;
                        z-index: 1;
                    }

                    .chart-header i {
                        font-size: 1.5rem;
                        color: #00f2fe;
                        filter: drop-shadow(0 0 8px rgba(0, 242, 254, 0.5));
                    }

                    .chart-body {
                        padding: 2rem;
                        position: relative;
                        min-height: 350px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }

                    .chart-body::before {
                        content: '';
                        position: absolute;
                        inset: 0;
                        background: radial-gradient(circle at 50% 50%, rgba(0, 242, 254, 0.03), transparent);
                        pointer-events: none;
                    }

                    .chart-container {
                        position: relative;
                        width: 100%;
                        height: 100%;
                        min-height: 320px;
                    }

                    .charts-grid {
                        display: grid;
                        grid-template-columns: 2fr 1fr;
                        gap: 2rem;
                        animation: fadeInUp 0.8s ease-out;
                    }

                    @keyframes fadeInUp {
                        from {
                            opacity: 0;
                            transform: translateY(30px);
                        }
                        to {
                            opacity: 1;
                            transform: translateY(0);
                        }
                    }

                    @media (max-width: 1024px) {
                        .charts-grid {
                            grid-template-columns: 1fr;
                        }
                    }
                </style>

                <div class="manager-charts-section">
                    <div class="charts-grid">
                        <!-- Line Chart -->
                        <div class="chart-card">
                            <div class="chart-header">
                                <h5><i class="fas fa-chart-line"></i> Dépenses vs Budget</h5>
                                <small class="text-muted d-block mt-2" style="position: relative; z-index: 1;">Evolution sur les 6 derniers mois</small>
                            </div>
                            <div class="chart-body">
                                <div class="chart-container">
                                    <canvas id="managerDepenseBudgetLineChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Pie Chart -->
                        <div class="chart-card">
                            <div class="chart-header">
                                <h5><i class="fas fa-pie-chart"></i> Répartition</h5>
                                <small class="text-muted d-block mt-2" style="position: relative; z-index: 1;">Par équipe</small>
                            </div>
                            <div class="chart-body">
                                <div class="chart-container">
                                    <canvas id="managerDepensePieChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% else %}
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="fas fa-crown text-warning"></i> Become a Manager
                    </h5>
                    <p class="card-text text-muted">
                        Ready to lead? Apply for the manager role to create and manage your own teams, handle budgets, and take your competitive career to the next level.
                    </p>
                    <div class="mt-3">
                        <a href="{{ path('player_manager_request') }}" class="btn btn-warning">
                            <i class="fas fa-paper-plane"></i> Apply for Manager Role
                        </a>
                        <a href="{{ path('player_manager_status') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-info-circle"></i> Check Application Status
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    {% if is_granted('ROLE_MANAGER') %}
        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    // Beautiful color gradients
                    const expenseColor = {
                        main: 'rgb(255, 71, 87)',
                        light: 'rgba(255, 71, 87, 0.1)',
                        medium: 'rgba(255, 71, 87, 0.5)'
                    };
                    
                    const budgetColor = {
                        main: 'rgb(37, 211, 102)',
                        light: 'rgba(37, 211, 102, 0.1)',
                        medium: 'rgba(37, 211, 102, 0.5)'
                    };

                    const pieColors = [
                        { bg: 'rgba(0, 242, 254, 0.9)', border: 'rgb(0, 242, 254)' },
                        { bg: 'rgba(37, 211, 102, 0.9)', border: 'rgb(37, 211, 102)' },
                        { bg: 'rgba(255, 71, 87, 0.9)', border: 'rgb(255, 71, 87)' },
                        { bg: 'rgba(255, 159, 64, 0.9)', border: 'rgb(255, 159, 64)' },
                        { bg: 'rgba(147, 112, 219, 0.9)', border: 'rgb(147, 112, 219)' },
                        { bg: 'rgba(255, 193, 7, 0.9)', border: 'rgb(255, 193, 7)' },
                        { bg: 'rgba(76, 175, 80, 0.9)', border: 'rgb(76, 175, 80)' },
                        { bg: 'rgba(33, 150, 243, 0.9)', border: 'rgb(33, 150, 243)' }
                    ];

                    // Line chart: Evolution Dépenses vs Budget (6 derniers mois)
                    const lineLabels = {{ managerDepenseBudgetLineLabels|json_encode()|raw }};
                    const depenseLine = {{ managerDepenseBudgetLineDepenses|json_encode()|raw }};
                    const budgetLine = {{ managerDepenseBudgetLineBudgets|json_encode()|raw }};
                    const lineCtx = document.getElementById('managerDepenseBudgetLineChart') ? document.getElementById('managerDepenseBudgetLineChart').getContext('2d') : null;
                    
                    if (lineCtx) {
                        // Create gradient for expenses line
                        const expenseGradient = lineCtx.createLinearGradient(0, 0, 0, 400);
                        expenseGradient.addColorStop(0, 'rgba(255, 71, 87, 0.4)');
                        expenseGradient.addColorStop(1, 'rgba(255, 71, 87, 0)');

                        // Create gradient for budget line
                        const budgetGradient = lineCtx.createLinearGradient(0, 0, 0, 400);
                        budgetGradient.addColorStop(0, 'rgba(37, 211, 102, 0.4)');
                        budgetGradient.addColorStop(1, 'rgba(37, 211, 102, 0)');

                        const lineChart = new Chart(lineCtx, {
                            type: 'line',
                            data: {
                                labels: lineLabels,
                                datasets: [
                                    {
                                        label: 'Dépenses validées',
                                        data: depenseLine,
                                        borderColor: expenseColor.main,
                                        backgroundColor: expenseGradient,
                                        borderWidth: 3,
                                        fill: true,
                                        tension: 0.4,
                                        pointRadius: 5,
                                        pointHoverRadius: 7,
                                        pointBackgroundColor: expenseColor.main,
                                        pointBorderColor: '#fff',
                                        pointBorderWidth: 2,
                                        pointHoverBorderWidth: 3,
                                        shadowOffsetX: 2,
                                        shadowOffsetY: 2,
                                        shadowBlur: 10,
                                        shadowColor: 'rgba(255, 71, 87, 0.3)'
                                    },
                                    {
                                        label: 'Budget alloué',
                                        data: budgetLine,
                                        borderColor: budgetColor.main,
                                        backgroundColor: budgetGradient,
                                        borderWidth: 3,
                                        fill: true,
                                        tension: 0.4,
                                        pointRadius: 5,
                                        pointHoverRadius: 7,
                                        pointBackgroundColor: budgetColor.main,
                                        pointBorderColor: '#fff',
                                        pointBorderWidth: 2,
                                        pointHoverBorderWidth: 3,
                                        shadowOffsetX: 2,
                                        shadowOffsetY: 2,
                                        shadowBlur: 10,
                                        shadowColor: 'rgba(37, 211, 102, 0.3)'
                                    }
                                ]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                animation: {
                                    duration: 1500,
                                    easing: 'easeInOutQuart',
                                    delay: (ctx) => {
                                        let delay = 0;
                                        if (ctx.type === 'data') {
                                            delay = ctx.dataIndex * 50 + ctx.datasetIndex * 100;
                                        }
                                        return delay;
                                    }
                                },
                                interaction: {
                                    mode: 'index',
                                    intersect: false
                                },
                                plugins: {
                                    legend: {
                                        position: 'bottom',
                                        labels: {
                                            usePointStyle: true,
                                            padding: 20,
                                            font: { size: 12, weight: '600' },
                                            color: '#a0a0a0',
                                            generateLabels: function(chart) {
                                                const datasets = chart.data.datasets;
                                                return datasets.map((dataset, i) => ({
                                                    text: dataset.label,
                                                    fillStyle: dataset.borderColor,
                                                    hidden: !chart.isDatasetVisible(i),
                                                    index: i,
                                                    pointStyle: 'circle'
                                                }));
                                            }
                                        }
                                    },
                                    tooltip: {
                                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                        titleColor: '#fff',
                                        bodyColor: '#fff',
                                        borderColor: 'rgba(0, 242, 254, 0.5)',
                                        borderWidth: 1,
                                        padding: 12,
                                        displayColors: true,
                                        callbacks: {
                                            label: function(context) {
                                                return context.dataset.label + ': ' + context.parsed.y.toLocaleString('fr-FR') + ' DT';
                                            }
                                        }
                                    }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        ticks: {
                                            color: '#a0a0a0',
                                            font: { size: 11 },
                                            callback: function(value) {
                                                return (value / 1000).toLocaleString('fr-FR') + 'k';
                                            }
                                        },
                                        grid: {
                                            color: 'rgba(0, 242, 254, 0.05)',
                                            drawBorder: false
                                        }
                                    },
                                    x: {
                                        ticks: {
                                            color: '#a0a0a0',
                                            font: { size: 11 }
                                        },
                                        grid: {
                                            display: false,
                                            drawBorder: false
                                        }
                                    }
                                }
                            }
                        });
                    }

                    // Pie chart: Répartition des dépenses par équipe
                    const pieLabels = {{ managerDepensePieLabels|json_encode()|raw }};
                    const pieData = {{ managerDepensePieValues|json_encode()|raw }};
                    const pieCtx = document.getElementById('managerDepensePieChart') ? document.getElementById('managerDepensePieChart').getContext('2d') : null;
                    
                    if (pieCtx) {
                        const pieBackgroundColors = pieColors.slice(0, pieLabels.length).map(c => c.bg);
                        const pieBorderColors = pieColors.slice(0, pieLabels.length).map(c => c.border);

                        const pieChart = new Chart(pieCtx, {
                            type: 'doughnut',
                            data: {
                                labels: pieLabels,
                                datasets: [{
                                    data: pieData,
                                    backgroundColor: pieBackgroundColors,
                                    borderColor: pieBorderColors,
                                    borderWidth: 2
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                animation: {
                                    animateRotate: true,
                                    animateScale: false,
                                    duration: 1500,
                                    easing: 'easeInOutQuart'
                                },
                                plugins: {
                                    legend: {
                                        position: 'bottom',
                                        labels: {
                                            usePointStyle: true,
                                            padding: 15,
                                            font: { size: 12, weight: '600' },
                                            color: '#a0a0a0'
                                        }
                                    },
                                    tooltip: {
                                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                        titleColor: '#fff',
                                        bodyColor: '#fff',
                                        borderColor: 'rgba(0, 242, 254, 0.5)',
                                        borderWidth: 1,
                                        padding: 12,
                                        callbacks: {
                                            label: function(context) {
                                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                                return context.label + ': ' + context.parsed.toLocaleString('fr-FR') + ' DT (' + percentage + '%)';
                                            }
                                        }
                                    }
                                }
                            }
                        });
                    }
                });
            </script>
        {% endblock %}
    {% endif %}
    <div class="team-section">
        <div class="section-header">
            <i class="fas fa-search"></i>
            <h2>Available Teams</h2>
            <span class="team-count">{{ availableTeams|length }} teams</span>
        </div>

        {% if availableTeams|length > 0 %}
            <div class="teams-grid">
                {% for team in availableTeams %}
                    <div class="team-card">
                        {% if team.logo %}
                            <div style="height: 120px; background: linear-gradient(135deg, rgba(26, 40, 71, 0.8), rgba(26, 40, 71, 0.6)); display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 0.5rem;">
                                <img src="{{ asset('uploads/logos/' ~ team.logo) }}" alt="{{ team.name }} logo" style="max-width: 100%; max-height: 100%; object-fit: contain; width: auto;">
                            </div>
                        {% else %}
                            <div style="height: 120px; background: linear-gradient(135deg, rgba(0, 242, 254, 0.1), rgba(37, 211, 102, 0.1)); display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-image" style="font-size: 2rem; color: rgba(0, 242, 254, 0.3);"></i>
                            </div>
                        {% endif %}
                        <div class="team-card-header">
                            <h3>{{ team.name }}</h3>
                            <span class="team-size-badge">
                                <i class="fas fa-users"></i> {{ team.players|length }}
                            </span>
                        </div>

                        <div class="team-card-body">
                            <div class="team-stat">
                                <span class="stat-label">Ranking</span>
                                <span class="stat-value">{{ team.ranking ?? 'Not Ranked' }}</span>
                            </div>
                            <div class="team-stat">
                                <span class="stat-label">Players</span>
                                <span class="stat-value">{{ team.players|length }}</span>
                            </div>
                            <div class="team-stat">
                                <span class="stat-label">Founded</span>
                                <span class="stat-value">{{ team.createdAt|date('Y') }}</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="no-teams-message">
                <i class="fas fa-inbox"></i>
                <p>Sorry! No other teams are available at the moment.</p>
            </div>
        {% endif %}
    </div>

    <!-- Player Profile Info -->
    <div class="profile-section">
        <div class="section-header">
            <i class="fas fa-user"></i>
            <h2>Your Profile</h2>
        </div>

        <div class="profile-card">
            <div class="profile-row">
                <span class="profile-label">Nickname:</span>
                <span class="profile-value">{{ player.nickname }}</span>
            </div>
            <div class="profile-row">
                <span class="profile-label">Email:</span>
                <span class="profile-value">{{ player.email }}</span>
            </div>
            <div class="profile-row">
                <span class="profile-label">First Name:</span>
                <span class="profile-value">{{ player.firstName ?? 'Not set' }}</span>
            </div>
            <div class="profile-row">
                <span class="profile-label">Last Name:</span>
                <span class="profile-value">{{ player.lastName ?? 'Not set' }}</span>
            </div>
            <div class="profile-row">
                <span class="profile-label">Birth Date:</span>
                <span class="profile-value">
                    {% if player.birthDate %}
                        {{ player.birthDate|date('d/m/Y') }}
                    {% else %}
                        Not set
                    {% endif %}
                </span>
            </div>

            <div class="profile-actions">
                <!-- Players can view their profile but not edit through admin panel -->
            </div>
        </div>
    </div>
</div>

