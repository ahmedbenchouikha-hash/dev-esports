{% extends 'base.html.twig' %}

{% block title %}Request Manager Role{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="d-flex align-items-center mb-4">
                <h1 class="mb-0">
                    <i class="fas fa-crown text-warning"></i> Request Manager Role
                </h1>
            </div>

            {% if app.flashes %}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endif %}

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-file-alt"></i> Manager Application Form
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        As a manager, you'll be able to create and manage your own esports team and budget. 
                        Please fill out this form with information about your management experience and vision.
                    </p>

                    {{ form_start(form, {'attr': {'class': 'form', 'novalidate': true}}) }}

                    <div class="mb-4">
                        {{ form_label(form.teamName) }}
                        {{ form_widget(form.teamName, {'attr': {'placeholder': 'e.g., Phoenix Dynasty'}}) }}
                        {% if form.teamName.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.teamName) }}
                            </div>
                        {% endif %}
                        <small class="text-muted d-block mt-1">
                            Optional. You can also manage an existing team if invited.
                        </small>
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.motivation, 'Why do you want to become a Manager?') }}
                        {{ form_widget(form.motivation) }}
                        {% if form.motivation.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.motivation) }}
                            </div>
                        {% endif %}
                        <small class="text-muted d-block mt-1">
                            Tell us about your management experience, vision, and what you can bring to a team.
                        </small>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>What happens next?</strong>
                        <ul class="mb-0 mt-2 ms-3">
                            <li>Your application will be reviewed by an administrator</li>
                            <li>You'll be notified of the decision within 24-48 hours</li>
                            <li>If approved, you can immediately start creating and managing teams</li>
                        </ul>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane"></i> Submit Application
                        </button>
                        <a href="{{ path('player_dashboard') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Dashboard
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
