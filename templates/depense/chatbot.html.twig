{% extends 'base.html.twig' %}

{% block title %}AI Expense Chatbot - Rankup{% endblock %}

{% block stylesheets %}
<style>
:root {
    --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --secondary-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    --success-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    --warning-gradient: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
    --glass-bg: rgba(255, 255, 255, 0.1);
    --glass-border: rgba(255, 255, 255, 0.2);
    --dark-bg: #0a0a0a;
    --dark-card: rgba(15, 15, 15, 0.9);
    --text-primary: #ffffff;
    --text-secondary: #b0b0b0;
    --accent-color: #00f2fe;
}

body {
    background: var(--dark-bg);
    color: var(--text-primary);
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    overflow-x: hidden;
}

.chatbot-container {
    min-height: 100vh;
    background: var(--dark-bg);
    position: relative;
    overflow: hidden;
}

.toast-container {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
}

.toast {
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 15px 20px;
    margin-bottom: 10px;
    color: var(--text-primary);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    animation: slideInRight 0.3s ease-out;
    display: flex;
    align-items: center;
    gap: 10px;
}

@keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

.toast.success { border-left: 4px solid #28a745; }
.toast.error { border-left: 4px solid #dc3545; }
.toast.info { border-left: 4px solid #17a2b8; }

.chatbot-container::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
        radial-gradient(circle at 20% 80%, rgba(120, 119, 198, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(255, 119, 198, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 40% 40%, rgba(120, 119, 198, 0.2) 0%, transparent 50%);
    animation: float 20s ease-in-out infinite;
    z-index: -1;
}

@keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    33% { transform: translateY(-20px) rotate(120deg); }
    66% { transform: translateY(10px) rotate(240deg); }
}

.glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
}

.glass-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.stat-card {
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 15px;
    padding: 20px;
    text-align: center;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--primary-gradient);
    opacity: 0;
    transition: left 0.5s ease;
}

.stat-card:hover::before {
    left: 100%;
    opacity: 0.1;
}

.stat-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

.stat-value {
    font-size: 2.5rem;
    font-weight: bold;
    background: var(--success-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 5px;
}

.chat-main {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 30px;
    height: calc(100vh - 200px);
}

.chat-window {
    background: var(--dark-card);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

.chat-header {
    background: var(--primary-gradient);
    padding: 20px;
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.chat-header h5 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
}

.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.9) 0%, rgba(20, 20, 20, 0.9) 100%);
    scroll-behavior: smooth;
}

.message {
    margin-bottom: 20px;
    animation: slideIn 0.3s ease-out;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.3s ease;
}

@keyframes slideIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.message.user {
    display: flex;
    justify-content: flex-end;
}

.message.bot {
    display: flex;
    justify-content: flex-start;
}

.message-content {
    max-width: 70%;
    padding: 15px 20px;
    border-radius: 18px;
    position: relative;
    word-wrap: break-word;
}

.message.user .message-content {
    background: var(--primary-gradient);
    color: white;
    border-bottom-right-radius: 5px;
}

.message.bot .message-content {
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    color: var(--text-primary);
    border-bottom-left-radius: 5px;
}

.message-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    margin: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
}

.message.user .message-avatar {
    background: var(--primary-gradient);
    order: 2;
}

.message.bot .message-avatar {
    background: var(--success-gradient);
    order: 0;
}

.chat-input-area {
    background: var(--dark-card);
    border-top: 1px solid var(--glass-border);
    padding: 20px;
}

.chat-input-container {
    display: flex;
    gap: 15px;
    align-items: center;
}

.chat-input {
    flex: 1;
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    border-radius: 25px;
    padding: 15px 20px;
    color: var(--text-primary);
    font-size: 16px;
    transition: all 0.3s ease;
}

.chat-input:focus {
    outline: none;
    border-color: var(--accent-color);
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.3);
    transform: scale(1.02);
}

.send-btn {
    background: var(--success-gradient);
    border: none;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 242, 254, 0.3);
}

.send-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(0, 242, 254, 0.5);
}

.send-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.sidebar {
    background: var(--dark-card);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: fit-content;
    position: sticky;
    top: 0;
    max-height: calc(100vh - 200px);
    overflow-y: auto;
}

.quick-actions {
    flex: 0 0 auto;
}

.quick-actions h6 {
    color: var(--text-primary);
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.quick-btn {
    width: 100%;
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 12px 15px;
    color: var(--text-primary);
    text-align: left;
    margin-bottom: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
}

.quick-btn:hover {
    background: var(--primary-gradient);
    transform: translateX(5px);
    border-color: transparent;
}

.typing-indicator {
    display: none;
    padding: 15px 20px;
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    border-radius: 18px;
    margin-bottom: 20px;
    animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.typing-dots {
    display: flex;
    gap: 4px;
}

.typing-dots span {
    width: 8px;
    height: 8px;
    background: var(--accent-color);
    border-radius: 50%;
    animation: typing 1.4s ease-in-out infinite;
}

.typing-dots span:nth-child(2) { animation-delay: 0.2s; }
.typing-dots span:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
    0%, 60%, 100% { transform: scale(1); }
    30% { transform: scale(1.2); }
}

.floating-particles {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
}

.particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--accent-color);
    border-radius: 50%;
    animation: particleFloat 15s linear infinite;
}

@keyframes particleFloat {
    0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateY(-100px) rotate(360deg); opacity: 0; }
}

@media (max-width: 768px) {
    .chat-main {
        grid-template-columns: 1fr;
        height: auto;
    }

    .sidebar {
        order: -1;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="chatbot-container">
    <div class="floating-particles" id="particles"></div>
    <div class="toast-container" id="toastContainer"></div>

    <div class="container-fluid py-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="display-4 fw-bold" style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                🤖 AI Expense Assistant
            </h1>
            <div class="d-flex gap-2">
                <button class="btn glass-card" id="themeToggle">
                    <i class="fas fa-moon"></i>
                </button>
                <a href="{{ path('depense_index') }}" class="btn glass-card">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        </div>

        <!-- Debug Info -->
        {% if app.user %}
            <div class="alert alert-info mb-3" style="font-size: 12px;">
                <strong>👤 User:</strong> {{ app.user.username }}<br>
                <strong>📋 Roles:</strong> {{ app.user.roles|join(', ') }}<br>
                <strong>👥 Teams:</strong> 
                {% if app.user.teams|length > 0 %}
                    {{ app.user.teams|map(t => t.name)|join(', ') }}
                {% else %}
                    <em>No teams assigned</em>
                {% endif %}
            </div>
        {% else %}
            <div class="alert alert-danger mb-3">
                ❌ Not authenticated! Please log in first.
            </div>
        {% endif %}

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value">{{ snapshot.global.budgetTotal|number_format(2, '.', ' ') }}</div>
                <div class="text-muted">Budget Total (TND)</div>
                <i class="fas fa-wallet position-absolute top-50 end-0 translate-middle-y opacity-25" style="font-size: 3rem;"></i>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ snapshot.global.spent|number_format(2, '.', ' ') }}</div>
                <div class="text-muted">Total Dépensé (TND)</div>
                <i class="fas fa-coins position-absolute top-50 end-0 translate-middle-y opacity-25" style="font-size: 3rem;"></i>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ snapshot.global.remaining|number_format(2, '.', ' ') }}</div>
                <div class="text-muted">Budget Restant (TND)</div>
                <i class="fas fa-piggy-bank position-absolute top-50 end-0 translate-middle-y opacity-25" style="font-size: 3rem;"></i>
            </div>
        </div>

        <!-- Main Chat Interface -->
        <div class="chat-main">
            <!-- Chat Window -->
            <div class="chat-window">
                <div class="chat-header">
                    <h5>
                        <i class="fas fa-robot"></i>
                        Assistant IA Financier
                        <span class="badge bg-success ms-2" id="onlineStatus">En ligne</span>
                    </h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-light" id="clearChat" title="Effacer la conversation">
                            <i class="fas fa-trash"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-light" id="exportChat" title="Exporter la conversation">
                            <i class="fas fa-download"></i>
                        </button>
                    </div>
                </div>

                <div class="chat-messages" id="chatBox">
                    <div class="message bot">
                        <div class="message-avatar">🤖</div>
                        <div class="message-content">
                            <div class="fw-bold mb-2">AI Assistant</div>
                            <div>
                                Bonjour ! 👋 Je suis votre assistant financier intelligent. Je peux vous aider avec :
                                <ul class="mb-0 mt-3">
                                    <li>📊 Analyses budgétaires détaillées</li>
                                    <li>💰 Suivi des dépenses par équipe</li>
                                    <li>📈 Optimisations et suggestions</li>
                                    <li>🔍 Recherche dans l'historique</li>
                                    <li>📋 Rapports personnalisés</li>
                                </ul>
                                <div class="mt-3">
                                    <small class="text-muted">💡 Essayez des commandes comme /help, /stats, /clear</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="typing-indicator" id="typingIndicator">
                    <div class="d-flex align-items-center gap-3">
                        <div class="message-avatar" style="background: var(--success-gradient);">🤖</div>
                        <div>
                            <div class="fw-bold">AI Assistant réfléchit...</div>
                            <div class="typing-dots">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="chat-input-area">
                    <div class="chat-input-container">
                        <input
                            type="text"
                            id="chatInput"
                            class="chat-input"
                            placeholder="Posez votre question sur le budget... (ou tapez /help)"
                            autocomplete="off"
                        >
                        <button id="chatSendBtn" class="send-btn" disabled>
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="sidebar">
                <div class="quick-actions">
                    <h6><i class="fas fa-zap"></i> Actions Rapides</h6>
                    <button class="quick-btn" data-text="Donne-moi un aperçu complet du budget global et par équipe.">
                        📊 Vue d'ensemble
                    </button>
                    <button class="quick-btn" data-text="Quelles équipes ont dépassé leur budget ? Montre-moi les détails.">
                        ⚠️ Alertes dépassement
                    </button>
                    <button class="quick-btn" data-text="Analyse les dépenses par catégorie et suggère des optimisations.">
                        📈 Analyse catégories
                    </button>
                    <button class="quick-btn" data-text="Montre-moi les 10 dernières dépenses validées avec détails.">
                        📅 Dernières dépenses
                    </button>
                    <button class="quick-btn" data-text="Propose une stratégie d'optimisation budgétaire pour les 3 prochains mois.">
                        🎯 Plan d'optimisation
                    </button>
                    <button class="quick-btn" data-text="Compare les budgets et dépenses entre toutes les équipes.">
                        📊 Comparaison équipes
                    </button>
                </div>

                <div class="chat-history">
                    <h6><i class="fas fa-history"></i> Historique récent</h6>
                    <div class="mb-2">
                        <input type="text" id="historySearch" class="form-control form-control-sm" placeholder="Rechercher..." style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: var(--text-primary);">
                    </div>
                    <div id="chatHistory" class="small">
                        <!-- Historique des conversations -->
                    </div>
                    <button class="btn btn-sm btn-outline-light mt-2 w-100" id="loadHistory">
                        <i class="fas fa-sync"></i> Actualiser
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Variables globales
let chatHistory = [];
let isTyping = false;
let theme = 'dark';

// Fonctions utilitaires
function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function nl2br(text) {
    return escapeHtml(text).replace(/\n/g, '<br>');
}

function formatTimestamp() {
    return new Date().toLocaleTimeString('fr-FR', {
        hour: '2-digit',
        minute: '2-digit'
    });
}

function createParticles() {
    const particlesContainer = document.getElementById('particles');
    for (let i = 0; i < 50; i++) {
        const particle = document.createElement('div');
        particle.className = 'particle';
        particle.style.left = Math.random() * 100 + '%';
        particle.style.animationDelay = Math.random() * 15 + 's';
        particle.style.animationDuration = (Math.random() * 10 + 15) + 's';
        particlesContainer.appendChild(particle);
    }
}

function showTypingIndicator() {
    isTyping = true;
    document.getElementById('typingIndicator').style.display = 'block';
    document.getElementById('chatBox').scrollTop = document.getElementById('chatBox').scrollHeight;
}

function hideTypingIndicator() {
    isTyping = false;
    document.getElementById('typingIndicator').style.display = 'none';
}

function appendMessage(sender, text, isUser = false, timestamp = null) {
    const chatBox = document.getElementById('chatBox');
    const messageDiv = document.createElement('div');
    messageDiv.className = `message ${isUser ? 'user' : 'bot'}`;

    const avatar = isUser ? '👤' : '🤖';
    const time = timestamp || formatTimestamp();

    messageDiv.innerHTML = `
        <div class="message-avatar">${avatar}</div>
        <div class="message-content">
            <div class="fw-bold mb-1">${isUser ? 'Vous' : 'AI Assistant'}</div>
            <div>${nl2br(text)}</div>
            <small class="text-muted mt-1 d-block">${time}</small>
        </div>
    `;

    chatBox.appendChild(messageDiv);
    chatBox.scrollTop = chatBox.scrollHeight;

    // Animation d'entrée
    setTimeout(() => {
        messageDiv.style.opacity = '1';
        messageDiv.style.transform = 'translateY(0)';
    }, 10);

    // Ajouter à l'historique
    chatHistory.push({
        sender: isUser ? 'user' : 'bot',
        text: text,
        timestamp: time
    });

    updateChatHistory();
}

function updateChatHistory(searchTerm = '') {
    const historyDiv = document.getElementById('chatHistory');
    let filteredHistory = chatHistory.slice(-10); // Derniers 10 éléments

    if (searchTerm) {
        filteredHistory = chatHistory.filter(item =>
            item.text.toLowerCase().includes(searchTerm.toLowerCase())
        );
    }

    historyDiv.innerHTML = filteredHistory.map(item => `
        <div class="mb-2 p-2 rounded" style="background: rgba(255,255,255,0.05); font-size: 12px; cursor: pointer;" onclick="loadFromHistory('${item.timestamp}')">
            <strong>${item.sender === 'user' ? 'Vous:' : 'AI:'}</strong> ${item.text.substring(0, 50)}${item.text.length > 50 ? '...' : ''}
            <br><small class="text-muted">${item.timestamp}</small>
        </div>
    `).join('');

    if (filteredHistory.length === 0 && searchTerm) {
        historyDiv.innerHTML = '<div class="text-muted small">Aucun résultat trouvé</div>';
    }
}

async function loadConversationHistory() {
    try {
        const res = await fetch('{{ path('depense_chatbot_history') }}', {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'include'
        });

        if (res.ok) {
            const data = await res.json();
            if (data.history) {
                // Convertir l'historique de la DB en format local
                chatHistory = data.history.map(item => ({
                    sender: 'user',
                    text: item.userMessage,
                    timestamp: item.createdAt
                })).concat(data.history.map(item => ({
                    sender: 'bot',
                    text: item.aiResponse,
                    timestamp: item.createdAt
                }))).sort((a, b) => new Date(a.timestamp) - new Date(b.timestamp));

                updateChatHistory();
            }
        }
    } catch (error) {
        console.log('Erreur lors du chargement de l\'historique:', error);
    }
}

function showToast(message, type = 'info', duration = 3000) {
    const toastContainer = document.getElementById('toastContainer');
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.innerHTML = `
        <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'}"></i>
        <span>${message}</span>
    `;

    toastContainer.appendChild(toast);

    setTimeout(() => {
        toast.style.animation = 'slideOutRight 0.3s ease-out';
        setTimeout(() => toast.remove(), 300);
    }, duration);
}

function loadFromHistory(timestamp) {
    // Trouver la conversation correspondante et la recharger dans le chat
    const conversation = chatHistory.find(h => h.timestamp === timestamp);
    if (conversation && conversation.sender === 'user') {
        document.getElementById('chatInput').value = conversation.text;
        document.getElementById('chatInput').focus();
        showToast('Message chargé depuis l\'historique', 'info');
    }
}

function processCommand(message) {
    const command = message.toLowerCase().trim();

    if (command === '/help') {
        return `📋 **Commandes disponibles :**
• /help - Afficher cette aide
• /clear - Effacer la conversation
• /stats - Statistiques de la session
• /export - Exporter la conversation
• /theme - Changer de thème

💡 **Questions suggérées :**
• "Analyse budgétaire complète"
• "Équipes en difficulté"
• "Optimisations possibles"
• "Historique des dépenses"`;
    }

    if (command === '/clear') {
        document.getElementById('chatBox').innerHTML = '';
        chatHistory = [];
        updateChatHistory();
        return '🧹 Conversation effacée !';
    }

    if (command === '/stats') {
        const userMessages = chatHistory.filter(h => h.sender === 'user').length;
        const botMessages = chatHistory.filter(h => h.sender === 'bot').length;
        return `📊 **Statistiques de session :**
• Messages utilisateur : ${userMessages}
• Réponses IA : ${botMessages}
• Durée : ${Math.floor((new Date() - new Date(chatHistory[0]?.timestamp || Date.now())) / 1000 / 60)} min
• Thème : ${theme === 'dark' ? 'Sombre 🌙' : 'Clair ☀️'}`;
    }

    if (command === '/export') {
        const exportData = chatHistory.map(h => `[${h.timestamp}] ${h.sender.toUpperCase()}: ${h.text}`).join('\n\n');
        const blob = new Blob([exportData], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `chat-export-${new Date().toISOString().split('T')[0]}.txt`;
        a.click();
        URL.revokeObjectURL(url);
        return '📁 Conversation exportée !';
    }

    if (command === '/theme') {
        toggleTheme();
        return `🎨 Thème changé vers ${theme === 'dark' ? 'sombre 🌙' : 'clair ☀️'}`;
    }

    return null; // Not a command
}

function toggleTheme() {
    const root = document.documentElement;
    theme = theme === 'dark' ? 'light' : 'dark';

    if (theme === 'light') {
        root.style.setProperty('--dark-bg', '#f8f9fa');
        root.style.setProperty('--dark-card', 'rgba(255, 255, 255, 0.9)');
        root.style.setProperty('--text-primary', '#212529');
        root.style.setProperty('--text-secondary', '#6c757d');
        root.style.setProperty('--glass-bg', 'rgba(255, 255, 255, 0.8)');
        root.style.setProperty('--glass-border', 'rgba(0, 0, 0, 0.1)');
        document.getElementById('themeToggle').innerHTML = '<i class="fas fa-sun"></i>';
    } else {
        root.style.setProperty('--dark-bg', '#0a0a0a');
        root.style.setProperty('--dark-card', 'rgba(15, 15, 15, 0.9)');
        root.style.setProperty('--text-primary', '#ffffff');
        root.style.setProperty('--text-secondary', '#b0b0b0');
        root.style.setProperty('--glass-bg', 'rgba(255, 255, 255, 0.1)');
        root.style.setProperty('--glass-border', 'rgba(255, 255, 255, 0.2)');
        document.getElementById('themeToggle').innerHTML = '<i class="fas fa-moon"></i>';
    }

    localStorage.setItem('chatbot-theme', theme);
}

async function sendMessage(message) {
    if (isTyping || !message.trim()) return;

    isTyping = true;
    document.getElementById('chatSendBtn').disabled = true;

    appendMessage('Vous', message, true);

    // Vérifier si c'est une commande
    const commandResponse = processCommand(message);
    if (commandResponse) {
        setTimeout(() => {
            appendMessage('AI Assistant', commandResponse, false);
            isTyping = false;
            document.getElementById('chatSendBtn').disabled = false;
            document.getElementById('chatInput').focus();
        }, 500);
        return;
    }

    showTypingIndicator();

    try {
        const body = new URLSearchParams();
        body.set('message', message);

        const res = await fetch('{{ path('depense_chatbot_ask') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: body.toString(),
            credentials: 'include'
        });

        let data;
        const responseText = await res.text();
        
        try {
            data = JSON.parse(responseText);
        } catch (jsonError) {
            console.error('Failed to parse JSON response:', res.status, responseText.substring(0, 500));
            throw new Error('Invalid response from server - Status: ' + res.status);
        }

        hideTypingIndicator();

        if (res.ok && data.reply) {
            appendMessage('AI Assistant', data.reply, false);
        } else if (res.status === 403) {
            appendMessage('AI Assistant', '❌ Accès refusé. Vous devez avoir le rôle Manager ou Admin.', false);
            showToast('Authentification requise', 'error');
        } else if (res.status === 401) {
            appendMessage('AI Assistant', '❌ Non authentifié. Veuillez vous reconnecter.', false);
            showToast('Reconnecter requis', 'error');
        } else {
            appendMessage('AI Assistant', data.error || 'Erreur lors de la réponse IA. Réessayez.', false);
            showToast('Erreur lors de la réponse IA', 'error');
        }
    } catch (error) {
        hideTypingIndicator();
        console.error('Error:', error);
        appendMessage('AI Assistant', '❌ Erreur réseau: ' + error.message, false);
        showToast('Erreur réseau: ' + error.message, 'error');
    } finally {
        isTyping = false;
        document.getElementById('chatSendBtn').disabled = false;
        document.getElementById('chatInput').focus();
    }
}

// Initialisation
document.addEventListener('DOMContentLoaded', function() {
    createParticles();

    // Restaurer le thème
    const savedTheme = localStorage.getItem('chatbot-theme') || 'dark';
    if (savedTheme === 'light') {
        theme = 'dark'; // Pour déclencher le toggle
        toggleTheme();
    }

    const chatInput = document.getElementById('chatInput');
    const chatSendBtn = document.getElementById('chatSendBtn');
    const quickPrompts = document.querySelectorAll('.quick-btn');
    const themeToggle = document.getElementById('themeToggle');
    const clearChat = document.getElementById('clearChat');
    const exportChat = document.getElementById('exportChat');
    const loadHistory = document.getElementById('loadHistory');
    const historySearch = document.getElementById('historySearch');

    // Gestionnaire d'input
    chatInput.addEventListener('input', function() {
        chatSendBtn.disabled = !this.value.trim();
    });

    chatInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            const message = this.value.trim();
            if (message) {
                this.value = '';
                sendMessage(message);
            }
        }
    });

    // Bouton envoyer
    chatSendBtn.addEventListener('click', function() {
        const message = chatInput.value.trim();
        if (message) {
            chatInput.value = '';
            sendMessage(message);
        }
    });

    // Actions rapides
    quickPrompts.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const text = this.getAttribute('data-text') || '';
            if (text.trim()) {
                // Clear input and send message immediately
                chatInput.value = '';
                sendMessage(text);
            }
        });
    });

    // Toggle thème
    themeToggle.addEventListener('click', toggleTheme);

    // Effacer chat
    clearChat.addEventListener('click', function() {
        if (confirm('Êtes-vous sûr de vouloir effacer la conversation ?')) {
            document.getElementById('chatBox').innerHTML = '';
            chatHistory = [];
            updateChatHistory();
            showToast('Conversation effacée', 'success');
        }
    });

    // Exporter chat
    exportChat.addEventListener('click', function() {
        processCommand('/export');
        showToast('Conversation exportée', 'success');
    });

    // Charger historique
    loadHistory.addEventListener('click', function() {
        loadConversationHistory();
        showToast('Historique actualisé', 'info');
    });

    // Recherche dans l'historique
    historySearch.addEventListener('input', function() {
        updateChatHistory(this.value);
    });

    // Focus initial
    chatForm.focus();

    // Animation d'entrée
    setTimeout(() => {
        document.querySelector('.chatbot-container').style.opacity = '1';
    }, 100);

    // Charger l'historique au démarrage
    loadConversationHistory();
});
</script>
                            <div>
