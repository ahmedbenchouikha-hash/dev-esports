                                <ul class="mb-0 mt-2">
                                    <li>Analyser les budgets par équipe</li>
                                    <li>Calculer les restes et dépassements</li>
                                    <li>Suggérer des répartitions optimisées</li>
                                    <li>Répondre à des questions spécifiques</li>
                                    <li>Fournir des résumés détaillés</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <form id="chatForm" class="p-3 border-top">
                    <div class="input-group">
                        <input
                            type="text"
                            id="chatInput"
                            class="form-control"
                            placeholder="Pose-moi une question sur le budget, les dépenses, les équipes..."
                            required
                        >
                        <button id="chatSendBtn" class="btn btn-primary" type="submit">
                            <i class="fas fa-paper-plane"></i> Send
                        </button>
