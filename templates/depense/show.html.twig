{% extends 'base.html.twig' %}

{% block title %}Expense Details - Dev Esports{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="page-title">💰 Expense Details</h1>
                <div>
                    <a href="{{ path('depense_edit', {id: depense.id}) }}" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a href="{{ path('depense_index') }}" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">{{ depense.titre }}</h5>
                </div>
                <div class="card-body">
                    <!-- Amount -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted">Amount:</label>
                            <h4 class="text-success">{{ depense.montant|number_format(2, ',', ' ') }}€</h4>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted">Status:</label>
                            {% if depense.statut == 'validée' %}
                                <span class="badge bg-success fs-6">Approved</span>
                            {% elseif depense.statut == 'refusée' %}
                                <span class="badge bg-danger fs-6">Rejected</span>
                            {% else %}
                                <span class="badge bg-warning fs-6">Pending</span>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted">Category:</label>
                            {% if depense.categorie == 'materiel' %}
                                <p><span class="badge bg-info">Material</span></p>
                            {% elseif depense.categorie == 'transport' %}
                                <p><span class="badge bg-primary">Transport</span></p>
                            {% elseif depense.categorie == 'logistique' %}
                                <p><span class="badge bg-secondary">Logistics</span></p>
                            {% elseif depense.categorie == 'nourriture' %}
                                <p><span class="badge bg-success">Food</span></p>
                            {% else %}
                                <p><span class="badge bg-warning">Other</span></p>
                            {% endif %}
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted">Team:</label>
                            {% if depense.team %}
                                <p><a href="{{ path('team_show', {id: depense.team.id}) }}" class="link-primary">{{ depense.team.name }}</a></p>
                            {% else %}
                                <p class="text-muted">-</p>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Date -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted">Created Date:</label>
                            <p>{{ depense.dateCreation|date('d/m/Y H:i') }}</p>
                        </div>
                    </div>

                    <!-- Description -->
                    {% if depense.description %}
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="text-muted">Description:</label>
                                <p>{{ depense.description }}</p>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="card">
                <div class="card-body">
                    {% if depense.statut == 'en_attente' %}
                        <p class="mb-2"><strong>Approve or Reject this expense:</strong></p>
                        <div class="d-flex gap-2">
                            <form method="POST" action="{{ path('depense_valider', {id: depense.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('valider' ~ depense.id) }}">
                                <button type="submit" class="btn btn-success" onclick="return confirm('Approve this expense?')">
                                    <i class="fas fa-check"></i> Approve
                                </button>
                            </form>

                            <form method="POST" action="{{ path('depense_refuser', {id: depense.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('refuser' ~ depense.id) }}">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Reject this expense?')">
                                    <i class="fas fa-times"></i> Reject
                                </button>
                            </form>
                        </div>
                    {% else %}
                        <p class="text-muted"><strong>Status:</strong> This expense has already been {{ depense.statut == 'validée' ? 'approved' : 'rejected' }}.</p>
                    {% endif %}

                    <hr>

                    <form method="POST" action="{{ path('depense_delete', {id: depense.id}) }}" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ depense.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete this expense? This action cannot be undone.')">
                            <i class="fas fa-trash"></i> Delete Expense
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
