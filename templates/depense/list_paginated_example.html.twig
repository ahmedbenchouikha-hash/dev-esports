{# Exemple template de liste des dépenses avec pagination #}

{% extends 'base.html.twig' %}

{% block title %}Liste des Dépenses - Pagination{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Dépenses</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('depense_new') }}" class="btn btn-primary">+ Nouvelle Dépense</a>
        </div>
    </div>

    {# Filtres (optionnel) #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="GET" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="titre" class="form-control" placeholder="Rechercher par titre...">
                </div>
                <div class="col-md-3">
                    <select name="categorie" class="form-select">
                        <option value="">-- Catégorie --</option>
                        <option value="Salaires">Salaires</option>
                        <option value="Équipement">Équipement</option>
                        <option value="Transport">Transport</option>
                        <option value="Autre">Autre</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="statut" class="form-select">
                        <option value="">-- Statut --</option>
                        <option value="en_attente">En attente</option>
                        <option value="approuvé">Approuvé</option>
                        <option value="refusé">Refusé</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100">Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    {# Table des dépenses #}
    <div class="card">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>
                        <a href="?sort=titre&direction={% if 'titre' == app.request.get('sort') and 'asc' == app.request.get('direction') %}desc{% else %}asc{% endif %}" 
                           class="text-decoration-none">
                            Titre
                            {% if 'titre' == app.request.get('sort') %}
                                <i class="fas fa-arrow-{% if 'asc' == app.request.get('direction') %}up{% else %}down{% endif %}"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th>
                        <a href="?sort=montant&direction={% if 'montant' == app.request.get('sort') and 'asc' == app.request.get('direction') %}desc{% else %}asc{% endif %}"
                           class="text-decoration-none">
                            Montant
                            {% if 'montant' == app.request.get('sort') %}
                                <i class="fas fa-arrow-{% if 'asc' == app.request.get('direction') %}up{% else %}down{% endif %}"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th>Catégorie</th>
                    <th>Équipe</th>
                    <th>Statut</th>
                    <th>
                        <a href="?sort=date_creation&direction={% if 'date_creation' == app.request.get('sort') and 'asc' == app.request.get('direction') %}desc{% else %}asc{% endif %}"
                           class="text-decoration-none">
                            Date
                            {% if 'date_creation' == app.request.get('sort') %}
                                <i class="fas fa-arrow-{% if 'asc' == app.request.get('direction') %}up{% else %}down{% endif %}"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for depense in pagination %}
                <tr>
                    <td><strong>{{ depense.titre }}</strong></td>
                    <td>
                        <span class="badge bg-info">{{ depense.montant|number_format(2, ',', '.') }} €</span>
                    </td>
                    <td>
                        <span class="badge bg-secondary">{{ depense.categorie ?? 'N/A' }}</span>
                    </td>
                    <td>{{ depense.team.name ?? '-' }}</td>
                    <td>
                        {% if depense.statut == 'en_attente' %}
                            <span class="badge bg-warning">En attente</span>
                        {% elseif depense.statut == 'approuvé' %}
                            <span class="badge bg-success">Approuvé</span>
                        {% else %}
                            <span class="badge bg-danger">Refusé</span>
                        {% endif %}
                    </td>
                    <td>{{ depense.date_creation|date('d/m/Y') }}</td>
                    <td>
                        <a href="{{ path('depense_show', {'id': depense.id}) }}" class="btn btn-sm btn-info">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="{{ path('depense_edit', {'id': depense.id}) }}" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a href="{{ path('depense_delete', {'id': depense.id}) }}" class="btn btn-sm btn-danger" 
                           onclick="return confirm('Êtes-vous sûr ?')">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">
                        Aucune dépense trouvée
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    <nav class="mt-4" aria-label="Pagination">
        <div class="d-flex justify-content-between align-items-center">
            <div class="text-muted">
                Total: <strong>{{ pagination.getTotalItemCount() }}</strong> dépenses
            </div>
            
            {{ knp_pagination_render(pagination, 'pagination', {}, {
                'pageParameterName': 'page',
                'sortDirectionParameterName': 'direction'
            }) }}
            
            <div class="text-muted">
                Page <strong>{{ pagination.getCurrentPageNumber() }}</strong> 
                sur <strong>{{ pagination.getLastPageNumber() }}</strong>
            </div>
        </div>
    </nav>

</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }
    
    .badge {
        padding: 0.5rem 0.75rem;
        font-weight: 500;
    }
</style>
{% endblock %}
