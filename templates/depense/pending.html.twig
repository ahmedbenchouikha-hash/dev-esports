{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="page-title">⏳ Pending Expenses</h1>
            <a href="{{ path('depense_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Expenses
            </a>
        </div>
    </div>
</div>

<!-- Pending Expenses List -->
<div class="row">
    <div class="col-md-12">
        {% if depenses is empty %}
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> No pending expenses. All expenses have been processed!
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Title</th>
                            <th>Amount</th>
                            <th>Category</th>
                            <th>Team</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for depense in depenses %}
                            <tr>
                                <td><strong>{{ depense.titre }}</strong></td>
                                <td class="text-warning"><strong>{{ depense.montant|number_format(2, ',', ' ') }}€</strong></td>
                                <td>
                                    {% if depense.categorie == 'materiel' %}
                                        <span class="badge bg-info">Material</span>
                                    {% elseif depense.categorie == 'transport' %}
                                        <span class="badge bg-primary">Transport</span>
                                    {% elseif depense.categorie == 'logistique' %}
                                        <span class="badge bg-secondary">Logistics</span>
                                    {% elseif depense.categorie == 'nourriture' %}
                                        <span class="badge bg-success">Food</span>
                                    {% else %}
                                        <span class="badge bg-warning">Other</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if depense.team %}
                                        <a href="{{ path('team_show', {id: depense.team.id}) }}">{{ depense.team.name }}</a>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td><small class="text-muted">{{ depense.dateCreation|date('d/m/Y H:i') }}</small></td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="{{ path('depense_show', {id: depense.id}) }}" class="btn btn-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        
                                        <form method="POST" action="{{ path('depense_valider', {id: depense.id}) }}" style="display:inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('valider' ~ depense.id) }}">
                                            <button type="submit" class="btn btn-success btn-sm" title="Approve" onclick="return confirm('Approve this expense?')">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>

                                        <form method="POST" action="{{ path('depense_refuser', {id: depense.id}) }}" style="display:inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('refuser' ~ depense.id) }}">
                                            <button type="submit" class="btn btn-danger btn-sm" title="Reject" onclick="return confirm('Reject this expense?')">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="alert alert-warning mt-3">
                <strong>⚠️ {{ depenses|length }} expense(s) awaiting approval</strong>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
