{% extends 'base.html.twig' %}

{% block title %}Create Expense - Dev Esports{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="page-title mb-4">💰 Create New Expense</h1>
            
            <!-- Flash Messages -->
            {% if app.flashes %}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endif %}

            <div class="card">
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'form', 'novalidate': true}}) }}
                    
                    <!-- Title -->
                    <div class="mb-3">
                        {{ form_label(form.titre, 'Expense Title *') }}
                        {{ form_widget(form.titre, {'attr': {'placeholder': 'Enter expense title', 'class': 'form-control'}}) }}
                        {% if form.titre.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.titre) }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Amount -->
                    <div class="mb-3">
                        {{ form_label(form.montant, 'Amount (€) *') }}
                        {{ form_widget(form.montant, {'attr': {'placeholder': '0.00', 'class': 'form-control'}}) }}
                        {% if form.montant.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.montant) }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        {{ form_label(form.categorie, 'Category *') }}
                        {{ form_widget(form.categorie, {'attr': {'class': 'form-control'}}) }}
                        {% if form.categorie.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.categorie) }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Team -->
                    <div class="mb-3">
                        {{ form_label(form.team, 'Team *') }}
                        {{ form_widget(form.team, {'attr': {'class': 'form-control'}}) }}
                        {% if form.team.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.team) }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        {{ form_label(form.description, 'Description') }}
                        {{ form_widget(form.description, {'attr': {'placeholder': 'Enter description', 'class': 'form-control', 'rows': 4}}) }}
                        {% if form.description.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.description) }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Submit Buttons -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Create Expense
                        </button>
                        <a href="{{ path('depense_index') }}" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
