{% extends 'emails/base.html.twig' %}

{% block title %}Payment Failed{% endblock %}

{% block content %}
<div style="max-width: 600px; margin: 0 auto;">
    <!-- Error Header -->
    <div style="background: linear-gradient(135deg, #dc3545 0%, #ff6b6b 100%); padding: 30px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 28px;">
            ❌ Payment Failed
        </h1>
        <p style="color: rgba(255,255,255,0.9); margin: 10px 0 0 0;">Unfortunately, we couldn't process your payment</p>
    </div>

    <!-- Main Content -->
    <div style="background: #f8f9fa; padding: 30px; border-radius: 0 0 8px 8px;">
        
        <!-- Message -->
        <div style="background: white; padding: 20px; border-left: 4px solid #dc3545; margin-bottom: 20px; border-radius: 4px;">
            <p style="margin: 0; color: #666; font-size: 16px;">
                We attempted to charge your payment method for:
            </p>
            <p style="margin: 15px 0 0 0; font-size: 18px; font-weight: bold; color: #333;">
                {{ ticketType|capitalize }} Ticket - {{ matchTitle }}
            </p>
        </div>

        <!-- Possible Reasons -->
        <div style="background: white; padding: 20px; border-left: 4px solid #ffc107; margin-bottom: 20px; border-radius: 4px;">
            <h3 style="margin-top: 0; color: #856404;">⚠️ Possible Reasons:</h3>
            <ul style="margin: 10px 0; padding-left: 20px; color: #666;">
                <li>Insufficient funds on your card</li>
                <li>Card has expired or is no longer valid</li>
                <li>Card issuer declined the transaction</li>
                <li>Incorrect CVV or billing information</li>
                <li>Connection issue - please try again</li>
            </ul>
        </div>

        <!-- What to Do -->
        <div style="background: #e7f3ff; padding: 20px; border-radius: 4px; margin-bottom: 20px; border-left: 4px solid #0066cc;">
            <h3 style="margin-top: 0; color: #0066cc;">What you can do:</h3>
            <ol style="margin: 10px 0; padding-left: 20px; color: #666;">
                <li>Check your card details and try again</li>
                <li>Try a different payment method</li>
                <li>Contact your bank if you suspect fraud</li>
                <li>Use a different card if available</li>
            </ol>
        </div>

        <!-- CTA Button -->
        <div style="text-align: center; margin: 30px 0;">
            <a href="https://dev-esports.com/ticket/payment/checkout" 
               style="background: linear-gradient(135deg, #b622d1 0%, #00d9ff 100%); color: white; padding: 12px 30px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">
                Try Again
            </a>
        </div>

        <!-- Ticket Still Available -->
        <div style="background: #d4edda; padding: 15px; border-radius: 4px; border-left: 4px solid #28a745; margin-bottom: 20px;">
            <p style="margin: 0; color: #155724;">
                <strong>Good news!</strong> Your ticket is still available. Please try purchasing again within the next 24 hours.
            </p>
        </div>

        <!-- Support -->
        <div style="background: #f0f0f0; padding: 20px; border-radius: 4px; text-align: center; color: #666; font-size: 14px;">
            <p style="margin: 0;">Still having issues? Contact us at <strong>support@dev-esports.com</strong></p>
            <p style="margin: 5px 0 0 0;">We're here to help! Response time: 24-48 hours</p>
        </div>
    </div>
</div>
{% endblock %}
