{% extends 'base.html.twig' %}

{% block title %}Admin - Team Details - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <a href="{{ path('admin_team_index') }}" class="btn btn-outline-primary btn-sm">← Back to Teams</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-body">
                <h1 class="page-title">{{ team.name }}</h1>
                
                {% if team.country %}
                    <p class="text-muted">📍 {{ team.country }}</p>
                {% endif %}
                
                {% if team.description %}
                    <p>{{ team.description }}</p>
                {% endif %}
                
                <hr>
                
                <p><strong>👥 Players:</strong> {{ team.players|length }}</p>
                <p><strong>🎮 Matches:</strong> {{ (team.gamesAsTeam1|length) + (team.gamesAsTeam2|length) }}</p>
                <p><strong>Created:</strong> {{ team.createdAt|date('d M Y - H:i') }}</p>
                <p><strong>Updated:</strong> {{ team.updatedAt|date('d M Y - H:i') }}</p>

                <hr>

                <!-- Action Buttons -->
                <div class="text-center">
                    <a href="{{ path('admin_team_edit', { id: team.id }) }}" class="btn btn-warning">Edit Team</a>
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete Team</button>
                    <a href="{{ path('admin_team_index') }}" class="btn btn-outline-primary">Back to Teams</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background-color: var(--secondary-color);">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this team?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ path('admin_team_delete', { id: team.id }) }}" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ team.id) }}">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
