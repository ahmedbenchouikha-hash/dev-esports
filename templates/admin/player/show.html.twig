{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <a href="{{ path('admin_player_index') }}" class="btn btn-outline-primary btn-sm">← Back to Players</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-body">
                <h1 class="page-title">{{ player.nickname }}</h1>
                
                <p><strong>👤 Full Name:</strong> {{ player.firstName }} {{ player.lastName }}</p>
                <p><strong>🎮 Team:</strong> {{ player.team.name ?? '-' }}</p>
                <p><strong>Role:</strong> {{ player.role ?? '-' }}</p>
                <p><strong>📅 Birth Date:</strong> {{ player.birthDate ? player.birthDate|date('d M Y') : '-' }}</p>
                
                <hr>
                
                <p><strong>Created:</strong> {{ player.createdAt|date('d M Y - H:i') }}</p>
                <p><strong>Updated:</strong> {{ player.updatedAt|date('d M Y - H:i') }}</p>

                <hr>

                <!-- Action Buttons -->
                <div class="text-center">
                    <a href="{{ path('admin_player_edit', { id: player.id }) }}" class="btn btn-warning">Edit Player</a>
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete Player</button>
                    <a href="{{ path('admin_player_index') }}" class="btn btn-outline-primary">Back to Players</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background-color: var(--secondary-color);">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this player?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ path('admin_player_delete', { id: player.id }) }}" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ player.id) }}">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
