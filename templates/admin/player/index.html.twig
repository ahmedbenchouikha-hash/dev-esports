{% extends 'base.html.twig' %}

{% block title %}Admin - Manage Players - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-6">
        <h1 class="page-title">⚙️ Manage Players</h1>
    </div>
    <div class="col-md-6 text-end">
        <a href="{{ path('admin_player_create') }}" class="btn btn-primary">+ Create Player</a>
    </div>
</div>

<!-- Search Section -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-9">
                        <input type="text" name="search" class="form-control" placeholder="Search by nickname, first name or last name..." value="{{ search }}">
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">Search</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Players Table -->
<div class="row">
    <div class="col-md-12">
        {% if players is empty %}
            <div class="alert alert-info">
                No players found.
            </div>
        {% else %}
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Nickname</th>
                                <th>Name</th>
                                <th>Team</th>
                                <th>Role</th>
                                <th>Birth Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for player in players %}
                                <tr>
                                    <td><strong>{{ player.nickname }}</strong></td>
                                    <td>{{ player.firstName }} {{ player.lastName }}</td>
                                    <td>{{ player.team.name ?? '-' }}</td>
                                    <td>{{ player.role ?? '-' }}</td>
                                    <td>{{ player.birthDate ? player.birthDate|date('d M Y') : '-' }}</td>
                                    <td>
                                        <a href="{{ path('admin_player_show', { id: player.id }) }}" class="btn btn-sm btn-info">View</a>
                                        <a href="{{ path('admin_player_edit', { id: player.id }) }}" class="btn btn-sm btn-warning">Edit</a>
                                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ player.id }}">Delete</button>
                                    </td>
                                </tr>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal{{ player.id }}" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content" style="background-color: var(--secondary-color);">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Confirm Delete</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete this player?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form method="POST" action="{{ path('admin_player_delete', { id: player.id }) }}" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ player.id) }}">
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
