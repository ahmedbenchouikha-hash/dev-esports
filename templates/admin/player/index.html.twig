{% extends 'base.html.twig' %}

{% block title %}Admin - Manage Players - RankUp{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-6">
        <h1 class="page-title">⚙️ Manage Players</h1>
    </div>
    <div class="col-md-6 text-end">
        <a href="{{ path('admin_player_create') }}" class="btn btn-primary">+ Create Player</a>
    </div>
</div>

<!-- Search & Filter Section -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Search Player</label>
                        <input type="text" name="search" class="form-control" placeholder="Nickname, first name or last name..." value="{{ search }}">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Filter by Team</label>
                        <select name="team" class="form-select">
                            <option value="">-- All Teams --</option>
                            {% for t in allTeams %}
                                <option value="{{ t.id }}" {% if team == t.id %}selected{% endif %}>{{ t.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Filter by Role</label>
                        <select name="role" class="form-select">
                            <option value="">-- All Roles --</option>
                            {% for r in allRoles %}
                                <option value="{{ r }}" {% if role == r %}selected{% endif %}>{{ r }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Sort By</label>
                        <select name="sort" class="form-select">
                            <option value="nickname" {% if sort == 'nickname' %}selected{% endif %}>Nickname</option>
                            <option value="firstName" {% if sort == 'firstName' %}selected{% endif %}>First Name</option>
                            <option value="lastName" {% if sort == 'lastName' %}selected{% endif %}>Last Name</option>
                            <option value="role" {% if sort == 'role' %}selected{% endif %}>Role</option>
                            <option value="createdAt" {% if sort == 'createdAt' %}selected{% endif %}>Newest</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search"></i> Apply Filters
                        </button>
                        {% if search or team or role %}
                            <a href="{{ path('admin_player_index') }}" class="btn btn-secondary w-100 mt-2">
                                <i class="fas fa-times"></i> Clear Filters
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Players Table -->
<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                {% if players is not empty %}
                    <p class="text-muted">
                        <strong>{{ players|length }}</strong> player{{ players|length != 1 ? 's' : '' }} found
                        {% if search or team or role %}
                            <span class="badge bg-info">Filtered</span>
                        {% endif %}
                    </p>
                {% endif %}
            </div>
        </div>

        {% if players is empty %}
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No players found matching your criteria.
            </div>
        {% else %}
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Nickname</th>
                                <th>Name</th>
                                <th>Team</th>
                                <th>Role</th>
                                <th>Birth Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for player in players %}
                                <tr>
                                    <td><strong>{{ player.nickname }}</strong></td>
                                    <td>{{ player.firstName }} {{ player.lastName }}</td>
                                    <td>{{ player.team.name ?? '-' }}</td>
                                    <td><span class="badge bg-secondary">{{ player.role ?? '-' }}</span></td>
                                    <td>{{ player.birthDate ? player.birthDate|date('d M Y') : '-' }}</td>
                                    <td>
                                        <a href="{{ path('admin_player_show', { id: player.id }) }}" class="btn btn-sm btn-info">View</a>
                                        <a href="{{ path('admin_player_edit', { id: player.id }) }}" class="btn btn-sm btn-warning">Edit</a>
                                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ player.id }}">Delete</button>
                                    </td>
                                </tr>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal{{ player.id }}" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content" style="background-color: var(--secondary-color);">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Confirm Delete</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete this player?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form method="POST" action="{{ path('admin_player_delete', { id: player.id }) }}" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ player.id) }}">
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
