{% extends 'base.html.twig' %}

{% block title %}Tournament Registrations - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>
                    <i class="fas fa-clipboard-list"></i> Tournament Registrations
                </h1>
                <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4" id="registrationTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                        <i class="fas fa-clock"></i> Pending 
                        <span class="badge bg-warning">{{ pendingRegistrations|length }}</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approved" type="button" role="tab">
                        <i class="fas fa-check"></i> Approved 
                        <span class="badge bg-success">{{ approvedRegistrations|length }}</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="rejected-tab" data-bs-toggle="tab" data-bs-target="#rejected" type="button" role="tab">
                        <i class="fas fa-times"></i> Rejected 
                        <span class="badge bg-danger">{{ rejectedRegistrations|length }}</span>
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="registrationTabsContent">
                <!-- Pending Tab -->
                <div class="tab-pane fade show active" id="pending" role="tabpanel">
                    <div class="card shadow-sm">
                        <div class="card-header bg-warning text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-clock"></i> Pending Registrations ({{ pendingRegistrations|length }})
                            </h5>
                        </div>
                        <div class="card-body">
                            {% if pendingRegistrations is empty %}
                                <div class="alert alert-info mb-0">
                                    <i class="fas fa-info-circle"></i> No pending registrations.
                                </div>
                            {% else %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Tournament</th>
                                                <th>Team</th>
                                                <th>Player</th>
                                                <th>Submitted</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for registration in pendingRegistrations %}
                                                <tr>
                                                    <td>#{{ registration.id }}</td>
                                                    <td>
                                                        <strong>{{ registration.tournament.name }}</strong>
                                                    </td>
                                                    <td>
                                                        <strong>{{ registration.team.name }}</strong>
                                                    </td>
                                                    <td>
                                                        {{ registration.player.nickname }}<br>
                                                        <small class="text-muted">{{ registration.player.email }}</small>
                                                    </td>
                                                    <td>
                                                        {{ registration.createdAt|date('Y-m-d H:i') }}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('admin_tournament_registration_show', {'id': registration.id}) }}" 
                                                           class="btn btn-sm btn-primary">
                                                            <i class="fas fa-eye"></i> Review
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Approved Tab -->
                <div class="tab-pane fade" id="approved" role="tabpanel">
                    <div class="card shadow-sm">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-check"></i> Approved Registrations ({{ approvedRegistrations|length }})
                            </h5>
                        </div>
                        <div class="card-body">
                            {% if approvedRegistrations is empty %}
                                <div class="alert alert-info mb-0">
                                    <i class="fas fa-info-circle"></i> No approved registrations.
                                </div>
                            {% else %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Tournament</th>
                                                <th>Team</th>
                                                <th>Player</th>
                                                <th>Approved</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for registration in approvedRegistrations %}
                                                <tr>
                                                    <td>#{{ registration.id }}</td>
                                                    <td>{{ registration.tournament.name }}</td>
                                                    <td>{{ registration.team.name }}</td>
                                                    <td>{{ registration.player.nickname }}</td>
                                                    <td>
                                                        {{ registration.updatedAt|date('Y-m-d H:i') }}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('admin_tournament_registration_show', {'id': registration.id}) }}" 
                                                           class="btn btn-sm btn-info">
                                                            <i class="fas fa-eye"></i> View
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Rejected Tab -->
                <div class="tab-pane fade" id="rejected" role="tabpanel">
                    <div class="card shadow-sm">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-times"></i> Rejected Registrations ({{ rejectedRegistrations|length }})
                            </h5>
                        </div>
                        <div class="card-body">
                            {% if rejectedRegistrations is empty %}
                                <div class="alert alert-info mb-0">
                                    <i class="fas fa-info-circle"></i> No rejected registrations.
                                </div>
                            {% else %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Tournament</th>
                                                <th>Team</th>
                                                <th>Player</th>
                                                <th>Rejected</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for registration in rejectedRegistrations %}
                                                <tr>
                                                    <td>#{{ registration.id }}</td>
                                                    <td>{{ registration.tournament.name }}</td>
                                                    <td>{{ registration.team.name }}</td>
                                                    <td>{{ registration.player.nickname }}</td>
                                                    <td>
                                                        {{ registration.updatedAt|date('Y-m-d H:i') }}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('admin_tournament_registration_show', {'id': registration.id}) }}" 
                                                           class="btn btn-sm btn-info">
                                                            <i class="fas fa-eye"></i> View
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}