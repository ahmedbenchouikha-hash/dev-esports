{% extends 'base.html.twig' %}

{% block title %}My Tournament Registrations{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('tournament_index') }}">Tournaments</a></li>
                    <li class="breadcrumb-item active">My Registrations</li>
                </ol>
            </nav>

            <h1 class="mb-4">
                <i class="fas fa-list"></i> My Tournament Registrations
            </h1>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% if registrations is empty %}
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> 
                    You haven't registered for any tournaments yet. 
                    <a href="{{ path('tournament_available') }}" class="alert-link">Browse available tournaments</a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Tournament</th>
                                <th>Game</th>
                                <th>Dates</th>
                                <th>Team Name</th>
                                <th>Status</th>
                                <th>Registered</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for registration in registrations %}
                                <tr>
                                    <td>
                                        <strong>{{ registration.tournament.name }}</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">{{ registration.tournament.game ?? 'N/A' }}</span>
                                    </td>
                                    <td>
                                        <small>
                                            {{ registration.tournament.startDate|date('M d') }} - 
                                            {{ registration.tournament.endDate|date('M d, Y') }}
                                        </small>
                                    </td>
                                    <td>
                                        {{ registration.teamName }}
                                        {% if registration.teamName != registration.team.name %}
                                            <br><small class="text-muted">(Team: {{ registration.team.name }})</small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if registration.isPending() %}
                                            <span class="badge bg-warning">
                                                <i class="fas fa-clock"></i> Pending Review
                                            </span>
                                        {% elseif registration.isApproved() %}
                                            <span class="badge bg-success">
                                                <i class="fas fa-check"></i> Approved
                                            </span>
                                        {% elseif registration.isRejected() %}
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times"></i> Rejected
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            {{ registration.createdAt|date('M d, Y') }}
                                        </small>
                                    </td>
                                    <td>
                                        <a href="{{ path('tournament_show', {'id': registration.tournament.id}) }}" 
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> View Tournament
                                        </a>
                                        {% if registration.isRejected() and registration.adminNotes %}
                                            <button type="button" class="btn btn-sm btn-outline-danger" 
                                                    data-bs-toggle="modal" data-bs-target="#rejectionModal{{ registration.id }}">
                                                <i class="fas fa-info-circle"></i> Reason
                                            </button>

                                            <!-- Rejection Reason Modal -->
                                            <div class="modal fade" id="rejectionModal{{ registration.id }}" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header bg-danger text-white">
                                                            <h5 class="modal-title">Rejection Reason</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p>{{ registration.adminNotes|nl2br }}</p>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary"