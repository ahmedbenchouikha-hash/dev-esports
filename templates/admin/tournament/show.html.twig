{% extends 'base.html.twig' %}

{% block title %}Admin - Tournament Details - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <a href="{{ path('admin_tournament_index') }}" class="btn btn-outline-primary btn-sm">← Back to Tournaments</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <h1 class="page-title">{{ tournament.name }}</h1>
                    <span class="badge {% if tournament.status == 'completed' %}badge-success{% elseif tournament.status == 'ongoing' %}badge-danger{% elseif tournament.status == 'pending' %}badge-warning{% else %}badge-secondary{% endif %}" style="font-size: 1rem;">
                        {{ tournament.status|capitalize }}
                    </span>
                </div>

                {% if tournament.description %}
                    <p>{{ tournament.description }}</p>
                {% endif %}
                
                <hr>
                
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>📅 Start Date:</strong> {{ tournament.startDate ? tournament.startDate|date('d M Y H:i') : '-' }}</p>
                        <p><strong>📅 End Date:</strong> {{ tournament.endDate ? tournament.endDate|date('d M Y H:i') : '-' }}</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>📍 Location:</strong> {{ tournament.location ?? '-' }}</p>
                        <p><strong>💰 Prize Pool:</strong> {% if tournament.prizePool %}${{ tournament.prizePool|number_format(2) }}{% else %}-{% endif %}</p>
                    </div>
                </div>

                <hr>

                {% if tournament.rules %}
                    <div class="mb-4">
                        <strong>📋 Tournament Rules:</strong>
                        <ul class="mt-2">
                            {% for rule in tournament.rules %}
                                <li>{{ rule }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    <hr>
                {% endif %}
                <p><strong>Created:</strong> {{ tournament.createdAt|date('d M Y - H:i') }}</p>
                <p><strong>Updated:</strong> {{ tournament.updatedAt|date('d M Y - H:i') }}</p>

                <hr>

                <!-- Action Buttons -->
                <div class="text-center">
                    <a href="{{ path('admin_tournament_edit', { id: tournament.id }) }}" class="btn btn-warning">Edit Tournament</a>
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModalTournament{{ tournament.id }}">Delete Tournament</button>
                    <a href="{{ path('admin_tournament_index') }}" class="btn btn-outline-primary">Back to Tournaments</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal - Outside Page Content -->
<div class="modal fade" id="deleteModalTournament{{ tournament.id }}" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="background-color: var(--secondary-color);">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this tournament? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ path('admin_tournament_delete', { id: tournament.id }) }}" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tournament.id) }}">
                    <button type="submit" class="btn btn-danger">Delete Tournament</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
