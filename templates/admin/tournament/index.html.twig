<main>
  <section class="pt-5 pb-5">
    <div class="container">
      <div class="row">
        <div class="col-xl-3 col-lg-3 col-md-4 col-12">
          {# use existing sidebar (bootstrap-friendly) #}
          {{ include('admin/_sidebar.html.twig') }}
        </div>

        <div class="col-lg-9 col-md-8 col-12">
          <div class="card mb-4">
            <div class="p-4 d-flex justify-content-between align-items-center">
              <div>
                <h3 class="mb-0">Manage Tournaments</h3>
                <span>Overview of tournaments</span>
              </div>
              <div class="nav btn-group flex-nowrap">
                <a href="{{ path('admin_tournament_create') }}" class="btn btn-primary">+ Create Tournament</a>
              </div>
            </div>
          </div>

          {# Filters row (light card) #}
          <div class="card mb-4">
            <div class="card-body">
              <form method="get" class="row g-2" action="{{ path('admin_tournament_index') }}">
                <div class="col">
                  <input type="search" name="search" value="{{ search|default('') }}" class="form-control" placeholder="Search by Name">
                </div>
                <div class="col-auto">
                  <select name="status" class="form-control">
                    <option value="">All Status</option>
                    <option value="pending" {{ status == 'pending' ? 'selected' : '' }}>Pending</option>
                    <option value="ongoing" {{ status == 'ongoing' ? 'selected' : '' }}>Ongoing</option>
                    <option value="completed" {{ status == 'completed' ? 'selected' : '' }}>Completed</option>
                    <option value="cancelled" {{ status == 'cancelled' ? 'selected' : '' }}>Cancelled</option>
                  </select>
                </div>
                <div class="col-auto">
                  <button class="btn btn-secondary" type="submit">SEARCH</button>
                </div>
              </form>
            </div>
          </div>

          {# Table view (light Bootstrap table like the second image) #}
          <div class="card mb-4">
            <div class="table-responsive">
              <table class="table table-hover table-centered mb-0 tournaments-table">
                <thead class="table-head">
                  <tr>
                    <th>
                      <a href="{{ path('admin_tournament_index', {sort: 'name', direction: (sort == 'name' and direction == 'ASC') ? 'DESC' : 'ASC', search: search, status: status}) }}" class="sort-link">
                        Name {{ sort == 'name' ? (direction == 'ASC' ? '↑' : '↓') : '↕' }}
                      </a>
                    </th>
                    <th>
                      <a href="{{ path('admin_tournament_index', {sort: 'startDate', direction: (sort == 'startDate' and direction == 'ASC') ? 'DESC' : 'ASC', search: search, status: status}) }}" class="sort-link">
                        Start Date {{ sort == 'startDate' ? (direction == 'ASC' ? '↑' : '↓') : '↕' }}
                      </a>
                    </th>
                    <th>End Date</th>
                    <th>Location</th>
                    <th>
                      <a href="{{ path('admin_tournament_index', {sort: 'prizePool', direction: (sort == 'prizePool' and direction == 'ASC') ? 'DESC' : 'ASC', search: search, status: status}) }}" class="sort-link">
                        Prize Pool {{ sort == 'prizePool' ? (direction == 'ASC' ? '↑' : '↓') : '↕' }}
                      </a>
                    </th>
                    <th>
                      <a href="{{ path('admin_tournament_index', {sort: 'status', direction: (sort == 'status' and direction == 'ASC') ? 'DESC' : 'ASC', search: search, status: status}) }}" class="sort-link">
                        Status {{ sort == 'status' ? (direction == 'ASC' ? '↑' : '↓') : '↕' }}
                      </a>
                    </th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% for t in tournaments %}
                    <tr class="t-row">
                      <td>
                        <div class="d-flex align-items-center">
                          <div>
                            <h6 class="mb-0">{{ t.name }}</h6>
                            {% if t.description %}
                              <small class="text-muted">{{ t.description|striptags|slice(0,80) ~ (t.description|length > 80 ? '…' : '') }}</small>
                            {% endif %}
                          </div>
                        </div>
                      </td>

                      <td>{{ t.startDate ? t.startDate|date('d M Y') : '-' }}</td>
                      <td>{{ t.endDate ? t.endDate|date('d M Y') : '-' }}</td>
                      <td>{{ t.location ?: '-' }}</td>
                      <td>{{ t.prizePool ? ('$' ~ t.prizePool|number_format(0, '.', ',')) : '-' }}</td>
                      <td>
                        <span class="badge bg-{{ t.status == 'ongoing' ? 'warning' : (t.status == 'completed' ? 'success' : (t.status == 'cancelled' ? 'danger' : 'secondary')) }}">{{ t.status|capitalize }}</span>
                      </td>
                      <td class="text-end">
                        <a href="{{ path('admin_tournament_show', {id: t.id}) }}" class="btn btn-sm btn-outline-primary">View</a>
                        <a href="{{ path('admin_tournament_edit', {id: t.id}) }}" class="btn btn-sm btn-outline-warning">Edit</a>
                        <form method="post" action="{{ path('admin_tournament_delete', {id: t.id}) }}" style="display:inline" onsubmit="return confirm('Delete tournament?')">
                          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ t.id) }}">
                          <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                      </td>
                    </tr>
                  {% else %}
                    <tr class="t-row">
                      <td colspan="7" class="text-center">No tournaments found.</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}

