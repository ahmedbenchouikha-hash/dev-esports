{% block title %}Admin - {{ title }} - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <a href="{{ path('admin_tournament_index') }}" class="btn btn-outline-primary btn-sm">← Back to Tournaments</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-body">
                <h1 class="page-title">{{ title }}</h1>

                {% if form.vars.errors|length > 0 %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Form Error!</strong>
                        {% for error in form.vars.errors %}
                            <div>{{ error.message }}</div>
                        {% endfor %}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endif %}

                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    {% for child in form %}
                        {% if child.vars.name != '_token' and 'hidden' not in child.vars.block_prefixes %}
                            <div class="mb-3">
                                {{ form_label(child, null, {'label_attr': {'class': 'form-label'}}) }}
                                
                                {% if child.vars.errors|length > 0 %}
                                    {{ form_widget(child, {'attr': {'class': 'form-control is-invalid'}}) }}
                                    <div class="invalid-feedback d-block">
                                        {% for error in child.vars.errors %}
                                            <div>• {{ error.message }}</div>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    {{ form_widget(child, {'attr': {'class': 'form-control'}}) }}
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endfor %}
                    
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary">{% if tournament %}Update Tournament{% else %}Create Tournament{% endif %}</button>
                        <a href="{{ path('admin_tournament_index') }}" class="btn btn-outline-primary">Cancel</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<style>
    .is-invalid {
        border-color: #dc3545 !important;
    }
    .invalid-feedback {
        color: #dc3545;
        margin-top: 0.25rem;
        font-size: 0.875rem;
    }
</style>
{% endblock %}
