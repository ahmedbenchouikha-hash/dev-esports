{% extends 'base.html.twig' %}

{% block title %}Match Statistics - Admin{% endblock %}

{% block body %}
<div class="container-lg mt-5">
    <!-- Header Section -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="mb-0" style="color: var(--primary); font-weight: 800;">
                <i class="fas fa-chart-bar"></i> Match Statistics
            </h1>
            <p class="text-muted mt-2 mb-0">Track player performance across all matches</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('admin_match_statistic_create') }}" class="btn btn-success btn-lg">
                <i class="fas fa-plus-circle"></i> Add New Statistic
            </a>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="card bg-dark border-secondary shadow-lg mb-4">
        <div class="card-header bg-dark border-secondary">
            <h5 class="mb-0" style="color: var(--text-primary);">
                <i class="fas fa-filter"></i> Search & Filter Statistics
            </h5>
        </div>
        <div class="card-body">
            <form method="GET" id="filterForm" class="row g-3">
                <div class="col-md-2">
                    <label for="search" class="form-label" style="color: var(--text-primary); font-weight: 600;">
                        <i class="fas fa-user"></i> Player
                    </label>
                    <input type="text" class="form-control form-control-dark" id="search" name="search" 
                           placeholder="Player name..." value="{{ search ?? '' }}">
                </div>

                <div class="col-md-2">
                    <label for="role" class="form-label" style="color: var(--text-primary); font-weight: 600;">
                        <i class="fas fa-users"></i> Role
                    </label>
                    <select class="form-select form-select-dark" id="role" name="role">
                        <option value="">All Roles</option>
                        {% for playerRole in availableRoles %}
                            <option value="{{ playerRole }}" {% if role == playerRole %}selected{% endif %}>
                                {{ playerRole }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="kdaMin" class="form-label" style="color: var(--text-primary); font-weight: 600;">
                        <i class="fas fa-arrow-up"></i> Min KDA
                    </label>
                    <input type="number" class="form-control form-control-dark" id="kdaMin" name="kdaMin" 
                           placeholder="0.0" value="{{ kdaMin ?? '' }}" step="0.1">
                </div>

                <div class="col-md-2">
                    <label for="kdaMax" class="form-label" style="color: var(--text-primary); font-weight: 600;">
                        <i class="fas fa-arrow-down"></i> Max KDA
                    </label>
                    <input type="number" class="form-control form-control-dark" id="kdaMax" name="kdaMax" 
                           placeholder="99.9" value="{{ kdaMax ?? '' }}" step="0.1">
                </div>

                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-50">
                        <i class="fas fa-search"></i> Filter
                    </button>
                    <a href="{{ path('admin_match_statistic_index') }}" class="btn btn-secondary w-50">
                        <i class="fas fa-redo"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-dark border-primary shadow">
                <div class="card-body text-center">
                    <div style="font-size: 2rem; color: var(--primary); margin-bottom: 0.5rem;">
                        <i class="fas fa-database"></i>
                    </div>
                    <h5 class="card-title text-muted mb-1">Total Records</h5>
                    <h2 class="text-primary mb-0">{{ total | default(0) }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary shadow">
                <div class="card-body text-center">
                    <div style="font-size: 2rem; color: var(--secondary); margin-bottom: 0.5rem;">
                        <i class="fas fa-list"></i>
                    </div>
                    <h5 class="card-title text-muted mb-1">Displayed</h5>
                    <h2 class="text-secondary mb-0">{{ statistics|length }}</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Grid View -->
    {% if statistics %}
    <div class="row">
        {% for statistic in statistics %}
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card bg-dark border-primary shadow-lg hover-lift" style="transition: all 0.3s ease;">
                <!-- Header -->
                <div class="card-header bg-dark border-primary">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="mb-1" style="color: var(--primary);">
                                <i class="fas fa-user-circle"></i> {{ statistic.player.nickname ?? 'Unknown' }}
                            </h5>
                            <small class="text-muted">
                                <i class="fas fa-briefcase"></i> {{ statistic.player.role ?? 'N/A' }}
                            </small>
                        </div>
                        <span class="badge bg-info">{{ statistic.player.team.name ?? 'No Team' }}</span>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body">
                    <!-- Match Info -->
                    <div class="mb-3 p-2" style="background: rgba(0, 242, 254, 0.1); border-radius: 6px;">
                        <small class="text-muted">Match:</small>
                        <div style="font-size: 0.9rem; color: var(--primary); font-weight: 600;">
                            {{ statistic.game.team1.name }} <strong>{{ statistic.game.score1 }}</strong>
                            vs
                            <strong>{{ statistic.game.score2 }}</strong> {{ statistic.game.team2.name }}
                        </div>
                    </div>

                    <!-- KDA Stats -->
                    <div class="row text-center mb-3">
                        <div class="col-4">
                            <div style="background: rgba(37, 211, 102, 0.1); padding: 0.5rem; border-radius: 6px;">
                                <div style="font-size: 1.5rem; font-weight: 800; color: #25d366;">
                                    {{ statistic.kills }}
                                </div>
                                <small style="color: #25d366; font-weight: 600;">Kills</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div style="background: rgba(255, 107, 107, 0.1); padding: 0.5rem; border-radius: 6px;">
                                <div style="font-size: 1.5rem; font-weight: 800; color: #ff6b6b;">
                                    {{ statistic.deaths }}
                                </div>
                                <small style="color: #ff6b6b; font-weight: 600;">Deaths</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div style="background: rgba(255, 193, 7, 0.1); padding: 0.5rem; border-radius: 6px;">
                                <div style="font-size: 1.5rem; font-weight: 800; color: #ffc107;">
                                    {{ statistic.assists }}
                                </div>
                                <small style="color: #ffc107; font-weight: 600;">Assists</small>
                            </div>
                        </div>
                    </div>

                    <hr style="border-color: rgba(0, 242, 254, 0.2);">

                    <!-- Performance Metrics -->
                    <div style="font-size: 0.85rem;">
                        <div class="mb-2 d-flex justify-content-between">
                            <span class="text-muted">KDA Ratio:</span>
                            <span style="color: var(--primary); font-weight: 700;">
                                {% if statistic.deaths > 0 %}
                                    {{ (statistic.kda)|number_format(2) }}
                                {% else %}
                                    ∞ Perfect
                                {% endif %}
                            </span>
                        </div>
                        <div class="mb-2 d-flex justify-content-between">
                            <span class="text-muted">Damage:</span>
                            <span style="color: #00bcd4;">{{ (statistic.damageDealt)|number_format(0) }}</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Gold Earned:</span>
                            <span style="color: #ffc107; font-weight: 600;">{{ (statistic.goldEarned)|number_format(0) }}</span>
                        </div>
                    </div>

                    <hr style="border-color: rgba(0, 242, 254, 0.2);">

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 mt-3">
                        <a href="{{ path('admin_match_statistic_show', {'id': statistic.id}) }}" class="btn btn-sm btn-info flex-grow-1">
                            <i class="fas fa-eye"></i> View
                        </a>
                        <a href="{{ path('admin_match_statistic_edit', {'id': statistic.id}) }}" class="btn btn-sm btn-warning flex-grow-1">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <form method="POST" action="{{ path('admin_match_statistic_delete', {'id': statistic.id}) }}" style="display: inline;" onsubmit="return confirm('Delete this record?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ statistic.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    {% if max_pages > 1 %}
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            {% if current_page > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_match_statistic_index', {'page': 1, 'search': search, 'role': role, 'kdaMin': kdaMin, 'kdaMax': kdaMax}) }}">« First</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_match_statistic_index', {'page': current_page - 1, 'search': search, 'role': role, 'kdaMin': kdaMin, 'kdaMax': kdaMax}) }}">‹ Previous</a>
                </li>
            {% endif %}

            {% for page in 1..max_pages %}
                {% if page == current_page %}
                    <li class="page-item active">
                        <span class="page-link">{{ page }}</span>
                    </li>
                {% else %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('admin_match_statistic_index', {'page': page, 'search': search, 'role': role, 'kdaMin': kdaMin, 'kdaMax': kdaMax}) }}">{{ page }}</a>
                    </li>
                {% endif %}
            {% endfor %}

            {% if current_page < max_pages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_match_statistic_index', {'page': current_page + 1, 'search': search, 'role': role, 'kdaMin': kdaMin, 'kdaMax': kdaMax}) }}">Next ›</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_match_statistic_index', {'page': max_pages, 'search': search, 'role': role, 'kdaMin': kdaMin, 'kdaMax': kdaMax}) }}">Last »</a>
                </li>
            {% endif %}
        </ul>
    </nav>
    {% endif %}

    {% else %}
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle"></i> <strong>No statistics found</strong>
        <p class="mb-0 mt-2">Try adjusting your filters or <a href="{{ path('admin_match_statistic_create') }}">add a new statistic</a>.</p>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}
</div>

<style>
    .form-control-dark,
    .form-select-dark {
        background-color: rgba(30, 58, 95, 0.5);
        border-color: rgba(0, 242, 254, 0.2);
        color: #ffffff;
        transition: all 0.3s ease;
    }

    .form-control-dark:focus,
    .form-select-dark:focus {
        background-color: rgba(30, 58, 95, 0.7);
        border-color: var(--primary);
        color: #ffffff;
        box-shadow: 0 0 0 0.2rem rgba(0, 242, 254, 0.25);
    }

    .form-control-dark::placeholder {
        color: var(--text-secondary);
    }

    .form-select-dark option {
        background-color: #1a2847;
        color: #ffffff;
    }

    .form-label {
        color: var(--text-primary);
        font-weight: 600;
        font-size: 0.95rem;
    }

    .hover-lift:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0, 242, 254, 0.2) !important;
        border-color: var(--primary) !important;
    }

    .card {
        border-radius: 8px;
        overflow: hidden;
    }

    .btn-sm {
        padding: 0.4rem 0.8rem;
        font-size: 0.85rem;
    }
</style>
{% endblock %}
