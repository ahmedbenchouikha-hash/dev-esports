{% extends 'base.html.twig' %}

{% block title %}{{ ticket.ticketNumber }} - Admin{% endblock %}

{% block body %}
<div class="container-lg mt-5">
    <!-- Header Section -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="mb-0" style="color: var(--primary); font-weight: 800;">
                <i class="fas fa-ticket-alt"></i> Ticket Details
            </h1>
            <p class="text-muted mt-2 mb-0">
                Ticket ID: <strong>#{{ ticket.id }}</strong>
            </p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('admin_ticket_edit', {'id': ticket.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a href="{{ path('admin_ticket_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Basic Information Card -->
            <div class="card bg-dark border-primary shadow-lg mb-4">
                <div class="card-header bg-dark border-primary">
                    <h5 class="mb-0" style="color: var(--primary);">
                        <i class="fas fa-info-circle"></i> Ticket Information
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Ticket Number & Type -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div style="background: rgba(0, 242, 254, 0.1); padding: 1rem; border-radius: 6px; border-left: 3px solid var(--primary);">
                                <small class="text-muted">Ticket Number</small>
                                <p style="color: var(--primary); font-weight: 700; font-size: 1.3rem; margin-top: 0.5rem;" class="mb-0">
                                    {{ ticket.ticketNumber }}
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div style="background: rgba(37, 211, 102, 0.1); padding: 1rem; border-radius: 6px; border-left: 3px solid var(--secondary);">
                                <small class="text-muted">Type</small>
                                <p class="mb-0" style="margin-top: 0.5rem;">
                                    <span class="badge bg-primary" style="font-size: 1rem; padding: 0.5rem 0.8rem;">
                                        {{ ticket.type|upper }}
                                    </span>
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div style="background: rgba(0, 188, 212, 0.1); padding: 1rem; border-radius: 6px; border-left: 3px solid #00bcd4;">
                                <small class="text-muted">Status</small>
                                <p class="mb-0" style="margin-top: 0.5rem;">
                                    {% if ticket.status == 'available' %}
                                        <span class="badge bg-success" style="font-size: 1rem; padding: 0.5rem 0.8rem;">✓ Available</span>
                                    {% elseif ticket.status == 'sold_out' %}
                                        <span class="badge bg-warning" style="font-size: 1rem; padding: 0.5rem 0.8rem;">⊘ Sold Out</span>
                                    {% else %}
                                        <span class="badge bg-danger" style="font-size: 1rem; padding: 0.5rem 0.8rem;">✕ Cancelled</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>

                    <hr style="border-color: rgba(0, 242, 254, 0.2);">

                    <!-- Price & Match -->
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted">Price Per Ticket</small>
                            <h3 style="color: var(--secondary); font-weight: 700; margin-top: 0.5rem;">
                                {{ ticket.price|number_format(2) }}€
                            </h3>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Match</small>
                            <h5 style="color: var(--primary); font-weight: 700; margin-top: 0.5rem;">
                                {{ ticket.game.team1.name }} vs {{ ticket.game.team2.name }}
                            </h5>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Match Details Card -->
            <div class="card bg-dark border-secondary shadow-lg mb-4">
                <div class="card-header bg-dark border-secondary">
                    <h5 class="mb-0" style="color: var(--secondary);">
                        <i class="fas fa-gamepad"></i> Match Information
                    </h5>
                </div>
                <div class="card-body">
                    <div style="background: rgba(0, 242, 254, 0.1); padding: 1.5rem; border-radius: 8px; margin-bottom: 1rem;">
                        <div style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">
                            <span style="color: var(--primary);">{{ ticket.game.team1.name }}</span>
                            <span style="color: #888; margin: 0 0.5rem;">vs</span>
                            <span style="color: var(--secondary);">{{ ticket.game.team2.name }}</span>
                        </div>
                        <div style="font-size: 2rem; font-weight: 900; color: var(--primary);">
                            {{ ticket.game.score1 }} <span style="color: #888;">-</span> {{ ticket.game.score2 }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted"><i class="fas fa-calendar"></i> Date & Time</small>
                            <p class="mb-0" style="color: var(--text-primary); font-weight: 600; margin-top: 0.5rem;">
                                {{ ticket.game.matchdate|date('d F Y') }}<br>
                                <span style="font-size: 0.95rem;">{{ ticket.game.matchdate|date('H:i') }}</span>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted"><i class="fas fa-trophy"></i> Tournament</small>
                            <p class="mb-0" style="color: var(--text-primary); font-weight: 600; margin-top: 0.5rem;">
                                {{ ticket.game.tournament.name }}
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Audit Information Card -->
            <div class="card bg-dark border-secondary shadow-lg">
                <div class="card-header bg-dark border-secondary">
                    <h5 class="mb-0">
                        <i class="fas fa-history"></i> Audit Information
                    </h5>
                </div>
                <div class="card-body" style="font-size: 0.9rem;">
                    <p class="mb-2">
                        <span class="text-muted"><i class="fas fa-user-clock"></i> Created:</span>
                        <span style="color: var(--text-primary); font-weight: 600;">{{ ticket.createdAt|date('d M Y H:i:s') }}</span>
                    </p>
                    <p class="mb-0">
                        <span class="text-muted"><i class="fas fa-sync-alt"></i> Last Updated:</span>
                        <span style="color: var(--text-primary); font-weight: 600;">{{ ticket.updatedAt|date('d M Y H:i:s') }}</span>
                    </p>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Sales Analytics Card -->
            <div class="card bg-dark border-primary shadow-lg mb-4">
                <div class="card-header bg-dark border-primary">
                    <h5 class="mb-0" style="color: var(--primary);">
                        <i class="fas fa-chart-bar"></i> Sales Analytics
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Occupancy Progress -->
                    <div class="mb-4">
                        <small class="text-muted"><i class="fas fa-percent"></i> Occupancy Rate</small>
                        <div style="margin-top: 0.75rem; margin-bottom: 0.5rem;">
                            <div class="progress" style="height: 32px; background-color: rgba(0, 0, 0, 0.3);">
                                <div class="progress-bar bg-success" style="width: {{ ticket.occupancyPercentage }}%; display: flex; align-items: center; justify-content: center;">
                                    <span style="font-weight: 700; font-size: 0.9rem; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);">
                                        {{ ticket.occupancyPercentage|number_format(1) }}%
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sold & Available -->
                    <div class="row mb-3">
                        <div class="col-6">
                            <div style="background: rgba(0, 242, 254, 0.1); padding: 1rem; border-radius: 6px; text-align: center; border: 1px solid rgba(0, 242, 254, 0.3);">
                                <small class="text-muted"><i class="fas fa-check"></i> Sold</small>
                                <p style="color: var(--primary); font-weight: 700; font-size: 1.5rem; margin-top: 0.5rem;" class="mb-0">
                                    {{ ticket.sold }}
                                </p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div style="background: rgba(37, 211, 102, 0.1); padding: 1rem; border-radius: 6px; text-align: center; border: 1px solid rgba(37, 211, 102, 0.3);">
                                <small class="text-muted"><i class="fas fa-chair"></i> Available</small>
                                <p style="color: var(--secondary); font-weight: 700; font-size: 1.5rem; margin-top: 0.5rem;" class="mb-0">
                                    {{ ticket.getAvailableSeats }}
                                </p>
                            </div>
                        </div>
                    </div>

                    <hr style="border-color: rgba(0, 242, 254, 0.2);">

                    <!-- Total -->
                    <small class="text-muted"><i class="fas fa-boxes"></i> Total Quantity</small>
                    <h4 style="color: var(--text-primary); font-weight: 700; margin-top: 0.5rem;">
                        {{ ticket.quantity }} {{ ticket.quantity == 1 ? 'ticket' : 'tickets' }}
                    </h4>
                </div>
            </div>

            <!-- Revenue Card -->
            <div class="card bg-dark border-warning shadow-lg mb-4">
                <div class="card-header bg-dark border-warning">
                    <h5 class="mb-0" style="color: #ffc107;">
                        <i class="fas fa-coins"></i> Revenue Summary
                    </h5>
                </div>
                <div class="card-body" style="text-align: center;">
                    <small class="text-muted">Total Revenue</small>
                    <h2 style="color: #ffc107; font-weight: 800; margin-top: 0.75rem; margin-bottom: 0.5rem;">
                        {{ (ticket.sold * ticket.price)|number_format(2) }}€
                    </h2>
                    <small class="text-muted">
                        ({{ ticket.sold }} × {{ ticket.price|number_format(2) }}€)
                    </small>

                    <hr style="border-color: rgba(0, 242, 254, 0.2); margin: 1rem 0;">

                    <div>
                        <small class="text-muted">Average Per Ticket</small>
                        <h5 style="color: var(--secondary); font-weight: 700; margin-top: 0.5rem;">
                            {{ ticket.price|number_format(2) }}€
                        </h5>
                    </div>
                </div>
            </div>

            <!-- Action Card -->
            <form method="POST" action="{{ path('admin_ticket_delete', {'id': ticket.id}) }}" onsubmit="return confirm('Delete this ticket? This cannot be undone.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ticket.id) }}">
                <button type="submit" class="btn btn-danger w-100">
                    <i class="fas fa-trash"></i> Delete Ticket
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
