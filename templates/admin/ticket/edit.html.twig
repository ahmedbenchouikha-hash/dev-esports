{% extends 'base.html.twig' %}

{% block title %}Edit Ticket - Admin{% endblock %}

{% block body %}
<div class="container-lg mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0" style="color: var(--primary); font-weight: 800;">
                <i class="fas fa-edit"></i> Edit Ticket
            </h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('admin_ticket_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card bg-dark border-primary shadow-lg">
                <div class="card-header bg-dark border-primary">
                    <h5 class="mb-0" style="color: var(--primary);">
                        <i class="fas fa-ticket-alt"></i> Update Ticket Information
                    </h5>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'novalidate': true}}) }}

                    <!-- Display form-level errors -->
                    {% if form.vars.errors|length > 0 %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle"></i> <strong>Validation Errors:</strong>
                        <ul class="mb-0 mt-2">
                            {% for error in form.vars.errors %}
                                <li>{{ error.message }}</li>
                            {% endfor %}
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {% endif %}

                    <div class="alert alert-info mb-3">
                        <i class="fas fa-info-circle"></i>
                        <strong>Ticket #{{ ticket.ticketNumber }}</strong> - Created on {{ ticket.createdAt|date('d/m/Y H:i') }}
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                {{ form_label(form.game) }}
                                {{ form_widget(form.game, {'attr': {'class': 'form-select form-select-dark', 'disabled': 'disabled'}}) }}
                                <small class="text-muted">Match cannot be changed</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                {{ form_label(form.ticketNumber) }}
                                {{ form_widget(form.ticketNumber, {'attr': {'class': 'form-control form-control-dark'}}) }}
                                {% if form.ticketNumber.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        <i class="fas fa-times-circle"></i> {{ form.ticketNumber.vars.errors[0].message }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                {{ form_label(form.type) }}
                                {{ form_widget(form.type, {'attr': {'class': 'form-select form-select-dark'}}) }}
                                {% if form.type.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        <i class="fas fa-times-circle"></i> {{ form.type.vars.errors[0].message }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                {{ form_label(form.price) }}
                                {{ form_widget(form.price, {'attr': {'class': 'form-control form-control-dark'}}) }}
                                {% if form.price.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        <i class="fas fa-times-circle"></i> {{ form.price.vars.errors[0].message }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <hr style="border-color: rgba(0, 242, 254, 0.2);">

                    <h6 class="mb-3" style="color: var(--primary);">Quantity & Status</h6>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                {{ form_label(form.quantity) }}
                                {{ form_widget(form.quantity, {'attr': {'class': 'form-control form-control-dark'}}) }}
                                {% if form.quantity.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        <i class="fas fa-times-circle"></i> {{ form.quantity.vars.errors[0].message }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                {{ form_label(form.sold) }}
                                {{ form_widget(form.sold, {'attr': {'class': 'form-control form-control-dark'}}) }}
                                {% if form.sold.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        <i class="fas fa-times-circle"></i> {{ form.sold.vars.errors[0].message }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                {{ form_label(form.status) }}
                                {{ form_widget(form.status, {'attr': {'class': 'form-select form-select-dark'}}) }}
                                {% if form.status.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        <i class="fas fa-times-circle"></i> {{ form.status.vars.errors[0].message }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Update Ticket
                        </button>
                        <a href="{{ path('admin_ticket_index') }}" class="btn btn-secondary">Cancel</a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bg-dark border-secondary shadow-lg">
                <div class="card-header bg-dark border-secondary">
                    <h5 class="mb-0" style="color: var(--secondary);">
                        <i class="fas fa-chart-bar"></i> Statistics
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Occupancy:</strong>
                        <div class="progress mt-2" style="height: 25px;">
                            <div class="progress-bar bg-success" role="progressbar" 
                                style="width: {{ ticket.occupancyPercentage }}%">
                                {{ ticket.occupancyPercentage|round(1) }}%
                            </div>
                        </div>
                    </div>
                    <p class="text-muted"><small>
                        <strong>{{ ticket.sold }}</strong> of <strong>{{ ticket.quantity }}</strong> tickets sold<br>
                        <strong>{{ ticket.availableSeats }}</strong> seats available
                    </small></p>
                    <hr>
                    <p class="text-muted"><small>
                        <strong>Revenue:</strong> {{ (ticket.sold * ticket.price)|number_format(2) }}€
                    </small></p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control-dark,
    .form-select-dark {
        background-color: rgba(30, 58, 95, 0.5);
        border-color: rgba(0, 242, 254, 0.2);
        color: #ffffff;
        transition: all 0.3s ease;
    }

    .form-control-dark:focus,
    .form-select-dark:focus {
        background-color: rgba(30, 58, 95, 0.7);
        border-color: var(--primary);
        color: #ffffff;
        box-shadow: 0 0 0 0.2rem rgba(0, 242, 254, 0.25);
    }

    .form-control-dark::placeholder {
        color: var(--text-secondary);
    }

    .form-select-dark option {
        background-color: #1a2847;
        color: #ffffff;
    }

    .form-label {
        color: var(--text-primary);
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
    }

    /* Validation Error Styling */
    .invalid-feedback {
        color: #ff6b6b;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
        font-weight: 500;
    }

    .invalid-feedback i {
        margin-right: 0.5rem;
    }

    /* Alert styling */
    .alert-danger {
        background-color: rgba(255, 107, 107, 0.1);
        border-color: #ff6b6b;
        color: #ff9999;
    }

    .alert-danger strong {
        color: #ff6b6b;
    }

    .alert-info {
        background-color: rgba(0, 242, 254, 0.1);
        border-color: var(--primary);
        color: var(--text-primary);
    }

    .alert-info i {
        color: var(--primary);
    }
</style>
{% endblock %}
