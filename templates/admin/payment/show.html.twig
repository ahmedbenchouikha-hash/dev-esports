{% extends 'base.html.twig' %}

{% block title %}Payment #{{ payment.id }} - Admin{% endblock %}

{% block body %}
<div class="container-lg mt-5">
    <!-- Header Section -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="mb-0" style="color: var(--primary); font-weight: 800;">
                <i class="fas fa-credit-card"></i> Payment Details
            </h1>
            <p class="text-muted mt-2 mb-0">
                Payment ID: <strong>#{{ payment.id }}</strong>
            </p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('admin_payment_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Payment Information Card -->
            <div class="card bg-dark border-primary shadow-lg mb-4">
                <div class="card-header bg-dark border-primary">
                    <h5 class="mb-0" style="color: var(--primary);">
                        <i class="fas fa-info-circle"></i> Payment Information
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Payment ID & Status -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div style="background: rgba(0, 242, 254, 0.1); padding: 1rem; border-radius: 6px; border-left: 3px solid var(--primary);">
                                <small class="text-muted">Payment ID</small>
                                <p style="color: var(--primary); font-weight: 700; font-size: 1.3rem; margin-top: 0.5rem;" class="mb-0">
                                    {{ payment.id }}
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div style="background: rgba(37, 211, 102, 0.1); padding: 1rem; border-radius: 6px; border-left: 3px solid var(--secondary);">
                                <small class="text-muted">Status</small>
                                <p class="mb-0" style="margin-top: 0.5rem;">
                                    {% if payment.status == 'succeeded' %}
                                        <span class="badge bg-success" style="font-size: 1rem; padding: 0.5rem 0.8rem;">
                                            <i class="fas fa-check"></i> Succeeded
                                        </span>
                                    {% elseif payment.status == 'pending' %}
                                        <span class="badge bg-warning" style="font-size: 1rem; padding: 0.5rem 0.8rem;">
                                            <i class="fas fa-hourglass-half"></i> Pending
                                        </span>
                                    {% elseif payment.status == 'failed' %}
                                        <span class="badge bg-danger" style="font-size: 1rem; padding: 0.5rem 0.8rem;">
                                            <i class="fas fa-times"></i> Failed
                                        </span>
                                    {% elseif payment.status == 'refunded' %}
                                        <span class="badge bg-info" style="font-size: 1rem; padding: 0.5rem 0.8rem;">
                                            <i class="fas fa-undo"></i> Refunded
                                        </span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div style="background: rgba(0, 188, 212, 0.1); padding: 1rem; border-radius: 6px; border-left: 3px solid #00bcd4;">
                                <small class="text-muted">Amount</small>
                                <p class="mb-0" style="margin-top: 0.5rem;">
                                    <strong style="color: var(--secondary); font-size: 1.3rem;">
                                        €{{ payment.amount|number_format(2) }}
                                    </strong>
                                </p>
                            </div>
                        </div>
                    </div>

                    <hr style="border-color: rgba(0, 242, 254, 0.2);">

                    <!-- Stripe Intent ID -->
                    <div class="mb-3">
                        <small class="text-muted">Stripe Payment Intent ID</small>
                        <div style="background: rgba(0, 0, 0, 0.3); padding: 0.75rem; border-radius: 6px; margin-top: 0.5rem; font-family: monospace; word-break: break-all;">
                            {{ payment.paymentIntentId }}
                        </div>
                    </div>
                </div>
            </div>

            <!-- QR Code Card -->
            {% if payment.qrCode %}
            <div class="card bg-dark border-info shadow-lg mb-4">
                <div class="card-header bg-dark border-info">
                    <h5 class="mb-0" style="color: #17a2b8;">
                        <i class="fas fa-qrcode"></i> Entry Verification QR Code
                    </h5>
                </div>
                <div class="card-body text-center">
                    <p class="text-muted small mb-3">This QR code is scanned at the event entrance for ticket verification</p>
                    <img src="{{ payment.qrCode }}" alt="Payment QR Code" style="max-width: 250px; border-radius: 8px; border: 2px solid rgba(0, 188, 212, 0.5); padding: 10px; background: white;">
                    <div class="mt-3">
                        <small class="text-muted">Encodes: {{ payment.paymentIntentId }} - {{ payment.ticket.ticketNumber }}</small>
                    </div>
                </div>
            </div>
            {% endif %}

            <!-- Customer Information Card -->
            <div class="card bg-dark border-secondary shadow-lg mb-4">
                <div class="card-header bg-dark border-secondary">
                    <h5 class="mb-0" style="color: var(--secondary);">
                        <i class="fas fa-user"></i> Customer Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted">Customer Name</small>
                            <h5 style="color: var(--primary); font-weight: 700; margin-top: 0.5rem;">
                                {{ payment.customerName ?: 'Not provided' }}
                            </h5>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Customer Email</small>
                            <h5 style="color: var(--primary); font-weight: 700; margin-top: 0.5rem;">
                                <a href="mailto:{{ payment.customerEmail }}" style="color: var(--primary);">
                                    {{ payment.customerEmail }}
                                </a>
                            </h5>
                        </div>
                    </div>
                    {% if payment.customerPhone %}
                    <hr style="border-color: rgba(0, 242, 254, 0.2);">
                    <div>
                        <small class="text-muted">Customer Phone</small>
                        <h5 style="color: var(--primary); font-weight: 700; margin-top: 0.5rem;">
                            <a href="tel:{{ payment.customerPhone }}" style="color: var(--primary);">
                                {{ payment.customerPhone }}
                            </a>
                        </h5>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Ticket Information Card -->
            <div class="card bg-dark border-info shadow-lg mb-4">
                <div class="card-header bg-dark border-info">
                    <h5 class="mb-0" style="color: #17a2b8;">
                        <i class="fas fa-ticket-alt"></i> Ticket Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <small class="text-muted">Ticket Number</small>
                            <h5 style="color: var(--primary); font-weight: 700; margin-top: 0.5rem;">
                                {{ payment.ticket.ticketNumber }}
                            </h5>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Ticket Type</small>
                            <span class="badge bg-primary" style="font-size: 1rem; padding: 0.5rem 0.8rem; margin-top: 0.5rem;">
                                {{ payment.ticket.type|upper }}
                            </span>
                        </div>
                    </div>

                    <hr style="border-color: rgba(0, 242, 254, 0.2);">

                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted">Price per Ticket</small>
                            <h5 style="color: var(--secondary); font-weight: 700; margin-top: 0.5rem;">
                                €{{ payment.amount|number_format(2) }}
                            </h5>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Quantity Purchased</small>
                            <h5 style="color: var(--primary); font-weight: 700; margin-top: 0.5rem;">
                                {{ payment.quantityPurchased }} ticket(s)
                            </h5>
                        </div>
                    </div>

                    <hr style="border-color: rgba(0, 242, 254, 0.2);">

                    <div>
                        <small class="text-muted">Match</small>
                        <h5 style="color: var(--primary); font-weight: 700; margin-top: 0.5rem;">
                            {{ payment.ticket.game.team1.name }} vs {{ payment.ticket.game.team2.name }}
                        </h5>
                    </div>

                    <div class="mt-3">
                        <a href="{{ path('admin_ticket_show', {'id': payment.ticket.id}) }}" class="btn btn-primary">
                            <i class="fas fa-eye"></i> View Full Ticket
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Stats -->
        <div class="col-lg-4">
            <!-- Total Revenue Card -->
            <div class="card bg-dark border-success shadow-lg mb-4">
                <div class="card-header bg-dark border-success">
                    <h5 class="mb-0" style="color: var(--secondary);">
                        <i class="fas fa-euro-sign"></i> Total Revenue
                    </h5>
                </div>
                <div class="card-body text-center">
                    <h2 style="color: var(--secondary); font-weight: 800; font-size: 2.5rem;">
                        €{{ (payment.amount * payment.quantityPurchased)|number_format(2) }}
                    </h2>
                    <small class="text-muted">
                        {{ payment.amount|number_format(2) }}€ × {{ payment.quantityPurchased }} tickets
                    </small>
                </div>
            </div>

            <!-- Transaction Timeline -->
            <div class="card bg-dark border-primary shadow-lg">
                <div class="card-header bg-dark border-primary">
                    <h5 class="mb-0" style="color: var(--primary);">
                        <i class="fas fa-history"></i> Transaction Timeline
                    </h5>
                </div>
                <div class="card-body" style="padding: 1.5rem;">
                    <div style="border-left: 3px solid var(--primary); padding-left: 1rem;">
                        <h6 style="color: var(--primary); font-weight: 700; margin-bottom: 0.25rem;">
                            Payment {{ payment.status|upper }}
                        </h6>
                        <small class="text-muted">
                            {% if payment.status == 'succeeded' %}
                                Successfully processed via Stripe
                            {% elseif payment.status == 'pending' %}
                                Awaiting payment confirmation
                            {% elseif payment.status == 'failed' %}
                                Payment processing failed
                            {% elseif payment.status == 'refunded' %}
                                Refund initiated
                            {% endif %}
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
