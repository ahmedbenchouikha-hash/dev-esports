{% extends "base.html.twig" %}

{% block title %}AI Pricing - Smart Pricing with Groq API{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🤖 AI-Powered Pricing (Groq API)</h1>
        <div id="status" class="badge badge-warning">Checking API...</div>
    </div>

    <!-- Groq Status Alert -->
    <div id="statusAlert" class="alert alert-info">
        <strong>Checking Groq API status...</strong>
        <div id="statusDetails"></div>
    </div>

    <!-- Setup Instructions -->
    {% if not geminiAvailable %}
    <div class="alert alert-danger">
        <h5>⚠️ Groq API Key Not Configured</h5>
        <p>To use AI pricing, add your Groq API key to .env:</p>
        <ol>
            <li><strong>Get Free API Key:</strong> <a href="https://console.groq.com/" target="_blank">https://console.groq.com/</a></li>
            <li><strong>Sign up and get your API key</strong> (7,000 requests/month free)</li>
            <li><strong>Add to .env file:</strong>
                <code class="bg-dark text-light p-2 d-block my-2">GROQ_API_KEY=your_api_key_here</code>
            </li>
            <li><strong>Restart your server</strong></li>
            <li><strong>Refresh this page</strong></li>
        </ol>
    </div>
    {% else %}
    <div class="alert alert-success" id="runningAlert">
        <strong>✅ Groq API is Connected!</strong>
        <p>Free tier: 7,000 requests/month | Cloud-based (no downloads needed)</p>
    </div>
    {% endif %}

    <!-- AI Analysis Dashboard (when available) -->
    <div id="aiDashboard" style="display: {{ geminiAvailable ? 'block' : 'none' }};">
        
        <!-- Action Buttons -->
        <div class="mb-4">
            <button class="btn btn-primary btn-lg me-2" id="analyzeAllBtn">
                <i class="fas fa-brain"></i> Analyze All Tickets with AI
            </button>
            <button class="btn btn-secondary" id="refreshStatusBtn">
                <i class="fas fa-sync"></i> Refresh Status
            </button>
        </div>

        <!-- Tickets Grid -->
        <div class="row">
            {% for ticket in tickets %}
            <div class="col-md-6 mb-4">
                <div class="card h-100" id="ticket-{{ ticket.id }}">
                    <div class="card-header bg-dark text-light">
                        <h5 class="card-title mb-0">
                            {{ ticket.type|upper }} - {{ ticket.game }}
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Current Price:</strong><br>
                                <span class="fs-5">€{{ ticket.price }}</span>
                            </div>
                            <div class="col-6 text-end">
                                <strong>AI Recommendation:</strong><br>
                                <span class="fs-5" id="ai-price-{{ ticket.id }}" class="text-info">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </span>
                            </div>
                        </div>

                        <!-- Analysis Details (loaded via AJAX) -->
                        <div id="analysis-{{ ticket.id }}" class="small">
                            <div class="text-muted">
                                <i class="fas fa-spinner fa-spin"></i> Analyzing with AI...
                            </div>
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <button class="btn btn-sm btn-info" 
                                    onclick="analyzeTicket({{ ticket.id }})">
                                <i class="fas fa-microscope"></i> Analyze
                            </button>
                            <button class="btn btn-sm btn-success apply-btn" 
                                    id="apply-{{ ticket.id }}"
                                    onclick="applyPricing({{ ticket.id }})"
                                    disabled>
                                <i class="fas fa-check"></i> Apply AI Price
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- Loading Indicator -->
    <div id="loadingIndicator" style="display: none; text-align: center; padding: 40px;">
        <div class="spinner-border text-primary mb-3" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>AI is analyzing your tickets... This may take a minute.</p>
    </div>
</div>

<style>
    .card {
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }
    .card:hover {
        border-color: #17a2b8;
        box-shadow: 0 0 15px rgba(23, 162, 184, 0.2);
    }
    .badge-warning {
        padding: 0.5rem 1rem;
        font-size: 1rem;
    }
    #statusAlert {
        font-size: 0.95rem;
    }
    .small {
        line-height: 1.8;
    }
    code {
        font-size: 0.9rem;
        padding: 0.25rem 0.5rem;
    }
</style>

<script>
    // Check Groq API status on page load
    async function checkGeminiStatus() {
        try {
            const response = await fetch('{{ path("ai_pricing_status") }}');
            const data = await response.json();
            
            const statusEl = document.getElementById('status');
            const alertEl = document.getElementById('statusAlert');
            const detailsEl = document.getElementById('statusDetails');
            
            if (data.status === 'configured') {
                statusEl.className = 'badge bg-success';
                statusEl.textContent = '✅ Groq API Connected';
                alertEl.className = 'alert alert-success';
                alertEl.innerHTML = `
                    <strong>✅ Groq API is Ready!</strong>
                    <div id="modelList">
                        <strong>Available Models:</strong>
                        <ul class="mb-0">
                            ${data.models.map(m => `<li>${m.name} (${m.size})</li>`).join('')}
                        </ul>
                        <p class="mt-2 mb-0"><small>Free tier: 7,000 requests/month</small></p>
                    </div>
                `;
            } else {
                statusEl.className = 'badge bg-danger';
                statusEl.textContent = '❌ API Key Missing';
                alertEl.className = 'alert alert-danger';
                alertEl.innerHTML = `
                    <strong>⚠️ Groq API Key Not Configured</strong>
                    <p>Please add GROQ_API_KEY to .env file. Get free key at: <a href="https://console.groq.com/" target="_blank">https://console.groq.com/</a></p>
                `;
            }
            
            return data.status === 'configured';
        } catch (error) {
            console.error('Error checking status:', error);
            return false;
        }
    }

    // Analyze single ticket with AI
    async function analyzeTicket(ticketId) {
        const analysisEl = document.getElementById('analysis-' + ticketId);
        const priceEl = document.getElementById('ai-price-' + ticketId);
        
        analysisEl.innerHTML = '<i class="fas fa-spinner fa-spin"></i> AI is thinking...';
        
        try {
            const response = await fetch(`/admin/ai-pricing/ticket/${ticketId}/ai-analysis`);
            
            if (response.status === 503) {
                analysisEl.innerHTML = '<span class="text-danger"><strong>⚠️ Groq API key not configured. Add GROQ_API_KEY to .env</strong></span>';
                return;
            }
            
            const data = await response.json();
            
            if (data.error) {
                analysisEl.innerHTML = `<div class="text-danger" style="word-break: break-word;">
                    <strong>❌ Error:</strong><br>
                    <code>${data.error}</code>
                </div>`;
                console.error('API Error:', data.error);
                return;
            }
            
            const ai = data.aiPowered;
            const rb = data.ruleBased;
            
            // Check if this is an error response (has error field)
            if (ai.error) {
                analysisEl.innerHTML = `<div class="text-danger bg-danger bg-opacity-10 p-2 rounded" style="word-break: break-word;">
                    <strong>❌ API Error:</strong><br>
                    <small><code>${ai.error}</code></small>
                </div>`;
                console.error('Gemini API Error:', ai.error);
                return;
            }
            
            // Update price
            priceEl.innerHTML = `€${ai.price.toFixed(2)} 
                <span class="badge bg-${ai.change_percentage > 0 ? 'warning' : 'info'}">
                    ${ai.change_percentage > 0 ? '+' : ''}${ai.change_percentage}%
                </span>`;
            
            // Show analysis details
            analysisEl.innerHTML = `
                <div class="ai-analysis-result mt-3">
                    <div class="ai-section mb-3">
                        <h6 class="ai-section-title">
                            <i class="fas fa-brain text-primary"></i> AI Analysis (Groq)
                        </h6>
                        <div class="ai-analysis-card">
                            <div class="analysis-row">
                                <span class="analysis-label">Action:</span>
                                <span class="badge action-badge-${(ai.action || 'UNKNOWN').toLowerCase()}">${(ai.action || 'UNKNOWN').toUpperCase()}</span>
                            </div>
                            <div class="analysis-row">
                                <span class="analysis-label">Reason:</span>
                                <span class="analysis-value">${ai.reason || 'No explanation provided'}</span>
                            </div>
                            <div class="analysis-row">
                                <span class="analysis-label">Confidence:</span>
                                <span class="confidence-badge">${(ai.confidence || 'medium').toUpperCase()}</span>
                            </div>
                        </div>
                    </div>

                    <div class="factors-section">
                        <h6 class="ai-section-title">
                            <i class="fas fa-chart-bar text-info"></i> Rule-Based Factors
                        </h6>
                        <div class="factors-grid">
                            <div class="factor-item">
                                <div class="factor-label">Demand</div>
                                <div class="factor-value">${(rb.demand || 0).toFixed(2)}x</div>
                            </div>
                            <div class="factor-item">
                                <div class="factor-label">Popularity</div>
                                <div class="factor-value">${(rb.popularity || 0).toFixed(2)}x</div>
                            </div>
                            <div class="factor-item">
                                <div class="factor-label">Scarcity</div>
                                <div class="factor-value">${(rb.scarcity || 0).toFixed(2)}x</div>
                            </div>
                            <div class="factor-item">
                                <div class="factor-label">Type</div>
                                <div class="factor-value">${(rb.type || 0).toFixed(2)}x</div>
                            </div>
                        </div>
                        <div class="recommendation-box">
                            <span class="rec-label">Recommendation:</span> 
                            <span class="rec-value">${rb.recommendedAction || 'KEEP_CURRENT'}</span>
                        </div>
                    </div>
                </div>
            `;
            
            // Enable apply button
            const applyBtn = document.getElementById('apply-' + ticketId);
            applyBtn.disabled = false;
            applyBtn.onclick = () => applyPricing(ticketId, ai.price);
            
        } catch (error) {
            analysisEl.innerHTML = `<span class="text-danger"><strong>Error:</strong> ${error.message}</span>`;
        }
    }

    // Apply AI pricing to a ticket
    async function applyPricing(ticketId, newPrice) {
        if (!confirm('Apply AI-recommended price change?')) return;
        
        try {
            const response = await fetch(`/admin/ai-pricing/apply/${ticketId}`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'}
            });
            
            const data = await response.json();
            
            if (data.success) {
                alert(`✅ Price updated!\n€${data.oldPrice} → €${data.newPrice}\nChange: ${data.change}%`);
                location.reload();
            } else {
                alert(`❌ Error: ${data.error}`);
            }
        } catch (error) {
            alert(`Error applying price: ${error.message}`);
        }
    }

    // Analyze all tickets at once
    document.getElementById('analyzeAllBtn')?.addEventListener('click', async () => {
        const indicator = document.getElementById('loadingIndicator');
        indicator.style.display = 'block';
        
        try {
            const response = await fetch('{{ path("ai_pricing_analyze_all") }}', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'}
            });
            
            const data = await response.json();
            
            indicator.style.display = 'none';
            
            if (data.error) {
                alert(`Error: ${data.error}`);
            } else {
                alert(`✅ Analysis complete!\nProcessed: ${data.processedCount}/${data.totalTickets}`);
                
                // Reload individual tickets
                data.analyses.forEach(analysis => {
                    analyzeTicket(analysis.ticketId);
                });
            }
        } catch (error) {
            indicator.style.display = 'none';
            alert(`Error: ${error.message}`);
        }
    });

    // Refresh status button
    document.getElementById('refreshStatusBtn')?.addEventListener('click', async () => {
        await checkGeminiStatus();
        alert('Status updated!');
    });

    // Initial status check
    document.addEventListener('DOMContentLoaded', () => {
        checkGeminiStatus();
        
        // Manual analysis: Click "Analyze" button on individual tickets to test the API
        // This prevents using all your free tier requests on page load
        // (Gemini free tier: 60 requests/minute)
    });
</script>

<style>
/* AI Analysis Results Styling */
.ai-analysis-result {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.ai-section-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #0d6efd;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

/* AI Analysis Card */
.ai-analysis-card {
    background: linear-gradient(135deg, #0d6efd 0%, #0b5cdb 100%);
    border-left: 4px solid #ffffff;
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 1.5rem;
    color: white;
}

.analysis-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
}

.analysis-row:last-child {
    border-bottom: none;
}

.analysis-label {
    font-weight: 600;
    color: #e7f0ff;
    min-width: 100px;
}

.analysis-value {
    color: #ffffff;
    font-style: italic;
}

/* Action Badge Styling */
.action-badge-increase {
    background-color: #d1e7dd;
    color: #0f5132;
    border: 1px solid #badbcc;
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
}

.action-badge-decrease {
    background-color: #f8d7da;
    color: #842029;
    border: 1px solid #f5c2c7;
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
}

.action-badge-keep {
    background-color: #e2e3e5;
    color: #383d41;
    border: 1px solid #d3d6db;
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
}

.action-badge-unknown {
    background-color: #fff3cd;
    color: #664d03;
    border: 1px solid #ffecb5;
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
}

/* Confidence Badge */
.confidence-badge {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 0.35rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
}

/* Factors Section */
.factors-section {
    background: linear-gradient(135deg, #f0f4ff 0%, #e8ecff 100%);
    border-radius: 6px;
    padding: 1rem;
    border: 2px solid #0d6efd;
}

.factors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
}

.factor-item {
    background: linear-gradient(135deg, #e7f3ff 0%, #f0f7ff 100%);
    border: 1px solid #b8daff;
    border-radius: 6px;
    padding: 0.75rem;
    text-align: center;
}

.factor-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #0c5460;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
}

.factor-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0d6efd;
}

/* Recommendation Box */
.recommendation-box {
    background: linear-gradient(135deg, #fff8e1 0%, #fffbe6 100%);
    border-left: 4px solid #ffc107;
    border-radius: 4px;
    padding: 0.75rem;
    margin-top: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid #ffc107;
}

.rec-label {
    font-weight: 600;
    color: #856404;
}

.rec-value {
    background-color: rgba(255, 193, 7, 0.2);
    color: #856404;
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.9rem;
}

/* Responsive Design */
@media (max-width: 576px) {
    .factors-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .recommendation-box {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }
}
</style>
{% endblock %}
