{% extends 'base.html.twig' %}

{% block title %}Admin - Match Details - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <a href="{{ path('admin_match_index') }}" class="btn btn-outline-primary btn-sm">← Back to Matches</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <h1 class="page-title">{{ game.team1.name }} vs {{ game.team2.name }}</h1>
                    <span class="badge {% if game.status == 'finished' %}badge-success{% elseif game.status == 'ongoing' %}badge-danger{% elseif game.status == 'pending' %}badge-warning{% else %}badge-secondary{% endif %}" style="font-size: 1rem;">
                        {{ game.status|capitalize }}
                    </span>
                </div>

                <!-- Score Board -->
                <div class="row mb-4">
                    <div class="col-md-5">
                        <h5>{{ game.team1.name }}</h5>
                    </div>
                    <div class="col-md-2 text-center">
                        <div style="font-size: 2rem; font-weight: bold;">
                            <span style="color: var(--highlight-color);">{{ game.score1 }}</span>
                            <div style="font-size: 1rem; color: #999;">-</div>
                            <span style="color: var(--highlight-color);">{{ game.score2 }}</span>
                        </div>
                    </div>
                    <div class="col-md-5 text-end">
                        <h5>{{ game.team2.name }}</h5>
                    </div>
                </div>

                <hr>

                <!-- Match Details -->
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>📅 Date:</strong> {{ game.matchdate|date('d M Y - H:i') }}</p>
                        <p><strong>🏆 Tournament:</strong> {{ game.tournament.name }}</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Status:</strong> {{ game.status|capitalize }}</p>
                        <p><strong>Created:</strong> {{ game.createdAt|date('d M Y - H:i') }}</p>
                    </div>
                </div>

                <hr>

                <!-- Action Buttons -->
                <div class="text-center">
                    <a href="{{ path('admin_match_edit', { id: game.id }) }}" class="btn btn-warning">Edit Match</a>
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete Match</button>
                    <a href="{{ path('admin_match_index') }}" class="btn btn-outline-primary">Back to Matches</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background-color: var(--secondary-color);">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this match?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ path('admin_match_delete', { id: game.id }) }}" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.id) }}">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
