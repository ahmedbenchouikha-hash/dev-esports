{% extends 'base.html.twig' %}

{% block title %}Admin - {{ title }} - RankUp{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <a href="{{ path('admin_match_index') }}" class="btn btn-outline-primary btn-sm">← Back to Matches</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card bg-dark border-primary shadow-lg">
            <div class="card-header bg-dark border-primary">
                <h2 class="mb-0" style="color: var(--primary); font-weight: 800;">
                    <i class="fas fa-gamepad"></i> {{ title }}
                </h2>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'novalidate': true}}) }}

                <!-- Display form-level errors -->
                {% if form.vars.errors|length > 0 %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle"></i> <strong>Validation Errors:</strong>
                    <ul class="mb-0 mt-2">
                        {% for error in form.vars.errors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                    </ul>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                {% endif %}

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.team1) }}
                            {{ form_widget(form.team1, {'attr': {'class': 'form-select form-select-dark'}}) }}
                            {% if form.team1.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    <i class="fas fa-times-circle"></i> {{ form.team1.vars.errors[0].message }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.team2) }}
                            {{ form_widget(form.team2, {'attr': {'class': 'form-select form-select-dark'}}) }}
                            {% if form.team2.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    <i class="fas fa-times-circle"></i> {{ form.team2.vars.errors[0].message }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.score1) }}
                            {{ form_widget(form.score1, {'attr': {'class': 'form-control form-control-dark'}}) }}
                            {% if form.score1.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    <i class="fas fa-times-circle"></i> {{ form.score1.vars.errors[0].message }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.score2) }}
                            {{ form_widget(form.score2, {'attr': {'class': 'form-control form-control-dark'}}) }}
                            {% if form.score2.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    <i class="fas fa-times-circle"></i> {{ form.score2.vars.errors[0].message }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.matchdate) }}
                            {{ form_widget(form.matchdate, {'attr': {'class': 'form-control form-control-dark'}}) }}
                            {% if form.matchdate.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    <i class="fas fa-times-circle"></i> {{ form.matchdate.vars.errors[0].message }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.status) }}
                            {{ form_widget(form.status, {'attr': {'class': 'form-select form-select-dark'}}) }}
                            {% if form.status.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    <i class="fas fa-times-circle"></i> {{ form.status.vars.errors[0].message }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.tournament) }}
                    {{ form_widget(form.tournament, {'attr': {'class': 'form-select form-select-dark'}}) }}
                    {% if form.tournament.vars.errors|length > 0 %}
                        <div class="invalid-feedback d-block">
                            <i class="fas fa-times-circle"></i> {{ form.tournament.vars.errors[0].message }}
                        </div>
                    {% endif %}
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success" style="min-width: 150px;">
                        <i class="fas fa-save"></i> {% if game %}Update Match{% else %}Create Match{% endif %}
                    </button>
                    <a href="{{ path('admin_match_index') }}" class="btn btn-secondary" style="min-width: 150px;">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <style>
        .form-control-dark,
        .form-select-dark {
            background-color: rgba(30, 58, 95, 0.5);
            border-color: rgba(0, 242, 254, 0.2);
            color: #ffffff;
            transition: all 0.3s ease;
        }

        .form-control-dark:focus,
        .form-select-dark:focus {
            background-color: rgba(30, 58, 95, 0.7);
            border-color: var(--primary);
            color: #ffffff;
            box-shadow: 0 0 0 0.2rem rgba(0, 242, 254, 0.25);
        }

        .form-control-dark::placeholder {
            color: var(--text-secondary);
        }

        .form-select-dark option {
            background-color: #1a2847;
            color: #ffffff;
        }

        .form-label {
            color: var(--text-primary);
            font-weight: 600;
            font-size: 0.95rem;
            margin-bottom: 0.5rem;
        }

        /* Validation Error Styling */
        .invalid-feedback {
            color: #ff6b6b;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: block;
            font-weight: 500;
        }

        .invalid-feedback i {
            margin-right: 0.5rem;
        }

        .form-control.is-invalid,
        .form-select.is-invalid {
            border-color: #ff6b6b;
        }

        .form-control-dark.is-invalid:focus {
            border-color: #ff6b6b;
            box-shadow: 0 0 0 0.2rem rgba(255, 107, 107, 0.25);
        }

        /* Alert styling for form-level errors */
        .alert-danger {
            background-color: rgba(255, 107, 107, 0.1);
            border-color: #ff6b6b;
            color: #ff9999;
        }

        .alert-danger strong {
            color: #ff6b6b;
        }

        .alert-danger ul {
            color: #ff9999;
        }

        .alert-danger .btn-close {
            filter: brightness(0.8);
        }

        /* Feedback message animations */
        @keyframes slideInError {
            from {
                opacity: 0;
                transform: translateY(-5px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .invalid-feedback {
            animation: slideInError 0.3s ease;
        }

        /* Button styling */
        .btn-success, .btn-secondary {
            font-weight: 600;
            border: none;
        }

        .btn-success {
            background: linear-gradient(135deg, var(--secondary), #1aa342);
        }

        .btn-success:hover {
            background: linear-gradient(135deg, #1aa342, var(--secondary));
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
        }
    </style>
</div>
{% endblock %}
