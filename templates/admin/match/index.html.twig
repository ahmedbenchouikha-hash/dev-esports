            <i class="fas fa-info-circle"></i> <strong>No matches found</strong>
            <p class="mb-0 mt-2">Try adjusting your search filters or <a href="{{ path('admin_match_create') }}">create a new match</a>.</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% else %}
