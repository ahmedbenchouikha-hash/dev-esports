{% extends 'base.html.twig' %}

{% block title %}Admin - Manage Matches - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-6">
        <h1 class="page-title">⚙️ Manage Matches</h1>
    </div>
    <div class="col-md-6 text-end">
        <a href="{{ path('admin_match_create') }}" class="btn btn-primary">+ Create Match</a>
    </div>
</div>

<!-- Search and Filter Section -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-6">
                        <input type="text" name="search" class="form-control" placeholder="Search by team name..." value="{{ search }}">
                    </div>
                    <div class="col-md-3">
                        <select name="status" class="form-select">
                            <option value="">All Status</option>
                            <option value="pending" {% if status == 'pending' %}selected{% endif %}>Pending</option>
                            <option value="ongoing" {% if status == 'ongoing' %}selected{% endif %}>Ongoing</option>
                            <option value="finished" {% if status == 'finished' %}selected{% endif %}>Finished</option>
                            <option value="cancelled" {% if status == 'cancelled' %}selected{% endif %}>Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">Search</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Matches Table -->
<div class="row">
    <div class="col-md-12">
        {% if games is empty %}
            <div class="alert alert-info">
                No matches found.
            </div>
        {% else %}
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Team 1</th>
                                <th>Team 2</th>
                                <th>Score</th>
                                <th>Tournament</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for game in games %}
                                <tr>
                                    <td>{{ game.team1.name }}</td>
                                    <td>{{ game.team2.name }}</td>
                                    <td><strong style="color: var(--highlight-color);">{{ game.score1 }} - {{ game.score2 }}</strong></td>
                                    <td>{{ game.tournament.name }}</td>
                                    <td>{{ game.matchdate|date('d M Y H:i') }}</td>
                                    <td>
                                        <span class="badge {% if game.status == 'finished' %}badge-success{% elseif game.status == 'ongoing' %}badge-danger{% elseif game.status == 'pending' %}badge-warning{% else %}badge-secondary{% endif %}">
                                            {{ game.status|capitalize }}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="{{ path('admin_match_show', { id: game.id }) }}" class="btn btn-sm btn-info">View</a>
                                        <a href="{{ path('admin_match_edit', { id: game.id }) }}" class="btn btn-sm btn-warning">Edit</a>
                                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ game.id }}">Delete</button>
                                    </td>
                                </tr>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal{{ game.id }}" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content" style="background-color: var(--secondary-color);">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Confirm Delete</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete this match?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form method="POST" action="{{ path('admin_match_delete', { id: game.id }) }}" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.id) }}">
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
