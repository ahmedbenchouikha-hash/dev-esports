<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}RankUp{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        <!-- Minimal CSS for Auth Pages (Bootstrap only) -->
        <link href="{{ asset('vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
        
        <!-- Font Awesome Icons (async) -->
        <link rel="stylesheet" href="{{ asset('vendor/fontawesome/css/all.min.css') }}" media="print" onload="this.media='all'">
        
        <!-- Minimal Auth-Specific Styles -->
        <style>
            :root {
                --primary: #b622d1;
                --primary-dark: #8b1aa8;
                --secondary: #00d9ff;
                --bg-dark: #0a0e27;
                --bg-secondary: #141829;
                --text-primary: #ffffff;
                --text-secondary: #b0b8cc;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            }

            body {
                background: linear-gradient(135deg, var(--bg-dark) 0%, var(--bg-secondary) 100%);
                color: var(--text-primary);
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                overflow-x: hidden;
            }

            .auth-container {
                width: 100%;
                max-width: 500px;
                padding: 2rem;
            }

            .auth-card {
                background: rgba(20, 24, 41, 0.95);
                border: 1px solid rgba(0, 242, 254, 0.1);
                border-radius: 20px;
                padding: 3rem;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
                backdrop-filter: blur(10px);
            }

            .form-control {
                background-color: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(0, 242, 254, 0.2);
                color: var(--text-primary);
            }

            .form-control:focus {
                background-color: rgba(255, 255, 255, 0.08);
                border-color: var(--secondary);
                color: var(--text-primary);
                box-shadow: 0 0 0 0.2rem rgba(0, 242, 254, 0.25);
            }

            .btn-login {
                background: linear-gradient(135deg, var(--primary), var(--primary-dark));
                border: none;
                color: white;
                font-weight: 600;
                padding: 0.75rem 1.5rem;
                transition: all 0.3s ease;
            }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(182, 34, 209, 0.4);
                color: white;
            }
        </style>

        {% block head_extra %}{% endblock %}
    </head>
    <body>
        <div class="auth-container">
            {% block body %}{% endblock %}
        </div>

        <!-- Bootstrap JS (only for form validation if needed) -->
        <script src="{{ asset('vendor/bootstrap/js/bootstrap.bundle.min.js') }}" defer></script>
    </body>
</html>
