{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <h1 class="page-title">🎮 Matches</h1>
    </div>
</div>

<!-- Search and Filter Section -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-6">
                        <input type="text" name="search" class="form-control" placeholder="Search by team name..." value="{{ search }}">
                    </div>
                    <div class="col-md-3">
                        <select name="status" class="form-select">
                            <option value="">All Status</option>
                            <option value="pending" {% if status == 'pending' %}selected{% endif %}>Pending</option>
                            <option value="ongoing" {% if status == 'ongoing' %}selected{% endif %}>Ongoing</option>
                            <option value="finished" {% if status == 'finished' %}selected{% endif %}>Finished</option>
                            <option value="cancelled" {% if status == 'cancelled' %}selected{% endif %}>Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">Search</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Matches List -->
<div class="row">
    {% if games is empty %}
        <div class="col-md-12">
            <div class="alert alert-info">
                No matches found. <a href="{{ path('match_index') }}">Clear filters</a>
            </div>
        </div>
    {% else %}
        {% for game in games %}
            <div class="col-lg-6 col-xl-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title">{{ game.team1.name }} vs {{ game.team2.name }}</h5>
                            <span class="badge {% if game.status == 'finished' %}badge-success{% elseif game.status == 'ongoing' %}badge-danger{% elseif game.status == 'pending' %}badge-warning{% else %}badge-secondary{% endif %}">
                                {{ game.status|capitalize }}
                            </span>
                        </div>
                        
                        <div class="text-center mb-3">
                            <div style="font-size: 2rem; font-weight: bold;">
                                <span style="color: var(--highlight-color);">{{ game.score1 }}</span>
                                <span style="color: #999;">-</span>
                                <span style="color: var(--highlight-color);">{{ game.score2 }}</span>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <small class="text-muted">
                                📅 {{ game.matchdate|date('d M Y - H:i') }}<br>
                                🏆 {{ game.tournament.name }}
                            </small>
                        </div>
                        
                        <a href="{{ path('match_show', { id: game.id }) }}" class="btn btn-primary w-100 btn-sm">View Details</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}

