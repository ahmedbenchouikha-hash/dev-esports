{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <h1 class="page-title">⏰ Upcoming Matches</h1>
    </div>
</div>

<div class="row">
    {% if games is empty %}
        <div class="col-md-12">
            <div class="alert alert-info">
                No upcoming matches scheduled.
            </div>
        </div>
    {% else %}
        {% for game in games %}
            <div class="col-lg-6 col-xl-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">{{ game.team1.name }} vs {{ game.team2.name }}</h5>
                        
                        <div class="text-center mb-3">
                            <div style="font-size: 1.5rem; font-weight: bold;">
                                <span style="color: var(--highlight-color);">{{ game.score1 }}</span>
                                <span style="color: #999;">-</span>
                                <span style="color: var(--highlight-color);">{{ game.score2 }}</span>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <small class="text-muted">
                                📅 {{ game.matchdate|date('d M Y - H:i') }}<br>
                                🏆 {{ game.tournament.name }}<br>
                                📍 {{ game.tournament.location ?? 'TBD' }}
                            </small>
                        </div>
                        
                        <a href="{{ path('match_show', { id: game.id }) }}" class="btn btn-primary w-100 btn-sm">View Details</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}
