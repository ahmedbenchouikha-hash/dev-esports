{% extends 'base.html.twig' %}

{% block title %}Create Team{% endblock %}

{% block body %}
    {% include '_sidebar.html.twig' %}

    <div class="content-with-sidebar">
        <div class="container" style="max-width: 600px;">
            <div class="card">
                <h1 style="margin-bottom: 30px; color: #667eea;">Create a New Team</h1>

                <div style="background-color: #e7f3ff; border-left: 4px solid #667eea; padding: 15px; border-radius: 4px; margin-bottom: 20px;">
                    <p style="margin: 0; color: #334155;">
                        <strong>Note:</strong> You will be added as the first team member. You can add up to 4 more players after creating the team.
                    </p>
                </div>

                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    <div class="form-group">
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name, {'attr': {'class': 'input' ~ (form.name.vars.valid ? '' : ' invalid'), 'placeholder': 'Enter team name'}}) }}
                        {{ form_errors(form.name) }}
                    </div>

                    <div style="margin-top: 30px;">
                        <button class="btn primary" type="submit" style="padding: 12px 30px;">Create Team</button>
                        <a href="{{ path('team_index') }}" class="btn secondary" style="padding: 12px 30px; text-decoration: none; display: inline-block; background-color: #e2e8f0; color: #333; margin-left: 10px;">Cancel</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
