{% block title %}Team Management{% endblock %}

{% block body %}
    {% include '_sidebar.html.twig' %}

    <div class="content-with-sidebar">
        <div class="container" style="max-width: 900px;">
            <div class="card">
                <h1 style="margin-bottom: 30px;">Team Management</h1>

                <!-- My Teams -->
                <div style="margin-bottom: 40px;">
                    <h2 style="color: #667eea; margin-bottom: 20px;">My Teams</h2>
                    {% if userTeams is not empty %}
                        <div style="display: grid; gap: 15px;">
                            {% for team in userTeams %}
                                <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; border-left: 4px solid #667eea;">
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <div>
                                            <h3 style="margin: 0 0 10px 0;">{{ team.name }}</h3>
                                            <p style="margin: 5px 0; color: #666;">
                                                Members: {{ team.memberCount }}/5
                                                <span style="display: inline-block; width: 150px; height: 8px; background-color: #e5e7eb; border-radius: 4px; margin-left: 10px; vertical-align: middle;">
                                                    <span style="display: inline-block; width: {{ (team.memberCount / 5 * 100) }}%; height: 100%; background-color: #10b981; border-radius: 4px;"></span>
                                                </span>
                                            </p>
                                        </div>
                                        <div style="display: flex; gap: 10px;">
                                            <a href="{{ path('team_show', {id: team.id}) }}" class="small-btn" style="background-color: #3b82f6; color: white;">View</a>
                                            <a href="{{ path('team_edit', {id: team.id}) }}" class="small-btn" style="background-color: #667eea; color: white;">Edit</a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p style="color: #999;">You haven't created any teams yet.</p>
                    {% endif %}
                </div>

                <!-- Joined Teams -->
                <div style="margin-bottom: 40px;">
                    <h2 style="color: #667eea; margin-bottom: 20px;">Teams I've Joined</h2>
                    {% if joinedTeams is not empty %}
                        <div style="display: grid; gap: 15px;">
                            {% for teamMember in joinedTeams %}
                                <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; border-left: 4px solid #10b981;">
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <div>
                                            <h3 style="margin: 0 0 10px 0;">{{ teamMember.team.name }}</h3>
                                            <p style="margin: 5px 0; color: #666;">Led by: <strong>{{ teamMember.team.creator.username }}</strong></p>
                                            <p style="margin: 5px 0; color: #666;">
                                                Members: {{ teamMember.team.memberCount }}/5
                                            </p>
                                        </div>
                                        <div style="display: flex; gap: 10px;">
                                            <a href="{{ path('team_show', {id: teamMember.team.id}) }}" class="small-btn" style="background-color: #3b82f6; color: white;">View</a>
                                            <form action="{{ path('team_leave', {id: teamMember.team.id}) }}" method="post" style="display:inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('') }}">
                                                <button type="submit" class="small-btn" style="background-color: #ef4444; color: white;" onclick="return confirm('Leave this team?');">Leave</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p style="color: #999;">You haven't joined any teams yet. <a href="{{ path('team_join_list') }}">Browse available teams</a></p>
                    {% endif %}
                </div>

                <!-- Actions -->
                <div style="display: flex; gap: 15px;">
                    <a href="{{ path('team_create') }}" class="btn primary" style="padding: 12px 30px; text-decoration: none; display: inline-block;">+ Create Team</a>
                    <a href="{{ path('team_join_list') }}" class="btn secondary" style="padding: 12px 30px; text-decoration: none; display: inline-block; background-color: #e2e8f0; color: #333;">Browse Teams</a>
                </div>
            </div>
        </div>
    </div>
