{% block title %}Teams - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <h1 class="page-title">🏆 Teams</h1>
    </div>
</div>

<!-- Search Section -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-8">
                        <input type="text" name="search" class="form-control" placeholder="Search by team name or country..." value="{{ search }}">
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">Search</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Teams List -->
<div class="row">
    {% if teams is empty %}
        <div class="col-md-12">
            <div class="alert alert-info">
                No teams found. <a href="{{ path('team_index') }}">Clear filters</a>
            </div>
        </div>
    {% else %}
        {% for team in teams %}
            <div class="col-lg-6 col-xl-4 mb-4">
                <div class="card h-100">
                    {% if team.logo %}
                        <div style="height: 120px; background: linear-gradient(135deg, rgba(26, 40, 71, 0.8), rgba(26, 40, 71, 0.6)); display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid rgba(0, 242, 254, 0.15); padding: 0.5rem;">
                            <img src="{{ asset('uploads/logos/' ~ team.logo) }}" alt="{{ team.name }} logo" style="max-width: 100%; max-height: 100%; object-fit: contain; width: auto;">
                        </div>
                    {% else %}
                        <div style="height: 120px; background: linear-gradient(135deg, rgba(0, 242, 254, 0.1), rgba(37, 211, 102, 0.1)); display: flex; align-items: center; justify-content: center; border-bottom: 1px solid rgba(0, 242, 254, 0.15);">
                            <i class="fas fa-image" style="font-size: 2rem; color: rgba(0, 242, 254, 0.3);"></i>
                        </div>
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title">{{ team.name }}</h5>
                        
                        {% if team.country %}
                            <p class="text-muted"><small>📍 {{ team.country }}</small></p>
                        {% endif %}
                        
                        {% if team.description %}
                            <p class="card-text" style="font-size: 0.9rem;">{{ team.description|slice(0, 100) }}{% if team.description|length > 100 %}...{% endif %}</p>
                        {% endif %}
                        
                        <!-- Team Members Section -->
                        <div class="mb-3">
                            <small class="text-muted d-block mb-2">
                                <strong>👥 Members ({{ team.players|length }}/5)</strong>
                            </small>
                            {% if team.players|length > 0 %}
                                <div style="display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 10px;">
                                    {% for player in team.players %}
                                        <span class="badge bg-primary">{{ player.nickname }}</span>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted mb-2" style="font-size: 0.85rem;">No members yet</p>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            <small class="text-muted">
                                🎮 {{ (team.gamesAsTeam1|length) + (team.gamesAsTeam2|length) }} Matches
                            </small>
                        </div>

                        {% if team.players|length >= 5 %}
                            <div class="alert alert-danger mb-3" style="font-size: 0.85rem;">
                                <i class="fas fa-exclamation-circle"></i> Team is full
                            </div>
                            <a href="{{ path('team_show', { id: team.id }) }}" class="btn btn-primary w-100 btn-sm">View Team</a>
                        {% else %}
                            <a href="{{ path('team_show', { id: team.id }) }}" class="btn btn-primary w-100 btn-sm mb-2">View Team</a>
                            {% if app.user and not team.players.contains(app.user) and not is_granted('ROLE_MANAGER') %}
                                <form method="POST" action="{{ path('team_join', { id: team.id }) }}" style="display: inline-block; width: 100%;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('join' ~ team.id) }}">
                                    <button type="submit" class="btn btn-success w-100 btn-sm">
                                        <i class="fas fa-plus"></i> Join Team
                                    </button>
