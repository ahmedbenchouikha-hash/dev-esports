                                <button class="btn btn-secondary w-100 btn-sm" disabled>
                                    <i class="fas fa-check"></i> Already a Member
                                </button>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>
