{% extends 'base.html.twig' %}

{% block title %}My Teams - Rankup{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <h1 class="page-title">👥 My Teams</h1>
        <p class="text-muted">Teams you are currently a member of</p>
    </div>
</div>

<!-- Teams List -->
<div class="row">
    {% if teams is empty %}
        <div class="col-md-12">
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                You are not currently a member of any team. 
                <a href="{{ path('team_index') }}">Browse available teams</a> to join one!
            </div>
        </div>
    {% else %}
        {% for team in teams %}
            <div class="col-lg-6 col-xl-4 mb-4">
                <div class="card h-100">
                    {% if team.logo %}
                        <div style="height: 120px; background: linear-gradient(135deg, rgba(26, 40, 71, 0.8), rgba(26, 40, 71, 0.6)); display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid rgba(0, 242, 254, 0.15); padding: 0.5rem;">
                            <img src="{{ asset('uploads/logos/' ~ team.logo) }}" alt="{{ team.name }} logo" style="max-width: 100%; max-height: 100%; object-fit: contain; width: auto;">
                        </div>
                    {% else %}
                        <div style="height: 120px; background: linear-gradient(135deg, rgba(0, 242, 254, 0.1), rgba(37, 211, 102, 0.1)); display: flex; align-items: center; justify-content: center; border-bottom: 1px solid rgba(0, 242, 254, 0.15);">
                            <i class="fas fa-image" style="font-size: 2rem; color: rgba(0, 242, 254, 0.3);"></i>
                        </div>
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title">{{ team.name }}</h5>
                        
                        {% if team.country %}
                            <p class="text-muted"><small>📍 {{ team.country }}</small></p>
                        {% endif %}
                        
                        {% if team.description %}
                            <p class="card-text" style="font-size: 0.9rem;">{{ team.description|slice(0, 100) }}{% if team.description|length > 100 %}...{% endif %}</p>
                        {% endif %}
                        
                        <!-- Team Members Section -->
                        <div class="mb-3">
                            <small class="text-muted d-block mb-2">
                                <strong>👥 Members ({{ team.players|length }}/5)</strong>
                            </small>
                            {% if team.players|length > 0 %}
                                <div style="display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 10px;">
                                    {% for player in team.players %}
                                        <span class="badge bg-primary">{{ player.nickname }}</span>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted mb-2" style="font-size: 0.85rem;">No members yet</p>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            <small class="text-muted">
                                🎮 {{ (team.gamesAsTeam1|length) + (team.gamesAsTeam2|length) }} Matches
                            </small>
                        </div>

                        <!-- Action Buttons -->
                        <a href="{{ path('team_show', { id: team.id }) }}" class="btn btn-primary w-100 btn-sm">
                            <i class="fas fa-eye"></i> View Team Details
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>

<style>
    .page-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: #00f2fe;
        text-shadow: 0 0 20px rgba(0, 242, 254, 0.3);
        margin-bottom: 0.5rem;
    }

    .card {
        background: rgba(26, 40, 71, 0.8);
        border: 1px solid rgba(0, 242, 254, 0.15);
        transition: all 0.3s ease;
    }

    .card:hover {
        border-color: rgba(0, 242, 254, 0.3);
        box-shadow: 0 8px 24px rgba(0, 242, 254, 0.1);
        transform: translateY(-4px);
    }

    .btn-primary {
        background: linear-gradient(135deg, #00f2fe, #00a8cc);
        border: none;
        color: #000;
        font-weight: 600;
    }

    .btn-primary:hover {
        box-shadow: 0 6px 20px rgba(0, 242, 254, 0.4);
        transform: translateY(-2px);
    }
</style>
{% endblock %}
