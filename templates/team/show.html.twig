{% extends 'base.html.twig' %}

{% block title %}{{ team.name }} - Dev Esports{% endblock %}

{% block body %}
{% if app.request.query.get('invite_success') %}
    <script>
        window.addEventListener('DOMContentLoaded', function () {
            window.alert('✅ Invitation envoyée avec succès à {{ app.request.query.get('invitee')|default('ce joueur')|e('js') }} !');
            const cleanUrl = window.location.pathname;
            window.history.replaceState({}, document.title, cleanUrl);
        });
    </script>
{% endif %}

<div class="row mb-4">
    <div class="col-md-12">
        <a href="{{ path('team_index') }}" class="btn btn-outline-primary btn-sm">← Back to Teams</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        {% if team.statut != 'approuvé' and not is_granted('ROLE_MANAGER') %}
            <div class="alert alert-warning" role="alert">
                <h4 class="alert-heading">⏳ Team Pending Approval</h4>
                <p>This team is waiting for admin approval and will be visible to all players once approved.</p>
            </div>
        {% elseif team.statut == 'refusé' %}
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">❌ Team Rejected</h4>
                <p>This team has been rejected by the admin.</p>
            </div>
        {% endif %}

        <div class="card mb-4">
            {% if team.logo %}
                <div style="height: 180px; background: linear-gradient(135deg, rgba(26, 40, 71, 0.8), rgba(26, 40, 71, 0.6)); display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid rgba(0, 242, 254, 0.15); padding: 1rem;">
                    <img src="{{ asset('uploads/logos/' ~ team.logo) }}" alt="{{ team.name }} logo" style="max-width: 100%; max-height: 100%; object-fit: contain; width: auto;">
                </div>
            {% else %}
                <div style="height: 180px; background: linear-gradient(135deg, rgba(0, 242, 254, 0.1), rgba(37, 211, 102, 0.1)); display: flex; align-items: center; justify-content: center; border-bottom: 1px solid rgba(0, 242, 254, 0.15);">
                    <i class="fas fa-image" style="font-size: 3rem; color: rgba(0, 242, 254, 0.3);"></i>
                </div>
            {% endif %}
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h1 class="page-title">{{ team.name }}</h1>
                        {% if team.statut == 'approuvé' %}
                            <span class="badge bg-success">✓ Approved</span>
                        {% elseif team.statut == 'en attente' %}
                            <span class="badge bg-warning">⏳ Pending</span>
                        {% else %}
                            <span class="badge bg-danger">✗ Rejected</span>
                        {% endif %}
                    </div>
                </div>
                
                {% if team.country %}
                    <p class="text-muted">📍 <strong>Country:</strong> {{ team.country }}</p>
                {% endif %}
                
                {% if team.description %}
                    <div class="mb-3">
                        <strong>Description:</strong>
                        <p>{{ team.description }}</p>
                    </div>
                {% endif %}
                
                <hr>
                
                <!-- Team Statistics -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <p><strong>👥 Players:</strong> {{ team.players|length }}</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>🎮 Total Matches:</strong> {{ (team.gamesAsTeam1|length) + (team.gamesAsTeam2|length) }}</p>
                    </div>
                </div>

                {% if is_granted('ROLE_MANAGER') and team.players is defined and app.user and team.players.contains(app.user) %}
                    <hr>
                    <h3>🤖 Assistant IA - Composition d'équipe</h3>
                    {% if app.request.query.get('post_create') and reco_mode == 'choose' %}
                        <div class="alert alert-info" role="alert">
                            Ton équipe est créée. Choisis maintenant le mode IA:
                            <strong>Auto</strong> (Gemini propose la meilleure composition) ou <strong>Manuel</strong> (joueurs recommandés + invitations manuelles).
                        </div>
                    {% endif %}

                    <div class="d-flex gap-2 flex-wrap mb-3">
                        <a href="{{ path('team_show', {id: team.id, reco_mode: 'auto'}) }}" class="btn {{ reco_mode == 'auto' ? 'btn-success' : 'btn-outline-success' }}">
                            <i class="fas fa-wand-magic-sparkles"></i> IA Auto: Best Team
                        </a>
                        <a href="{{ path('team_show', {id: team.id, reco_mode: 'manual'}) }}" class="btn {{ reco_mode == 'manual' ? 'btn-primary' : 'btn-outline-primary' }}">
                            <i class="fas fa-users"></i> IA Manuel: Recommended Players
                        </a>
                    </div>

                    {% if reco_mode == 'choose' %}
                        <div class="alert alert-secondary mb-0" role="alert">
                            Sélectionne un mode ci-dessus pour voir les recommandations IA.
                        </div>
                    {% endif %}
                {% endif %}

                {% if reco_mode == 'auto' and perfect_team_plan is defined and perfect_team_plan %}
                    <div class="alert alert-success" role="alert">
                        <strong>Pourquoi cette équipe ?</strong><br>
                        {{ perfect_team_plan.summary }}
                    </div>
                    {% if perfect_team_plan.slotsRemaining == 0 %}
                        <div class="alert alert-info" role="alert">
                            L'équipe est déjà complète.
                        </div>
                    {% elseif perfect_team_plan.recommendedPlayers is defined and perfect_team_plan.recommendedPlayers|length > 0 %}
                        <h5 class="mb-3">Top choix IA pour compléter l'équipe ({{ perfect_team_plan.slotsRemaining }} place(s) restante(s))</h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Joueur</th>
                                        <th>Rôle suggéré</th>
                                        <th>Score IA</th>
                                        <th>Raison</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in perfect_team_plan.recommendedPlayers %}
                                        <tr>
                                            <td>{{ item.player.nickname ?? item.player.username }}</td>
                                            <td><span class="badge bg-secondary">{{ item.suggestedRole }}</span></td>
                                            <td><span class="badge bg-success">{{ item.aiScore }}</span></td>
                                            <td>{{ item.reason }}</td>
                                            <td>
                                                <form method="POST" action="{{ path('team_invite') }}" class="m-0">
                                                    <input type="hidden" name="team_id" value="{{ team.id }}">
                                                    <input type="hidden" name="player_id" value="{{ item.player.id }}">
                                                    <input type="hidden" name="reco_mode" value="{{ reco_mode }}">
                                                    <button type="submit" class="btn btn-sm btn-primary" {% if team.statut != 'approuvé' %}disabled{% endif %}>
                                                        <i class="fas fa-paper-plane"></i>
                                                        {% if team.statut == 'approuvé' %}Inviter{% else %}En attente d'approbation{% endif %}
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                {% endif %}

                {% if reco_mode == 'manual' and ai_recommendations is defined and ai_recommendations|length > 0 %}
                    <h5>👥 Joueurs recommandés (choix manuel)</h5>
                    <div class="alert alert-info" role="alert">
                        L'IA te propose des profils; tu choisis qui inviter.
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Joueur</th>
                                    <th>Score IA</th>
                                    <th>Raison</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in ai_recommendations %}
                                    <tr>
                                        <td>{{ item.player.nickname ?? item.player.username }}</td>
                                        <td><span class="badge bg-success">{{ item.aiScore }}</span></td>
                                        <td>{{ item.reason }}</td>
                                        <td>
                                            <form method="POST" action="{{ path('team_invite') }}" class="m-0">
                                                <input type="hidden" name="team_id" value="{{ team.id }}">
                                                <input type="hidden" name="player_id" value="{{ item.player.id }}">
                                                <input type="hidden" name="reco_mode" value="{{ reco_mode }}">
                                                <button
                                                    type="submit"
                                                    class="btn btn-sm btn-primary"
                                                    {% if team.statut != 'approuvé' %}disabled{% endif %}
                                                >
                                                    <i class="fas fa-paper-plane"></i>
                                                    {% if team.statut == 'approuvé' %}
                                                        Inviter
                                                    {% else %}
                                                        En attente d'approbation
                                                    {% endif %}
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                <!-- Players Section -->
                {% if team.players|length > 0 %}
                    <hr>
                    <h3>👥 Current Members ({{ team.players|length }})</h3>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Nickname</th>
                                    <th>Name</th>
                                    <th>Role</th>
                                    <th>Birth Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for player in team.players %}
                                    <tr>
                                        <td>{{ player.nickname }}</td>
                                        <td>{{ player.firstName }} {{ player.lastName }}</td>
                                        <td>{{ player.role ?? '-' }}</td>
                                        <td>{{ player.birthDate ? player.birthDate|date('d M Y') : '-' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <hr>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> No members yet. 
                        {% if is_granted('ROLE_MANAGER') and team.statut == 'approuvé' %}
                            Invite players below to join the team!
                        {% endif %}
                    </div>
                {% endif %}

                <!-- Invite Players Section (for team managers) -->
                {% if is_granted('ROLE_MANAGER') and team.statut == 'approuvé' %}
                    <hr>
                    <h3>📤 Invite Players</h3>
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <form method="POST" action="{{ path('team_invite') }}" class="mb-3">
                                <input type="hidden" name="team_id" value="{{ team.id }}">
                                <input type="hidden" name="reco_mode" value="{{ reco_mode|default('manual') }}">
                                <div class="row g-2">
                                    <div class="col-lg-9">
                                        <select name="player_id" class="form-select" required>
                                            <option value="">-- Select a player to invite --</option>
                                            {% for player in available_players %}
                                                <option value="{{ player.id }}">{{ player.nickname }} ({{ player.firstName }} {{ player.lastName }})</option>
                                            {% endfor %}
                                        </select>
                                        {% if available_players|length == 0 %}
                                            <small class="text-muted">All players are already team members.</small>
                                        {% endif %}
                                    </div>
                                    <div class="col-lg-3">
                                        <button type="submit" class="btn btn-primary w-100" {% if available_players|length == 0 %}disabled{% endif %}>
                                            <i class="fas fa-paper-plane"></i> Send Invite
                                        </button>
                                    </div>
                                </div>
                            </form>

                            {% if pending_invitations|length > 0 %}
                                <div class="mt-3 p-3 bg-light rounded">
                                    <h5>⏳ Pending Invitations</h5>
                                    <ul class="list-unstyled">
                                        {% for invitation in pending_invitations %}
                                            <li class="mb-2 p-2 border-bottom">
                                                <strong>{{ invitation.player.nickname }}</strong> - Invited {{ invitation.createdAt|date('d M Y H:i') }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                <!-- Recent Matches -->
                {% set allMatches = team.gamesAsTeam1|merge(team.gamesAsTeam2)|sort((a, b) => b.matchdate <=> a.matchdate) %}
                {% if allMatches|length > 0 %}
                    <hr>
                    <h3>Recent Matches</h3>
                    <div class="row">
                        {% for match in allMatches[:5] %}
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">{{ match.team1.name }} vs {{ match.team2.name }}</h6>
                                        <p class="mb-1">
                                            <strong style="color: var(--highlight-color);">{{ match.score1 }} - {{ match.score2 }}</strong>
                                        </p>
                                        <small class="text-muted">{{ match.matchdate|date('d M Y - H:i') }}</small><br>
                                        <a href="{{ path('match_show', { id: match.id }) }}" class="btn btn-sm btn-outline-primary mt-2">View</a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Delete Team Action -->
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
            <div class="mt-4 pt-4" style="border-top: 2px solid rgba(255, 56, 96, 0.3); text-align: center;">
                <button class="btn btn-danger btn-lg" id="deleteBtn" style="cursor: pointer; z-index: 1000; position: relative;">
                    <i class="fas fa-trash"></i> Delete Team
                </button>
                <script>
                    document.getElementById('deleteBtn').addEventListener('click', function(e) {
                        e.preventDefault();
                        if (window.confirm('Are you sure you want to delete {{ team.name }}? This action cannot be undone.')) {
                            var form = document.createElement('form');
                            form.method = 'POST';
                            form.action = '{{ path('team_delete', { id: team.id }) }}';
                            
                            var token = document.createElement('input');
                            token.type = 'hidden';
                            token.name = '_token';
                            token.value = '{{ csrf_token('delete' ~ team.id) }}';
                            
                            form.appendChild(token);
                            document.body.appendChild(form);
                            form.submit();
                        }
                    });
                </script>
            </div>
        {% endif %}

        <div class="text-center mt-3">
            <a href="{{ path('team_index') }}" class="btn btn-outline-primary">← Back to Teams</a>
        </div>
    </div>
</div>
{% endblock %}
