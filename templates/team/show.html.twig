{% extends 'base.html.twig' %}

{% block title %}{{ team.name }}{% endblock %}

{% block body %}
    {% include '_sidebar.html.twig' %}

    <div class="content-with-sidebar">
        <div class="container" style="max-width: 700px;">
            <div class="card">
                <h1 style="margin-bottom: 10px; color: #667eea;">{{ team.name }}</h1>
                <p style="color: #666; margin-bottom: 30px;">Led by <strong>{{ team.creator.username }}</strong></p>

                <!-- Team Stats -->
                <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div>
                            <p style="margin: 0; opacity: 0.9;">Members</p>
                            <h2 style="margin: 10px 0 0 0; font-size: 28px;">{{ team.memberCount }}<span style="font-size: 18px; opacity: 0.8;"> / 5</span></h2>
                        </div>
                        <div>
                            <p style="margin: 0; opacity: 0.9;">Available Spots</p>
                            <h2 style="margin: 10px 0 0 0; font-size: 28px;">{{ team.availableSlots }}</h2>
                        </div>
                    </div>
                    <div style="margin-top: 20px; height: 8px; background-color: rgba(255,255,255,0.2); border-radius: 4px; overflow: hidden;">
                        <div style="height: 100%; width: {{ (team.memberCount / 5 * 100) }}%; background-color: rgba(255,255,255,0.9);"></div>
                    </div>
                </div>

                <!-- Team Members -->
                <div style="margin-bottom: 30px;">
                    <h3 style="color: #333; margin-bottom: 15px;">Team Members</h3>
                    <div style="background-color: #f8f9fa; border-radius: 8px; overflow: hidden;">
                        {% for member in team.members %}
                            <div style="padding: 15px; border-bottom: 1px solid #e5e7eb;">
                                <div style="display: flex; align-items: center; gap: 15px;">
                                    <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                                        {{ member.user.username[0]|upper }}
                                    </div>
                                    <div>
                                        <p style="margin: 0; font-weight: 600;">{{ member.user.username }}</p>
                                        <p style="margin: 5px 0 0 0; font-size: 12px; color: #999;">
                                            {{ member.user.email }}
                                            {% if member.user == team.creator %}
                                                <span style="background-color: #667eea; color: white; padding: 2px 8px; border-radius: 3px; margin-left: 10px;">Captain</span>
                                            {% endif %}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Actions -->
                <div style="display: flex; gap: 15px;">
                    {% if app.user == team.creator %}
                        <a href="{{ path('team_edit', {id: team.id}) }}" class="btn primary" style="padding: 12px 30px; text-decoration: none; display: inline-block;">Edit Team</a>
                    {% else %}
                        {% set isMember = false %}
                        {% for member in team.members %}
                            {% if member.user == app.user %}
                                {% set isMember = true %}
                            {% endif %}
                        {% endfor %}
                        
                        {% if isMember %}
                            <form action="{{ path('team_leave', {id: team.id}) }}" method="post" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('') }}">
                                <button type="submit" class="btn secondary" style="padding: 12px 30px; background-color: #ef4444; color: white; border: none; cursor: pointer;" onclick="return confirm('Leave this team?');">Leave Team</button>
                            </form>
                        {% else %}
                            {% if not team.isFull %}
                                <form action="{{ path('team_join', {id: team.id}) }}" method="post" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('join-team-' ~ team.id) }}">
                                    <button type="submit" class="btn primary" style="padding: 12px 30px;">Join Team</button>
                                </form>
                            {% else %}
                                <div style="background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 15px; border-radius: 4px;">
                                    <p style="margin: 0; color: #92400e;">This team is full.</p>
                                </div>
                            {% endif %}
                        {% endif %}
                    {% endif %}

                    <a href="{{ path('team_index') }}" class="btn secondary" style="padding: 12px 30px; text-decoration: none; display: inline-block; background-color: #e2e8f0; color: #333;">Back to Teams</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
