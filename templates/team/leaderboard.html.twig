{% extends 'base.html.twig' %}

{% block title %}Leaderboard - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-12 d-flex justify-content-between align-items-center">
        <h1 class="page-title">🏆 Team Leaderboard</h1>
        <a href="{{ path('team_index') }}" class="btn btn-outline-primary btn-sm">← Back to Teams</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-10 mx-auto">
        <div class="card">
            <div class="card-body">
                {% if teams is empty %}
                    <div class="alert alert-info mb-0">No teams available for leaderboard yet.</div>
                {% else %}
                    <div class="mb-3 text-muted">
                        Showing top {{ teams|length }} team{{ teams|length > 1 ? 's' : '' }} by score.
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Team</th>
                                    <th>Score</th>
                                    <th>Game</th>
                                    <th>Country</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for team in teams %}
                                    <tr>
                                        <td>
                                            {% if loop.index == 1 %}
                                                🥇
                                            {% elseif loop.index == 2 %}
                                                🥈
                                            {% elseif loop.index == 3 %}
                                                🥉
                                            {% else %}
                                                {{ loop.index }}
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a href="{{ path('team_show', { id: team.id }) }}" class="text-decoration-none">
                                                {{ team.name }}
                                            </a>
                                        </td>
                                        <td><strong>{{ team.score ?? 0 }}</strong></td>
                                        <td>{{ team.jeu ?? '-' }}</td>
                                        <td>{{ team.country ?? '-' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
