{% extends "base.html.twig" %}

{% block title %}Sent Invitations - Rankup{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title mb-0">Sent Invitations</h1>
        <a href="{{ path('player_dashboard') }}" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    {% if sentInvitations|length > 0 %}
        <div class="row">
            {% for invitation in sentInvitations %}
                <div class="col-md-6 mb-3">
                    <div class="card {% if invitation.status == 'accepted' %}border-success{% elseif invitation.status == 'rejected' %}border-danger{% else %}border-primary{% endif %}">
                        <div class="card-header {% if invitation.status == 'accepted' %}bg-success text-white{% elseif invitation.status == 'rejected' %}bg-danger text-white{% else %}bg-primary text-white{% endif %}">
                            {{ invitation.team.name }}
                        </div>
                        <div class="card-body">
                            <p class="mb-2"><strong>Player:</strong> {{ invitation.player.nickname }}</p>
                            <p class="mb-2"><strong>Sent on:</strong> {{ invitation.createdAt|date('d M Y H:i') }}</p>
                            {% if invitation.respondedAt %}
                                <p class="mb-2"><strong>Responded on:</strong> {{ invitation.respondedAt|date('d M Y H:i') }}</p>
                            {% endif %}
                            <span class="badge {% if invitation.status == 'accepted' %}bg-success{% elseif invitation.status == 'rejected' %}bg-danger{% else %}bg-warning text-dark{% endif %}">{{ invitation.status|title }}</span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info mb-0">No sent invitations yet.</div>
    {% endif %}
</div>
{% endblock %}
