{% extends 'base.html.twig' %}

{% block title %}Team Chat - Dev Esports{% endblock %}

{% block body %}
<div class="row mb-3">
    <div class="col-md-12 d-flex justify-content-between align-items-center">
        <h1 class="page-title mb-0">💬 Team Chat</h1>
        <a href="{{ path('team_show', {id: current_team.id}) }}" class="btn btn-outline-primary btn-sm">Back to Team</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-3">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-3">My Teams</h5>
                <div class="list-group">
                    {% for team in teams %}
                        <a
                            href="{{ path('team_chat_room', {id: team.id}) }}"
                            class="list-group-item list-group-item-action {% if team.id == current_team.id %}active{% endif %}"
                        >
                            {{ team.name }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Chat: {{ current_team.name }}</strong>
                <small class="text-muted">Real-time team chat</small>
            </div>
            <div class="card-body p-0">
                <div id="chatMessages" style="height: 420px; overflow-y: auto; padding: 1rem; background: rgba(10, 20, 40, 0.35);">
                    {% for message in messages %}
                        {% set isMine = message.sender and app.user and message.sender.id == app.user.id %}
                        <div class="d-flex mb-2 {% if isMine %}justify-content-end{% else %}justify-content-start{% endif %}" data-message-id="{{ message.id }}">
                            <div class="p-2 rounded" style="max-width: 75%; {% if isMine %}background: rgba(37, 211, 102, 0.2); border: 1px solid rgba(37, 211, 102, 0.3);{% else %}background: rgba(0, 242, 254, 0.12); border: 1px solid rgba(0, 242, 254, 0.25);{% endif %}">
                                <div class="small fw-bold">{{ message.sender.nickname ?? 'Player' }}</div>
                                <div>{{ message.content }}</div>
                                <div class="text-muted small mt-1">{{ message.createdAt ? message.createdAt|date('H:i') : '' }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <form id="chatForm" class="p-3 border-top" autocomplete="off">
                    <div class="input-group">
                        <input
                            type="text"
                            id="chatInput"
                            class="form-control"
                            maxlength="1000"
                            placeholder="Type a message..."
                            required
                        >
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-paper-plane"></i> Send
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const messagesEl = document.getElementById('chatMessages');
    const formEl = document.getElementById('chatForm');
    const inputEl = document.getElementById('chatInput');
    const submitBtn = formEl ? formEl.querySelector('button[type="submit"]') : null;
    const teamId = {{ current_team.id }};

    let lastMessageId = 0;
    let isSending = false;
    const knownMessageIds = new Set();

    const existing = messagesEl.querySelectorAll('[data-message-id]');
    if (existing.length > 0) {
        const ids = Array.from(existing).map(el => Number(el.getAttribute('data-message-id')) || 0);
        lastMessageId = Math.max(...ids);
        ids.filter(id => id > 0).forEach(id => knownMessageIds.add(id));
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function appendMessage(message) {
        const msgId = Number(message.id) || 0;
        if (msgId > 0 && knownMessageIds.has(msgId)) {
            return;
        }

        const wrapper = document.createElement('div');
        wrapper.className = `d-flex mb-2 ${message.isMine ? 'justify-content-end' : 'justify-content-start'}`;
        wrapper.setAttribute('data-message-id', String(msgId));

        const bubbleStyle = message.isMine
            ? 'max-width: 75%; background: rgba(37, 211, 102, 0.2); border: 1px solid rgba(37, 211, 102, 0.3);'
            : 'max-width: 75%; background: rgba(0, 242, 254, 0.12); border: 1px solid rgba(0, 242, 254, 0.25);';

        wrapper.innerHTML = `
            <div class="p-2 rounded" style="${bubbleStyle}">
                <div class="small fw-bold">${escapeHtml(message.sender || 'Player')}</div>
                <div>${escapeHtml(message.content || '')}</div>
                <div class="text-muted small mt-1">${escapeHtml(message.createdAt || '')}</div>
            </div>
        `;

        messagesEl.appendChild(wrapper);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        if (msgId > 0) {
            knownMessageIds.add(msgId);
            lastMessageId = Math.max(lastMessageId, msgId);
        }
    }

    async function fetchNewMessages() {
        try {
            const res = await fetch(`{{ path('team_chat_messages', {id: current_team.id}) }}?after=${lastMessageId}`, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (!res.ok) {
                return;
            }

            const data = await res.json();
            (data.messages || []).forEach(appendMessage);
        } catch (error) {
            console.error('Chat polling error:', error);
        }
    }

    formEl.addEventListener('submit', async function (event) {
        event.preventDefault();

        if (isSending) {
            return;
        }

        const content = inputEl.value.trim();
        if (!content) {
            return;
        }

        isSending = true;
        if (submitBtn) {
            submitBtn.disabled = true;
        }

        try {
            const body = new URLSearchParams();
            body.set('content', content);

            const res = await fetch(`{{ path('team_chat_send', {id: current_team.id}) }}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: body.toString()
            });

            const data = await res.json();
            if (res.ok && data.message) {
                appendMessage(data.message);
                inputEl.value = '';
                inputEl.focus();
            }
        } catch (error) {
            console.error('Chat send error:', error);
        } finally {
            isSending = false;
            if (submitBtn) {
                submitBtn.disabled = false;
            }
        }
    });

    setInterval(fetchNewMessages, 2500);
})();
</script>
{% endblock %}
